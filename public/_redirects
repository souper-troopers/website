/product/african-worry-dolls-gift-tags        /shop/gift-tags/  301
/product/african-worry-dolls-per-doll         /shop/worry-dolls/ 301
/product-category/coffee/african-worry-dolls  /shop/worry-dolls/ 301
/product-category/coffee                      /shop/coffee/     301
/product-category/donate                      /donate/          301
/product-tag/african-worry-dolls              /shop/worry-dolls/ 301
/product/*             /shop/                                   301
/product-category/*    /shop/                                   301

