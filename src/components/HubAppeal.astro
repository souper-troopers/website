---
/* The campaign band: a band, not a pop-up, in the brand red (Adrian: red, so it catches the eye).
   Black on #dd4b59 is 5.2:1; white would be 4.0:1. Placed directly after the PhotoHero on Home,
   Donate and Get Involved. Drafted 30 September for Save our Hub (that page is still built, hidden);
   since 10 November it leads to Double Up for Humanity. Off on the live site until
   DOUBLE_UP.bannerLive; always shown on staging. See src/lib/double-up.ts. */
import { doubleUpBannerBuilt } from "../lib/double-up";
---

{doubleUpBannerBuilt() && (
	<a class="hub-appeal" href="/double-up/">
		<span class="wrap hub-appeal-inner">
			{/* A "x2" sticker (10 November, Stephen's pick over the old heart-shaped Hub photo, which was
			    made for Save our Hub): doubling is the message now, and it matches the badge on the
			    Double Up page. Decorative - the words carry the meaning. */}
			<span class="hub-appeal-x2" aria-hidden="true">&times;2</span>
			<span class="hub-appeal-body">
				<span><strong>Double Up for Humanity.</strong> Every rand you give is doubled, 23&ndash;27 November.</span>
				<span class="hub-appeal-cta">Find out more <span aria-hidden="true">&rarr;</span></span>
			</span>
		</span>
	</a>
)}

<style>
/* Sits flush under the hero: main spaces its children with a gap (--space-16, --space-12 on
   phones), so the band pulls itself up by exactly that much. */
.hub-appeal {
	display: block;
	margin-top: calc(-1 * var(--space-16));
	background: var(--st-red);
	color: #000;
	text-decoration: none;
}

.hub-appeal-inner {
	display: flex;
	align-items: center;
	gap: var(--space-4);
	padding-top: var(--space-3);
	padding-bottom: var(--space-3);
	font-size: 1.05rem;
}

/* The sticker spills out of the band, as the heart did: negative margins take it out of the band's
   height, and it paints over the next section rather than under it. Ink on the brand yellow is
   ~8:1. */
.hub-appeal-x2 {
	flex: none;
	position: relative;
	z-index: 1;
	display: grid;
	place-items: center;
	width: 76px;
	height: 76px;
	margin-block: -16px;
	border-radius: 50%;
	background: var(--st-yellow);
	color: var(--st-ink);
	font-size: 2rem;
	font-weight: 800;
	line-height: 1;
	transform: rotate(-10deg);
	box-shadow: 0 2px 0 rgba(0, 0, 0, 0.15), 0 6px 14px rgba(0, 0, 0, 0.3);
	transition: transform 0.2s ease;
}

.hub-appeal:hover .hub-appeal-x2 {
	transform: rotate(-4deg) scale(1.06);
}

.hub-appeal-body {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	justify-content: space-between;
	gap: var(--space-2) var(--space-5);
}

.hub-appeal-cta {
	font-weight: 700;
	text-decoration: underline;
	text-underline-offset: 3px;
	white-space: nowrap;
}

.hub-appeal:hover {
	background: #e46673;
}

@media (prefers-reduced-motion: reduce) {
	.hub-appeal-x2 {
		transition: none;
	}
}

.hub-appeal:focus-visible {
	outline: 3px solid var(--st-ink);
	outline-offset: -3px;
}

@media (max-width: 700px) {
	.hub-appeal {
		margin-top: calc(-1 * var(--space-12));
	}

	.hub-appeal-x2 {
		width: 64px;
		height: 64px;
		font-size: 1.7rem;
	}
}
</style>
