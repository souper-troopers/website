---
/* Save our Hub band (drafted 30 September): the fixed entry the review asked for - a band, not a
   pop-up, in the brand red (Adrian: red, so it catches the eye). Black on #dd4b59 is 5.2:1; white
   would be 4.0:1. Placed directly after the PhotoHero on Home, Donate and Get Involved. Off on live
   builds until CAMPAIGN.live - see src/lib/campaign.ts. */
import { Image } from "astro:assets";
import { campaignVisible } from "../lib/campaign";
import hubExterior from "../assets/images/humanity-hub-exterior.jpg";

// Three hearts that overlap slightly, cut out of ONE photo of the building - the photo shows
// through all three at once. Sizes and offsets are hand-set, in the cluster's own 140x94 units,
// so the band looks the same on every deploy; the mask SVG is built from them here. Upright, no
// tilt (the user's call).
const BOX = { w: 140, h: 94 };
const hearts = [
	{ w: 84, h: 78, x: 0, y: 8 },
	{ w: 54, h: 50, x: 72, y: 0 },
	// Drawn as its own layer on top, just overlapping the large heart's right side.
	{ w: 38, h: 35, x: 62, y: 58, top: true },
];
// The heart path, in a viewBox trimmed to the shape (x 2-22, y 3-21.6).
const HEART =
	"M12 21.6 10.5 20.2C5.4 15.6 2 12.5 2 8.6 2 5.5 4.4 3 7.5 3c1.7 0 3.4.8 4.5 2.1C13.1 3.8 14.8 3 16.5 3 19.6 3 22 5.5 22 8.6c0 3.9-3.4 7-8.5 11.6z";
const maskFor = (list: typeof hearts) => {
	const paths = list
		.map(({ w, h, x, y }) => {
			const t = `translate(${x} ${y}) scale(${w / 20} ${h / 18.6}) translate(-2 -3)`;
			return `<path transform='${t}' d='${HEART}'/>`;
		})
		.join("");
	const svg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 ${BOX.w} ${BOX.h}'>${paths}</svg>`;
	return `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
};
// Two layers of the same photo, lined up exactly, so it reads as one picture. A heart in its
// own layer gets its own shadow and so visibly sits on top; in one shared mask it would merge
// into the others.
const layers = [maskFor(hearts.filter((h) => !h.top)), maskFor(hearts.filter((h) => h.top))];
---

{campaignVisible() && (
	<a class="hub-appeal" href="/save-our-hub/">
		<span class="wrap hub-appeal-inner">
			{/* The building itself: "our home is for sale" lands harder when you can see the home.
			    Decorative - the words carry the meaning. One photo, seen through three hearts (a CSS mask). */}
			<span class="hub-appeal-hearts">
				{layers.map((mask) => (
					<span class="hub-appeal-layer">
						<Image
							class="hub-appeal-photo"
							src={hubExterior}
							alt=""
							widths={[200, 400]}
							sizes="140px"
							width={200}
							style={`-webkit-mask-image:${mask};mask-image:${mask}`}
						/>
					</span>
				))}
			</span>
			<span class="hub-appeal-body">
				<span><strong>Our home is for sale.</strong> Help us secure the Humanity Hub.</span>
				<span class="hub-appeal-cta">Save our Hub <span aria-hidden="true">&rarr;</span></span>
			</span>
		</span>
	</a>
)}

<style>
/* Sits flush under the hero: main spaces its children with a gap (--space-16, --space-12 on
   phones), so the band pulls itself up by exactly that much. */
.hub-appeal {
	display: block;
	margin-top: calc(-1 * var(--space-16));
	background: var(--st-red);
	color: #000;
	text-decoration: none;
}

.hub-appeal-inner {
	display: flex;
	align-items: center;
	gap: var(--space-4);
	padding-top: var(--space-3);
	padding-bottom: var(--space-3);
	font-size: 1.05rem;
}

/* Each layer carries the drop shadow, since a filter on the masked image would be cut off by its
   own mask; on the layer it follows that layer's hearts. */
.hub-appeal-hearts {
	--u: 1px;
	flex: none;
	display: block;
	position: relative;
	width: calc(140 * var(--u));
	height: calc(94 * var(--u));
}

.hub-appeal-layer {
	position: absolute;
	inset: 0;
	filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.35));
}

.hub-appeal-photo {
	display: block;
	width: 100%;
	height: 100%;
	object-fit: cover;
	object-position: 30% 60%;
	-webkit-mask-size: 100% 100%;
	mask-size: 100% 100%;
	-webkit-mask-repeat: no-repeat;
	mask-repeat: no-repeat;
}

.hub-appeal-body {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	justify-content: space-between;
	gap: var(--space-2) var(--space-5);
}

.hub-appeal-cta {
	font-weight: 700;
	text-decoration: underline;
	text-underline-offset: 3px;
	white-space: nowrap;
}

.hub-appeal:hover {
	background: #e46673;
}

.hub-appeal:focus-visible {
	outline: 3px solid var(--st-ink);
	outline-offset: -3px;
}

@media (max-width: 700px) {
	.hub-appeal {
		margin-top: calc(-1 * var(--space-12));
	}

	.hub-appeal-hearts {
		--u: 0.85px;
	}
}
</style>
