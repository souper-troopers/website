---
/* The campaign band: a band, not a pop-up, in the brand red (Adrian: red, so it catches the eye).
   Black on #dd4b59 is 5.2:1; white would be 4.0:1. Placed directly after the PhotoHero on Home,
   Donate and Get Involved. Drafted 30 September for Save our Hub (that page is still built, hidden);
   since 10 November it leads to Double Up for Humanity. Off on the live site until
   DOUBLE_UP.bannerLive; always shown on staging. See src/lib/double-up.ts. */
import { doubleUpBannerBuilt } from "../lib/double-up";

/* Faint black "2"s scattered behind the words (10 November, Stephen; yellow at first). At most 10%
   black, so the black text on the red still holds 4.7:1 where a 2 sits behind it. Fixed positions from a
   seeded generator, so every build draws the same pattern and nothing shifts between pages. */
let seed = 7;
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const twos = Array.from({ length: 40 }, (_, i) => ({
	left: ((i + rnd() * 0.8) / 40) * 100,
	top: -20 + rnd() * 90,
	size: 1.1 + rnd() * 2.6,
	rotate: -25 + rnd() * 50,
	opacity: 0.05 + rnd() * 0.05,
	// Falling (10 November): 9-17s per drop, started part-way through so they're spread out.
	duration: 9 + rnd() * 8,
	delay: -rnd() * 17,
}));
---

{doubleUpBannerBuilt() && (
	<a class="hub-appeal" href="/double-up/">
		<span class="hub-appeal-twos" aria-hidden="true">
			{twos.map((t) => (
				<span style={`left:${t.left.toFixed(1)}%;top:${t.top.toFixed(0)}%;font-size:${t.size.toFixed(2)}rem;transform:rotate(${t.rotate.toFixed(0)}deg);opacity:${t.opacity.toFixed(2)};animation-duration:${t.duration.toFixed(1)}s;animation-delay:${t.delay.toFixed(1)}s`}>2</span>
			))}
		</span>
		<span class="wrap hub-appeal-inner">
			{/* A "x2" sticker (10 November, Stephen's pick over the old heart-shaped Hub photo, which was
			    made for Save our Hub): doubling is the message now, and it matches the badge on the
			    Double Up page. Decorative - the words carry the meaning. */}
			<span class="hub-appeal-x2" aria-hidden="true">&times;2</span>
			<span class="hub-appeal-body">
				<span><strong>Double Up for Humanity.</strong> Every rand you give is <span class="hub-appeal-doubled">doubled</span>, 23&ndash;27 November.</span>
				<span class="hub-appeal-cta">Find out more <span aria-hidden="true">&rarr;</span></span>
			</span>
		</span>
	</a>
)}

<style>
/* Sits flush under the hero: main spaces its children with a gap (--space-16, --space-12 on
   phones), so the band pulls itself up by exactly that much. */
.hub-appeal {
	display: block;
	position: relative;
	margin-top: calc(-1 * var(--space-16));
	background: var(--st-red);
	color: #000;
	text-decoration: none;
}

/* Clipped to the band in its own layer, so the x2 sticker can still spill over the edges. */
.hub-appeal-twos {
	position: absolute;
	inset: 0;
	overflow: hidden;
	pointer-events: none;
}

.hub-appeal-twos span {
	position: absolute;
	color: #000;
	font-weight: 800;
	line-height: 1;
	/* Drift down through the band and wrap round, each at its own pace. `top` is animated (the
	   inline transform holds the tilt); 40 small absolutely placed glyphs, so it's cheap. */
	animation: hub-twos-fall linear infinite;
}

@keyframes hub-twos-fall {
	from {
		top: -45%;
	}
	to {
		top: 110%;
	}
}

/* Still, at their scattered starting places, for anyone who asks for less motion. */
@media (prefers-reduced-motion: reduce) {
	.hub-appeal-twos span {
		animation: none;
	}
}

.hub-appeal-inner {
	position: relative;
	display: flex;
	align-items: center;
	gap: var(--space-4);
	padding-top: var(--space-3);
	padding-bottom: var(--space-3);
	font-size: 1.05rem;
}

/* The sticker spills out of the band, as the heart did: negative margins take it out of the band's
   height, and it paints over the next section rather than under it. Ink on the brand yellow is
   ~8:1. */
.hub-appeal-x2 {
	flex: none;
	position: relative;
	z-index: 1;
	display: grid;
	place-items: center;
	width: 76px;
	height: 76px;
	margin-block: -16px;
	border-radius: 50%;
	background: var(--st-yellow);
	color: var(--st-ink);
	font-size: 2rem;
	font-weight: 800;
	line-height: 1;
	transform: rotate(-10deg);
	box-shadow: 0 2px 0 rgba(0, 0, 0, 0.15), 0 6px 14px rgba(0, 0, 0, 0.3);
	transition: transform 0.2s ease;
}

.hub-appeal:hover .hub-appeal-x2 {
	transform: rotate(-4deg) scale(1.06);
}

/* "doubled", picked out (10 November, Stephen): a hand-drawn-looking yellow marker stroke behind
   the word, in bold, that gives a little bounce now and then. Ink on the yellow is ~8:1. */
.hub-appeal-doubled {
	display: inline-block;
	position: relative;
	z-index: 0;
	padding: 0 0.2em;
	font-weight: 800;
	animation: hub-doubled-bounce 4s ease-in-out 1s infinite;
}

.hub-appeal-doubled::before {
	content: "";
	position: absolute;
	z-index: -1;
	inset: 0.05em -0.05em 0;
	border-radius: 0.3em 0.5em 0.35em 0.6em;
	background: var(--st-yellow);
	transform: rotate(-2deg) skewX(-8deg);
}

@keyframes hub-doubled-bounce {
	0%, 82%, 100% {
		transform: none;
	}
	86% {
		transform: translateY(-3px) scale(1.12) rotate(-3deg);
	}
	91% {
		transform: translateY(0) scale(0.97);
	}
	95% {
		transform: scale(1.04);
	}
}

@media (prefers-reduced-motion: reduce) {
	.hub-appeal-doubled {
		animation: none;
	}
}

.hub-appeal-body {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	justify-content: space-between;
	gap: var(--space-2) var(--space-5);
}

.hub-appeal-cta {
	font-weight: 700;
	text-decoration: underline;
	text-underline-offset: 3px;
	white-space: nowrap;
}

.hub-appeal:hover {
	background: #e46673;
}

@media (prefers-reduced-motion: reduce) {
	.hub-appeal-x2 {
		transition: none;
	}
}

.hub-appeal:focus-visible {
	outline: 3px solid var(--st-ink);
	outline-offset: -3px;
}

@media (max-width: 700px) {
	.hub-appeal {
		margin-top: calc(-1 * var(--space-12));
	}

	.hub-appeal-x2 {
		width: 64px;
		height: 64px;
		font-size: 1.7rem;
	}
}
</style>
