---
/* Save our Hub band (drafted 30 September): the fixed entry the review asked for - a band, not a
   pop-up, in the brand red (Adrian: red, so it catches the eye). Black on #dd4b59 is 5.2:1; white
   would be 4.0:1. Placed directly after a page's PhotoHero on the homepage and Donate. Off on live
   builds until CAMPAIGN.live - see src/lib/campaign.ts. */
import { campaignVisible } from "../lib/campaign";
---

{campaignVisible() && (
	<a class="hub-appeal" href="/save-our-hub/">
		<span class="wrap hub-appeal-inner">
			<span><strong>Our home is for sale.</strong> Help us secure the Humanity Hub.</span>
			<span class="hub-appeal-cta">Save our Hub <span aria-hidden="true">&rarr;</span></span>
		</span>
	</a>
)}

<style>
/* Sits flush under the hero: main spaces its children with a gap (--space-16, --space-12 on
   phones), so the band pulls itself up by exactly that much. */
.hub-appeal {
	display: block;
	margin-top: calc(-1 * var(--space-16));
	background: var(--st-red);
	color: #000;
	text-decoration: none;
}

.hub-appeal-inner {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	justify-content: space-between;
	gap: var(--space-2) var(--space-5);
	padding-top: var(--space-4);
	padding-bottom: var(--space-4);
	font-size: 1.05rem;
}

.hub-appeal-cta {
	font-weight: 700;
	text-decoration: underline;
	text-underline-offset: 3px;
	white-space: nowrap;
}

.hub-appeal:hover {
	background: #e46673;
}

.hub-appeal:focus-visible {
	outline: 3px solid var(--st-ink);
	outline-offset: -3px;
}

@media (max-width: 700px) {
	.hub-appeal {
		margin-top: calc(-1 * var(--space-12));
	}
}
</style>
