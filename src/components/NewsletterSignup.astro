---
/**
 * "Get news and updates" (28 September, `q47`). A plain form posting to Mailchimp - no script, no
 * third-party code on our pages. Mailchimp's own page opens in a new tab to confirm, so the visitor
 * keeps their place here. `variant="footer"` sits on the ink footer; `variant="band"` is the
 * homepage's section. See src/lib/newsletter.ts for how it is switched on.
 */
import { newsletterForm, newsletterVisible } from "../lib/newsletter";

interface Props {
	variant: "footer" | "band";
}
const { variant } = Astro.props;
const form = newsletterForm();
const show = newsletterVisible();
const id = `newsletter-${variant}`;
---

{show && (
	<div class:list={["newsletter", `newsletter-${variant}`]}>
		{variant === "band" ? (
			<h2 id={`${id}-title`}>Get news and updates</h2>
		) : (
			<p class="newsletter-label" id={`${id}-title`}>Get news and updates</p>
		)}
		<form
			class="newsletter-form"
			action={form?.action ?? "#"}
			method="post"
			target="_blank"
			aria-labelledby={`${id}-title`}
		>
			{/* Name and surname (13 October, Shan: an email alone "feels like we're chatting to bots").
			    MERGE1 / MERGE2 are the audience's own First Name and Last Name fields - the names
			    Mailchimp's hosted form posts - so they land in the existing columns. */}
			<label class="visually-hidden" for={`${id}-first`}>First name</label>
			<input
				id={`${id}-first`}
				class="newsletter-field newsletter-name"
				type="text"
				name="MERGE1"
				required
				autocomplete="given-name"
				placeholder="First name"
			/>
			<label class="visually-hidden" for={`${id}-last`}>Surname</label>
			<input
				id={`${id}-last`}
				class="newsletter-field newsletter-name"
				type="text"
				name="MERGE2"
				required
				autocomplete="family-name"
				placeholder="Surname"
			/>
			<label class="visually-hidden" for={`${id}-email`}>Your email</label>
			<input
				id={`${id}-email`}
				class="newsletter-field newsletter-email"
				type="email"
				name="EMAIL"
				required
				autocomplete="email"
				placeholder="Your email"
			/>
			{form && (
				<div class="newsletter-trap" aria-hidden="true">
					<input type="text" name={form.honeypot} tabindex="-1" value="" autocomplete="off" />
				</div>
			)}
			<button class="btn btn-primary" type="submit">
				Subscribe<span class="visually-hidden"> (opens in a new tab)</span>
			</button>
		</form>
	</div>
)}

<style>
	.newsletter-form {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: 0;
	}

	.newsletter-field {
		box-sizing: border-box;
		flex: 1 1 14rem;
		min-width: 0;
		height: 36px;
		padding: 0 var(--space-3);
		border-radius: 10px;
		border: 1px solid rgba(36, 35, 43, 0.2);
		background: var(--st-white);
		color: var(--st-ink);
		font: inherit;
	}

	/* The two name fields share a row; the email and Subscribe take the next. */
	.newsletter-name {
		flex: 1 1 9rem;
	}

	.newsletter-email {
		flex-basis: 60%;
	}

	.newsletter-form .btn {
		height: 36px;
		padding-top: 0;
		padding-bottom: 0;
		cursor: pointer;
	}

	/* Mailchimp's bot trap: off-screen, not display:none, which some bots detect and skip. */
	.newsletter-trap {
		position: absolute;
		left: -5000px;
	}

	/* Footer: label, field and button on one row beside the socials, on the ink background; the
	   label goes above the field once the row is too narrow. */
	.newsletter-footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2) var(--space-4);
	}

	.newsletter-footer .newsletter-form {
		flex: 1 1 22rem;
		max-width: 26rem;
	}

	/* From 900px the footer sign-up is one line of its own under the socials: label, first name,
	   surname, email and Subscribe (13 October). Narrower, the names share a row above the email. */
	@media (min-width: 900px) {
		.newsletter-footer {
			flex-wrap: nowrap;
		}

		.newsletter-footer .newsletter-form {
			flex: 0 1 auto;
			flex-wrap: nowrap;
			max-width: none;
		}

		.newsletter-footer .newsletter-name {
			flex: 0 1 10rem;
		}

		.newsletter-footer .newsletter-email {
			flex: 0 1 16rem;
		}
	}

	.newsletter-label {
		margin: 0;
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		/* Matches "Follow us" beside it. */
		opacity: 0.6;
	}

	/* Outlined on the ink footer (28 September, the user's call, kept after a trial): a white-bordered
	   field and a teal-bordered button, rather than a white field and a filled teal button, so the
	   sign-up sits as quietly as the dimmed labels beside it. Label 0.85 white ~12:1, teal border ~6:1. */
	.newsletter-footer .newsletter-field {
		background: transparent;
		border: 1px solid var(--st-white);
		color: var(--st-white);
	}

	.newsletter-footer .newsletter-field::placeholder {
		color: rgba(255, 255, 255, 0.65);
	}

	.newsletter-footer .newsletter-form .btn {
		background: transparent;
		border-color: var(--st-teal);
		color: rgba(255, 255, 255, 0.85);
	}

	.newsletter-footer .newsletter-form .btn:hover {
		background: rgba(27, 171, 190, 0.18);
		color: var(--st-white);
	}

	/* Homepage band: the heading, then the form, left-aligned like the page's other sections. */
	.newsletter-band {
		max-width: 36rem;
	}

	.newsletter-band h2 {
		margin: 0 0 var(--space-4);
	}
</style>
