---
import { Image } from "astro:assets";
import shopPhoto from "../assets/images/shop-products.jpg";

/**
 * "Every purchase pays a wage": the shop's promise on its photograph, drawn like the audience
 * banners on Get Involved - the photo fills the card, a tint darkens its left side, and the words sit
 * on that in white. Used as the shop's lead card and as the homepage's pointer to the shop (Kerry, on
 * the 2 September review: the homepage "needs to kind of speak to our social enterprise").
 *
 * One component rather than two copies because the tint is measured, not guessed: it is tuned to
 * this photo and to the text column below, and a copy would drift from the check that proved it.
 *
 * The text is in normal flow and the photo is laid behind it, so the card grows to fit the words
 * instead of the words spilling off the photo. Get Involved hides its banner blurb on small phones;
 * this one cannot, because on the shop it is the page's trust statement and is said nowhere else.
 *
 * Give each page its own words for the paragraph (the slot). The same sentence on two pages reads as
 * thin content; see "The parent/child rule" in AGENTS.md.
 */
interface Props {
	heading: string;
	/** The shop, where this is the first and largest image: load it at once, at high priority. */
	eager?: boolean;
	/** An onward link under the words - the homepage's "Visit the shop". */
	href?: string;
	linkLabel?: string;
}

const { heading, eager = false, href, linkLabel } = Astro.props;
---

<div class="card shop-promise">
	<div class="shop-promise-media">
		<Image
			src={shopPhoto}
			alt="Troopers Coffee bags and African Worry Dolls on display"
			width={1600}
			widths={[600, 1100, 1600]}
			sizes="(min-width: 1100px) 1060px, 100vw"
			loading={eager ? "eager" : "lazy"}
			fetchpriority={eager ? "high" : undefined}
			class="shop-promise-img"
		/>
		<div class="shop-promise-scrim" aria-hidden="true"></div>
		<div class="shop-promise-text">
			<h2>{heading}</h2>
			<slot />
			{href && <a class="shop-promise-link" href={href}>{linkLabel ?? "Visit the shop"} &rarr;</a>}
		</div>
	</div>
</div>

<style>
	.shop-promise {
		padding: 0;
		gap: 0;
		overflow: hidden;
	}

	/* Get Involved's banner shapes - 3:1 once there is room, 16:9 on a phone - but as a floor rather
	   than a fixed shape: `aspect-ratio` lets an in-flow child grow the box, so if the words need more
	   height than the ratio gives, the card gets taller and the photo (cover) follows. */
	.shop-promise-media {
		position: relative;
		width: 100%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		aspect-ratio: 16 / 9;
	}

	@media (min-width: 701px) {
		.shop-promise-media {
			aspect-ratio: 3 / 1;
		}
	}

	.shop-promise-img {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Measured against the real photo pixels under every line of text, not assumed. Get Involved's own
	   tint (0.82 / 0.62 at 40% / 0.12 at 74%) failed here - paragraph worst 1.5-3.4:1 - because this
	   photo is a white wall and pale wood exactly where the words sit. White text needs roughly 0.6 of
	   tint under every glyph on those pixels, so on a phone, where the words span the whole photo, the
	   tint is near-even. Change the stops and re-run that check. */
	.shop-promise-scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(24, 23, 30, 0.74) 0%, rgba(24, 23, 30, 0.68) 100%);
	}

	/* From 701px the words are held to the left 56% of the photo, and the tint stays at 0.66 or more
	   until past them before it fades, so the dolls and the red curtain on the right stay clear. */
	@media (min-width: 701px) {
		.shop-promise-scrim {
			background: linear-gradient(
				100deg,
				rgba(24, 23, 30, 0.86) 0%,
				rgba(24, 23, 30, 0.78) 45%,
				rgba(24, 23, 30, 0.66) 62%,
				rgba(24, 23, 30, 0.14) 86%,
				rgba(24, 23, 30, 0) 100%
			);
		}

		.shop-promise-text {
			max-width: min(34rem, 56%);
		}
	}

	.shop-promise-text {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
		padding: var(--space-5);
		/* No max-width here: on a phone the words span the photo (the tint is even there), and from
		   701px the limit is set in the tint's media block above. A max-width here would come later
		   in the sheet and override that one - which it did, running the text onto the pale half. */
	}

	.shop-promise-text h2 {
		margin: 0;
		color: #fff;
		font-size: clamp(1.6rem, 3.4vw, 2.3rem);
		line-height: 1.1;
	}

	/* Fully white, not Get Involved's 86%: on this photo the difference is what gets the paragraph
	   over 4.5:1 without darkening the tint further. The slot's paragraph is the caller's markup, so
	   it is reached with :global. */
	.shop-promise-text :global(p) {
		margin: 0;
		color: #fff;
	}

	/* White and underlined, not teal: teal-dark on this dark tint would fail contrast, and the
	   underline is what says "link" (the same call as `.stories-band a`). */
	.shop-promise-link {
		margin-top: var(--space-2);
		color: #fff;
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
