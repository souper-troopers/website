---
/**
 * A success story's video, shown as a still with a play button. The provider's player - with its
 * scripts and cookies - loads only when someone presses play, so a page of stories costs one small
 * image per video rather than a full player each.
 *
 * Only rendered when a story has a video link, so a story without one looks exactly as it did.
 * There are deliberately no placeholder frames for stories still waiting on a video.
 */
import { videoEmbed } from "../lib/video";

interface Props {
	url: string;
	/** Names the video for screen readers and the player, e.g. "Sidney's story". */
	title: string;
}

const { url, title } = Astro.props;
const embed = await videoEmbed(url);
---

{embed ? (
	<button type="button" class="story-video" data-embed={embed.src} data-title={title}>
		{embed.thumbnail && <img src={embed.thumbnail} alt="" width="480" height="270" loading="lazy" decoding="async" />}
		<span class="story-video-play" aria-hidden="true">
			<svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
		</span>
		<span class="visually-hidden">Play video: {title}</span>
	</button>
) : (
	<a class="story-video-link" href={url} target="_blank" rel="noopener">Watch the video &rarr;</a>
)}

<script>
	// One listener for every video on the page. The button turns into the player in place, so the
	// card doesn't move, and focus follows it so a keyboard user lands on the controls they asked for.
	document.addEventListener("click", (event) => {
		const button = (event.target as Element).closest<HTMLButtonElement>("button.story-video");
		if (!button?.dataset.embed) return;
		const frame = document.createElement("iframe");
		frame.src = button.dataset.embed;
		frame.title = button.dataset.title ?? "Video";
		frame.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
		frame.allowFullscreen = true;
		frame.className = "story-video";
		button.replaceWith(frame);
		frame.focus();
	});
</script>

<style is:global>
	/* Global because the script above creates the iframe, which never gets this component's scoped
	   attribute. The button and the player share .story-video so the swap doesn't resize the card. */
	.story-video {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		padding: 0;
		margin: 0 0 var(--space-4);
		border: 0;
		border-radius: calc(var(--radius) / 2);
		overflow: hidden;
		background: var(--st-ink);
		cursor: pointer;
	}

	.story-video img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Teal fill with an ink glyph: the same pairing as .btn-primary (5.64:1), and a button shape, so
	   it reads as the control it is. */
	.story-video-play {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		place-items: center;
		width: 64px;
		height: 64px;
		margin: -32px 0 0 -32px;
		border-radius: 50%;
		background: var(--st-teal);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
		transition: transform 0.2s ease;
	}

	.story-video-play svg {
		width: 30px;
		height: 30px;
		margin-left: 3px;
		fill: var(--st-ink);
	}

	.story-video:hover .story-video-play {
		transform: scale(1.08);
	}

	/* Ink, not teal-dark: on the homepage this sits on the teal stories band. */
	.story-video:focus-visible {
		outline: 3px solid var(--st-ink);
		outline-offset: 3px;
	}

	.story-video-link {
		display: inline-block;
		margin-bottom: var(--space-3);
		font-weight: 700;
	}

	@media (prefers-reduced-motion: reduce) {
		.story-video-play {
			transition: none;
		}
	}
</style>
