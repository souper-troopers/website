---
import { Image, getImage } from "astro:assets";
import logoReversed from "../assets/images/logo-reversed.png";
import dignityMoment from "../assets/images/dignity-moment.jpg";
import { getSiteSettings } from "../lib/sanity";
import CartWidget from "../components/CartWidget.svelte";
import "@fontsource/quicksand/400.css";
import "@fontsource/quicksand/500.css";
import "@fontsource/quicksand/600.css";
import "@fontsource/quicksand/700.css";
import quicksand400 from "@fontsource/quicksand/files/quicksand-latin-400-normal.woff2?url";
import quicksand700 from "@fontsource/quicksand/files/quicksand-latin-700-normal.woff2?url";

interface Props {
	title: string;
	description?: string;
	/** Float the header transparently over the page's own hero, instead of sitting in normal flow above it. Only meaningful for pages whose hero is a photo (currently just the homepage) — the hero must supply its own darkening scrim for nav legibility. */
	heroOverlay?: boolean;
}

const {
	title,
	description = "Souper Troopers helps people move from crisis to dignity through food, work, and community in Cape Town.",
	heroOverlay = false,
} = Astro.props;

const navLinks = [
	{ href: "/", label: "Home" },
	{ href: "/about", label: "Who We Are" },
	{ href: "/our-work", label: "Our Work" },
	{ href: "/shop", label: "Shop" },
	{ href: "/get-involved", label: "Get Involved" },
	{ href: "/contact", label: "Contact" },
];

const socialLinks = [
	{
		label: "Facebook",
		href: "https://www.facebook.com/soupertroopers",
		path: "M22.675 0H1.325C.593 0 0 .593 0 1.325v21.351C0 23.407.593 24 1.325 24H12.82v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116C23.407 24 24 23.407 24 22.676V1.325C24 .593 23.407 0 22.675 0z",
	},
	{
		label: "Instagram",
		href: "https://www.instagram.com/souper_troopers/",
		path: "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.163 6.163 0 1 0 0 12.326 6.163 6.163 0 0 0 0-12.326zm0 10.162a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z",
	},
	{
		label: "LinkedIn",
		href: "https://www.linkedin.com/company/souper-troopers-npo/",
		path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.114 20.452H3.558V9h3.556v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
	},
	{
		label: "TikTok",
		href: "https://www.tiktok.com/@souper_troopers",
		path: "M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z",
	},
	{
		label: "YouTube",
		href: "https://www.youtube.com/@SouperTroopers1818",
		path: "M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z",
	},
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const settings = await getSiteSettings();
const fullTitle = `${title} — Souper Troopers`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: dignityMoment, width: 1200, height: 630 });
const ogImageURL = new URL(ogImage.src, Astro.site);

const structuredData = {
	"@context": "https://schema.org",
	"@type": "NGO",
	name: "Souper Troopers",
	url: Astro.site?.href,
	logo: new URL(logoReversed.src, Astro.site).href,
	description: settings.tagline,
	email: settings.email,
	address: settings.address,
	taxID: settings.npoNumber,
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="preload" href={quicksand400} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={quicksand700} as="font" type="font/woff2" crossorigin />
		<!-- Pre-launch preview only — remove this once the site goes live on the real domain. -->
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon-512.png" sizes="512x512" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="description" content={description} />
		<title>{fullTitle}</title>
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Souper Troopers" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

		<!-- Cloudflare Web Analytics -->
		<script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "db07bdfbee474364b7d4e4d32a400bb6"}'></script>
		<!-- End Cloudflare Web Analytics -->
	</head>
	<body>
		<header class:list={["site-header", { "site-header-overlay": heroOverlay }]}>
			<div class="wrap header-inner">
				<a href="/" class="brand">
					<Image src={logoReversed} alt="Souper Troopers" width={44} height={44} densities={[1, 2, 3]} />
					<span>Souper Troopers</span>
				</a>
				<nav aria-label="Primary" id="primary-nav">
					{navLinks.map((link) => (
						<a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>{link.label}</a>
					))}
				</nav>
				<CartWidget client:load />
				<a class="btn btn-primary donate-cta" href="/donate">Donate</a>
				<button class="nav-toggle" aria-expanded="false" aria-controls="primary-nav" aria-label="Menu">
					<span class="nav-toggle-bar"></span>
					<span class="nav-toggle-bar"></span>
					<span class="nav-toggle-bar"></span>
				</button>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap footer-inner">
				<strong>Souper Troopers</strong>
				<span>{settings.address}</span>
				<a href={`mailto:${settings.email}`}>{settings.email}</a>
			</div>
			<div class="wrap footer-social">
				<span class="footer-social-label">Follow us</span>
				<div class="social-links">
					{socialLinks.map((social) => (
						<a href={social.href} target="_blank" rel="noopener" aria-label={social.label}>
							<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={social.path} /></svg>
						</a>
					))}
				</div>
			</div>
			<p class="fine-print wrap">
				&copy; {new Date().getFullYear()} Souper Troopers. Est. 2014. &nbsp;|&nbsp; NPO {settings.npoNumber} &nbsp;|&nbsp; PBO {settings.pboNumber} &nbsp;|&nbsp; B-BBEE {settings.bbbeeLevel} &nbsp;|&nbsp; Shop products by Shmiley (Pty) Ltd, a Souper Troopers social enterprise.
			</p>
		</footer>

		<style is:global>
			:root {
				/* Official brand palette (souper-troopers-logo-document-06-11-2018.pdf) */
				--st-teal: #1babbe;
				--st-teal-dark: #148294;
				--st-teal-secondary: #24badd;
				--st-ink: #24232b;
				--st-yellow: #dbbc3b;
				--st-green: #4bbc63;
				--st-red: #dd4b59;
				--st-bg: #faf9f6;
				--st-white: #ffffff;
				--radius: 18px;
				--header-height: 71px;
				font-family: "Quicksand", "Segoe UI", system-ui, sans-serif;
			}

			* {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				padding: 0;
			}

			body {
				background: var(--st-bg);
				color: var(--st-ink);
				line-height: 1.5;
			}

			h1,
			h2,
			h3 {
				line-height: 1.1;
				font-weight: 700;
			}

			a {
				color: var(--st-teal-dark);
			}

			.wrap {
				max-width: 1100px;
				margin: 0 auto;
				padding: 0 1.5rem;
			}

			.site-header {
				background: var(--st-ink);
				position: sticky;
				top: 0;
				z-index: 100;
			}

			.site-header-overlay {
				position: fixed;
				left: 0;
				right: 0;
				background: transparent;
				transition: background-color 0.2s ease;
			}

			/*
			 * Starts transparent so the hero photo shows through behind it. A small script
			 * (see index.astro) adds this class once the user scrolls past the hero, so the
			 * header stops overlapping page content transparently and instead behaves like a
			 * normal opaque sticky header for the rest of the page.
			 */
			.site-header-overlay.is-solid {
				background: var(--st-ink);
			}

			.header-inner {
				display: flex;
				align-items: center;
				gap: 2rem;
				padding-top: 0.75rem;
				padding-bottom: 0.75rem;
				flex-wrap: wrap;
			}

			.brand {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				font-weight: 700;
				font-size: 1.1rem;
				color: var(--st-white);
				text-decoration: none;
				margin-right: auto;
			}

			.brand img {
				display: block;
			}

			nav[aria-label="Primary"] {
				display: flex;
				gap: 1.25rem;
				flex-wrap: wrap;
			}

			nav[aria-label="Primary"] a {
				color: rgba(255, 255, 255, 0.85);
				text-decoration: none;
				font-weight: 600;
				font-size: 0.95rem;
				padding-bottom: 4px;
				border-bottom: 2px solid transparent;
			}

			nav[aria-label="Primary"] a:hover {
				color: var(--st-teal);
			}

			nav[aria-label="Primary"] a[aria-current="page"] {
				color: var(--st-teal);
				border-bottom-color: var(--st-teal);
			}

			.nav-toggle {
				display: none;
				flex-direction: column;
				justify-content: center;
				gap: 5px;
				width: 32px;
				height: 32px;
				padding: 0;
				border: none;
				background: transparent;
				cursor: pointer;
				flex-shrink: 0;
			}

			.nav-toggle-bar {
				display: block;
				width: 100%;
				height: 2px;
				background: var(--st-white);
				border-radius: 2px;
				transition: transform 0.2s ease, opacity 0.2s ease;
			}

			.nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) {
				transform: translateY(7px) rotate(45deg);
			}

			.nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) {
				opacity: 0;
			}

			.nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) {
				transform: translateY(-7px) rotate(-45deg);
			}

			@media (max-width: 760px) {
				.header-inner {
					gap: 0.85rem;
				}

				.brand span {
					display: none;
				}

				.nav-toggle {
					display: flex;
				}

				nav[aria-label="Primary"] {
					display: none;
					position: absolute;
					top: 100%;
					left: 0;
					right: 0;
					flex-direction: column;
					gap: 0;
					background: var(--st-ink);
					padding: 0.5rem 1.5rem 1.25rem;
					box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
				}

				nav[aria-label="Primary"].is-open {
					display: flex;
				}

				nav[aria-label="Primary"] a {
					padding: 0.75rem 0;
					border-bottom: 1px solid rgba(255, 255, 255, 0.1);
				}

				nav[aria-label="Primary"] a[aria-current="page"] {
					border-bottom-color: var(--st-teal);
				}
			}

			.btn {
				display: inline-block;
				padding: 0.7rem 1.4rem;
				border-radius: 999px;
				font-weight: 700;
				text-decoration: none;
				text-align: center;
			}

			.btn-primary {
				background: var(--st-teal);
				color: var(--st-white);
			}

			.btn-primary:hover {
				background: var(--st-teal-dark);
			}

			.btn-secondary {
				background: var(--st-green);
				color: var(--st-white);
			}

			.btn-secondary:hover {
				opacity: 0.9;
			}

			.btn-outline {
				background: transparent;
				color: var(--st-ink);
				border: 2px solid var(--st-ink);
			}

			.site-footer {
				margin-top: 3rem;
				background: var(--st-ink);
				color: rgba(255, 255, 255, 0.85);
				padding: 1.75rem 0 1.25rem;
			}

			.footer-inner {
				display: flex;
				align-items: baseline;
				flex-wrap: wrap;
				gap: 0.5rem 1rem;
			}

			.site-footer a {
				color: var(--st-teal);
			}

			.footer-social {
				display: flex;
				align-items: center;
				gap: 0.9rem;
				margin-top: 1.1rem;
			}

			.footer-social-label {
				font-size: 0.8rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				opacity: 0.6;
			}

			.social-links {
				display: flex;
				gap: 0.85rem;
			}

			.social-links a {
				display: inline-flex;
				color: rgba(255, 255, 255, 0.75);
			}

			.social-links a:hover {
				color: var(--st-teal);
			}

			.social-links svg {
				display: block;
				fill: currentColor;
			}

			.fine-print {
				margin-top: 0.75rem;
				font-size: 0.8rem;
				opacity: 0.55;
			}

			/* Shared page building blocks */
			.section {
				padding: 3.5rem 0;
			}

			.section-intro h2 {
				font-size: clamp(1.6rem, 3vw, 2.2rem);
				margin-bottom: 0.5rem;
			}

			.section-intro p {
				max-width: 60ch;
				color: rgba(36, 35, 43, 0.75);
			}

			.grid {
				display: grid;
				gap: 1.5rem;
				margin-top: 2rem;
			}

			.grid-2 {
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			}

			.grid-3 {
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
			}

			.grid-4 {
				grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
			}

			.card {
				background: var(--st-white);
				color: var(--st-ink);
				border-radius: var(--radius);
				padding: 1.75rem;
				box-shadow: 0 14px 30px rgba(0, 0, 0, 0.05);
			}

			.card h3 {
				margin-top: 0;
			}

			.cast-letter {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 44px;
				height: 44px;
				border-radius: 50%;
				background: var(--st-teal);
				color: var(--st-white);
				font-weight: 700;
				font-size: 1.3rem;
				margin-bottom: 0.85rem;
			}

			.category-tile {
				text-decoration: none;
				color: inherit;
				display: flex;
				flex-direction: column;
				transition: transform 0.15s ease;
			}

			.category-tile:hover {
				transform: translateY(-3px);
			}

			.category-tile-img {
				width: 100%;
				aspect-ratio: 4 / 3;
				object-fit: cover;
				border-radius: calc(var(--radius) - 6px);
				margin-bottom: 1rem;
			}

			.category-tile h2 {
				font-size: 1.2rem;
				margin: 0 0 0.4rem;
			}

			.category-tile p {
				color: rgba(36, 35, 43, 0.65);
				font-size: 0.92rem;
				margin: 0 0 0.75rem;
			}

			.category-tile-cta {
				margin-top: auto;
				font-weight: 700;
				color: var(--st-teal-dark);
				font-size: 0.9rem;
			}

			.payment-icon {
				display: block;
				width: 28px;
				height: 28px;
				margin-bottom: 0.75rem;
				fill: var(--st-teal-dark);
			}

			.payment-icon-paypal {
				fill: #003087;
			}

			.redirect-note {
				margin-top: 0.6rem;
				font-size: 0.8rem;
				color: rgba(36, 35, 43, 0.55);
			}

			.contact-form {
				display: grid;
				gap: 1rem;
				max-width: 480px;
				margin-top: 2rem;
			}

			.contact-form label {
				display: grid;
				gap: 0.35rem;
				font-weight: 600;
				font-size: 0.9rem;
			}

			.contact-form input,
			.contact-form textarea {
				font: inherit;
				padding: 0.6rem 0.75rem;
				border-radius: 10px;
				border: 1px solid rgba(0, 0, 0, 0.15);
				background: var(--st-white);
			}

			.contact-form .btn {
				width: fit-content;
				border: none;
				cursor: pointer;
			}

			.contact-form .btn:disabled {
				opacity: 0.5;
				pointer-events: none;
			}

			.form-error {
				color: var(--st-red);
			}

			.honeypot-field {
				position: absolute;
				width: 1px;
				height: 1px;
				overflow: hidden;
				clip: rect(0 0 0 0);
				white-space: nowrap;
			}

			.partner-logo-frame {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 100px;
				height: 100px;
				margin-bottom: 0.75rem;
				border-radius: calc(var(--radius) / 2);
			}

			.partner-logo-frame.on-dark {
				background: var(--st-ink);
				padding: 0.5rem;
			}

			.partner-logo {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: contain;
			}

			.team-photo {
				display: block;
				width: 120px;
				height: 120px;
				object-fit: cover;
				border-radius: 50%;
				margin: 0 auto 0.75rem;
			}

			.goods-tile {
				position: relative;
				display: flex;
