---
import { Image } from "astro:assets";
import logoReversed from "../assets/images/logo-reversed.png";
import "@fontsource/quicksand/400.css";
import "@fontsource/quicksand/500.css";
import "@fontsource/quicksand/600.css";
import "@fontsource/quicksand/700.css";

interface Props {
	title: string;
	description?: string;
	/** Float the header transparently over the page's own hero, instead of sitting in normal flow above it. Only meaningful for pages whose hero is a photo (currently just the homepage) — the hero must supply its own darkening scrim for nav legibility. */
	heroOverlay?: boolean;
}

const {
	title,
	description = "Souper Troopers helps people move from crisis to dignity through food, work, and community in Cape Town.",
	heroOverlay = false,
} = Astro.props;

const navLinks = [
	{ href: "/", label: "Home" },
	{ href: "/about", label: "About" },
	{ href: "/our-work", label: "Our Work" },
	{ href: "/shop", label: "Shop" },
	{ href: "/get-involved", label: "Get Involved" },
	{ href: "/contact", label: "Contact" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon-512.png" sizes="512x512" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="description" content={description} />
		<title>{title} — Souper Troopers</title>
	</head>
	<body>
		<header class:list={["site-header", { "site-header-overlay": heroOverlay }]}>
			<div class="wrap header-inner">
				<a href="/" class="brand">
					<Image src={logoReversed} alt="Souper Troopers" width={44} height={44} />
					<span>Souper Troopers</span>
				</a>
				<nav aria-label="Primary">
					{navLinks.map((link) => (
						<a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>{link.label}</a>
					))}
				</nav>
				<a class="btn btn-primary donate-cta" href="/donate">Donate</a>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap footer-inner">
				<div>
					<strong>Souper Troopers</strong>
					<p>66 Newmarket Street, Woodstock, Cape Town</p>
					<p><a href="mailto:manager@soupertroopers.org">manager@soupertroopers.org</a></p>
					<p style="font-size: 0.85rem; opacity: 0.7;">Shop products by Shmiley (Pty) Ltd, a Souper Troopers social enterprise.</p>
				</div>
				<div>
					<p class="tagline">We are all human. We all have a story. Together, we are the change.</p>
				</div>
			</div>
			<p class="fine-print wrap">
				&copy; {new Date().getFullYear()} Souper Troopers. Est. 2014. &nbsp;|&nbsp; NPO 188-609 &nbsp;|&nbsp; PBO 930063119 &nbsp;|&nbsp; B-BBEE Level 1
			</p>
		</footer>

		<style is:global>
			:root {
				/* Official brand palette (souper-troopers-logo-document-06-11-2018.pdf) */
				--st-teal: #1babbe;
				--st-teal-dark: #148294;
				--st-teal-secondary: #24badd;
				--st-ink: #24232b;
				--st-yellow: #dbbc3b;
				--st-green: #4bbc63;
				--st-red: #dd4b59;
				--st-bg: #faf9f6;
				--st-white: #ffffff;
				--radius: 18px;
				--header-height: 71px;
				font-family: "Quicksand", "Segoe UI", system-ui, sans-serif;
			}

			* {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				padding: 0;
			}

			body {
				background: var(--st-bg);
				color: var(--st-ink);
				line-height: 1.5;
			}

			h1,
			h2,
			h3 {
				line-height: 1.1;
				font-weight: 700;
			}

			a {
				color: var(--st-teal-dark);
			}

			.wrap {
				max-width: 1100px;
				margin: 0 auto;
				padding: 0 1.5rem;
			}

			.site-header {
				background: var(--st-ink);
				position: sticky;
				top: 0;
				z-index: 100;
			}

			.site-header-overlay {
				position: fixed;
				left: 0;
				right: 0;
				background: transparent;
				transition: background-color 0.2s ease;
			}

			/*
			 * Starts transparent so the hero photo shows through behind it. A small script
			 * (see index.astro) adds this class once the user scrolls past the hero, so the
			 * header stops overlapping page content transparently and instead behaves like a
			 * normal opaque sticky header for the rest of the page.
			 */
			.site-header-overlay.is-solid {
				background: var(--st-ink);
			}

			.header-inner {
				display: flex;
				align-items: center;
				gap: 2rem;
				padding-top: 0.75rem;
				padding-bottom: 0.75rem;
				flex-wrap: wrap;
			}

			.brand {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				font-weight: 700;
				font-size: 1.1rem;
				color: var(--st-white);
				text-decoration: none;
				margin-right: auto;
			}

			.brand img {
				display: block;
			}

			nav[aria-label="Primary"] {
				display: flex;
				gap: 1.25rem;
				flex-wrap: wrap;
			}

			nav[aria-label="Primary"] a {
				color: rgba(255, 255, 255, 0.85);
				text-decoration: none;
				font-weight: 600;
				font-size: 0.95rem;
				padding-bottom: 4px;
				border-bottom: 2px solid transparent;
			}

			nav[aria-label="Primary"] a:hover {
				color: var(--st-teal);
			}

			nav[aria-label="Primary"] a[aria-current="page"] {
				color: var(--st-teal);
				border-bottom-color: var(--st-teal);
			}

			.btn {
				display: inline-block;
				padding: 0.7rem 1.4rem;
				border-radius: 999px;
				font-weight: 700;
				text-decoration: none;
				text-align: center;
			}

			.btn-primary {
				background: var(--st-teal);
				color: var(--st-white);
			}

			.btn-primary:hover {
				background: var(--st-teal-dark);
			}

			.btn-secondary {
				background: var(--st-green);
				color: var(--st-white);
			}

			.btn-secondary:hover {
				opacity: 0.9;
			}

			.btn-outline {
				background: transparent;
				color: var(--st-ink);
				border: 2px solid var(--st-ink);
			}

			.site-footer {
				margin-top: 4rem;
				background: var(--st-ink);
				color: rgba(255, 255, 255, 0.85);
				padding: 3rem 0 1.5rem;
			}

			.footer-inner {
				display: grid;
				gap: 2rem;
				grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
			}

			.site-footer a {
				color: var(--st-teal);
			}

			.site-footer .tagline {
				font-size: 1.1rem;
				font-style: italic;
				max-width: 32ch;
			}

			.fine-print {
				margin-top: 2rem;
				font-size: 0.85rem;
				opacity: 0.6;
			}

			/* Shared page building blocks */
			.section {
				padding: 3.5rem 0;
			}

			.section-intro h2 {
				font-size: clamp(1.6rem, 3vw, 2.2rem);
				margin-bottom: 0.5rem;
			}

			.section-intro p {
				max-width: 60ch;
				color: rgba(36, 35, 43, 0.75);
			}

			.grid {
				display: grid;
				gap: 1.5rem;
				margin-top: 2rem;
			}

			.grid-2 {
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			}

			.grid-3 {
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
			}

			.grid-4 {
				grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
			}

			.card {
				background: var(--st-white);
				border-radius: var(--radius);
				padding: 1.75rem;
				box-shadow: 0 14px 30px rgba(0, 0, 0, 0.05);
			}

			.card h3 {
				margin-top: 0;
			}

			.stat {
				background: var(--st-white);
				border: 1px solid rgba(0, 0, 0, 0.06);
				border-radius: var(--radius);
				padding: 1.5rem;
				text-align: center;
			}

			.stat strong {
				display: block;
				font-size: 2rem;
				color: var(--st-teal-dark);
			}

			.stat span {
				font-size: 0.9rem;
				color: rgba(36, 35, 43, 0.7);
			}

			.hero {
				background: linear-gradient(135deg, var(--st-teal) 0%, var(--st-red) 100%);
				color: var(--st-white);
				padding: 4rem 0;
			}

			.hero-photo {
				position: relative;
				padding: calc(5.5rem + var(--header-height)) 0 5.5rem;
				overflow: hidden;
				background: var(--st-ink);
			}

			.hero-bg {
				position: absolute;
				top: -12%;
				left: 0;
				width: 100%;
				height: 124%;
				object-fit: cover;
				object-position: center 30%;
				z-index: 0;
				will-change: transform;
			}

			.hero-scrim {
				position: absolute;
				inset: 0;
				background: linear-gradient(
					100deg,
					rgba(24, 23, 31, 0.92) 0%,
					rgba(24, 23, 31, 0.75) 40%,
					rgba(27, 171, 190, 0.55) 100%
				);
				z-index: 1;
			}

			.hero-content {
				position: relative;
				z-index: 2;
			}

			.hero h1 {
				font-size: clamp(2.2rem, 5vw, 3.4rem);
				max-width: 20ch;
				margin: 0 0 1rem;
			}

			.hero p {
				max-width: 55ch;
				font-size: 1.1rem;
				margin: 0 0 2rem;
				opacity: 0.95;
			}

			.hero .actions {
				display: flex;
				gap: 1rem;
				flex-wrap: wrap;
			}

			.hero .btn-primary {
				background: var(--st-white);
				color: var(--st-ink);
			}

			.hero .btn-secondary {
				background: rgba(255, 255, 255, 0.15);
				color: var(--st-white);
				border: 2px solid rgba(255, 255, 255, 0.6);
			}

			.page-hero {
				background: var(--st-ink);
				color: var(--st-white);
				padding: 3rem 0;
			}

			.page-hero h1 {
				margin: 0 0 0.5rem;
				font-size: clamp(2rem, 4vw, 2.8rem);
			}

			.page-hero p {
				max-width: 60ch;
				opacity: 0.85;
			}

			.quote {
				border-left: 4px solid var(--st-teal);
				padding-left: 1.25rem;
				font-style: italic;
				font-size: 1.15rem;
				margin: 1.5rem 0;
			}

			.quote cite {
				display: block;
				margin-top: 0.5rem;
				font-style: normal;
				font-weight: 600;
				font-size: 0.9rem;
				opacity: 0.75;
			}

			.figure img {
				width: 100%;
				height: auto;
				border-radius: var(--radius);
				display: block;
			}

			.badge {
				display: inline-block;
				background: rgba(27, 171, 190, 0.12);
				color: var(--st-teal-dark);
				border-radius: 999px;
				padding: 0.3rem 0.9rem;
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.03em;
				text-transform: uppercase;
			}

			.badge-on-dark {
				background: rgba(255, 255, 255, 0.14);
				color: var(--st-teal);
			}

			/* Choose your path — asymmetric tiles */
			.path-grid {
				display: grid;
				grid-template-columns: 1.3fr 1fr;
				grid-auto-rows: 1fr;
				gap: 1.25rem;
				margin-top: 2rem;
				min-height: 460px;
			}

			.path-tile {
				display: flex;
				flex-direction: column;
				justify-content: flex-end;
				padding: 2rem;
				border-radius: 24px;
				color: var(--st-white);
				text-decoration: none;
				transition: transform 0.2s ease;
			}

			.path-tile:hover {
				transform: translateY(-4px);
			}

			.path-tile h3 {
				font-size: 1.6rem;
				margin: 0 0 0.6rem;
			}

			.path-tile p {
				opacity: 0.92;
				margin: 0 0 1.25rem;
				max-width: 38ch;
			}

			.path-cta {
				font-weight: 700;
				text-decoration: underline;
			}

			.path-tile-primary {
				grid-row: span 2;
				padding: 2.75rem;
			}

			.path-tile-primary h3 {
				font-size: 2rem;
			}

			.path-teal {
				background: linear-gradient(135deg, var(--st-teal) 0%, var(--st-teal-dark) 100%);
			}

			.path-green {
				background: var(--st-green);
			}

			.path-ink {
				background: var(--st-ink);
			}

			@media (max-width: 700px) {
				.path-grid {
					grid-template-columns: 1fr;
					min-height: 0;
				}

				.path-tile-primary {
					grid-row: auto;
				}
			}

			/* Impact — full-bleed band */
			.impact-band {
				background: var(--st-ink);
				color: var(--st-white);
				padding: 4.5rem 0;
			}

			.impact-band h2 {
				font-size: clamp(1.8rem, 3.5vw, 2.6rem);
				margin: 0.6rem 0 0.75rem;
			}

			.impact-band .section-intro p {
				color: rgba(255, 255, 255, 0.75);
			}

			.impact-stats {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
				gap: 2.5rem;
				margin-top: 3rem;
			}

			.impact-stat strong {
				display: block;
				font-size: clamp(2.5rem, 5vw, 3.5rem);
				font-weight: 700;
				color: var(--st-teal);
				line-height: 1;
				margin-bottom: 0.6rem;
			}

			.impact-stat span {
				font-size: 0.95rem;
				color: rgba(255, 255, 255, 0.75);
			}

			/* Success stories — gradient band, editorial quote */
			.stories-band {
				background: linear-gradient(135deg, var(--st-teal) 0%, var(--st-red) 100%);
				color: var(--st-white);
				padding: 4.5rem 0;
			}

			.stories-band h2 {
				font-size: clamp(1.8rem, 3.5vw, 2.6rem);
				margin: 0.6rem 0 0;
			}

			.stories-band .badge-on-dark {
				background: rgba(255, 255, 255, 0.22);
				color: var(--st-white);
			}

			.stories-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 2.5rem;
				margin-top: 2.75rem;
				align-items: start;
			}

			.story-quote {
				margin: 0;
				font-size: clamp(1.5rem, 3vw, 2.1rem);
				font-style: italic;
				font-weight: 600;
				line-height: 1.35;
			}

			.story-quote cite {
				display: block;
				margin-top: 1.1rem;
				font-style: normal;
				font-weight: 600;
				font-size: 1rem;
				opacity: 0.85;
			}

			.story-block h3 {
				font-size: 1.4rem;
				margin: 0 0 0.6rem;
			}

			.story-block p {
				opacity: 0.92;
				line-height: 1.6;
				margin: 0;
			}
		</style>
	</body>
</html>
