		<script>
			const navToggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
			const primaryNav = document.querySelector<HTMLElement>("#primary-nav");

			function closeNav() {
				navToggle?.setAttribute("aria-expanded", "false");
				primaryNav?.classList.remove("is-open");
			}

			navToggle?.addEventListener("click", () => {
				const isOpen = navToggle.getAttribute("aria-expanded") === "true";
				navToggle.setAttribute("aria-expanded", String(!isOpen));
				primaryNav?.classList.toggle("is-open", !isOpen);
			});

			primaryNav?.addEventListener("click", (event) => {
				if ((event.target as HTMLElement).tagName === "A") {
					closeNav();
				}
			});

			// Auto-close on downward scroll only (not upward) — the menu overlays the page content
			// right below the header, so continuing to scroll down through it reads as the user moving
			// on, not adjusting their position within an open menu.
			let lastScrollY = window.scrollY;
			window.addEventListener(
				"scroll",
				() => {
					const currentScrollY = window.scrollY;
					if (currentScrollY > lastScrollY && primaryNav?.classList.contains("is-open")) {
						closeNav();
					}
					lastScrollY = currentScrollY;
				},
				{ passive: true },
			);
		</script>
	</body>
</html>
