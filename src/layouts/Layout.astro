---
import { Image, getImage } from "astro:assets";
import logoReversed from "../assets/images/logo-reversed.png";
import mandelaMural from "../assets/images/mandela-mural.png";
import { getSiteSettings } from "../lib/sanity";
import { openingHoursSpecification } from "../lib/opening-hours";
import {
	addressCountry,
	addressLocality,
	addressRegion,
	displayAddress,
	postalCode,
	streetAddressFrom,
} from "../lib/address";
import CartWidget from "../components/CartWidget.svelte";
import EmailLink from "../components/EmailLink.svelte";
import AddressLink from "../components/AddressLink.svelte";
import quicksand400 from "@fontsource/quicksand/files/quicksand-latin-400-normal.woff2?url";
import quicksand600 from "@fontsource/quicksand/files/quicksand-latin-600-normal.woff2?url";
import quicksand700 from "@fontsource/quicksand/files/quicksand-latin-700-normal.woff2?url";

// Hand-rolled in place of @fontsource's default CSS so we can trim to the weights/subset we actually
// use. font-display: swap is deliberate: text paints immediately in the metrics-matched fallback
// below and is replaced in place when Quicksand lands. `optional` would permanently give up on the
// real font after a moment, and `block` would reintroduce the invisible text this setup removed.
// Only the weights actually used in this codebase (400/600/700) and the latin subset (covers the
// Latin-1 diacritics used in Afrikaans names/copy) — see @fontsource/quicksand/*.css for the original.
const quicksandUnicodeRange =
	"U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD";

/*
 * Metrics-matched fallback — the same technique Figma ships in production as "figmaSans Fallback",
 * and what Next.js's next/font and Astro's own fonts API both generate automatically.
 *
 * Arial, re-metricked so it occupies *exactly* the space Quicksand will. That is what lets us show
 * text immediately instead of hiding it: the swap changes glyph shapes without moving anything, so
 * there is no reflow to hide. Before this, the site hid all text behind a `.fonts-pending` class
 * until the font arrived — which made text-led pages' LCP wait for the font by construction
 * (measured 2,234ms on /about/ against 1,034ms with no custom font at all) and still paid a ~0.02
 * CLS when the swap finally landed. Both were the same root cause.
 *
 * One face per weight, not the single face most tools emit: only xWidthAvg differs across weights
 * (465/481/489), so a lone 400-derived fallback leaves bold text visibly mismatched.
 *
 * Derived from the real font files with Capsize's formula — the same one Astro uses, see
 * node_modules/astro/dist/assets/fonts/infra/capsize-font-metrics-resolver.js:
 *   sizeAdjust = (Quicksand.xWidthAvg / Quicksand.unitsPerEm) / (Arial.xWidthAvg / Arial.unitsPerEm)
 *   ascent|descent|lineGap override = Quicksand.<metric> / (Quicksand.unitsPerEm * sizeAdjust)
 * Inputs: Quicksand ascent 1000, descent -250, lineGap 0, upem 1000, xWidthAvg 465/481/489;
 * Arial ascent 1854, descent -434, lineGap 67, upem 2048, xWidthAvg 913.
 *
 * Baked rather than computed at build time on purpose: @capsizecss/unpack is Astro's dependency and
 * not ours, so building on it would be depending on a transitive package. These only change if the
 * font files do. To recompute (from the repo root, requires that dependency to still be present):
 *   node --input-type=module -e "import {fromBuffer} from '@capsizecss/unpack';
 *   import {readFileSync} from 'node:fs'; const a=await fromBuffer(readFileSync(
 *   '/System/Library/Fonts/Supplemental/Arial.ttf')); for (const w of [400,600,700]) {
 *   const q=await fromBuffer(readFileSync('node_modules/@fontsource/quicksand/files/quicksand-latin-'
 *   +w+'-normal.woff2')); const sa=(q.xWidthAvg/q.unitsPerEm)/(a.xWidthAvg/a.unitsPerEm),
 *   em=q.unitsPerEm*sa; console.log(w,sa,q.ascent/em,Math.abs(q.descent)/em,q.lineGap/em); }"
 *
 * ⚠ Exact on Windows and macOS, where Arial genuinely exists. Android has no Arial and aliases
 * local("Arial") to Roboto, so that @font-face simply fails to match and those visitors fall
 * through to the unadjusted stack below — better than today, but not shift-free.
 */
const quicksandWeights = [
	{ weight: 400, url: quicksand400, sizeAdjust: "104.3067%", ascent: "95.8711%", descent: "23.9678%" },
	{ weight: 600, url: quicksand600, sizeAdjust: "107.8957%", ascent: "92.6821%", descent: "23.1705%" },
	{ weight: 700, url: quicksand700, sizeAdjust: "109.6903%", ascent: "91.1658%", descent: "22.7915%" },
];

/**
 * ⚠ **Off since 2026-08-23, at the user's request** — see "Fonts" in AGENTS.md for the full
 * reasoning and the measurements behind it. The short version: a webfont on a static MPA swaps
 * visibly on a cold cache and there is no configuration that removes that, only ones that move the
 * cost somewhere else. Quicksand is Souper Troopers' brand font, so this is expected to be
 * revisited before launch rather than being a settled decision.
 *
 * Everything needed to turn it back on is still here and still correct — flipping this to `true`
 * restores the @font-face rules, the metrics-matched fallback and Quicksand's place in the stack in
 * one move. That is also how the cost of the custom font was measured in the first place.
 */
const USE_CUSTOM_FONT = false;

/**
 * With the custom font off, this stack *is* the site's typeface rather than a momentary fallback,
 * so it is a real system stack rather than the two-name afterthought it used to be. Resolves to San
 * Francisco on Apple, Roboto on Android, Segoe UI on Windows — the typeface each reader already
 * reads everything else in, which is why a system stack never looks broken even though it looks
 * different on every device.
 *
 * `-apple-system`/`BlinkMacSystemFont` sit behind `system-ui` for older Safari and Chrome, which
 * shipped those before `system-ui` was supported. Arial is the last named stop for anything that
 * has none of the above.
 *
 * "Quicksand Fallback" must sit immediately after Quicksand when the custom font is on, so the
 * re-metricked Arial is what gets used while the real font is in flight.
 */
const systemStack = `system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif`;
const fontStack = USE_CUSTOM_FONT
	? `"Quicksand", "Quicksand Fallback", ${systemStack}`
	: systemStack;

const fontFaceCSS =
	(USE_CUSTOM_FONT ? quicksandWeights : [])
		.map(
			({ weight, url, sizeAdjust, ascent, descent }) => `
			@font-face {
				font-family: 'Quicksand';
				font-style: normal;
				font-weight: ${weight};
				font-display: swap;
				src: url(${url}) format('woff2');
				unicode-range: ${quicksandUnicodeRange};
			}

			@font-face {
				font-family: 'Quicksand Fallback';
				font-style: normal;
				font-weight: ${weight};
				src: local('Arial');
				size-adjust: ${sizeAdjust};
				ascent-override: ${ascent};
				descent-override: ${descent};
				line-gap-override: 0%;
			}
		`
		)
		.join("\n") +
	`
			:root { --st-font-stack: ${fontStack}; }
		`;

interface Props {
	title: string;
	description?: string;
	/** Float the header transparently over the page's own hero, instead of sitting in normal flow above it. Every public page since 2026-09-24, paired with `PhotoHero.astro`, whose scrim keeps the nav legible. */
	heroOverlay?: boolean;
	/** The hero carries its own Donate button (the homepage), so on a phone the header's Donate / Shop waits until that button has scrolled away. */
	heroDonate?: boolean;
	/** Override the default og:image — pass an absolute URL. Product pages use the product photo so a shared link previews the actual item. */
	ogImage?: string;
	/** Open Graph type. Defaults to "website"; product pages pass "product". */
	ogType?: string;
	/** Extra schema.org blocks emitted alongside the site-wide NGO one — e.g. Product and BreadcrumbList on a product page. */
	jsonLd?: Record<string, unknown>[];
	/** Keep this page out of search results permanently, independently of the pre-launch blanket below. For internal pages that are real routes but shouldn't be findable — pair it with an exclusion in the sitemap `filter` in `astro.config.mjs`. */
	noindex?: boolean;
	/** Use `title` exactly as given, instead of appending " - Souper Troopers". Only the homepage should need this: "Brand - descriptor" is the convention for a site's front door, and the automatic suffix can only ever produce "descriptor - Brand". Every other page reads correctly with the brand last. */
	rawTitle?: boolean;
}

/**
 * Set to `false` at launch — see "Before real launch" in AGENTS.md. A flag rather than a deleted
 * line so that flipping it can't also un-hide the pages that pass `noindex` for their own reasons.
 */
const PRE_LAUNCH_NOINDEX = true;

const {
	title,
	description = "Souper Troopers helps people move from crisis to dignity through food, work, and community in Cape Town.",
	heroOverlay = false,
	heroDonate = false,
	ogImage: ogImageOverride,
	ogType = "website",
	jsonLd = [],
	noindex = false,
	rawTitle = false,
} = Astro.props;

/**
 * A shortcut to the internal update page, which is otherwise reachable only from a link someone
 * pasted into an email — and it now has two sub-pages of its own, which made it easy to get lost in.
 *
 * ⚠ Tied to `PRE_LAUNCH_NOINDEX` deliberately, not a separate flag. `/request-for-comment` is a
 * `noindex` page written for Kerry and Shan; the moment this site serves the real domain, a link to
 * it in the public nav would put an internal working document one click from every visitor. Sharing
 * the launch flag means it cannot survive launch by being forgotten — flipping that one constant
 * removes the link and the blanket noindex together.
 *
 * Styled apart from the real nav (see `.nav-internal`) for the same reason: it should never read as
 * part of the site's own structure.
 */
// Points at the index rather than straight at Status: there are five internal pages now, and
// three of them were reachable only from inside the one question that raised them.
const internalLink = PRE_LAUNCH_NOINDEX ? { href: "/internal", label: "Internal" } : null;

const navLinks = [
	{ href: "/", label: "Home" },
	{ href: "/about", label: "Who We Are" },
	{ href: "/our-work", label: "Our Work" },
	// No "Shop" here (design brief §3.3, 25 September): it was in the header three times - this link,
	// the Donate / Shop pill and the cart. The pill carries it, and marks /shop routes as current.
	{ href: "/get-involved", label: "Get Involved" },
	{ href: "/contact", label: "Contact" },
];

const socialLinks = [
	{
		label: "Facebook",
		href: "https://www.facebook.com/soupertroopers",
		path: "M22.675 0H1.325C.593 0 0 .593 0 1.325v21.351C0 23.407.593 24 1.325 24H12.82v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116C23.407 24 24 23.407 24 22.676V1.325C24 .593 23.407 0 22.675 0z",
	},
	{
		label: "Instagram",
		href: "https://www.instagram.com/souper_troopers/",
		path: "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.163 6.163 0 1 0 0 12.326 6.163 6.163 0 0 0 0-12.326zm0 10.162a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z",
	},
	{
		label: "LinkedIn",
		href: "https://www.linkedin.com/company/souper-troopers-npo/",
		path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.114 20.452H3.558V9h3.556v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
	},
	{
		label: "TikTok",
		href: "https://www.tiktok.com/@souper_troopers",
		path: "M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z",
	},
	{
		label: "YouTube",
		href: "https://www.youtube.com/@SouperTroopers1818",
		path: "M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z",
	},
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const settings = await getSiteSettings();
// Keep a page's own title free of " - ": the suffix already supplies one separator, and a title
// carrying its own produced three segments with no hierarchy ("Donate - support our work in Cape
// Town - Souper Troopers"). Commas are fine.
const fullTitle = rawTitle ? title : `${title} - Souper Troopers`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// The default share-card image, used by every page that doesn't pass its own `ogImage`. Three
// things here are deliberate (all set 2026-08-13):
//   - The homepage hero, not a portrait photo. Share cards are landscape, so a 2:3 source
//     (dignity-moment.jpg, what this was until now) gets centre-cropped to a narrow band — in a real
//     WhatsApp preview that landed below the subject's eyes, showing a scarf and no face.
//   - 1260x630, not 1200x630. The mural is natively 2:1, and 1200x630 (1.91:1) crops ~2.4% off each
//     side, which is just enough to clip the Souper Troopers badge painted at the right-hand edge.
//     1260x630 keeps the whole frame while still clearing Facebook's "at least 1200x630" floor in
//     both dimensions; the platforms crop to their own shape at display time regardless.
//   - `format: "jpeg"`, because Astro's default output is webp. WhatsApp renders webp fine (the old
//     card did), but LinkedIn and X are unreliable with it, and a share card is the wrong place to
//     depend on the scraper being modern.
const ogImage = await getImage({ src: mandelaMural, width: 1260, height: 630, format: "jpeg" });
const ogImageURL = ogImageOverride ?? new URL(ogImage.src, Astro.site).href;

/**
 * The site-wide organisation entity. This is how a search engine knows *what* Souper Troopers is,
 * *where* it operates and that the social accounts are the same organisation — none of which is
 * inferable from the page copy alone.
 *
 * `description` deliberately isn't the brand tagline ("We are all human..."). A tagline is the right
 * thing on the page and the wrong thing here: this field is read as a factual summary of the
 * organisation, and the tagline never says what the organisation actually does or where.
 *
 * `address` is a structured PostalAddress rather than the flat string, because a string can't be
 * resolved to a place. Only `streetAddress` comes from Sanity — the rest are constants living in
 * `src/lib/address.ts`, since the locality/region/country/postal code are not fields Kerry can edit
 * today, and the contact page needs the same values.
 */
const structuredData = {
	"@context": "https://schema.org",
	"@type": "NGO",
	name: "Souper Troopers",
	url: Astro.site?.href,
	logo: new URL(logoReversed.src, Astro.site).href,
	description:
		"Souper Troopers is a Cape Town non-profit working with people experiencing homelessness. It runs the Humanity Hub, a service centre in Woodstock, and the CAST programme - offering dignity, skills training, help with identity documents and a route back into work.",
	email: settings.email,
	address: {
		"@type": "PostalAddress",
		streetAddress: streetAddressFrom(settings.address),
		addressLocality,
		addressRegion,
		postalCode,
		addressCountry,
	},
	areaServed: {
		"@type": "City",
		name: addressLocality,
	},
	/**
	 * The premises are named, and the name is load-bearing. Searches and AI scans were reading the
	 * organisation as a food scheme rather than as the service centre it is (Shan, 2 September) —
	 * a hangover from the name and from soup being where it started. Nothing in the structured data
	 * said otherwise, because "Humanity Hub" appeared only in body copy.
	 *
	 * ⚠ Deliberately `location`, NOT `alternateName`. The Hub is what the *place* is called, which is
	 * simply true; claiming it as another name for the organisation would quietly take a side on the
	 * "should we lead with Souper Troopers or the Humanity Hub" question, which is the board's to
	 * settle. If they decide the Hub becomes the primary identity, `alternateName` is the line to add.
	 */
	location: {
		"@type": "Place",
		name: "The Humanity Hub",
		address: {
			"@type": "PostalAddress",
			streetAddress: streetAddressFrom(settings.address),
			addressLocality,
			addressRegion,
			postalCode,
			addressCountry,
		},
	},
	// Shared with the visible list on the contact page — see `src/lib/opening-hours.ts` for why these
	// are derived rather than written twice, and for the by-appointment caveat.
	openingHoursSpecification,
	sameAs: socialLinks.map((link) => link.href),
	taxID: settings.npoNumber,
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		{/* Deliberately NOT preloaded. That looks wrong for a self-hosted webfont, and was right
		    until the metrics-matched fallback landed: while text was hidden until Quicksand arrived,
		    getting it early was the whole game. Now nothing waits for it, so a <link rel=preload> only
		    competes with the HTML/CSS/hero image for a narrow pipe. Measured at 700kbps, 3 runs each:
		    preloading costs ~470ms of FCP site-wide (1,570ms vs 1,100ms) and up to 46% of LCP on
		    /shop/ (3,507ms vs 1,896ms), buying only a ~600ms earlier swap. fetchpriority="low" was
		    tried and changes nothing — FCP stayed at ~1,570ms, so it is the request existing at all,
		    not its priority. Restore by putting the three <link rel="preload" as="font"> back here. */}
		<style set:html={fontFaceCSS} />
		{/* Two independent reasons a page can be unlisted, deliberately emitted as one tag so no page
		    ever carries two conflicting robots metas. `PRE_LAUNCH_NOINDEX` is the blanket over the
		    whole preview and comes off at launch; the per-page `noindex` prop must *survive* that,
		    because the internal pages (request-for-comment, google-listing) should stay out of search
		    permanently. Deleting the blanket without this would have quietly published both. */}
		{(PRE_LAUNCH_NOINDEX || noindex) && <meta name="robots" content="noindex, nofollow" />}
		{/* The icons have no background of their own — just the brush ring and the ST — so the ink
		    letterforms would be near-invisible against a dark browser tab strip. The `-dark` variants
		    are identical but with white letters, picked up via `media` on the link. `favicon.ico` stays
		    unscoped as the fallback for anything that ignores `media`, hence its ink version.

		    `?v=` is a cache-buster, and it is here because favicons are the one asset browsers cache
		    outside the ordinary rules: Chrome and Safari keep them in their own store and will happily
		    keep painting a stale icon long after the file behind it changed, whatever the response
		    headers say. Bump the number whenever the artwork changes — the query is ignored by the
		    server, it only makes the URL new. Note `/favicon.ico` is *also* fetched by convention
		    without any query, so that one file can still serve stale for a while; nothing can be done
		    about that from here. */}
		<link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon-32.png?v=2" sizes="32x32" media="(prefers-color-scheme: light)" />
		<link rel="icon" type="image/png" href="/favicon-32-dark.png?v=2" sizes="32x32" media="(prefers-color-scheme: dark)" />
		<link rel="icon" type="image/png" href="/favicon-512.png?v=2" sizes="512x512" media="(prefers-color-scheme: light)" />
		<link rel="icon" type="image/png" href="/favicon-512-dark.png?v=2" sizes="512x512" media="(prefers-color-scheme: dark)" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
		<meta name="description" content={description} />
		<title>{fullTitle}</title>
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Souper Troopers" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		{jsonLd.map((block) => (
			<script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
		))}

		<!-- Cloudflare Web Analytics -->
		<script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "db07bdfbee474364b7d4e4d32a400bb6"}'></script>
		<!-- End Cloudflare Web Analytics -->
	</head>
	<body>
		<header class:list={["site-header", { "site-header-overlay": heroOverlay, "hero-has-donate": heroOverlay && heroDonate }]}>
			<div class="wrap header-inner">
				{/* The label names the link once. With the logo's alt text and the visible words both
				    counted, it used to read "Souper Troopers Souper Troopers"; and on phones, where the
				    words are hidden, the label is what keeps the link named. */}
				<a href="/" class="brand" aria-label="The Humanity Hub by Souper Troopers - home">
					{/* In the initial viewport on every page there is, so Astro's lazy default only ever
					    delays it. ~2KB, so eager costs nothing; it is deliberately NOT fetchpriority="high",
					    which is reserved for each page's LCP image. */}
					<Image src={logoReversed} alt="" width={44} height={44} densities={[1, 2, 3]} loading="eager" />
					{/* A trial (2026-09-14) of leading with the Hub while keeping the tie to the logo, which
					    still reads Souper Troopers. The logo itself waits on the board and q29. */}
					<span class="brand-name">
						<span class="brand-title">The Humanity Hub</span>
						<span class="brand-by">by Souper Troopers</span>
					</span>
				</a>
				{/* data-astro-prefetch="load" overrides the site-wide `viewport` default (astro.config.mjs)
				    for these five links only. Under 760px this nav is translate-Y'd fully above the
				    viewport until the hamburger opens it, so an IntersectionObserver never sees it and
				    `viewport` would not fire until the menu is already open — on the exact device where
				    the delay was noticed. `load` prefetches at idle regardless of position. Affordable
				    precisely because it is the fixed nav: five documents at ~10KB gzipped each, less than
				    one hero photo, and the same six on every page so they are cache hits after the first. */}
				<nav aria-label="Primary" id="primary-nav">
					{/* Sits before Home and is separated by a rule, so it reads as "not part of this
					    menu" rather than as the first item of it. Only rendered before launch. */}
					{internalLink && (
						<a
							class="nav-internal"
							href={internalLink.href}
							data-astro-prefetch="load"
							aria-current={currentPath === internalLink.href ? "page" : undefined}
						>{internalLink.label}{currentPath === internalLink.href && <span class="current-marker" aria-hidden="true"></span>}</a>
					)}
					{navLinks.map((link) => (
						<a href={link.href} data-astro-prefetch="load" aria-current={currentPath === link.href ? "page" : undefined}>{link.label}{currentPath === link.href && <span class="current-marker" aria-hidden="true"></span>}</a>
					))}
				</nav>
				{/* Adrian's point on the 2 September call: the homepage never mentions the shop, so a
				    visitor meets it for the first time on a page branded Shmiley. His fix was to put
				    both destinations behind the one contrast-coloured control people already look at.

				    ⚠ The word "Shop" stays visible rather than hiding under "Support", because seeing it
				    was the actual goal - "people will immediately [think] oh, shop for what?"

				    Two separate controls since 25 September (they were one segmented pill, and before that a
				    menu): Donate is the page's filled .btn-primary, Shop an outlined ghost beside it, so the
				    one action the site most wants reads first. The cart sits beside Shop, where it belongs.
				    No JavaScript at all. */}
				{/* One wrapper for Donate, Shop and the cart, so the group wraps as a unit: loose, the cart
				    dropped onto a row of its own at 962-1019px. The homepage's phone rule still hides only
				    .support-menu (Donate / Shop), so the cart stays. */}
				<div class="header-actions">
					<div class="support-menu">
						<a class="btn btn-primary header-donate" href="/donate" data-astro-prefetch="load" aria-current={currentPath === "/donate" ? "page" : undefined}><span class="support-label">Donate{currentPath === "/donate" && <span class="current-marker" aria-hidden="true"></span>}</span></a>
						<a class="btn header-shop" href="/shop" data-astro-prefetch="load" aria-current={currentPath === "/shop" || currentPath.startsWith("/shop/") ? "page" : undefined}><span class="support-label">Shop{(currentPath === "/shop" || currentPath.startsWith("/shop/")) && <span class="current-marker" aria-hidden="true"></span>}</span></a>
					</div>
					<CartWidget client:load />
				</div>
				<button class="nav-toggle" aria-expanded="false" aria-controls="primary-nav" aria-label="Menu">
					<span class="nav-toggle-bar"></span>
					<span class="nav-toggle-bar"></span>
					<span class="nav-toggle-bar"></span>
				</button>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap footer-inner">
				<strong>Souper Troopers</strong>
				<AddressLink client:visible lines={[displayAddress(settings.address)]} copyable={false} />
				<EmailLink client:visible address={settings.email} />
			</div>
			<div class="wrap footer-social">
				<span class="footer-social-label">Follow us</span>
				<div class="social-links">
					{socialLinks.map((social) => (
						<a href={social.href} target="_blank" rel="noopener" aria-label={social.label}>
							<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={social.path} /></svg>
						</a>
					))}
				</div>
			</div>
			<p class="fine-print wrap">
				&copy; {new Date().getFullYear()} Souper Troopers. Est. 2014. &nbsp;|&nbsp; NPO {settings.npoNumber} &nbsp;|&nbsp; PBO {settings.pboNumber} &nbsp;|&nbsp; B-BBEE {settings.bbbeeLevel} &nbsp;|&nbsp; Shop products by Shmiley (Pty) Ltd, a Souper Troopers social enterprise.
			</p>
		</footer>

		<style is:global>
			/* Cross-document view transitions — the fix for "switching pages doesn't feel server-rendered".
			   This is a static MPA with no ClientRouter, so every navigation tears down one document and
			   builds another. Chrome holds the old page's last painted frame while the new one loads, but
			   only briefly; measured at 6x CPU throttle with 150ms latency, /about/ takes 376ms to first
			   paint, which is right on the edge of that budget. Past it the browser gives up, shows blank,
			   and then paints the new document top-down as it parses — the header first, then each section
			   below it. That reveal is *correct* progressive rendering and is not worth removing; what is
			   worth removing is the blank frame in front of it, which is what reads as a flash.
			
			   These two lines make the browser snapshot the outgoing page, hold it, and cross-fade into
			   the incoming one — so the parse-time reveal happens behind the transition instead of in
			   front of the reader. No JavaScript, no ClientRouter, no per-page changes.
			
			   Deliberately NOT Astro's <ClientRouter />, which is the heavier lever: it swaps documents in
			   JS and would need every inline script on the site re-examined for re-run semantics —
			   Masonry.astro resolves its own grid through `document.currentScript.previousElementSibling`
			   at parse time, index.astro attaches scroll handlers, our-work.astro arms the CAST animation
			   once per load. This gets most of the effect and touches none of that.
			
			   Both documents must opt in, which they do — every page renders through this layout. Browsers
			   without support ignore the at-rule entirely and simply navigate the way they do today, so
			   there is no fallback to write. It hides the seam; it does not make anything faster, and it
			   is not what fixes images arriving late (see the `[loading="eager"]` rule further down). */
			@view-transition {
				navigation: auto;
			}

			/* A full-page cross-fade is motion, and someone who has asked for less of it should get the
			   plain navigation instead. `@view-transition` is valid inside a conditional group rule. */
			@media (prefers-reduced-motion: reduce) {
				@view-transition {
					navigation: none;
				}
			}

			/* The current-page underline slides between pages (asked for 25 September). Every page has
			   at most one .current-marker - under the current nav link, or under Donate / Shop in the
			   header pill - and it carries the same view-transition-name everywhere, so the browser
			   treats the old page's and the new page's as one thing and moves and stretches it from
			   one to the other, over the page cross-fade. A real element rather than the link's border
			   or an ::after, because a pseudo-element can't be named. Where only one side has a marker
			   (e.g. a Get Involved child page, which matches no nav item) it just fades.
			   Laptop only: below 761px the nav is a hidden drop-down, so only the pill's marker exists
			   there and it would slide in from nowhere. Browsers without cross-document view
			   transitions (Firefox, for now) just switch, as they did before; reduced motion turns the
			   whole transition off above. */
			.current-marker {
				position: absolute;
				left: 0;
				right: 0;
				bottom: -2px;
				height: 2px;
				background: var(--st-teal);
				pointer-events: none;
			}

			@media (min-width: 761px) {
				.current-marker {
					view-transition-name: current-marker;
				}
			}

			::view-transition-group(current-marker) {
				animation-duration: 0.35s;
				animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
			}

			:root {
				/* Official brand palette (souper-troopers-logo-document-06-11-2018.pdf) */
				--st-teal: #1babbe;
				--st-teal-dark: #148294;
				--st-teal-secondary: #24badd;
				/* A 50% tint of --st-teal on white. Kept as a token rather than a one-off literal so
				   it stays tied to the brand teal if that ever shifts. */
				--st-teal-light: #8dd5df;
				--st-ink: #24232b;
				--st-yellow: #dbbc3b;
				--st-green: #4bbc63;
				--st-red: #dd4b59;
				--st-bg: #faf9f6;
				--st-white: #ffffff;
				--radius: 18px;
				/* The real height of the header row, derived rather than written down: the tallest child
				   is the 44px Donate control (52px until 25 September), plus this rule's own var(--space-3) padding top and
				   bottom. It was 71px against an actual 76px, so everything keyed off it - the hero
				   paddings, and the sticky contents bar on the update page - sat 5px too high, which
				   on that sticky bar meant page content showing through the gap behind it.
				   `.header-inner`'s min-height now uses this same value, so the two cannot drift.
				   ⚠ Still a single number, and the header wraps to two or three rows between 761 and
				   ~1085px, where no single value can be right. That is a pre-existing responsive gap,
				   not something this fixes. */
				--header-height: calc(44px + var(--space-3) * 2);
				/* How far a photo hero's words must start below the top of the page, clearing the header that
				   floats over it. Equal to --header-height except in the 761-1085px band, where the header row
				   wraps (see the media blocks after :root) - measured 190px to 777px, 137px to 1037px with the
				   44px header controls (2026-09-25; 204 / 145 to 1019 with the 52px pill, 833 / 1077
				   before the nav's Shop link went). The
				   boundaries are rounded outward, so an error costs a little extra space, never overlap. */
				--hero-clearance: var(--header-height);

				/* Spacing scale — the only padding/margin/gap values used across the site (mobile
				   included). Keeps every gap/padding drawing from the same finite, standard 4px-based
				   scale instead of one-off values per rule. */
				--space-1: 0.25rem;
				--space-2: 0.5rem;
				--space-3: 0.75rem;
				--space-4: 1rem;
				--space-5: 1.25rem;
				--space-6: 1.5rem;
				--space-8: 2rem;
				--space-10: 2.5rem;
				--space-12: 3rem;
				--space-16: 4rem;
				--space-20: 5rem;
				--space-24: 6rem;

				/* Set from `fontStack` in the frontmatter, so USE_CUSTOM_FONT can change it. */
				font-family: var(--st-font-stack);
			}

			@media (min-width: 761px) and (max-width: 1045px) {
				:root {
					--hero-clearance: 137px;
				}
			}

			@media (min-width: 761px) and (max-width: 785px) {
				:root {
					--hero-clearance: 190px;
				}
			}

			/* Standard mobile breakpoint — every narrow-screen override in this file uses this same
			   700px cutoff (the .nav-toggle switch at 760px is a separate, unrelated concern: when the
			   nav collapses into a menu button, not spacing rhythm). */

			* {
				box-sizing: border-box;
			}

			/* Left over from the removed .fonts-pending mechanism, and deliberately kept: it is now
			   what makes every link's hover colour ease rather than snap. Scoped away from svg so
			   icons relying on fill: currentColor (cart icon, footer social links) aren't affected. */
			*:not(svg):not(svg *) {
				transition: color 0.3s ease;
			}

			h1,
			h2,
			h3,
			h4,
			h5,
			h6,
			p {
				margin: 0;
			}

			html,
			body {
				margin: 0;
				padding: 0;
			}

			body {
				background: var(--st-bg);
				color: var(--st-ink);
				line-height: 1.5;
				display: flex;
				flex-direction: column;
				min-height: 100vh;
			}

			main {
				flex: 1 0 auto;
				position: relative;
				display: flex;
				flex-direction: column;
				gap: var(--space-16);
				padding-bottom: var(--space-16);
			}

			h1,
			h2,
			h3 {
				line-height: 1.1;
				font-weight: 700;
			}

			a {
				color: var(--st-teal-dark);
			}

			.wrap {
				width: 100%;
				max-width: 1100px;
				margin: 0 auto;
				/* Below 1100px, .wrap is the full viewport width, not just the centered 1100px box —
				   without this, cards/content sit flush against the screen edges on any viewport
				   narrower than 1100px, not just phone widths. */
				padding-left: var(--space-5);
				padding-right: var(--space-5);
			}

			.site-header {
				background: var(--st-ink);
				position: sticky;
				top: 0;
				z-index: 100;
				/* Hairline of light (not a black drop shadow) so the header stays distinct when a
				   matching ink band scrolls up under it — shadow on ink-on-ink barely reads. */
				border-bottom: 1px solid rgba(255, 255, 255, 0.1);
			}

			/*
			 * Starts transparent so the hero photo shows through behind it. A small script (see
			 * index.astro) sets --header-fade continuously as the user scrolls through the hero,
			 * fading the header to solid ink rather than snapping — no CSS transition here, since
			 * a transition would lag behind the scroll-driven updates instead of tracking them.
			 * The hairline fades with the same variable so it doesn't sit across the hero photo
			 * while the header is still clear.
			 */
			.site-header-overlay {
				position: fixed;
				left: 0;
				right: 0;
				background: rgba(36, 35, 43, var(--header-fade, 0));
				border-bottom-color: rgba(255, 255, 255, calc(0.1 * var(--header-fade, 0)));
			}

			/* min-height, not height: the row must still be free to grow when it wraps (the nav drops
			   onto its own line below ~1085px), but it must never START shorter than its finished self.
			   Without this the header renders at 66px as soon as the brand has parsed, then jumps to
			   76px the moment the Donate control - then the tallest child at 52px - is parsed a beat later, moving
			   the brand and the whole nav down by 4px. That is a layout shift on every page of the
			   site, and Cloudflare RUM duly named #primary-nav as the top CLS source. It is the very
			   same bug the <=760px rule below already fixes with a fixed height, for the very same
			   reason (see its comment) - it was simply never applied to the desktop row.
			   The value tracks the tallest child rather than being a second magic number: the 44px button
			   + the two var(--space-3) paddings on this rule. */
			/* Donate / Shop: two separate controls, 8px apart (25 September; one segmented pill before).
			   Donate is .btn-primary (ink on teal, 5.64:1). Shop is an outlined ghost - transparent, a
			   1.5px white rule, white label - filling faintly on hover. Both 44px tall (revised 25
			   September, from 52), the height --header-height is built from, so the laptop header is 68px.
			   Side padding 18px on laptops, 14px below 761px. Labels use the nav links' type (0.95rem /
			   1.5) and are centred; the current-page underline copies the nav's (4px gap, 2px rule): ink
			   under Donate on /donate, teal under Shop on /shop and /shop/... ⚠ The header row has little slack: re-measure the
			   single-row threshold (in 2px steps) after any change here. */
			.header-actions {
				display: flex;
				align-items: center;
				flex-shrink: 0;
				gap: var(--space-6);
			}

			.support-menu {
				display: inline-flex;
				align-items: center;
				flex-shrink: 0;
				gap: 8px;
			}

			.support-menu .btn {
				display: inline-flex;
				align-items: center;
				box-sizing: border-box;
				height: 44px;
				padding: 0 18px;
				font-size: 0.95rem;
				font-weight: 700;
				line-height: 1.5;
				white-space: nowrap;
			}

			/* The underline is drawn outside the label's box, so the word stays centred in the pill
			   (asked for 25 September, over matching the nav's baseline). Same 4px gap and 2px rule as
			   the nav's underline; it spans the word, not the pill. It is the shared .current-marker
			   (defined beside @view-transition), so it slides here from the nav on the way to /donate or /shop. */
			.support-menu .support-label {
				position: relative;
			}

			.support-menu .support-label .current-marker {
				bottom: -6px;
			}

			.support-menu .header-donate .current-marker {
				background: var(--st-ink);
			}

			/* `.support-menu` in front: the site-wide `.btn` rule sits later in this sheet and, at equal
			   specificity, replaced this border with its transparent 2px one. */
			.support-menu .header-shop {
				border: 1.5px solid rgba(255, 255, 255, 0.7);
				color: var(--st-white);
				background: transparent;
				transition: background 0.15s ease;
			}

			.support-menu .header-shop:hover {
				background: rgba(255, 255, 255, 0.12);
				color: var(--st-white);
			}

			.support-menu .header-shop:focus-visible {
				outline: 2px solid var(--st-white);
				outline-offset: 2px;
			}

			.header-inner {
				display: flex;
				align-items: center;
				/* var(--space-6), not --space-8. `.wrap` caps this row at 1100px and the row was sitting
				   about 4px inside that - so adding two characters to the internal link's label
				   ("Status" -> "Internal") pushed every page's header from one row to three, at every
				   viewport width, because the cap means the wrap is not viewport-dependent.
				   Measured: at a 32px gap "Internal" wraps and "Notes" does not; at 24px there is real
				   headroom again. Anything added to this row from here - a nav item, a longer label -
				   should be re-measured at 1440px rather than eyeballed, since a wrap here is invisible
				   on a wide screen right up until it happens. */
				gap: var(--space-6);
				padding-top: var(--space-3);
				padding-bottom: var(--space-3);
				min-height: var(--header-height);
				flex-wrap: wrap;
			}

			.brand {
				display: flex;
				align-items: center;
				gap: var(--space-2);
				font-weight: 700;
				font-size: 1.1rem;
				color: var(--st-white);
				text-decoration: none;
				/**
				 * Below 761px this is load-bearing and must stay: the nav is `position: absolute` there
				 * (it slides down from behind the header), so it is out of the row entirely and this
				 * auto margin is the only thing pushing Donate, the cart and the hamburger to the right
				 * edge. Zeroing it collapses all three against the logo. It is overridden above 760px
				 * only - see the block below.
				 */
				margin-right: auto;
			}

			/**
			 * Where the header's free space goes, and why it is not on the brand above 760px.
			 *
			 * ⚠ `.brand { margin-right: auto }` absorbs *all* the row's slack, which makes the nav's
			 * horizontal position a function of everything else in that row - including two siblings
			 * that the parser has not reached yet. Astro injects its island bootstrap (an inline
			 * `<style>` and two inline `<script>` blocks, ~1.8KB) at the first island on the page,
			 * which is `<CartWidget>`, sitting between the nav and the Donate button. Inline scripts
			 * block the HTML parser, so the browser lays out and paints brand + nav *before* the cart
			 * and Donate exist - and at that moment the auto margin has 206px more slack to eat.
			 * Measured: the Status link paints at x=593.5 and settles at x=387.1.
			 *
			 * That reflow has always happened. It only became visible when `@view-transition` landed
			 * (2026-08-27), because the cross-fade holds the outgoing frame on screen and animates
			 * across it, turning a pre-paint flicker into a ~200px slide. **It is not network-bound** -
			 * the whole header is in the first chunk of HTML - so throttling the connection does
			 * nothing and only CPU throttling reproduces it. Don't go looking for a slow request.
			 *
			 * The fix is to put the slack *after* the nav instead of before it, so the nav's position
			 * depends only on the brand, which parses first and cannot be late. Cost: the nav sits
			 * 60.3px further left than it used to, and that figure is constant at any viewport ≥1100px
			 * because `.wrap` caps the row at 1100px - so this is a fixed small shift, not one that
			 * grows on wide screens.
			 */
			@media (min-width: 761px) {
				.brand {
					margin-right: 0;
				}

				/* The first of the trailing group (Donate, Shop, cart since 25 September), so the slack
				   opens up between the nav and Donate. */
				.header-actions {
					margin-left: auto;
				}
			}

			.brand img {
				display: block;
			}

			/* Two lines stacked beside the logo. ⚠ Width is budgeted to the pixel: the title is sized
			   to 140px wide, exactly what the old one-line "Souper Troopers" took. At 16px it was
			   144px, and those 4px moved the point where the header wraps onto two rows up past
			   1080px (measured). The two lines total ~32px tall, inside the 44px logo, so the
			   header's height doesn't move. Below 761px `.brand span` hides this and the logo stands
			   alone, as the old one-line name did. */
			.brand-name {
				display: flex;
				flex-direction: column;
				line-height: 1.15;
			}

			.brand-title {
				font-size: 0.97rem;
				font-weight: 700;
			}

			.brand-by {
				font-size: 0.72rem;
				font-weight: 600;
				color: rgba(255, 255, 255, 0.75);
			}

			nav[aria-label="Primary"] {
				display: flex;
				gap: 1.25rem;
				flex-wrap: wrap;
			}

			nav[aria-label="Primary"] a {
				color: rgba(255, 255, 255, 0.85);
				text-decoration: none;
				font-weight: 600;
				font-size: 0.95rem;
				padding-bottom: 4px;
				border-bottom: 2px solid transparent;
				position: relative;
			}

			nav[aria-label="Primary"] a:hover {
				color: var(--st-teal);
			}

			/* The underline itself is the .current-marker inside the link (so it can slide between
			   pages); the border stays transparent and only holds the space. */
			nav[aria-label="Primary"] a[aria-current="page"] {
				color: var(--st-teal);
			}

			/* Over a photo hero, the current page is marked by its teal underline alone and the word
			   stays white: teal text needs a near-black backdrop to reach 4.5:1, and on the photo it
			   measured 1.6-2.8:1 (Contact, Shop, Get Involved). Once the header fades to ink it could be
			   teal again, but a colour that changes mid-scroll reads as a glitch. */
			.site-header-overlay nav[aria-label="Primary"] a[aria-current="page"] {
				color: var(--st-white);
			}

			/* The internal update page, before launch only. Deliberately not styled like the five real
			   nav items: it is scaffolding for Kerry and Shan, not part of the site, and it should
			   read that way at a glance rather than being discovered by clicking.

			   Amber rather than teal is the whole point — teal is this site's "you can act on this"
			   colour and the current-page marker, so borrowing it would file this alongside the real
			   pages. Amber is already the page family's "temporary, in progress" colour (the Test-mode
			   chip, the question numbers, the "still open" badge). #f0cf5a rather than the raw brand
			   #dbbc3b: on the ink header that lifts contrast from 6.9:1 to 9.4:1. */
			/* The divider is a border on the link itself rather than an element between two flex
			   children, so it travels with the item and disappears with it at launch. Its own
			   padding-right plus the nav's 1.25rem gap put equal space either side of the rule. */
			.nav-internal {
				color: #f0cf5a !important;
				padding-right: 1rem;
				border-right: 1px solid rgba(255, 255, 255, 0.25);
				/* Smaller than the real items, which reinforces "not part of this menu" and, more
				   practically, keeps it affordable: `.wrap` caps the header at 1100px and the five real
				   links plus the brand, cart and Donate already use most of it. At the full 0.95rem
				   with a two-word label this pushed Donate onto a second row at 1280px. A temporary
				   link must not cost the permanent header its layout. */
				font-size: 0.85rem;
			}

			.nav-internal:hover {
				color: #f7e08a !important;
			}

			.nav-internal .current-marker {
				background: #f0cf5a;
			}

			.nav-toggle {
				display: none;
				flex-direction: column;
				justify-content: center;
				gap: 5px;
				width: 32px;
				height: 32px;
				padding: 0;
				border: none;
				background: transparent;
				cursor: pointer;
				flex-shrink: 0;
				/* #primary-nav is position:absolute (see below), which paints above non-positioned
				   flow content regardless of DOM order — without this, the open dropdown would paint
				   over the toggle button that opened it. */
				position: relative;
				z-index: 1;
			}

			.nav-toggle-bar {
				display: block;
				width: 100%;
				height: 2px;
				background: var(--st-white);
				border-radius: 2px;
				transition: transform 0.2s ease, opacity 0.2s ease;
			}

			.nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) {
				transform: translateY(7px) rotate(45deg);
			}

			.nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) {
				opacity: 0;
			}

			.nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) {
				transform: translateY(-7px) rotate(-45deg);
			}

			@media (max-width: 760px) {
				/* Fixed (not content-driven) height, one step taller than the old content-driven ~56px
				   for a bit more breathing room. Content-driven padding used to mean the row's height
				   would jump by a few px whenever a taller child appeared — e.g. the header's own
				   Donate button (see .show-header-donate below) is taller than the logo, so the header
				   grew slightly the moment it showed up on scroll. A fixed height plus align-items:
				   center (already set on .header-inner, see base rule) keeps the row height constant
				   and content centered regardless of which children are present.
				   --header-height is redeclared here to match — .hero-photo's padding calc() (and
				   anything else keyed off it) picks the new value up automatically. */
				:root {
					--header-height: var(--space-16);
				}

				.header-inner {
					gap: var(--space-3);
					height: var(--header-height);
					/* The base rule's padding-top/bottom (var(--space-3), 12px each) is still in the
					   cascade here and has to be zeroed explicitly — with a fixed height, that leftover
					   24px of padding left only 40px for content, less than the 44px logo (the tallest
					   child), so it overflowed the padded area and rendered pinned to the top-padding
					   edge instead of truly centered (less room below than above — read as "closer to
					   the bottom"). Zeroing it hands the full 64px to align-items:center to work with. */
					padding-top: 0;
					padding-bottom: 0;
					/* Same story as the padding above: the base rule's min-height (which reserves the
					   desktop row's 76px so parsing cannot grow it) is still in the cascade here, and
					   min-height beats height - so without this reset the mobile bar renders 76px tall
					   instead of the 64px this rule is choosing. */
					min-height: 0;
				}

				.brand span {
					display: none;
				}

				/* Visual order: brand, Donate / Shop, cart, menu. Since 25 September this is also the DOM
				   order; the rules stay so it can't drift. brand is left at its default order (0). */
				/* `order` must target a *direct child* of .header-inner - .header-actions since 25
				   September (Donate, Shop and the cart inside it). The homepage's hide rule below is a
				   descendant selector, so it still reaches .support-menu inside it. */
				/* Its inner gap follows the header row's own phone gap, as when these were loose children
				   of it - at 24px the menu button fell off the row at 320px. */
				.header-actions {
					order: 1;
					gap: var(--space-3);
				}

				.support-menu .btn {
					padding: 0 14px;
				}

				.nav-toggle {
					order: 3;
					display: flex;
				}

				/* Homepage only (.hero-has-donate; every page's header is an overlay since 2026-09-24,
				   but only the homepage hero has its own Donate): the hero's "Donate now" button sits right
				   below, so the header's copy is redundant at rest and the two visibly crowd each other.
				   Hard display toggle (not opacity/visibility) — those still reserve layout space while
				   fading, which leaves a dead gap between the cart and hamburger icons; display:none
				   removes it from the flex row entirely so its share of the `gap` closes up too. Toggled
				   by index.astro's scroll script once the hero's own button has scrolled out of view. */
				.site-header-overlay.hero-has-donate .support-menu {
					display: none;
				}

				/* inline-flex, not inline-block: the two controls sit side by side in a flex row. */
				.site-header-overlay.hero-has-donate.show-header-donate .support-menu {
					display: inline-flex;
				}

				/* Always in the flex layout (no display:none) so transform/visibility can transition —
				   display can't be animated. Closed state sits translated fully above its own box
				   (behind the header), non-interactive via visibility:hidden. The visibility delay is
				   asymmetric on purpose: show immediately when opening (delay 0s) so content is visible
				   for the whole slide-in, but only hide once closing has fully finished sliding away
				   (delay = transition duration), so it doesn't vanish mid-slide.
				   top:0 (not 100%) + padding-top covering --header-height, rather than starting below
				   the header: on the homepage the header is still transparent at rest (fades in on
				   scroll, see index.astro), so a menu that only started below it left a gap showing the
				   hero photo through that transparent strip. Extending the menu's own solid background
				   up behind the header removes that gap; z-index:-1 (below) keeps it behind the header's
				   own controls (logo/cart/donate/toggle — all non-positioned or explicitly stacked
				   above, see .nav-toggle) so they stay visible and clickable on top of it. */
				nav[aria-label="Primary"] {
					display: flex;
					position: absolute;
					top: 0;
					left: 0;
					right: 0;
					flex-direction: column;
					gap: 0;
					background: var(--st-ink);
					padding: calc(var(--header-height) + var(--space-2)) var(--space-6) var(--space-5);
					box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
					transform: translateY(-100%);
					visibility: hidden;
					transition: transform 0.25s ease, visibility 0s linear 0.25s;
					z-index: -1;
				}

				nav[aria-label="Primary"].is-open {
					transform: translateY(0);
					visibility: visible;
					transition: transform 0.25s ease, visibility 0s linear 0s;
				}

				@media (prefers-reduced-motion: reduce) {
					nav[aria-label="Primary"] {
						transition: none;
					}
				}

				nav[aria-label="Primary"] a {
					padding: var(--space-3) 0;
					border-bottom: 1px solid rgba(255, 255, 255, 0.1);
				}

				nav[aria-label="Primary"] a[aria-current="page"] {
					border-bottom-color: var(--st-teal);
				}

				/* The stacked menu marks the current item with its own hairline, recoloured above. */
				nav[aria-label="Primary"] .current-marker {
					display: none;
				}

				/* Stacked menu: a vertical rule between two items in a column separates nothing, so the
				   divider becomes a stronger version of the bottom hairline the items already carry,
				   plus a little space below it. */
				.nav-internal {
					padding-right: 0;
					border-right: 0;
					margin-bottom: var(--space-2);
					padding-bottom: var(--space-3);
					border-bottom-color: rgba(255, 255, 255, 0.28) !important;
				}
			}

			.btn {
				display: inline-block;
				padding: var(--space-3) var(--space-6);
				/* Transparent rather than none, for two reasons: it strips the UA border that a
				   <button class="btn"> would otherwise draw, and it gives every variant the same
				   border box - so a filled .btn-primary and an outlined .btn-outline sitting next
				   to each other are the same height instead of differing by the outline's 4px.
				   The outline variants recolour this border; it must not be overridden to none anywhere,
				   which is what silently flattened the PayFast button when it was demoted. */
				border: 2px solid transparent;
				border-radius: 999px;
				font-weight: 700;
				text-decoration: none;
				text-align: center;
			}

			/* Ink label, not white. White on --st-teal is 2.76:1 - the site's single biggest contrast
			   failure - while ink on the very same fill is 5.64:1, so the brand teal is kept exactly
			   and only the label changes. It also reads calmer: white on a saturated teal vibrates,
			   dark on it doesn't, which is most of why a grid of these felt shouty.
			   Hover therefore has to brighten rather than darken. The old --st-teal-dark hover puts
			   ink at 3.44:1, so hovering would have failed the check the rest state just passed. */
			/* Pure black since 26 September (was --st-ink, 5.64:1): the user found the label soft, and
			   black on the same brand teal is 7.62:1 - WCAG's enhanced (AAA) level - with the fill
			   unchanged. Hover is 9.14:1. Only here: the rest of the site's text keeps the ink. */
			.btn-primary {
				background: var(--st-teal);
				color: #000;
			}

			.btn-primary:hover {
				background: var(--st-teal-secondary);
			}

			.btn-secondary {
				background: var(--st-green);
				color: var(--st-white);
			}

			.btn-secondary:hover {
				opacity: 0.9;
			}

			.btn-outline {
				background: transparent;
				color: var(--st-ink);
				border: 2px solid var(--st-ink);
			}

			/* The action colour, quietly - for a group of equal-weight controls that all *do*
			   something rather than navigate (the donate page's payment handoffs). Teal restores
			   the colour affordance a bare ink outline lacks, without a saturated fill competing
			   with the header's single primary CTA. 4.52:1 on a white card in both states.
			   Deliberately a separate variant rather than a change to .btn-outline: on the closing
			   CTA rows that one sits beside a teal-filled .btn-primary, and staying ink is exactly
			   what makes the pair read as primary-then-secondary instead of two equal teals. */
			.btn-outline-teal {
				background: transparent;
				color: var(--st-teal-dark);
				border-color: var(--st-teal-dark);
			}

			.btn-outline-teal:hover {
				background: var(--st-teal-dark);
				color: var(--st-white);
			}

			.site-footer {
				background: var(--st-ink);
				color: rgba(255, 255, 255, 0.85);
				padding: var(--space-6) 0 var(--space-5);
				/* Lighter teal so copy buttons stay legible against the dark footer. */
				--copy-button-color: var(--st-teal);
			}

			.footer-inner {
				display: flex;
				align-items: baseline;
				flex-wrap: wrap;
				gap: var(--space-2) var(--space-4);
			}

			.site-footer a {
				color: var(--st-teal);
			}

			.footer-social {
				display: flex;
				align-items: center;
				gap: var(--space-4);
				margin-top: var(--space-4);
			}

			.footer-social-label {
				font-size: 0.8rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				opacity: 0.6;
			}

			.social-links {
				display: flex;
				gap: var(--space-3);
			}

			.social-links a {
				display: inline-flex;
				color: rgba(255, 255, 255, 0.75);
			}

			.social-links a:hover {
				color: var(--st-teal);
			}

			.social-links svg {
				display: block;
				fill: currentColor;
			}

			.fine-print {
				margin-top: var(--space-3);
				font-size: 0.8rem;
				opacity: 0.55;
			}

			/* The header is sticky at 72px, so an anchored section would otherwise land with its
			   heading hidden underneath it. */
			main [id] {
				scroll-margin-top: calc(72px + var(--space-5));
			}

			/* Shared page building blocks */
			.section {
				display: flex;
				flex-direction: column;
				gap: var(--space-8);
			}

			.section-intro {
				display: flex;
				flex-direction: column;
				gap: var(--space-2);
			}

			.section-intro h2 {
				font-size: clamp(1.6rem, 3vw, 2.2rem);
			}

			.section-intro p {
				max-width: 60ch;
				color: rgba(36, 35, 43, 0.75);
			}

			/* Centred, larger variant for a section that is a single statement rather than an
			   intro to the block beneath it. */
			.section-intro.statement {
				align-items: center;
				text-align: center;
			}

			/* .badge pins itself to flex-start; the centred variant needs it to follow the block. */
			.section-intro.statement .badge {
				align-self: center;
			}

			.section-intro.statement h2 {
				font-size: clamp(2rem, 4.5vw, 3rem);
				max-width: 20ch;
			}

			.section-intro.statement p {
				font-size: 1.15rem;
			}

			/* Slow breathe for the one load-bearing word in a headline ("Every" in the mission
			   statement, "human" in the hero). Defaults to teal for light backgrounds; override
			   --glow-rgb / --glow-dim / --glow-bright to retune it per placement (see
			   .hero-highlight). --glow-rgb is a bare "r, g, b" triplet because it feeds rgba(). */
			.glow-word {
				--glow-rgb: 27, 171, 190;
				--glow-dim: var(--st-teal-dark);
				--glow-bright: var(--st-teal);
				color: var(--glow-dim);
				text-shadow:
					0 0 12px rgba(var(--glow-rgb), 0.35),
					0 0 28px rgba(var(--glow-rgb), 0.18);
				animation: word-glow 3.5s ease-in-out infinite;
			}

			@keyframes word-glow {
				0%,
				100% {
					color: var(--glow-dim);
					text-shadow:
						0 0 12px rgba(var(--glow-rgb), 0.3),
						0 0 28px rgba(var(--glow-rgb), 0.14);
				}
				50% {
					color: var(--glow-bright);
					text-shadow:
						0 0 18px rgba(var(--glow-rgb), 0.55),
						0 0 44px rgba(var(--glow-rgb), 0.3);
				}
			}

			/* Keeps the colour and a static halo - the word still reads as emphasised without the
			   pulse. */
			@media (prefers-reduced-motion: reduce) {
				.glow-word {
					animation: none;
				}
			}

			.grid {
				display: grid;
				gap: var(--space-6);
			}

			.grid-2 {
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			}

			.grid-3 {
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
			}

			.grid-4 {
				grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
			}

			/* Opt-in modifier for grids whose item count can drop below the column count. The
			   auto-fit above collapses empty tracks, so a lone item stretches across the full row —
			   fine for a deliberately short row of cards, wrong where the count is data-driven and
			   a card carries a square image (it scales with the card). auto-fill keeps the empty
			   tracks so items stay one column wide however few there are. Add alongside .grid-N,
			   don't replace it — this only overrides the track sizing. */
			.grid-fill.grid-2 {
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
			}

			.grid-fill.grid-3 {
				grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
			}

			.grid-fill.grid-4 {
				grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
			}

			/* Product grids (2026-09-24): fixed column counts rather than auto-fit, so the photos are as
			   large as the column allows - three across on a laptop, where auto-fit had been fitting four
			   smaller ones - and a short row never stretches. Two across on a phone, not one: products
			   are browsed by picture, and one per screen made nine dolls a long scroll. More room between
			   rows than columns, since there is no card box to separate one product from the next. */
			.product-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: var(--space-12) var(--space-8);
			}

			@media (max-width: 900px) {
				.product-grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
					gap: var(--space-8) var(--space-5);
				}
			}

			/* --- "More" inside a card (2026-09-13) -------------------------------------------------
			   The rule this serves, in the user's words: people don't read *unless* they are deciding
			   something or checking whether the organisation can be trusted. So a card keeps visible
			   what someone needs to decide, and the supporting detail - the evidence, the how - opens
			   on click. `<details>` rather than a clamp and a button: no JavaScript, keyboard
			   operable, and the hidden text stays in the page, so search engines and answer engines
			   still read all of it. Cutting it instead would have been a real cost to discoverability.

			   ⚠ Never inside a card that is itself an `<a>` - interactive content can't nest inside a
			   link. Trim those instead, and leave the detail to the page the card links to. */
			.card-more {
				width: 100%;
			}

			.card-more > summary {
				list-style: none;
				cursor: pointer;
				display: inline-flex;
				align-items: center;
				gap: 0.45em;
				min-height: 24px;
				font-weight: 600;
				/* Teal-dark and underlined: it is a control, and the colour rule reserves this for
				   things you can act on. 4.52:1 on the white cards it lives in. */
				color: var(--st-teal-dark);
				text-decoration: underline;
				text-underline-offset: 3px;
			}

			.card-more > summary::-webkit-details-marker {
				display: none;
			}

			.card-more > summary::after {
				content: "";
				width: 7px;
				height: 7px;
				border-right: 2px solid currentColor;
				border-bottom: 2px solid currentColor;
				transform: rotate(45deg) translate(-2px, -2px);
				transition: transform 120ms ease;
			}

			.card-more[open] > summary::after {
				transform: rotate(-135deg) translate(-1px, -1px);
			}

			.card-more-hide,
			.card-more[open] .card-more-show {
				display: none;
			}

			.card-more[open] .card-more-hide {
				display: inline;
			}

			.card-more > div {
				display: flex;
				flex-direction: column;
				gap: var(--space-3);
				margin-top: var(--space-3);
			}

			.card-more p {
				margin: 0;
			}

			@media (prefers-reduced-motion: reduce) {
				.card-more > summary::after {
					transition: none;
				}
			}

			.card {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: var(--space-3);
				background: var(--st-white);
				color: var(--st-ink);
				border-radius: var(--radius);
				padding: var(--space-6);
				box-shadow: 0 14px 30px rgba(0, 0, 0, 0.05);
			}

			/* Card actions (decided 25 September): one motif for every card that *navigates*. The card
			   is the link; a teal wedge rises from its foot and the label sits over it, right-aligned,
			   with an arrow (src/components/CardCtaLabel.astro). On hover the wedge climbs and deepens
			   and the arrow slides. Cards that *act* - Add to cart, donate buttons, FAQ chevrons,
			   .card-more - don't use it.
			   The wedge is a ::after at z-index -1 inside an isolated card, so it paints over the
			   card's white but under every word: a paragraph that runs close to the foot is never
			   tinted over. */
			.card-cta {
				position: relative;
				isolation: isolate;
				overflow: hidden;
				display: flex;
				flex-direction: column;
				color: var(--st-ink);
				text-decoration: none;
				/* A hairline edge as well as the card shadow: with a tinted foot, the soft shadow alone
				   left the bottom of the card with no edge against the page. */
				box-shadow: 0 0 0 1px rgba(36, 35, 43, 0.07), 0 14px 30px rgba(0, 0, 0, 0.05);
			}

			.card-cta::after {
				content: "";
				position: absolute;
				left: 0;
				right: 0;
				bottom: 0;
				z-index: -1;
				height: 96px;
				/* --st-teal-light, kept faint: a quiet tone rather than a loud one (revised 25 September,
				   from the brand teal at 0.14). A gentler slope too: 20% of the wedge's height across
				   the card, down from 40%. The right edge stays put, so the label's clearance doesn't change. */
				background: rgba(141, 213, 223, 0.2);
				clip-path: polygon(0 58%, 100% 38%, 100% 100%, 0 100%);
				pointer-events: none;
				transition: clip-path 0.25s ease, background-color 0.25s ease;
			}

			.card-cta:hover::after {
				background: rgba(141, 213, 223, 0.32);
				clip-path: polygon(0 46%, 100% 26%, 100% 100%, 0 100%);
			}

			.card-cta:focus-visible {
				outline: 3px solid var(--st-teal);
				outline-offset: 3px;
			}

			.card-cta-label {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				align-self: flex-end;
				margin-top: auto;
				/* A guaranteed 24px above the label, so whatever sits above it (a headline, a
				   paragraph) always ends above the wedge's top edge - without it, short cards on
				   phones ran their last line into the wedge. Padding rather than margin, because
				   margin-top is already auto. */
				padding-top: var(--space-6);
				/* Nudged 8px into the card's bottom padding, so there is more room between the wedge's
				   top edge and the words (asked for 25 September). */
				margin-bottom: -8px;
				color: var(--st-ink);
				font-weight: 700;
				text-decoration: none;
			}

			.card-cta-arrow {
				flex-shrink: 0;
				fill: none;
				stroke: currentColor;
				stroke-width: 2.2;
				stroke-linecap: round;
				stroke-linejoin: round;
				transition: transform 0.25s ease;
			}

			.card-cta:hover .card-cta-arrow {
				transform: translateX(4px);
			}

			/* A card that can't itself be a link (it holds a form, or a "More" toggle) keeps the wedge,
			   but only its own action - the label, a button or a link - moves it: hovering the rest of
			   the card does nothing, as clicking it does nothing. */
			.card-cta:not(a):hover::after {
				background: rgba(141, 213, 223, 0.2);
				clip-path: polygon(0 58%, 100% 38%, 100% 100%, 0 100%);
			}

			.card-cta:not(a):hover .card-cta-arrow {
				transform: none;
			}

			.card-cta:not(a):has(.card-cta-action:hover, .card-cta-action:focus-visible)::after {
				background: rgba(141, 213, 223, 0.32);
				clip-path: polygon(0 46%, 100% 26%, 100% 100%, 0 100%);
			}

			.card-cta .card-cta-action:hover .card-cta-arrow,
			.card-cta .card-cta-action:focus-visible .card-cta-arrow {
				transform: translateX(4px);
			}

			/* The action keeps its 24px above as the previous element's margin rather than its own
			   padding, so its focus ring and hit area stay the size of the words - and its own
			   margin-top stays auto, which is what holds it at the card's foot. */
			.card-cta :has(+ .card-cta-action) {
				margin-bottom: var(--space-6);
			}

			.card-cta-action {
				padding: 0;
				color: var(--st-ink);
				text-decoration: none;
			}

			.card-cta-button {
				border: 0;
				background: none;
				font: inherit;
				font-weight: 700;
				cursor: pointer;
			}

			.card-cta-action:focus-visible {
				outline: 3px solid var(--st-teal);
				outline-offset: 3px;
				border-radius: 4px;
			}

			/* Wide cards (the Woolworths card, the shop's fulfilment card): the wedge at a fixed *angle*
			   rather than .card-cta's percentages, which are relative to the card and go nearly flat on
			   a card several times wider than its neighbours. A band tilted by --wedge-angle about the
			   bottom-right corner, 60px tall at the right edge like every other wedge; the overflow
			   clips the rest, so on a very wide card it starts partway across. Set --wedge-angle to the
			   slope of the cards it sits with (about 5.5deg beside the partner cards, 3.3deg beside
			   the shop tiles, at laptop width). Hover lifts it by the same 12px as the clip-path
			   wedge. */
			.card-cta.card-cta-wide::after,
			.card-cta.card-cta-wide:not(a):hover::after {
				height: 100px;
				bottom: -40px;
				clip-path: none;
				transform: skewY(calc(-1 * var(--wedge-angle, 5.5deg)));
				transform-origin: 100% 100%;
				transition: transform 0.25s ease, background-color 0.25s ease;
			}

			a.card-cta.card-cta-wide:hover::after,
			.card-cta.card-cta-wide:not(a):has(.card-cta-action:hover, .card-cta-action:focus-visible)::after {
				clip-path: none;
				transform: translateY(-12px) skewY(calc(-1 * var(--wedge-angle, 5.5deg)));
			}

			@media (prefers-reduced-motion: reduce) {
				.card-cta.card-cta-wide::after {
					transition: none;
				}

				a.card-cta.card-cta-wide:hover::after,
				.card-cta.card-cta-wide:not(a):has(.card-cta-action:hover, .card-cta-action:focus-visible)::after {
					transform: skewY(calc(-1 * var(--wedge-angle, 5.5deg)));
				}
			}

			/* On phones a plain .card has 16px of padding, so the label's 8px nudge left it 8px off the
			   card's edge. 24px below keeps it 16px up, as on laptops. Pillars, shop tiles, the Get
			   Involved audience cards and product cards carry their padding on an inner body instead, so they are left alone. */
			@media (max-width: 700px) {
				.card.card-cta:not(.pillar, .category-tile, .gi-card, .item-card) {
					padding-bottom: var(--space-6);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.card-cta::after,
				.card-cta-arrow {
					transition: none;
				}

				.card-cta:hover::after {
					clip-path: polygon(0 58%, 100% 38%, 100% 100%, 0 100%);
				}

				.card-cta:hover .card-cta-arrow,
				.card-cta .card-cta-action:hover .card-cta-arrow,
				.card-cta .card-cta-action:focus-visible .card-cta-arrow {
					transform: none;
				}

				.card-cta:not(a):has(.card-cta-action:hover, .card-cta-action:focus-visible)::after {
					clip-path: polygon(0 58%, 100% 38%, 100% 100%, 0 100%);
				}
			}

			.card[hidden] {
				display: none;
			}

			/* CAST is a sequence, so draw it as one — a connecting rule behind the letters instead
			   of four disconnected cards. */
			.cast-journey {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: var(--space-6);
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.cast-step {
				position: relative;
				display: flex;
				flex-direction: column;
				gap: var(--space-3);
				padding-top: var(--space-6);
			}

			/* The rule runs between this step's letter and the next one's. */
			.cast-step:not(:last-child)::before {
				content: "";
				position: absolute;
				top: calc(var(--space-6) + 22px);
				left: 44px;
				width: calc(100% + var(--space-6) - 44px);
				height: 2px;
				background: repeating-linear-gradient(
					to right,
					var(--st-teal) 0 8px,
					transparent 8px 14px
				);
				opacity: 0.5;
			}

			.cast-step h3 {
				font-size: 1.15rem;
			}

			.cast-step p {
				color: rgba(36, 35, 43, 0.75);
			}

			@media (max-width: 900px) {
				.cast-journey {
					grid-template-columns: 1fr;
					gap: var(--space-5);
				}

				.cast-step:not(:last-child)::before {
					display: none;
				}
			}

			/* First-load reveal: each step arrives in turn and the dashed rule draws toward the next
			   one, so the eye travels C → A → S → T the way the journey itself does. Armed by an
			   inline script on our-work.astro rather than by default, so the steps stay visible if
			   JS is off or motion is reduced. Plays once per page load. */
			.cast-journey.cast-armed .cast-step {
				opacity: 0;
			}

			.cast-journey.cast-armed .cast-step:not(:last-child)::before {
				transform: scaleX(0);
				transform-origin: left center;
			}

			.cast-journey.cast-playing .cast-step {
				animation: cast-step-in 450ms cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
				animation-delay: var(--cast-delay, 0ms);
			}

			.cast-journey.cast-playing .cast-letter {
				animation: cast-letter-in 450ms cubic-bezier(0.34, 1.4, 0.64, 1) backwards;
				animation-delay: var(--cast-delay, 0ms);
			}

			/* Starts just after its own letter lands and finishes as the next step fades in, so the
			   line reads as handing off to the node it points at. */
			.cast-journey.cast-playing .cast-step:not(:last-child)::before {
				animation: cast-line-draw 300ms ease-out forwards;
				animation-delay: calc(var(--cast-delay, 0ms) + 150ms);
			}

			@keyframes cast-step-in {
				from {
					opacity: 0;
					transform: translateX(-28px);
				}
				to {
					opacity: 1;
					transform: translateX(0);
				}
			}

			@keyframes cast-letter-in {
				from {
					transform: scale(0.5);
				}
				to {
					transform: scale(1);
				}
			}

			@keyframes cast-line-draw {
				from {
					transform: scaleX(0);
				}
				to {
					transform: scaleX(1);
				}
			}

			/* Success stories vary a lot in length, and in a grid the short ones inherit the height of
			   the tallest in their row — which made the second row look like a different kind of
			   content. Multi-column lets each card be its own height. Reading order becomes
			   column-wise, which is fine here: the stories are independent, not a sequence. */
			.story-masonry {
				columns: 3;
				column-gap: var(--space-6);
			}

			.story-masonry > .card {
				break-inside: avoid;
				margin-bottom: var(--space-6);
			}

			@media (max-width: 900px) {
				.story-masonry {
					columns: 2;
				}
			}

			@media (max-width: 640px) {
				.story-masonry {
					columns: 1;
				}
			}

			/* Services are a reference list, not a set of cards. Without the card chrome, rows of
			   uneven length stop reading as boxes with dead space in them. */
			.service-list {
				margin: 0;
				border-top: 1px solid rgba(36, 35, 43, 0.12);
			}

			.service-row {
				display: grid;
				grid-template-columns: minmax(180px, 1fr) 2fr;
				gap: var(--space-4) var(--space-8);
				padding: var(--space-5) 0;
				border-bottom: 1px solid rgba(36, 35, 43, 0.12);
			}

			.service-row dt {
				font-weight: 700;
				font-size: 1.05rem;
			}

			.service-row dd {
				margin: 0;
				color: rgba(36, 35, 43, 0.75);
			}

			@media (max-width: 700px) {
				.service-row {
					grid-template-columns: 1fr;
					gap: var(--space-2);
				}
			}

			.cast-letter {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 44px;
				height: 44px;
				border-radius: 50%;
				background: var(--st-teal);
				color: var(--st-white);
				font-weight: 700;
				font-size: 1.3rem;
			}

			/* A frame: no padding of its own, so the photo runs flush to the card's edges, and the body
			   restores the padding the global .card rule would have given. */
			/* Shop landing tiles - the white card box is back since 25 September (it went on 2026-09-24),
			   with the .card-cta wedge and "Shop" label: the three landing tiles only; the product grids
			   inside each category stay cardless, per the 21 September review. The photo bleeds to the
			   card's edges, as the homepage pillars do. Whole-card link. Doubled class because the
			   ≤700px `.card { padding }` rule sits later at the same specificity. */
			.card.category-tile {
				gap: 0;
				padding: 0;
				align-items: stretch;
				/* The photo's own backdrop colour (set per tile by shop/index.astro), so the photo runs
				   into the card and the words sit on its backdrop, not on a white panel - as on the
				   product cards (25 September). */
				background: var(--card-colour, #fff);
				/* A true square (26 September): the near-square 4:3 and 3:2 versions read as "slightly off".
				   The text keeps its natural height and the photo takes what is left above it. */
				aspect-ratio: 1 / 1;
			}

			/* The wedge solid and a shade darker, as on the product cards, so it sits cleanly over
			   whatever it meets. */
			/* EXPERIMENT (26 September): the blue footer raised to sit behind all of the tile's words,
			   not just "Shop". It is drawn by the text body rather than the card's usual ::after, so it
			   always covers exactly the words however long the blurb runs, with the same rising slope
			   at its top edge reaching 24px up over the photo's foot. The card's own wedge is off. */
			a.card-cta.category-tile::after {
				display: none;
			}

			.category-tile-body {
				position: relative;
				isolation: isolate;
			}

			.category-tile-body::before {
				content: "";
				position: absolute;
				inset: -24px 0 0 0;
				z-index: -1;
				background: #d5e7e8;
				clip-path: polygon(0 24px, 100% 0, 100% 100%, 0 100%);
				pointer-events: none;
				transition: background-color 0.25s ease;
			}

			a.category-tile:hover .category-tile-body::before,
			a.category-tile:focus-visible .category-tile-body::before {
				background: #c6e1e3;
			}

			.blur-up {
				position: relative;
				overflow: hidden;
				background-size: cover;
				background-position: center;
			}

			.blur-up img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				opacity: 0;
				transition: opacity 0.4s ease;
			}

			.blur-up img.is-loaded {
				opacity: 1;
			}

			/* Above-the-fold images are never gated behind JavaScript. `loading="eager"` is the attribute
			   that already marks an image as in the initial viewport on this site (see the note on the
			   homepage hero in index.astro), so keying off it means a new hero cannot be added and quietly
			   miss this — the same attribute does both jobs and they cannot drift apart.
			
			   Why it matters: the three fade-in families above start their <img> at opacity 0 and wait for
			   an inline onload="this.classList.add('is-loaded')" before revealing it, then take a further
			   400ms to do so. For a hero that is the page's LCP element, which means the LCP cannot be
			   recorded until the fade finishes — an element at opacity 0 has not been painted. Measured on
			   /about/ at 6x CPU throttle with 150ms latency: text painted at 376ms and the <h1> was the LCP
			   candidate at 408ms, but the image's load event only fired at 540ms and it did not finish
			   fading until 824ms. That ~450ms with the copy up and the image wells still empty is the
			   "content arrives late" half of the flash, and unlike the navigation gap it is entirely
			   self-inflicted.
			
			   What replaces the fade is what the wrapper was already drawing underneath: .blur-up carries
			   the Sanity LQIP as a background-image, so the blurred preview shows until the real image
			   decodes over it, and .shimmer-up carries the placeholder shimmer for local images that have
			   no LQIP. The trade is honest and worth stating: the real image now arrives as a cut rather
			   than a fade. On a hero that is the standard progressive-image behaviour and it makes the LCP
			   measurement truthful; below the fold the fade is unobtrusive and stays.
			
			   ⚠ The onload attributes on those images must STAY even though the class no longer changes
			   their opacity: `.shimmer-up:has(img.is-loaded)` is what stops the shimmer animation, so
			   removing onload as now-dead code would leave it animating forever behind a loaded image. */
			.blur-up img[loading="eager"],
			.figure img[loading="eager"],
			.goods-tile-img[loading="eager"] {
				opacity: 1;
				transition: none;
			}

			/* Generic loading placeholder for local (non-Sanity) images, which have no LQIP data —
			   a shimmer instead of a true blurred preview. See .figure and .goods-tile below. */
			@keyframes shimmer {
				0% { background-position: 200% 0; }
				100% { background-position: -200% 0; }
			}

			.shimmer-up {
				background-image: linear-gradient(100deg, rgba(27, 171, 190, 0.08) 30%, rgba(27, 171, 190, 0.18) 50%, rgba(27, 171, 190, 0.08) 70%);
				background-size: 200% 100%;
				animation: shimmer 1.6s ease-in-out infinite;
			}

			.shimmer-up:has(img.is-loaded) {
				animation: none;
			}

			/* Flush to the card's top and sides (the card's own radius and overflow round
			   it). The image is requested uncropped from Sanity, so object-fit cover decides the crop. */
			.category-tile-img {
				position: relative;
				width: 100%;
				/* Fills whatever the square card leaves above the text (26 September): 4:3, then 3:2, left
				   the card near-square, which read as "slightly off". The photos are 16:9 files with spare
				   width, so the crop never reaches the products. */
				flex: 1 1 0;
				min-height: 0;
				overflow: hidden;
			}

			.category-tile-img img {
				position: absolute;
				inset: 0;
				transition: transform 0.3s ease, opacity 0.4s ease;
			}

			.category-tile:hover .category-tile-img img {
				transform: scale(1.03);
			}

			@media (prefers-reduced-motion: reduce) {
				.category-tile:hover .category-tile-img img {
					transform: none;
				}
			}

			.category-tile-body {
				display: flex;
				flex-direction: column;
				/* Its natural height, not a share of the spare space: in the square card the photo takes
				   whatever is left above the words. */
				flex: 0 0 auto;
				padding: var(--space-6);
			}

			.category-tile h2 {
				font-size: 1.2rem;
				margin-bottom: var(--space-2);
			}

			/* No bottom margin: the .card-cta label brings its own 24px above it. 0.75, not the site's
			   0.65 floor: the tiles now sit on their photo's backdrop, and on the bracelets' #e5e5e3 the
			   floor measured 4.49:1; 0.75 gives ~5.4:1 there. */
			.category-tile p {
				color: rgba(36, 35, 43, 0.75);
				font-size: 0.92rem;
				margin-bottom: 0;
			}

			.payment-method-header {
				display: flex;
				align-items: center;
				gap: var(--space-2);
			}

			.payment-method-header h3 {
				margin: 0;
			}

			/* Muted ink, not teal-dark: these sit in non-interactive "Ways to give" cards, where a
			   teal glyph next to a heading suggested the card itself was the control. The real
			   control is the button below it. (.payment-icon-paypal keeps its brand blue.) */
			.payment-icon {
				display: block;
				flex-shrink: 0;
				width: 28px;
				height: 28px;
				fill: rgba(36, 35, 43, 0.7);
			}

			.payment-icon-paypal {
				fill: #003087;
			}

			.redirect-note {
				font-size: 0.8rem;
				color: rgba(36, 35, 43, 0.65);
			}

			.bank-details {
				display: grid;
				gap: var(--space-2);
				width: 100%;
				margin: 0;
				padding: var(--space-4);
				background: rgba(36, 35, 43, 0.04);
				border-radius: calc(var(--radius) / 2);
				font-size: 0.9rem;
			}

			.bank-details > div {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: var(--space-4);
			}

			.bank-details dt {
				color: rgba(36, 35, 43, 0.65);
			}

			.bank-details dd {
				display: flex;
				align-items: baseline;
				justify-content: flex-end;
				gap: 0.4em;
				margin: 0;
				font-weight: 700;
			}

			.payfast-form {
				display: grid;
				gap: var(--space-2);
				width: 100%;
			}

			.payfast-form label {
				font-size: 0.85rem;
				font-weight: 600;
				color: rgba(36, 35, 43, 0.7);
			}

			.payfast-form input[type="number"] {
				width: 100%;
				padding: var(--space-3);
				margin-bottom: var(--space-2);
				border: 1px solid rgba(36, 35, 43, 0.18);
				border-radius: calc(var(--radius) / 2);
				font: inherit;
				font-size: 1rem;
			}

			.payfast-form button {
				justify-self: start;
				cursor: pointer;
				font: inherit;
				font-weight: 700;
			}

			.pay-qr {
				display: block;
				width: 160px;
				height: auto;
				border-radius: calc(var(--radius) / 2);
			}

			.contact-form {
				display: grid;
				gap: var(--space-4);
				width: 100%;
				max-width: 480px;
				margin: 0 auto;
			}

			.contact-form label {
				display: grid;
				gap: var(--space-1);
				font-weight: 600;
				font-size: 0.9rem;
			}

			.contact-form input,
			.contact-form textarea {
				box-sizing: border-box;
				font: inherit;
				padding: var(--space-2) var(--space-3);
				border-radius: 10px;
				border: 1px solid rgba(0, 0, 0, 0.15);
				background: var(--st-white);
			}

			/* A fixed height for single-line fields (26 September): with the height worked out from the
			   text, a browser's autofill preview or a password-manager extension - which swap the font
			   inside one field - made the name field a different height from the email field beside it. */
			.contact-form input:not([type="checkbox"], [type="radio"], [type="hidden"]) {
				height: 40px;
			}

			.contact-form .btn {
				width: fit-content;
				cursor: pointer;
			}

			.contact-form .btn:disabled {
				opacity: 0.5;
				pointer-events: none;
			}

			.form-error {
				color: var(--st-red);
			}

			.honeypot-field {
				position: absolute;
				width: 1px;
				height: 1px;
				overflow: hidden;
				clip: rect(0 0 0 0);
				white-space: nowrap;
			}

			/* Text for screen readers only — for things a sighted reader gets from context but a
			   listener doesn't, such as a link opening in a new tab. Same technique as
			   `.honeypot-field` above, but that one is named for its single purpose and shouldn't be
			   borrowed for this; a rule called "honeypot" hiding real content is a trap for whoever
			   next tries to delete it. */
			.visually-hidden {
				position: absolute;
				width: 1px;
				height: 1px;
				overflow: hidden;
				clip: rect(0 0 0 0);
				clip-path: inset(50%);
				white-space: nowrap;
			}

			.partner-logo-frame {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 100px;
				height: 100px;
				border-radius: calc(var(--radius) / 2);
			}

			.partner-logo-frame.on-dark {
				background: var(--st-ink);
				padding: var(--space-2);
			}

			.partner-logo {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: contain;
			}

			.team-photo {
				width: 120px;
				height: 120px;
				border-radius: 50%;
				margin: 0 auto;
			}

			/* Flex rather than .grid-4 so a trailing part-row (7 members = 4 + 3) centres itself
			   instead of hanging off the left edge. */
			.team-grid {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: var(--space-6);
			}

			.team-grid > .card {
				flex: 0 1 200px;
			}

			.team-bio {
				font-size: 0.9rem;
				color: rgba(36, 35, 43, 0.7);
			}

			/* Supporters are a plain name list rather than logo cards — the old site ran them
			   together as one comma-separated paragraph, which nobody can scan. */
			.supporters {
				margin-top: var(--space-8);
			}

			.supporters h3 {
				font-size: 1rem;
				color: rgba(255, 255, 255, 0.75);
				margin-bottom: var(--space-4);
			}

			.supporter-list {
				list-style: none;
				padding: 0;
				margin: 0;
				columns: 4;
				column-gap: var(--space-6);
				font-size: 0.92rem;
				color: rgba(255, 255, 255, 0.75);
			}

			.supporter-list li {
				break-inside: avoid;
				padding: 0.2rem 0;
			}

			.supporter-list a {
				color: inherit;
			}

			.supporter-note {
				color: rgba(255, 255, 255, 0.5);
			}

			@media (max-width: 900px) {
				.supporter-list {
					columns: 2;
				}
			}

			/* Muted ink, not teal-dark: this static eyebrow shared a card with the real
			   "Read the article" link and wore the identical colour, so the card offered two
			   apparent links and only one worked. */
			.press-publication {
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				color: rgba(36, 35, 43, 0.65);
			}

			.closing-cta {
				padding: var(--space-8) var(--space-6);
				gap: var(--space-5);
			}

			/* Non-interactive category labels (donate + get-involved) — no hover lift, so they
			   don't read as clickable now that the mailto wrapping has been removed.
			   Photo on top, label on white beneath since 2026-09-24 (design brief phase 2): the label
			   used to sit on the photo under a dark gradient. */
			.goods-tile {
				display: flex;
				flex-direction: column;
				border-radius: var(--radius);
				overflow: hidden;
				background-color: var(--st-white);
				box-shadow: 0 14px 30px rgba(0, 0, 0, 0.05);
			}

			/* The placeholder shimmer is a background on the whole tile; once the photo is in, the label
			   area must be plain white rather than the shimmer's faint teal. */
			.goods-tile:has(.goods-tile-img.is-loaded) {
				background-image: none;
			}

			.goods-tile-img {
				display: block;
				width: 100%;
				height: auto;
				aspect-ratio: 4 / 3;
				object-fit: cover;
				opacity: 0;
				transition: opacity 0.4s ease;
			}

			.goods-tile-img.is-loaded {
				opacity: 1;
			}

			/* Two across on a phone: with the label under the photo a tile reads fine at ~165px, and one
			   per row made Donate ~600px longer. */
			@media (max-width: 700px) {
				.grid:has(> .goods-tile) {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}

			.goods-tile span {
				color: var(--st-ink);
				font-weight: 600;
				font-size: 0.92rem;
				line-height: 1.3;
				padding: var(--space-3) var(--space-4) var(--space-4);
			}

			.stat {
				background: var(--st-white);
				color: var(--st-ink);
				border: 1px solid rgba(0, 0, 0, 0.06);
				border-radius: var(--radius);
				padding: 1.5rem;
				text-align: center;
			}

			/* Ink, not teal-dark — a static figure, and the teal family is reserved for things you
			   can act on. */
			.stat strong {
				display: block;
				font-size: 2rem;
				color: var(--st-ink);
			}

			.stat span {
				font-size: 0.9rem;
				color: rgba(36, 35, 43, 0.7);
			}

			.hero {
				background: linear-gradient(135deg, var(--st-teal) 0%, var(--st-red) 100%);
				color: var(--st-white);
				padding: var(--space-16) 0;
			}

			/* Back to its natural height (2026-09-24, the user's call): stretched to the full screen,
			   the still mural read oddly - mostly close-up wall. The full-screen box (display: flex,
			   column, justify-content: center, min-height 100vh then 100svh, and flex-end in the
			   ≤760px rule) was agreed on the 2 September review for the hero *video*, so bring it back
			   with the video - commit 37ab492 has it. */
			.hero-photo {
				position: relative;
				padding: calc(var(--space-20) + var(--hero-clearance)) 0 var(--space-20);
				overflow: hidden;
				background: var(--st-ink);
			}

			.hero-bg {
				position: absolute;
				top: -35%;
				left: 0;
				width: 100%;
				height: 145%;
				z-index: 0;
				will-change: transform;
				background-position: center 30%;
			}

			.hero-bg img {
				object-position: center 30%;
			}

			/* Measured, not assumed (design brief, 24 September): white text against every pixel of photo +
			   tint under every line, on all twelve public pages at 360-1440px - body 4.5:1 at the worst
			   pixel, h1 3:1. The old homepage tint (0.92 -> 0.75 at 40% -> teal 0.55) failed that on its own
			   page: its paragraph reached 2.3:1 on a phone and the nav 2.7:1, because the words and links
			   ran onto the light half. Two layers now:
			   - a top band behind the floating header, so the nav reads on any photo - held at full
			     strength to (clearance - 24px) and only then fading, because when the header wraps
			     (761-1037px) its second row, with Shop's white label on it, sits well down the hero;
			     with the band fading from the very top, Shop measured 3.85:1 there;
			   - the familiar ink-to-teal sweep, kept at 0.7 or darker across the text column (which ends
			     near 62% of the width) before it opens up to teal on the right.
			   On a phone or small tablet the words span most of the photo, so the tint is near-even there. Change a stop
			   and re-run the check (scripts/check-hero-contrast.playwright.js). */
			.hero-scrim {
				position: absolute;
				inset: 0;
				background:
					linear-gradient(180deg, rgba(24, 23, 31, 0.7) 0, rgba(24, 23, 31, 0.7) calc(var(--hero-clearance) - 24px), rgba(24, 23, 31, 0) calc(var(--hero-clearance) + 48px)),
					linear-gradient(
						100deg,
						rgba(24, 23, 31, 0.9) 0%,
						rgba(24, 23, 31, 0.8) 40%,
						rgba(24, 23, 31, 0.72) 68%,
						rgba(24, 23, 31, 0) 92%
					);
				z-index: 1;
			}

			/* To 900px, not 760: at 768 the text column runs to ~73% of the width, past where the sweep
			   opens up (measured 3.2:1 there before this). */
			@media (max-width: 900px) {
				.hero-scrim {
					background:
						linear-gradient(180deg, rgba(24, 23, 31, 0.7) 0, rgba(24, 23, 31, 0.7) calc(var(--hero-clearance) - 24px), rgba(24, 23, 31, 0) calc(var(--hero-clearance) + 48px)),
						linear-gradient(180deg, rgba(24, 23, 31, 0.74) 0%, rgba(24, 23, 31, 0.8) 100%);
				}
			}

			.hero-content {
				position: relative;
				z-index: 2;
			}

			.hero h1 {
				font-size: clamp(2.2rem, 5vw, 3.4rem);
				max-width: 20ch;
				margin-bottom: var(--space-4);
			}

			/* Same breathe as the mission statement, retuned for yellow-on-dark: the hero sits on
			   ink + photo, so the pulse brightens the word rather than deepening it (the reverse of
			   the light-background case), and the halo is warm yellow instead of teal. */
			.hero-highlight {
				color: var(--st-yellow);
				--glow-rgb: 219, 188, 59;
				--glow-dim: var(--st-yellow);
				--glow-bright: #f0dd8a;
			}

			.hero p {
				max-width: 55ch;
				font-size: 1.1rem;
				margin-bottom: var(--space-8);
				opacity: 0.95;
			}

			.actions {
				display: flex;
				gap: var(--space-4);
				flex-wrap: wrap;
			}

			.hero .btn-secondary {
				background: rgba(255, 255, 255, 0.15);
				color: var(--st-white);
				border: 2px solid rgba(255, 255, 255, 0.6);
			}

			.page-hero {
				background: var(--st-ink);
				color: var(--st-white);
				padding: var(--space-12) 0;
			}

			.page-hero h1 {
				margin-bottom: var(--space-2);
				font-size: clamp(2rem, 4vw, 2.8rem);
			}

			.page-hero p {
				max-width: 60ch;
				opacity: 0.85;
			}

			/* PhotoHero.astro (design brief, 24 September): one hero on every public page. The image
			   rules used to arrive with .blur-up; the component only adds that class when it has an
			   LQIP, so they are stated here. */
			.hero-bg img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			/* A smaller overhang than the homepage's 35%, with a gentler parallax to match (0.1, set
			   by PhotoHero's script): at rest the hero shows the part of the photo below the overhang,
			   and at 35% a wide inner hero showed only the lower half of a photo - the two people on
			   Our Work lost their heads. 12% is still more than the 0.1 rate can ever uncover. */
			.photo-hero--page .hero-bg,
			.photo-hero--band .hero-bg {
				top: -12%;
				height: 124%;
			}

			/* PhotoHero's `zoom` (desktop only): the photo is enlarged from its left edge, so the subject
			   moves right of the text column. The hero's overflow: hidden crops the rest. */
			@media (min-width: 901px) {
				.photo-hero[style*="--hero-zoom"] .hero-bg img {
					width: calc(var(--hero-zoom) * 100%);
					max-width: none;
				}
			}

			/* Top-level inner pages. 42vh since 25 September (was 56vh: a quarter shorter, the user's
			   call - "taking a little too much vertical space"; a third off cropped Our Work's two
			   people too tightly). 378px at 1440x900. The words are centred in the photo below the
			   header, nudged down a little (40px above, 24px below). Phones keep their own rule. */
			.hero-photo.photo-hero--page {
				display: flex;
				flex-direction: column;
				justify-content: center;
				min-height: max(260px, 42vh);
				padding: calc(var(--hero-clearance) + 40px) 0 24px;
			}

			/* Child and product pages: a slim strip with the parent's photo, words at its foot - with
			   56px under them since 25 September (was 32), so they no longer sit tight on the edge. */
			.hero-photo.photo-hero--band {
				display: flex;
				flex-direction: column;
				justify-content: flex-end;
				min-height: calc(220px + var(--hero-clearance));
				padding: calc(var(--space-8) + var(--hero-clearance)) 0 56px;
			}

			/* One h1 size for every hero but the homepage's, which stays larger. Wider than the
			   homepage's 20ch: product names ("African Worry Doll - Christmas Angel") would break
			   into three lines at 20. */
			/* text-wrap: balance (25 September) so a product name doesn't strand its last word -
			   "(pack of 3)" split across lines. Inner heroes only: the homepage headline's breaks are
			   Kerry's copy and a question with her (q37). */
			.photo-hero--page h1,
			.photo-hero--band h1 {
				font-size: clamp(2rem, 4vw, 2.8rem);
				max-width: 24ch;
				margin-bottom: 28px;
				text-wrap: balance;
			}

			/* Less on the slimmer band. (Both were 8px until 25 September - too tight; the page size
			   went 18 -> 28px the same day, after the About trial.) */
			.photo-hero--band h1 {
				margin-bottom: 14px;
			}

			.photo-hero--page p,
			.photo-hero--band p {
				max-width: 60ch;
				margin-bottom: 0;
			}

			@media (max-width: 760px) {
				.hero-photo.photo-hero--page {
					min-height: max(300px, 45svh);
					padding: calc(var(--header-height) * 1.5 + 80px) 0 calc(var(--header-height) * 0.5);
				}

				.hero-photo.photo-hero--band {
					min-height: calc(180px + var(--header-height));
					padding: calc(var(--space-6) + var(--header-height)) 0 56px;
				}
			}

			.quote {
				border-left: 4px solid var(--st-teal);
				padding-left: var(--space-5);
				font-style: italic;
				font-size: 1.15rem;
			}

			.quote cite {
				display: block;
				margin-top: var(--space-2);
				font-style: normal;
				font-weight: 600;
				font-size: 0.9rem;
				opacity: 0.75;
			}

			.figure {
				border-radius: var(--radius);
				overflow: hidden;
			}

			.figure img {
				width: 100%;
				max-height: 460px;
				object-fit: cover;
				border-radius: var(--radius);
				display: block;
				opacity: 0;
				transition: opacity 0.4s ease;
			}

			.figure img.is-loaded {
				opacity: 1;
			}

			/* Ink text on the teal tint, not teal-dark on teal tint. Two reasons: a pill-shaped,
			   teal-filled, teal-lettered label reads as a button, and teal-dark on this tint was
			   4.02:1 — under AA, and at 12.8px bold it does not qualify as large text. Ink is
			   13.85:1. The tint alone still carries the brand accent. */
			.badge {
				display: inline-block;
				align-self: flex-start;
				background: rgba(27, 171, 190, 0.12);
				color: var(--st-ink);
				border-radius: 999px;
				padding: var(--space-1) var(--space-4);
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.03em;
				text-transform: uppercase;
			}

			/* White rather than --st-teal for the same reason as .badge above: --st-teal is the
			   primary button fill, and a static pill wearing it reads as pressable. */
			.badge-on-dark {
				background: rgba(255, 255, 255, 0.14);
				color: var(--st-white);
			}

			/* Choose your path — one lead tile over a supporting row.
			   Donate gets the width and the headline number because it's the primary action; the
			   other two are told apart by their brush ring, not by a background colour each. That
			   keeps the section to two fills (teal, ink) and leaves --st-green/--st-red free to go on
			   meaning success/error in the cart and copy components. */

			/* Impact — full-bleed band. Light since 2026-09-24 (design brief phase 2: at most one dark band
			   per page besides the footer, and on Our Work that is the CAST stage). White against the
			   off-white page, ink figures. .dark-band (Who We Are's partners) stays ink. */
			.impact-band {
				background: var(--st-white);
				color: var(--st-ink);
				padding: var(--space-16) 0;
			}

			.dark-band {
				background: var(--st-ink);
				color: var(--st-white);
				padding: var(--space-16) 0;
			}

			.impact-band h2,
			.dark-band h2 {
				font-size: clamp(1.8rem, 3.5vw, 2.6rem);
			}

			.dark-band .section-intro p {
				color: rgba(255, 255, 255, 0.75);
			}

			.impact-band .section-intro p {
				color: rgba(36, 35, 43, 0.7);
			}

			.impact-band .wrap {
				display: flex;
				flex-direction: column;
				gap: var(--space-12);
			}

			.dark-band .wrap {
				display: flex;
				flex-direction: column;
				gap: var(--space-8);
			}

			.impact-stats {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
				gap: var(--space-10);
			}

			.impact-stat {
				display: flex;
				flex-direction: column;
				gap: var(--space-2);
			}

			/* Ink, not a teal: a static figure at this size doesn't need a colour to stand out, and any
			   teal on static *text* competes with the buttons and links the teal family is reserved for. */
			/* 3vw, not 5vw (25 September): "Workshops" at 5vw was ~267px in a 216px column at 1024 and
			   pushed the page 31px sideways; at wider widths it spilled into the page margin. */
			.impact-stat strong {
				display: block;
				font-size: clamp(2rem, 3vw, 3.5rem);
				font-weight: 700;
				color: var(--st-ink);
				line-height: 1;
			}

			.impact-stat span {
				font-size: 0.95rem;
				color: rgba(36, 35, 43, 0.7);
			}

			/* Narrow-screen tightening: vertical rhythm shrinks so there's less empty space to scroll
			   past. (.wrap's side padding is unconditional now, applied above at the base rule — it
			   used to live only in this block, back when desktop's max-width was wrongly assumed to
			   keep content off the edges at every width above 700px; it doesn't, between 700px and
			   1100px .wrap is full-viewport-width same as mobile, just without the media query.)
			   Kept as the LAST rule in this stylesheet, deliberately: every selector below is also
			   targeted by an earlier, unconditional (desktop) rule elsewhere above. Equal specificity
			   (simple class selectors on both sides) means source order decides the winner regardless
			   of the media condition — this block has to stay after all of them, or the desktop
			   declarations silently win back the cascade even on mobile (confirmed happening: this
			   block used to sit mid-stylesheet, ahead of the .impact-band/.dark-band/.stories-band/
			   .stories-grid/.story-card desktop rules, which were overriding it despite that media
			   query never applying past 700px). */
			@media (max-width: 700px) {
				/* Vertical rhythm is regularized here: the same value for the same *kind* of boundary,
				   rather than a different one per component. What it is NOT is a single value for
				   every boundary — that was tried and it removed the only cue mobile has for where a
				   section ends, since a nested layout is read entirely from the size of the gaps
				   between things. Three tiers, and the tier is chosen by how deep the boundary is:

				     --space-5  (20px)  siblings inside one group   .grid, .impact-stats, .path-grid
				     --space-6  (24px)  a group and its own heading  .section, .*-band .wrap
				     --space-12 (48px)  one whole section to the next  main

				   The ratio is what does the work, not the absolute numbers: a section break has to
				   read as clearly bigger than a card break at a glance, without either side of it
				   being on screen at the same time. 48/20 here is close to desktop's 64/24, so both
				   widths read the same way; it was 20/20 when every tier shared a value, which is
				   why an <h2> starting a new section looked like the next item in the list above it.
				   20px still sets the x-axis (.wrap's side padding, at the base rule above), so the
				   innermost tier stays square with the horizontal margin.

				   Excluded on purpose: .hero-photo (deliberately asymmetric, see below) and box
				   paddings that were already uniform on all four sides (.card, .path-tile,
				   .story-card) — those never had a top/bottom-vs-side mismatch to begin with. */
				main {
					gap: var(--space-12);
					padding-bottom: var(--space-12);
				}

				.section {
					gap: var(--space-6);
				}

				.grid {
					gap: var(--space-5);
				}

				.card {
					padding: var(--space-4);
				}

				/* Asymmetric on purpose: the fixed header already occupies the top, framing the hero
				   text on its own — stacking the full var(--space-12) on top of --header-height as well
				   doubles up on that framing and reads as too much dead air before the heading. The
				   bottom, with nothing above it, keeps the fuller gap before the next section. */
				.hero-photo {
					padding: calc(var(--space-6) + var(--header-height)) 0 var(--space-12);
				}

				/* No padding override here: .hero and .hero-photo are always applied together (see
				   index.astro) and .hero-photo's own padding above is the one that actually needs to
				   account for --header-height — a .hero padding rule here would win the whole shorthand
				   by source order and silently erase that offset (confirmed happening before this fix:
				   hero-content rendered 16px underneath the fixed header on mobile). */
				.hero p {
					margin-bottom: var(--space-6);
				}

				.page-hero {
					padding: var(--space-8) 0;
				}

				/* A band's own padding is what separates its content from the section boundary, so it
				   belongs to the outer tier — not the --space-5 it shared with everything else, which
				   left the heading almost touching the colour change that announces it. It can sit a
				   tier below main's gap (--space-8, not --space-12) because a band changes background
				   as well, and that edge marks the boundary on its own; the padding here only has to
				   stop the content crowding it. */
				.impact-band,
				.dark-band {
					padding: var(--space-8) 0;
				}

				/* Middle tier: these are a band's heading-to-content gap, the .section equivalent. */
				.impact-band .wrap {
					gap: var(--space-6);
				}

				.dark-band .wrap {
					gap: var(--space-6);
				}

				.impact-stats {
					gap: var(--space-5);
				}

			}
		</style>

		<script>
			const navToggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
			const primaryNav = document.querySelector<HTMLElement>("#primary-nav");

			function closeNav() {
				navToggle?.setAttribute("aria-expanded", "false");
				primaryNav?.classList.remove("is-open");
			}

			navToggle?.addEventListener("click", () => {
				const isOpen = navToggle.getAttribute("aria-expanded") === "true";
				navToggle.setAttribute("aria-expanded", String(!isOpen));
				primaryNav?.classList.toggle("is-open", !isOpen);
			});

			primaryNav?.addEventListener("click", (event) => {
				if ((event.target as HTMLElement).tagName === "A") {
					closeNav();
				}
			});

			// Auto-close on downward scroll only (not upward) — the menu overlays the page content
			// right below the header, so continuing to scroll down through it reads as the user moving
			// on, not adjusting their position within an open menu.
			let lastScrollY = window.scrollY;
			window.addEventListener(
				"scroll",
				() => {
					const currentScrollY = window.scrollY;
					if (currentScrollY > lastScrollY && primaryNav?.classList.contains("is-open")) {
						closeNav();
					}
					lastScrollY = currentScrollY;
				},
				{ passive: true },
			);
		</script>
	</body>
</html>
