			/* Narrow-screen tightening: content gets horizontal breathing room it doesn't need on
			   desktop (.wrap has no side padding above 700px — max-width already keeps it off the
			   edges there), and vertical rhythm shrinks so there's less empty space to scroll past.
			   Kept as the LAST rule in this stylesheet, deliberately: every selector below is also
			   targeted by an earlier, unconditional (desktop) rule elsewhere above. Equal specificity
			   (simple class selectors on both sides) means source order decides the winner regardless
			   of the media condition — this block has to stay after all of them, or the desktop
			   declarations silently win back the cascade even on mobile (confirmed happening: this
			   block used to sit mid-stylesheet, ahead of the .impact-band/.dark-band/.stories-band/
			   .stories-grid/.story-card desktop rules, which were overriding it despite that media
			   query never applying past 700px). */
			@media (max-width: 700px) {
				/* Longhand, not shorthand `padding:` — several elements (.header-inner, .footer-inner)
				   share the .wrap class alongside their own vertical padding/gap rules. A shorthand
				   here would reset their top/bottom values to 0 (equal specificity, later in source
				   order wins), which is exactly the header-padding bug this comment is here to prevent
				   from coming back. */
				.wrap {
					padding-left: var(--space-5);
					padding-right: var(--space-5);
				}

				/* Vertical rhythm matches the x-axis dimension (.wrap's side padding, above) throughout
				   this block — one consistent value instead of a different one per component. Excluded
				   on purpose: .hero-photo (deliberately asymmetric, see below) and box paddings that
				   were already uniform on all four sides (.card, .path-tile, .story-card) — those never
				   had a top/bottom-vs-side mismatch to begin with. */
				main {
					gap: var(--space-5);
					padding-bottom: var(--space-5);
				}

				.section {
					gap: var(--space-5);
				}

				.grid {
					gap: var(--space-5);
				}

				.card {
					padding: var(--space-4);
				}

				/* Asymmetric on purpose: the fixed header already occupies the top, framing the hero
				   text on its own — stacking the full var(--space-12) on top of --header-height as well
				   doubles up on that framing and reads as too much dead air before the heading. The
				   bottom, with nothing above it, keeps the fuller gap before the next section. */
				.hero-photo {
					padding: calc(var(--space-6) + var(--header-height)) 0 var(--space-12);
				}

				/* No padding override here: .hero and .hero-photo are always applied together (see
