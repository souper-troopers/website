---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import dignityPhoto from "../assets/images/dignity-moment.jpg";
import workshopPhoto from "../assets/images/workshop-craft.jpg";

const team = [
	{ name: "Kerry Hoffman", role: "Founder and Executive Director" },
	{ name: "Moeshfieqah Bosch", role: "Manager, The Humanity Hub" },
	{ name: "Tasneem Hoosain-Fielies", role: "Social Auxiliary Worker" },
	{ name: "Jake Gluckman", role: "Counsellor" },
	{ name: "Odette Oliver", role: "African Worry Doll Supervisor" },
	{ name: "Gideon Venter", role: "Admin & Fieldwork Assistant" },
	{ name: "Caryn Gootkin", role: "Fundraising & Finance" },
];

const partners = [
	{ name: "BFG Financial Services", blurb: "Pro bono accountants keeping our records in order." },
	{ name: "Boldr", blurb: "A smart TV, gas stove, and pantry support for our workshops." },
	{ name: "Capital International Group", blurb: "Monthly donor with strategic input and hands-on staff involvement." },
	{ name: "CNC Products", blurb: "Kerry's family business — connects us to hotel and restaurant clients." },
	{ name: "Dis-Chem Foundation", blurb: "Monthly credit for Troopers' toiletries and snacks." },
	{ name: "Dito", blurb: "Training academy, fundraising, and Christmas parties for the Souper Squad." },
	{ name: "Khulisa Social Solutions", blurb: "Government-funded partnership employing 25 Troopers." },
	{ name: "Ladles of Love", blurb: "Shared resources and skills at the Humanity Hub." },
	{ name: "Mensch", blurb: "Fundraising events and skills workshops through their changemaker network." },
	{ name: "Mini Meltdown", blurb: "Connections and hands-on support wherever it's needed." },
	{ name: "Ozow", blurb: "Funded a loadshedding solution for the Humanity Hub." },
	{ name: "Swindon Property", blurb: "Sponsors our rent, and their team regularly connects with ours." },
	{ name: "Salushi Express", blurb: "Long-time volunteers, raffle prizes, and our coffee on their menu." },
	{ name: "Web Times", blurb: "Website support and development." },
	{ name: "Werksmans", blurb: "Pro bono legal advice and representation." },
];
---

<Layout title="About" description="Souper Troopers' mission, values, and approach — dignity, love, and respect for every person we work with.">
	<section class="page-hero">
		<div class="wrap">
			<h1>About Souper Troopers</h1>
			<p>Est. 2014, Woodstock, Cape Town. A social enterprise built on dignity, love, and respect.</p>
		</div>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">How we began</span>
			<h2>It started with soup and sandwiches</h2>
			<p>
				In June 2014, Kerry Hoffman spent a day sharing soup and sandwiches with people living on
				the street. That relaxed social gathering — and the regular monthly events that followed
				for the next five years — helped us understand the complexity of homelessness and the
				inadequacies of existing interventions. Those early years cemented Souper Troopers in the
				social capital of the streets, and taught us that every person has their own story and
				needs individualised support to move forward.
			</p>
		</div>
	</section>

	<section class="section wrap">
		<div class="grid grid-2" style="align-items:center;">
			<div>
				<span class="badge">Our mission</span>
				<h2>Every person deserves dignity</h2>
				<p>
					Every person deserves dignity, and with the right support, anyone can rebuild their
					future. That belief drives everything we do — from a first conversation on the street
					to a first pay cheque.
				</p>
			</div>
			<div class="figure">
				<Image src={dignityPhoto} alt="A member of the Souper Troopers community smiling" widths={[400, 800]} sizes="(min-width: 700px) 500px, 100vw" />
			</div>
		</div>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">How we work</span>
			<h2>Dignity. Love. Respect.</h2>
			<p>Every beneficiary is seen as human first — before being homeless.</p>
		</div>
		<div class="grid grid-3">
			<div class="card">
				<h3>Not a handout</h3>
				<p>A hand up. Support is tailored to the person, not a one-size-fits-all programme.</p>
			</div>
			<div class="card">
				<h3>People-first</h3>
				<p>Success stories and real outcomes lead — not organisational statistics.</p>
			</div>
			<div class="card">
				<h3>Sustainable</h3>
				<p>Shmiley (Pty) Ltd — our own social enterprise, selling Troopers Coffee and African Worry Dolls&trade; — creates real jobs and reduces our reliance on donor funding.</p>
			</div>
		</div>
	</section>

	<section class="section wrap">
		<div class="grid grid-2" style="align-items:start;">
			<div class="figure">
				<Image src={workshopPhoto} alt="A Souper Squad skills workshop, making African Worry Dolls together" widths={[400, 800]} sizes="(min-width: 700px) 500px, 100vw" />
			</div>
			<div>
				<span class="badge">Where we work</span>
				<h2>The Humanity Hub</h2>
				<p>
					Our service centre at 66 Newmarket Street, Woodstock, Cape Town — a holistic range of
					services tailored to each person's journey, addressing both immediate needs and
					long-term transformation. See <a href="/our-work">what that support looks like</a> on
					Our Work.
				</p>
			</div>
		</div>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">Meet the team</span>
			<h2>The people behind the Humanity Hub</h2>
		</div>
		<div class="grid grid-4">
			{team.map((person) => (
				<div class="card">
					<h3>{person.name}</h3>
					<p>{person.role}</p>
				</div>
			))}
		</div>
	</section>

	<section class="dark-band">
		<div class="wrap">
			<div class="section-intro">
				<span class="badge badge-on-dark">Partners &amp; supporters</span>
				<h2>We don't do this alone</h2>
				<p>These businesses and organisations choose to partner with and support Souper Troopers.</p>
			</div>
			<div class="grid grid-4">
				{partners.map((partner) => (
					<div class="card">
						<h3>{partner.name}</h3>
						<p>{partner.blurb}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section wrap">
		<div class="card" style="text-align:center;">
			<span class="badge">Registered &amp; compliant</span>
			<p style="margin: 0.75rem 0 0; font-weight: 600;">NPO 188-609 &nbsp;|&nbsp; PBO 930063119 &nbsp;|&nbsp; B-BBEE Level 1</p>
			<p style="color: rgba(36,35,43,0.7);">Section 18A tax certificates are available for qualifying donations.</p>
		</div>
	</section>
</Layout>
