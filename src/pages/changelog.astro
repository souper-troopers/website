---
import Layout from "../layouts/Layout.astro";

/**
 * A client-readable record of what has changed, and why. Same family as the other internal pages:
 * `noindex`, out of the sitemap, outside the password.
 *
 * ⚠ Curated, deliberately, and NOT generated from the git history. The commit log is the accurate
 * record and it is unreadable for this audience - 140-odd entries, most of them about caching,
 * typechecking or CI. This says what changed for Souper Troopers, at a level Kerry or a board member
 * can read in two minutes.
 *
 * The honest cost of that is staleness: nothing generates this, so it goes out of date exactly the
 * way `llms.txt` did before it was made dynamic. Add to it when shipping, not as a separate chore.
 *
 * `from` is the part worth keeping. Where a change came out of one of their answers or a meeting,
 * say so - it is the clearest argument for replying to the next question, and this page is the only
 * place they can see their own input landing.
 */

type Change = { text: string; from?: string };
type Release = { date: string; heading: string; changes: Change[] };

const releases: Release[] = [
	{
		date: "25 September 2026",
		heading: "Every page opens on a photograph",
		changes: [
			{ text: "On Our Work, Recovery support is now Holistic support (trauma counselling and wellness, like yoga and art therapy), Housing assistance is now Family reunification, with your photo, and the Souper Squad card is gone.", from: "Shan, on the status page" },
			{ text: "The General worry doll is now R225, custom and wholesale doll enquiries go to sales@soupertroopers.org, and two photos that had been filed under the wrong doll are now only on the right one.", from: "Shan, on the status page" },
			{ text: "One new question on the status page: is the Souper Squad finished altogether, and who makes the dolls now? It's mentioned in a few places across the site, so we'd like to change them all together." },
			{ text: "Each product page now shows its photos in their own shape - the square gift tags fill their frame - with the price, a line about the product, the handmade note and Add to cart together on a white card beside them. Long product names no longer leave a word stranded on its own line." },
			{ text: "The words on the photograph at the top of each main page now sit nearer the middle of the picture, with a little more space between the title and the line beneath it." },
			{ text: "The worry dolls and gift tags are back on white cards, each with its price on the photo and a \"View\" at the bottom; the whole card opens the product. The note that every doll is handmade now sits above them as a short statement, and custom and wholesale orders are two cards of their own underneath." },
			{ text: "On Get Involved, the four B-BBEE scorecard cards now turn over like the partner cards on Who We Are: \"How it counts\" shows the detail on the back, without pushing anything else down the page." },
			{ text: "The top of the homepage says a little less: the line under the headline now ends at \"from crisis to dignity\", and the \"Or see how else you can help\" link is gone - the ways to help are just below. No words were rewritten. One new question on the status page asks whether the headline itself could drop its middle sentence." },
			{ text: "The CAST steps on Our Work now sit on a white card instead of a dark one, with the same colourful letters and the line drawing itself underneath in teal. Our Work no longer has a dark band apart from the footer." },
			{ text: "\"People, not just statistics\" on the homepage is now Odette's own words, large, beside her photo - no box around it - with a link to the other stories on Our Work." },
			{ text: "The shop's product grids are simpler: each doll or gift tag is now one tap - photo, name or price - straight to its own page, where Add to cart is. Those pages no longer end with a \"More from\" row, since the list you came from is one click back." },
			{ text: "\"How we began\" on Who We Are now tells the whole story at once - no \"More\" to click - beside a photo of Kerry. One new question on the status page asks Shan for a photo from the 2014 soup days, and a larger portrait of Kerry." },
			{ text: "On Who We Are, the partner logos now line up with the Woolworths card above them, and each is a small card you can turn over: the round button in its corner shows what that partner does for us. Nothing on the page moves when you do." },
			{ text: "Donate and Shop at the top of every page are now two separate buttons: Donate filled in teal, Shop outlined beside it, with the basket next to Shop. The header is a little slimmer, and the button for the page you are on is underlined, like the menu links. In Chrome, Edge and Safari that underline now slides across to wherever you go next." },
			{ text: "The status page's question about the Humanity Hub name now asks what the board decided on 28 September, and for the Humanity Hub logo that is painted on the building. It is marked as needed before launch, since the top of every page already reads \"The Humanity Hub by Souper Troopers\"." },
			{ text: "One new question on the status page, marked as needed before launch: may we use the photos you've given us? Nearly all of them show people, and we'd like one of them - three people on the couch at the Hub - at the top of Who We Are once we know it's fine." },
			{ text: "The three \"How to get involved\" cards on the homepage are now plain white, matching every other card on the site." },
			{ text: "Get Involved no longer stacks three dark photographs one under another. \"For individuals\" and \"For companies\" are now two cards side by side, each with its photo on top and the ways to help underneath; open one and everything for that audience appears below the pair.", from: "the 25 September review of the site" },
			{ text: "Get Involved, Volunteer and Donate goods now have their own photograph at the top - Kerry and a colleague at the doll and coffee stall - instead of sharing Our Work's." },
			{ text: "Four tidy-ups from reviewing the week's changes: the Contact cards no longer leave a large empty space under the opening hours; the service cards on Our Work no longer stretch to match the tallest one; the homepage's three \"How to get involved\" cards now line up; and on the Corporate partnership page the title no longer runs across the face in the photograph." },
			{ text: "The status page now marks the few questions the site can't go live without as \"Needed before launch\", and lists them at the top of the questions. One new question is on there: who looks after the soupertroopers.org address and your email, which has to be known before the new site can be switched on.", from: "Shan, on the timing" },
			{ text: "The darkening behind the words on each photograph now fades out to nothing, so most of each photo shows in full colour. The paler-photo idea that was tried on Get Involved is dropped: the site no longer sits on dark bands and boxes, which was most of what made it feel dark.", from: "Adrian, on the 21 September review" },
			{ text: "\"Shop\" was in the menu at the top three times. The menu no longer has its own Shop link - the Donate / Shop button at the top right does that job, and shows when you are in the shop.", from: "the design brief" },
			{ text: "Less to read before you reach what you came for. The Volunteer, Donate goods and Corporate partnership pages no longer open by listing what the cards just below them list again, and longer cards show their first line with the rest a click away. No wording was rewritten - the only new words are an \"Address and opening hours\" link.", from: "the design brief" },
			{ text: "The address now has one home, the Contact page (and the foot of every page); elsewhere it links there. And the two banners on Get Involved now show where each route goes even before you open them.", from: "the design brief" },
			{ text: "Fewer kinds of box. Cards across the site are now one plain white card, and cards with a photo show the photo on top with the words underneath, instead of words printed over a darkened photo. The small labels above section headings are gone everywhere, since each one just repeated the heading. Buttons come in three styles instead of five.", from: "the design brief" },
			{ text: "Lighter. The coloured teal-to-red band behind the homepage stories and Who We Are's \"How we began\" is gone, and the impact figures on Our Work and Donate now sit on white. Each page keeps at most one dark band.", from: "Adrian, on the 21 September review" },
			{ text: "The homepage shows one success story, with a link to the rest on Our Work. \"How to get involved\" is three matching cards. Pages no longer end on a repeated \"Donate now\" row - the Donate and Shop buttons are always at the top of the page." },
			{ text: "The trial of a pale look on Get Involved's two banners is paused, so the whole site uses one style while it settles. It comes back as a whole-site comparison, so you can judge it properly." },
			{ text: "Every page now opens the way the homepage does: a photograph across the top, with the menu floating over it and the page's title on the photo. Before, only the homepage did this and every other page started on a plain black band, so moving from the homepage to any other page felt like stepping into a different site. Who We Are and Contact show the Humanity Hub, Our Work and Get Involved show a conversation at the Hub, Donate shows a visit, and the shop shows the coffee and dolls. Pages one level down, like Volunteer or a single doll, get a slimmer strip of the same photograph.", from: "Adrian, on the 21 September review, and the design brief" },
			{ text: "Every word on those photographs was checked for readability against the photo itself, not just by eye, on phones, tablets and laptops. The darkening behind the words is a little stronger than it was on the homepage, which did not pass that check everywhere." },
		],
	},
	{
		date: "24 September 2026",
		heading: "The Worry Dolls, with Shan's photographs",
		changes: [
			{ text: "The photograph at the top of the homepage is back to its earlier height rather than filling the whole screen. Stretched that far, the mural was mostly close-up wall. The full-screen version comes back with the hero video." },
			{ text: "The shop is simpler to look at. Products no longer sit in white boxes: the photographs are larger, three to a row, with the name, price and a quieter \"Add to cart\" beneath each. On the Worry Dolls page each doll is named by its style - Female, Brooch, Christmas Elf - since the page already says African Worry Dolls, and custom orders and wholesale now share one box under the dolls. The three tiles on the main shop page match.", from: "Adrian and Hilton, on the 21 September review" },
			{ text: "The Gift Tags picture on the main shop page was a small, blurry copy from the old site. It is now Shan's studio photographs of the two packs side by side - India Harris and Hans Moolman - sharp at any size.", from: "Shan's photos" },
			{ text: "A first draft of the homepage to react to on the 30th. Under the opening photo it now says three things - the Humanity Hub, the CAST programme, and that every purchase pays a wage - each a card you can click through, with the photo above the words rather than behind them. Then a larger \"How to get involved\", and the success stories. The page is four sections instead of five, and nothing on it has new wording: every line was already on the site.", from: "Kerry and Adrian, on the 21 September review" },
			{ text: "Every Worry Doll style now shows Shan's new studio photographs - 43 of them - and each product page has a set you can swipe through, so you see the range rather than one example. The styles follow Shan's list: Female, Male, General, Christmas Angel, Christmas Elf, Literary, Brooch, Magnet and Keyring. Madiba, a one-off custom doll, is gone.", from: "Shan, and the 21 September review" },
			{ text: "The Worry Dolls page says plainly that every doll is handmade, so the one you receive won't match the photo exactly. There is also a card for custom orders and a line for wholesale enquiries, both by email for now.", from: "Kerry and Adrian, on the 21 September review" },
			{ text: "Two new questions on the status page: Odette's video on YouTube, and a few details to confirm - four on the Worry Dolls page, and who in the Our Work photos has agreed to be shown." },
			{ text: "A trial of a lighter look: the two banners on Get Involved now use a pale wash with dark text instead of a dark one with white text. It's one page, to see whether you prefer it before it goes any further.", from: "Adrian, on the 21 September review" },
			{ text: "Three of the service cards on Our Work now show Souper Troopers' own photos instead of stock pictures: essential needs, recovery support and the social enterprises. We only used photos where nobody receiving help can be recognised - a face next to \"recovery support\" says something about that person on a public page for years. The other four keep their placeholder photos until there are shots that work the same way.", from: "Shan's photos, 16 September" },
		],
	},
	{
		date: "14 September 2026",
		heading: "A shorter donate page, and Woolworths first",
		changes: [
			{ text: "Who We Are now opens on a photograph of the Humanity Hub, drawn like the shop's \"Every purchase pays a wage\" card. Further down, the partners are a wall of logos - open one to see what they give - and the supporters list folds away behind its heading, so that section is a third shorter. How we began shows its first line, with the rest a click away, and Our mission is centred again." },
			{ text: "Who We Are reads more simply. The small labels above each section are gone, and each title now says plainly what the section is - Our mission, How we began, How we work, The Humanity Hub, Meet the team, and so on - instead of repeating the first line of the paragraph beneath it. \"Dignity, love and respect\" moved into the first line of How we work, so the page still says it." },
			{ text: "The name at the top of every page now reads \"The Humanity Hub\", with \"by Souper Troopers\" beneath it, beside the logo. The logo itself hasn't changed - that waits for the board, and for someone to design a Hub logo (it's on the status page).", from: "Shan, on the 2 September review" },
			{ text: "The homepage now fills the screen when it opens - the photo and the message first, with everything else starting just below. The hero video will slot into the same space when it's ready.", from: "Brad, Hilton and Adrian, on the 2 September review" },
			{ text: "A pass through the whole site for things said twice. Where a page repeated itself it now says it once: the volunteer page asked what you'd like to do three times, the corporate page listed the same donated services twice, and Who We Are repeated the charity numbers from the footer just beneath them. The common questions on the volunteer, donate goods and corporate pages now open one at a time, like Contact and Donate.", from: "Adrian, on the 2 September review" },
			{ text: "Two additions to the status page: a first try at the homepage's three pillars for you to react to, and a request for Shan's Shmiley carousel.", from: "the 2 September review" },
			{ text: "The Donate / Shop button at the top of every page is now two buttons in one: click Donate or Shop and you're there, instead of opening a menu first." },
			{ text: "Zapper is gone from the donate page, since you've moved to SnapScan.", from: "Kerry, on the 2 September review" },
			{ text: "The donate page is about half the reading it was. Direct EFT, the method we prefer, now leads as one wide card with the bank details beside it; the other four ways to give sit beneath it in a line or two each. The questions donors ask open one at a time, and the other ways to help are two photographs you can click through.", from: "Adrian, on the 2 September review" },
			{ text: "Woolworths now appears first on Who We Are, larger than the other partners and linking to their site. The logo is their public one, and the words beneath it only repeat what the site already says about the partnership - please check both with Woolworths before launch (it's on the status page).", from: "the 2 September review" },
			{ text: "Success stories can now carry a video. Paste a YouTube or Vimeo link into a story in the Studio and it appears on that story's card as a picture with a play button - the video itself only loads when someone presses play. Stories without one look exactly as before." },
			{ text: "Three opening lines now lead with the Humanity Hub - on the homepage, Who We Are and Donate - since the Hub is what people meet when they come to us. The name Souper Troopers, the logo and the page titles haven't changed; that waits for the board.", from: "Shan, on the 2 September review" },
		],
	},
	{
		date: "13 September 2026",
		heading: "Less to read, more to go on",
		changes: [
			{ text: "Cards now show what you need to decide, and open the rest on click. People rarely read unless they're deciding something or checking whether an organisation can be trusted - so the claim stays visible and the evidence behind it is one click away, rather than everything at once. First pass on Get Involved and the shop.", from: "Adrian, on the 2 September review" },
			{ text: "Who We Are can now show a lead partner first, as a larger entry at the top of the partners - ready for Woolworths once the partnership is confirmed and they have approved their logo. Each partner can also link to its own website now.", from: "the 2 September review" },
			{ text: "Two new questions on the status page: Woolworths' logo and a line about the partnership, after Monday's meeting; and who would design a Humanity Hub logo, if the board decides to lead with that name.", from: "the 2 September review" },
			{ text: "The homepage now speaks to the social enterprise: \"Every purchase pays a wage\" sits on a photograph of the coffee and worry dolls, with a way through to the shop, instead of one small tile. And it asks for a donation twice rather than three times - the closing band that repeated the ask is gone; the Donate button in the header is always there.", from: "Kerry and Adrian, on the 2 September review" },
			{ text: "The homepage no longer repeats its headline figure. 1,700+ people supported sat in the main Donate tile and again in a band of statistics directly below it; it now appears once, next to the action it argues for. Our Work keeps the full set.", from: "the 2 September review" },
			{ text: "The Contact page leads with a photograph of the building, with the painted 66 on the wall so you know the door when you get there. Every title on the page is now the same size." },
			{ text: "The questions on the Contact page now open one at a time. You see the four questions at a glance and open the one that's yours, rather than reading past three answers to find it. The answers are still in the page, so search engines read them as before." },
			{ text: "The Contact page now reads top to bottom: visiting and email first, then the common questions, then the message form beneath them." },
			{ text: "On the shop page, \"Every purchase pays a wage\" now sits on the photograph itself, in white on a darkened side of the picture, the way the two banners on Get Involved do, and the three product cards show their photos edge to edge. Two small labels that only repeated the headings beneath them are gone, the opening line no longer says what the first card says, and each product card's link is just \"Shop\" rather than repeating the name above it." },
			{ text: "Our Work has a new take on the CAST journey: four big letters that fill in turn as a hand-drawn line carries a dot from Connect to Transform. It is a proposal to react to, not the final graphic - that brief is still with Brad's designer.", from: "Kerry, on the 2 September review" },
			{ text: "Our Work's \"What support looks like\" is now seven photo cards, one for each kind of help at the Humanity Hub, all the same size. The photos are placeholders from a free image library until our own are ready - none of them shows anyone from Souper Troopers." },
			{ text: "The two bookable offers for companies - team workshops and office coffee - are half the length on Get Involved. The full detail was already on the corporate partnership page, so the same words were appearing twice." },
		],
	},
	{
		date: "7 September 2026",
		heading: "Get Involved, rebuilt around who you are",
		changes: [
			{ text: "Pages could arrive blank in Safari after clicking a link, with the browser offering to download the page instead of showing it. Traced to the way pages were being fetched in the background before you clicked them - something only Safari does differently. That background fetching is now off, and the problem has not recurred since." },
			{ text: "The shop basket could stop working in Safari private browsing, where saving the basket is blocked - it now keeps working for the visit rather than failing outright." },
			{ text: "Get Involved now asks who you are before it asks what you want to do. Two photographs - one for individuals, one for companies - and opening either reveals everything for that audience. Before, six cards sat at the top and you had to work out which applied to you.", from: "Adrian, on the 2 September review" },
			{ text: "The same page had been labelling things three times over - a card, a heading and a chip all saying \"individuals\". The chips are gone and the photographs carry the titles." },
			{ text: "A page listing everything written for you rather than for visitors - this changelog, the status page, and the three write-ups that were previously only reachable from inside the question that raised them. It is the \"Internal\" link in the menu." },
			{ text: "This changelog." },
			{ text: "A new question on the status page asking which words stay on the homepage - the review agreed the site says too much, but not what survives. Cutting the repetition is ours to do; deciding which of your words go is not.", from: "the 2 September review" },
		],
	},
	{
		date: "6 September 2026",
		heading: "Volunteering, goods, and the shop",
		changes: [
			{ text: "A volunteer page, saying what volunteers actually do here - sorting donations, keeping the Hub organised, teaching the squad a skill or running a workshop. It had been left unbuilt on purpose, because the only thing we could have said was \"give time\".", from: "Shan's answer about volunteering" },
			{ text: "The goods page now says what condition things need to be in, and why, in Shan's own words. It also says that collection can sometimes be arranged for something large, and lists the craft materials the Souper Squad needs.", from: "Shan's answer about donations" },
			{ text: "The shop leads with where the money goes rather than with an explanation of Shmiley.", from: "the 2 September review" },
			{ text: "The Donate button in the header is now a Donate / Shop menu, so the shop is visible from every page.", from: "Adrian, on the 2 September review" },
			{ text: "The Humanity Hub is now named in page titles, descriptions and the data Google reads. It appeared only in body text before, which is why searches were reading the organisation as a food scheme rather than a service centre.", from: "Shan's finding about AI scans" },
		],
	},
	{
		date: "5 September 2026",
		heading: "The review, written up",
		changes: [
			{ text: "Minutes of the 2 September review: ten decisions with the reasoning kept, what is still open, and what each person owes." },
			{ text: "A page setting out what we need from the video shoot - including that a film with talking in it cannot start on its own, so the plan needs a silent clip as well." },
			{ text: "Kerry's replies and Shan's second and third rounds recorded on the Status page. Every question now has a reply against it for the first time." },
		],
	},
	{
		date: "23 - 27 August 2026",
		heading: "Speed, and the pages people were looking for",
		changes: [
			{ text: "Two new pages for the things people most often ask about: donating goods, and corporate partnership." },
			{ text: "Questions on the contact and donate pages are now answered in the words people actually use to ask them." },
			{ text: "Pages now fade into each other instead of flashing white between clicks." },
			{ text: "Photographs appear as soon as they arrive rather than waiting for the page's scripts, and the header no longer shifts as it loads." },
			{ text: "The custom font is off for now. Measured properly, it was costing about a second on some pages and causing the text to jump as it swapped in - a worse trade than it looked. Easy to turn back on." },
			{ text: "The MySchool card was wrong: Woolworths merged MySchool into MyDifference and stopped accepting the cards on 30 June. Corrected.", from: "Shan's reply" },
		],
	},
	{
		date: "19 - 22 August 2026",
		heading: "Legibility and load time",
		changes: [
			{ text: "The homepage photograph was loading last instead of first, which was making the site feel slow. Fixed, and measured: pages load between a fifth and a half faster." },
			{ text: "The donate page's six payment buttons were all shouting equally. Quietened, and the button text darkened so it is actually readable on the brand teal." },
		],
	},
	{
		date: "15 August 2026",
		heading: "The Status page becomes a conversation",
		changes: [
			{ text: "You can now reply underneath any question on the Status page instead of writing an email, and each item reads as one dated thread." },
			{ text: "The internal pages are behind a password, with a login each, so a reply is signed by whoever wrote it." },
			{ text: "The Status page was too long to read; it is now about half the length on opening, with a contents bar." },
			{ text: "A page comparing the Shmiley options side by side." },
			{ text: "The tab icon was an unreadable smudge at small sizes. Rebuilt from the logo's own lettering and brush ring." },
			{ text: "Product photographs and press links from the Drive, and the photograph of the building - which turned out to have been on the old site all along.", from: "the Drive folder Shan shared" },
		],
	},
	{
		date: "11 - 13 August 2026",
		heading: "Being found",
		changes: [
			{ text: "Every shop product now has its own page, so an individual doll or coffee can be found, linked and shared. Before this, eleven products shared three pages." },
			{ text: "Page titles and descriptions rewritten around what people actually search for. They had been the menu labels, which nobody searches." },
			{ text: "A sitemap, so search engines can see the whole site." },
			{ text: "The picture that shows when a link is shared was a crop of somebody's chin. It is now the Mandela mural." },
			{ text: "Teal is now reserved for things you can click. Prices and statistics had been styled like links, and links like plain text." },
			{ text: "A Publish button in the content tool, so a batch of edits can be put live without needing us or a Netlify account." },
		],
	},
	{
		date: "8 - 10 August 2026",
		heading: "The site itself",
		changes: [
			{ text: "The new site built across all pages, with the content moved into a tool you can edit yourself." },
			{ text: "A working shop with a real basket and card checkout through PayFast, tested with real transactions." },
			{ text: "The real product catalogue, prices and photographs brought across from the old site." },
			{ text: "Automatic weekly backups of all the content, to a private repository, with an alert if a backup ever fails to arrive." },
			{ text: "Contact and enquiry forms that actually send, and privacy-respecting visitor statistics." },
		],
	},
];

const totalChanges = releases.reduce((sum, release) => sum + release.changes.length, 0);
---

<Layout
	title="What has changed"
	description="A running record of changes to the Souper Troopers site."
	noindex
>
	<section class="page-hero">
		<div class="wrap">
			<span class="badge badge-on-dark">For Kerry, Shan &amp; the board</span>
			<h1>What has changed</h1>
			<p>The {totalChanges} changes worth knowing about, newest first. Where something came out of one of your answers or a meeting, it says so.</p>
		</div>
	</section>

	<section class="section wrap">
		<div class="cl-intro">
			<p>This is the short version. Everything here is on the live preview now - nothing is waiting to be switched on. If something looks wrong, the Status page is the place to say so.</p>
		</div>

		{releases.map((release) => (
			<div class="cl-release">
				<div class="cl-when">
					<h2>{release.heading}</h2>
					<p class="cl-date">{release.date}</p>
				</div>
				<ul class="cl-changes">
					{release.changes.map((change) => (
						<li>
							<span>{change.text}</span>
							{change.from && <span class="cl-from">From {change.from}</span>}
						</li>
					))}
				</ul>
			</div>
		))}
	</section>
</Layout>

<style>
	.cl-intro {
		max-width: 68ch;
		margin-bottom: var(--space-6);
	}

	.cl-intro p {
		margin: 0;
		color: rgba(36, 35, 43, 0.72);
	}

	.cl-release {
		padding-top: var(--space-5);
		border-top: 1px solid rgba(36, 35, 43, 0.12);
	}

	.cl-release + .cl-release {
		margin-top: var(--space-5);
	}

	.cl-when h2 {
		margin: 0 0 var(--space-1);
		font-size: 1.2rem;
	}

	.cl-date {
		margin: 0 0 var(--space-3);
		font-size: 0.85rem;
		font-weight: 600;
		/* Ink, not teal: a date is static content, and teal on text means you can act on it. */
		color: rgba(36, 35, 43, 0.65);
	}

	.cl-changes {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-3);
		max-width: 74ch;
	}

	.cl-changes li {
		padding-left: var(--space-4);
		position: relative;
	}

	.cl-changes li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--st-teal-light);
	}

	.cl-from {
		display: block;
