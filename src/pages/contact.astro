---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact" description="Get in touch with Souper Troopers.">
	<section class="page-hero">
		<div class="wrap">
			<h1>Contact Us</h1>
			<p>We'd love to hear from you — whether you're donating, volunteering, or partnering with us.</p>
		</div>
	</section>

	<section class="section wrap">
		<div class="grid grid-2">
			<div class="card">
				<h3>Visit us</h3>
				<p>66 Newmarket Street<br />Woodstock, Cape Town</p>
				<p>Open Mondays–Thursdays, 8:30am–4pm, and Fridays, 8:30am–3pm.</p>
				<p>Visits to the Humanity Hub are by appointment — Moeshfieqah arranges those on <a href="mailto:manager@soupertroopers.org">manager@soupertroopers.org</a>.</p>
			</div>
			<div class="card">
				<h3>Who to email</h3>
				<p><strong>Donations and drop-offs</strong><br /><a href="mailto:manager@soupertroopers.org">manager@soupertroopers.org</a></p>
				<p><strong>Section 18A tax certificates</strong><br /><a href="mailto:accounts@soupertroopers.org">accounts@soupertroopers.org</a></p>
				<p><strong>Anything else</strong><br /><a href="mailto:info@soupertroopers.org">info@soupertroopers.org</a></p>
			</div>
			<div class="card">
				<h3>Programme &amp; partnerships</h3>
				<p><a href="mailto:kerry@soupertroopers.org">kerry@soupertroopers.org</a></p>
				<p>For Troopers Coffee specifically: <a href="https://instagram.com/troopers_coffee" target="_blank" rel="noopener">@troopers_coffee</a></p>
				<p>For African Worry Dolls&trade;: <a href="https://instagram.com/africanworrydolls" target="_blank" rel="noopener">@africanworrydolls</a></p>
			</div>
		</div>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">Send a message</span>
			<h2>Or just tell us what's up</h2>
			<p>Prefer not to email directly? Use the form below and we'll get back to you.</p>
		</div>

		<form id="contact-form" class="contact-form" name="contact" method="POST" data-netlify="true" data-netlify-honeypot="bot-field">
			<input type="hidden" name="form-name" value="contact" />
			<label class="honeypot-field" aria-hidden="true">
				Leave this field blank
				<input type="text" name="bot-field" tabindex="-1" autocomplete="off" />
			</label>

			<label>
				Your name
				<input type="text" name="name" required />
			</label>

			<label>
				Your email
				<input type="email" name="email" required />
			</label>

			<label>
				Message
				<textarea name="message" rows="4" required></textarea>
			</label>

			<button class="btn btn-primary" type="submit">Send message</button>
			<p id="contact-form-error" class="form-note form-error" hidden>
				Something went wrong sending that — you can email
				<a href="mailto:manager@soupertroopers.org">manager@soupertroopers.org</a> directly instead.
			</p>
		</form>
	</section>

	<div id="contact-toast" class="toast" role="status" aria-live="polite"></div>
</Layout>

<style>
	.section-intro {
		width: 100%;
		max-width: 480px;
		margin: 0 auto;
	}

	.toast {
		position: fixed;
		left: 50%;
		bottom: 1.5rem;
		z-index: 200;
		max-width: calc(100% - 2rem);
		text-align: center;
		background: var(--st-teal-dark);
		color: var(--st-white);
		padding: 0.85rem 1.5rem;
		border-radius: var(--radius);
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.28);
		opacity: 0;
		pointer-events: none;
		transform: translate(-50%, 0.5rem);
		transition: opacity 0.25s ease, transform 0.25s ease;
	}

	.toast.show {
		opacity: 1;
		pointer-events: auto;
		transform: translate(-50%, 0);
	}
</style>

<script>
	const form = document.querySelector<HTMLFormElement>("#contact-form");
	const errorEl = document.querySelector<HTMLElement>("#contact-form-error");
	const toastEl = document.querySelector<HTMLElement>("#contact-toast");
	let toastTimer: ReturnType<typeof setTimeout>;

	function showToast(message: string) {
		if (!toastEl) return;
		toastEl.textContent = message;
		toastEl.classList.add("show");
		clearTimeout(toastTimer);
		toastTimer = setTimeout(() => toastEl.classList.remove("show"), 4000);
	}

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (errorEl) errorEl.hidden = true;

		const submitButton = form.querySelector<HTMLButtonElement>("button[type='submit']");
		if (submitButton) submitButton.disabled = true;

		try {
			const response = await fetch("/", {
				method: "POST",
				headers: { "Content-Type": "application/x-www-form-urlencoded" },
				body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString(),
			});
			if (!response.ok) throw new Error("Form submission failed");

			form.reset();
			showToast(
				import.meta.env.DEV
					? "Message sent (local dev — Netlify only emails this notification from the live deployed site, not from dev)."
					: "Message sent — thanks for reaching out, we'll get back to you soon.",
			);

			if (submitButton) {
				const originalText = submitButton.textContent;
				submitButton.textContent = "Sent ✓";
				setTimeout(() => {
					submitButton.textContent = originalText;
					submitButton.disabled = false;
				}, 1800);
			}
		} catch {
			if (errorEl) errorEl.hidden = false;
			if (submitButton) submitButton.disabled = false;
		}
	});
</script>
