---
import Layout from "../layouts/Layout.astro";
import EmailLink from "../components/EmailLink.svelte";
import AddressLink from "../components/AddressLink.svelte";
import { Image } from "astro:assets";
import hubExterior from "../assets/images/humanity-hub-exterior.jpg";
import { displayHours } from "../lib/opening-hours";
import { getSiteSettings } from "../lib/sanity";
import { displayAddress } from "../lib/address";
import Faq from "../components/Faq.astro";
import { faqPageJsonLd, type FaqItem } from "../lib/faq";

// Was a hardcoded duplicate of the Sanity value until the postal code landed. Reading it from the
// same place the footer does means the two can't drift, which matters more than usual here: this is
// the page Google is most likely to read the address off, and it has to match the Google listing.
const settings = await getSiteSettings();

const emailDirectory = [
	{ label: "Donations & drop-offs", address: "manager@soupertroopers.org" },
	{ label: "Visits & appointments", address: "manager@soupertroopers.org" },
	{ label: "Section 18A certificates", address: "accounts@soupertroopers.org" },
	{ label: "Programme & partnerships", address: "kerry@soupertroopers.org" },
	{ label: "Anything else", address: "info@soupertroopers.org" },
];

// The Hub photo: half the row in two columns. A photo stretched taller than 3:2 renders wider than
// its card, hence the cap above the column width.
const photoSizes = "(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 600px";

const shopBrands = [
	{ handle: "@troopers_coffee", href: "https://instagram.com/troopers_coffee" },
	{ handle: "@africanworrydolls", href: "https://instagram.com/africanworrydolls" },
];

/**
 * The four things people arrive at a contact page already wondering, asked in the words they would
 * use. Every answer is already asserted elsewhere - the by-appointment note on the visit card above,
 * the email-only fact Shan confirmed on 2026-08-11, and the "not a shelter, not an overnight
 * facility" instruction that `src/pages/llms.txt.ts` already gives to answer engines.
 *
 * ⚠ That last one existed **only** in `llms.txt` until now, which meant the site was telling
 * machines something no page told a human, and no page said it anywhere a search engine would
 * index it. It is the single most likely thing for someone to get wrong about this organisation,
 * so it belongs in visible copy first.
 */
const faqItems: FaqItem[] = [
	{
		question: "Is Souper Troopers a shelter?",
		answer:
			"No. Souper Troopers is not a shelter and the Humanity Hub is not an overnight facility. The Hub is a day-time base in Woodstock, Cape Town, where people experiencing homelessness meet social workers, share a meal, take part in skills training, and get help replacing identity documents and finding work.",
		link: { href: "/our-work", label: "What happens at the Humanity Hub" },
	},
	{
		question: "Can I visit the Humanity Hub without an appointment?",
		answer:
			"No - visits are by appointment rather than drop-in, and Moeshfieqah sets those up. Email us with a rough idea of when suits you and what you would like to see, and she will arrange a time.",
		email: "manager@soupertroopers.org",
	},
	{
		question: "Does Souper Troopers have a phone number?",
		answer:
			"No. There is no direct line - email is the only way to reach the team, and it is read every working day. That is a deliberate choice for a small team rather than an oversight, so email is not a second-best route here.",
	},
	{
		question: "Where do I drop off donated goods?",
		answer:
			`At the Humanity Hub, ${displayAddress(settings.address)}. Email first to arrange a time, so somebody is expecting you and free to help you unload.`,
		link: { href: "/get-involved/donate-goods", label: "What to bring and how to arrange it" },
	},
];
---

<Layout
	title="Contact us at the Humanity Hub, Woodstock"
	description="Get in touch with Souper Troopers at the Humanity Hub, our service centre in Woodstock, Cape Town - address, email, opening hours and a contact form."
	jsonLd={[faqPageJsonLd(faqItems)]}
>
	<section class="page-hero">
		<div class="wrap">
			<h1>Contact Us</h1>
			<p>We'd love to hear from you - whether you're donating, volunteering, or partnering with us.</p>
		</div>
	</section>

	{/* Visit us on the left; the two channels - email, and the shop's own accounts - stacked on the
	    right, plain cards. The Hub photo is the page's one image. Its title sits below it, so it reads
	    like the cards beside it: title, then content. */}
	<section class="section wrap">
		<div class="contact-cards">
			<div class="card photo-card visit-card" data-name="visit">
				<div class="photo-card-media">
					{/* The building, from the pavement opposite. Not decoration: visits here are by
					    appointment, so everyone arriving has arranged it in advance and the only real question on
					    the day is "is this the right door" - which a street number painted a metre high answers
					    better than any address line. */}
					{/* Above the fold at both breakpoints (measured) and the largest thing on the page, so not
					    lazy - see the note on the homepage hero in index.astro. `width` is set as well as
					    `widths`, or Astro points the plain `src` at the full 2400px source as the fallback. */}
					<Image
						src={hubExterior}
						alt="The Humanity Hub at 66 Newmarket Street - a grey and white corner building with a large 66 painted on its side wall, Table Mountain behind it."
						width={1200}
						height={800}
						widths={[480, 800, 1200]}
						sizes={photoSizes}
						loading="eager"
						fetchpriority="high"
						class="photo-card-img visit-photo"
					/>
				</div>
				<div class="photo-card-body">
					<div class="card-heading">
						<h2 class="contact-title">Visit us</h2>
						<p>The Humanity Hub, Woodstock</p>
					</div>
					<p><AddressLink client:visible lines={[displayAddress(settings.address)]} /></p>
					<dl class="visit-hours">
						{displayHours.map((entry) => (
							<div>
								<dt>{entry.days}</dt>
								<dd>{entry.hours}</dd>
							</div>
						))}
					</dl>
					<p class="visit-note">Humanity Hub visits are by appointment - Moeshfieqah sets those up.</p>
				</div>
			</div>
			<div class="contact-reach">
				<div class="card email-card" data-name="email">
					<h2 class="contact-title">Email us</h2>
					<dl class="email-directory">
						{emailDirectory.map((entry) => (
							<div>
								<dt>{entry.label}</dt>
								<dd><EmailLink client:visible address={entry.address} /></dd>
							</div>
						))}
					</dl>
				</div>
				<div class="card brand-card" data-name="shop">
					<h2 class="contact-title">Follow the shop brands</h2>
					<ul class="brand-list">
						{shopBrands.map((brand) => (
							<li>
								<a href={brand.href} target="_blank" rel="noopener">{brand.handle}</a>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</section>
	
	{/* One centred column. Not beside the form: two different jobs side by side read as one dense
	    block (tried 2026-09-13), and "before you get in touch" is a step, not an alternative. */}
	<section class="section wrap">
		<div class="faq-column">
			{/* No "Common questions" chip: the questions announce themselves. */}
			<h2 class="contact-title">Before you get in touch</h2>
			<Faq items={faqItems} collapsible />
		</div>
	</section>

	{/* A plain section, not a card, on the same column as the questions above: its heading shares
	    their left edge, and the fields keep the form's comfortable 480px. */}
	<section class="section wrap">
		<div class="message-column">
			<div class="card-heading">
				<h2 class="contact-title">Send us a message</h2>
				<p>Prefer not to email directly? Use the form below and we'll get back to you.</p>
			</div>
			<form id="contact-form" class="contact-form" name="contact" method="POST" data-netlify="true" data-netlify-honeypot="bot-field">
			<input type="hidden" name="form-name" value="contact" />
			<label class="honeypot-field" aria-hidden="true">
				Leave this field blank
				<input type="text" name="bot-field" tabindex="-1" autocomplete="off" />
			</label>

			<label>
				Your name
				<input type="text" name="name" required />
			</label>

			<label>
				Your email
				<input type="email" name="email" required />
			</label>

			<label>
				Message
				<textarea name="message" rows="4" required></textarea>
			</label>

			<button class="btn btn-primary" type="submit">Send message</button>
			<p id="contact-form-error" class="form-note form-error" hidden>
				Something went wrong sending that - you can email <EmailLink client:visible address="manager@soupertroopers.org" /> directly instead.
			</p>
		</form>
		</div>
	</section>

	<div id="contact-toast" class="toast" role="status" aria-live="polite"></div>
</Layout>

<style>
	/* Two cards per row from 701px, one below. Stretched, so the photo in the shorter card grows to meet
	   its neighbour and both cards' text ends level (see .photo-card-media). */
	.contact-cards {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: stretch;
		gap: var(--space-6);
	}
	
	@media (max-width: 700px) {
		.contact-cards {
			grid-template-columns: 1fr;
			gap: var(--space-5);
		}
	}
	
	/* One size for every title below the h1. The four cards and the questions are peers, and they had
	   been three sizes at two heading levels (27, 19 and 35px; h3 before h2). This is Get Involved's
	   sub-section size, which is the level these sit at. */
	.contact-title {
		margin: 0;
		font-size: clamp(1.2rem, 2vw, 1.45rem);
		line-height: 1.2;
	}
	
	.card-heading {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	
	.card-heading p {
		margin: 0;
		color: rgba(36, 35, 43, 0.7);
		text-wrap: pretty;
	}
	
	/* A photo card is a frame: no padding of its own, so the photo runs flush to its edges, and the
	   body restores the padding the global .card rule would have given. */
	.photo-card {
		padding: 0;
		gap: 0;
		overflow: hidden;
	}
	
	/* Grows into whatever height the row gives the card, so the text ends at the card's foot and the
	   photo takes the slack - otherwise it lands as empty white under the last line. `aspect-ratio`
	   is the floor, not the shape: it reserves the photo's 3:2 before it loads, so nothing shifts,
	   and it is what the photo falls back to wherever there is no slack (one column). */
	.photo-card-media {
		position: relative;
		align-self: stretch;
		flex: 1 0 auto;
		aspect-ratio: 3 / 2;
	}
	
	.photo-card-img {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	
	/* ⚠ The Hub photo crops from the RIGHT only. The 66 is at the very left edge of the frame (about
	   2-9% across), so a centred crop takes the first 6 off; the right is street and parked cars. */
	.visit-photo {
		object-position: left center;
	}
	
	.photo-card-body {
		align-self: stretch;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		padding: var(--space-6);
	}
	
	@media (max-width: 700px) {
		/* Mirrors the global .card padding at this width. */
		.photo-card-body {
			padding: var(--space-4);
		}
	}
	
	/* The email directory and the shop card, stacked opposite the Hub. */
	.contact-reach {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		min-width: 0;
	}
	
	/* Grows to absorb whichever column ends up shorter, so the slack lands inside the last card rather
	   than as a gap between the two. */
	.brand-card {
		flex: 1;
	}
	
	@media (max-width: 700px) {
		.contact-reach {
			gap: var(--space-5);
		}
	
		.brand-card {
			flex: none;
		}
	}
	
	/* The questions' column: same width, same left edge. */
	.message-column {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
		width: 100%;
		max-width: 46rem;
		margin: 0 auto;
	}
	
	/* The global form is a centred 480px block; here it keeps the width and starts at the column's edge. */
	.message-column .contact-form {
		margin: 0;
	}
	
	.faq-column {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
		width: 100%;
		max-width: 46rem;
		margin: 0 auto;
	}

	.visit-hours {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		margin: 0;
	}

	.visit-hours > div {
		display: flex;
		gap: var(--space-3);
	}

	.visit-hours dt {
		min-width: 4.5rem;
		font-weight: 600;
	}

	.visit-hours dd {
		margin: 0;
		color: rgba(36, 35, 43, 0.7);
	}

	.visit-note {
		font-size: 0.9rem;
		color: rgba(36, 35, 43, 0.7);
	}

	/* Hairline-separated rows so five routes read as one directory to scan, rather than five
	   free-standing paragraphs. */
	.email-directory {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		width: 100%;
		margin: 0;
	}

	.email-directory > div {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding-bottom: var(--space-3);
		border-bottom: 1px solid rgba(36, 35, 43, 0.08);
	}

	.email-directory > div:last-child {
		padding-bottom: 0;
		border-bottom: none;
	}

	.email-directory dt {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: rgba(36, 35, 43, 0.65);
	}

	.email-directory dd {
		margin: 0;
	}

	.brand-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.toast {
		position: fixed;
		left: 50%;
		bottom: 1.5rem;
		z-index: 200;
		max-width: calc(100% - 2rem);
		text-align: center;
		background: var(--st-teal-dark);
		color: var(--st-white);
		padding: 0.85rem 1.5rem;
		border-radius: var(--radius);
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.28);
		opacity: 0;
		pointer-events: none;
		transform: translate(-50%, 0.5rem);
		transition: opacity 0.25s ease, transform 0.25s ease;
	}

	.toast.show {
		opacity: 1;
		pointer-events: auto;
		transform: translate(-50%, 0);
	}
</style>

<script>
	const form = document.querySelector<HTMLFormElement>("#contact-form");
	const errorEl = document.querySelector<HTMLElement>("#contact-form-error");
	const toastEl = document.querySelector<HTMLElement>("#contact-toast");
	let toastTimer: ReturnType<typeof setTimeout>;

	function showToast(message: string) {
		if (!toastEl) return;
		toastEl.textContent = message;
		toastEl.classList.add("show");
		clearTimeout(toastTimer);
		toastTimer = setTimeout(() => toastEl.classList.remove("show"), 4000);
	}

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (errorEl) errorEl.hidden = true;

		const submitButton = form.querySelector<HTMLButtonElement>("button[type='submit']");
		if (submitButton) submitButton.disabled = true;

		try {
			const response = await fetch("/", {
				method: "POST",
				headers: { "Content-Type": "application/x-www-form-urlencoded" },
				body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString(),
			});
			if (!response.ok) throw new Error("Form submission failed");

			form.reset();
			showToast(
				import.meta.env.DEV
					? "Message sent (local dev - Netlify only emails this notification from the live deployed site, not from dev)."
					: "Message sent - thanks for reaching out, we'll get back to you soon.",
			);

			if (submitButton) {
				const originalText = submitButton.textContent;
				submitButton.textContent = "Sent ✓";
				setTimeout(() => {
					submitButton.textContent = originalText;
					submitButton.disabled = false;
				}, 1800);
			}
		} catch {
			if (errorEl) errorEl.hidden = false;
			if (submitButton) submitButton.disabled = false;
		}
	});
</script>
