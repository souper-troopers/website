---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact" description="Get in touch with Souper Troopers.">
	<section class="page-hero">
		<div class="wrap">
			<h1>Contact Us</h1>
			<p>We'd love to hear from you — whether you're donating, volunteering, or partnering with us.</p>
		</div>
	</section>

	<section class="section wrap">
		<div class="grid grid-2">
			<div class="card">
				<h3>Visit or write</h3>
				<p>66 Newmarket Street<br />Woodstock, Cape Town</p>
				<p><a href="mailto:manager@soupertroopers.org">manager@soupertroopers.org</a></p>
			</div>
			<div class="card">
				<h3>Programme &amp; partnerships</h3>
				<p><a href="mailto:kerry@soupertroopers.org">kerry@soupertroopers.org</a></p>
				<p>For Troopers Coffee specifically: <a href="https://instagram.com/troopers_coffee" target="_blank" rel="noopener">@troopers_coffee</a></p>
				<p>For African Worry Dolls&trade;: <a href="https://instagram.com/africanworrydolls" target="_blank" rel="noopener">@africanworrydolls</a></p>
			</div>
		</div>
	</section>
</Layout>
