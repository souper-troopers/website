---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Donate" description="Support the CAST programme — donation options for Souper Troopers.">
	<section class="page-hero">
		<div class="wrap">
			<h1>Donate</h1>
			<p>Every donation funds a step in someone's CAST journey — from a first conversation to a first pay cheque.</p>
		</div>
	</section>

	<section class="section wrap">
		<div class="grid grid-3">
			<div class="stat"><strong>1,700+</strong><span>lives supported since 2014</span></div>
			<div class="stat"><strong>77%</strong><span>employment success in the latest CAST intake</span></div>
			<div class="stat"><strong>Section 18A</strong><span>certificates available for donations</span></div>
		</div>
	</section>

	<section class="section wrap">
		<div class="card">
			<h2>Ways to give</h2>
			<p>
				Souper Troopers is finalising a full list of donation methods, including a new monthly-giving
				platform. In the meantime, email the team directly to donate:
			</p>
			<a class="btn btn-primary" href="mailto:manager@soupertroopers.org">Email manager@soupertroopers.org</a>
			<p style="margin-top:1.5rem; font-size:0.9rem; color: rgba(36,35,43,0.6);">
				<!-- TODO: replace with the confirmed donation methods (EFT/bank details, once-off vs monthly links, and the new monthly platform) once Kerry confirms — see the "Are there existing donation platforms that need to remain?" question in the Website Discovery doc. -->
				Once-off and monthly donation options, plus direct deposit details, will be added here once confirmed.
			</p>
		</div>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">Prefer to give another way?</span>
			<h2>Goods and products also help</h2>
		</div>
		<div class="grid grid-2">
			<div class="card"><h3>Donate goods</h3><p>Food, clothing, household items, and materials for African Worry Dolls.</p><a href="/get-involved">See the full list &rarr;</a></div>
			<div class="card"><h3>Shop with purpose</h3><p>Troopers Coffee and African Worry Dolls&trade; fund jobs directly.</p><a href="/shop">Shop &rarr;</a></div>
		</div>
	</section>
</Layout>
