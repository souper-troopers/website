---
import Layout from "../layouts/Layout.astro";
import CountUp from "../components/CountUp.svelte";
import EmailLink from "../components/EmailLink.svelte";
import CopyButton from "../components/CopyButton.svelte";
import { Image } from "astro:assets";
import Faq from "../components/Faq.astro";
import { getImpactStats, getSiteSettings } from "../lib/sanity";
import { faqPageJsonLd, type FaqItem } from "../lib/faq";
import transportPhoto from "../assets/images/donation-funds/transport.jpg";
import trainingPhoto from "../assets/images/donation-funds/training.jpg";
import idDocumentsPhoto from "../assets/images/donation-funds/id-documents.jpg";
import carePacksPhoto from "../assets/images/donation-funds/care-packs.jpg";
import snapscanQr from "../assets/images/pay/snapscan-qr.png";
import zapperQr from "../assets/images/pay/zapper-qr.png";

const impactStats = await getImpactStats("donate");
const settings = await getSiteSettings();

// The old site's PayFast "Pay Now" form pointed return_url/cancel_url at soupertroopers.org
// (itself) - copying that as-is would send a donor on this site back to the old one after paying.
const payfastReturnUrl = new URL("/donate?donated=1", Astro.site).href;
const payfastCancelUrl = new URL("/donate", Astro.site).href;

// Zapper's app link (https://zapper.gitbook.io/integrations/apps/app-links) takes the *decoded*
// contents of the Zapper QR code as its `qr` parameter. There is no dashboard or lookup that hands
// you that string, so it was read off zapper-qr.png itself (macOS CoreImage QR detector) - meaning
// if that image is ever replaced with a new code, this constant has to be re-decoded from it, or
// the button will keep paying into whatever the old QR pointed at. Verified against zapper.com:
// the link returns 200 and the page emits a matching `zapper://payment?qr=...` deep link and iOS
// smart-app-banner. `successCallbackURL` is deliberately omitted - it's optional, and the only
// page to send someone back to is this one, whose thank-you banner is PayFast-specific.
const zapperCode = "http://2.zap.pe?t=8&i=26568:26974:7[34|0.00-100.00-200.00-1|15|,39|ZAR|0|:10[38|Souper Troopers|0|,61||4|";
const zapperUrl = `https://www.zapper.com/payWithZapper?qr=${encodeURIComponent(zapperCode)}&appName=${encodeURIComponent("Souper Troopers")}`;

// The visible <dl> and the "copy all" button both derive from this array, so what a donor pastes
// into their banking app cannot drift from what the page shows them - same reasoning as
// opening-hours.ts and address.ts. `copy` marks the row that also keeps its own inline control.
const bankDetails = [
	{ term: "Account name", value: "Souper Troopers" },
	{ term: "Bank", value: "ABSA" },
	{ term: "Account type", value: "Cheque" },
	{ term: "Account number", value: "4092622072", copy: true },
	{ term: "Reference", value: "Your name" },
];
const bankDetailsText = bankDetails.map((detail) => `${detail.term}: ${detail.value}`).join("\n");

const fundedItems = [
	{ label: "Transport to appointments and training", photo: transportPhoto },
	{ label: "Course & skills training fees", photo: trainingPhoto },
	{ label: "ID document costs", photo: idDocumentsPhoto },
	{ label: "Care packs for essential needs", photo: carePacksPhoto },
];

/**
 * Every answer restates something this page already says - the EFT card's "no card fees", the
 * Section 18A routing, the PaySoftImpact redirect, the four funded items above. Nothing new is
 * asserted here; see the note at the top of `src/lib/faq.ts`.
 *
 * ⚠ Deliberately no rand amounts against specific outcomes ("R150 buys transport"). Whether
 * donations are earmarked per item or pooled is still an open question with the client, so a
 * costed claim would be a guess presented as a fact - see the shelved suggested-amounts item in
 * AGENTS.md.
 */
const faqItems: FaqItem[] = [
	{
		question: "Is my donation to Souper Troopers tax-deductible?",
		answer: `Yes. Souper Troopers is a registered Public Benefit Organisation (PBO ${settings.pboNumber}) in South Africa, and we issue a Section 18A certificate for the full value of your donation.`,
	},
	{
		question: "How do I get my Section 18A certificate?",
		// No bare address in the text: an unlinked email sitting next to a linked one reads as a
		// mistake, and this question is about the certificate rather than about where proof of
		// payment goes - the EFT card above already says that.
		answer: "Email your proof of payment to our accounts team and they will issue a certificate for the full value of your donation. If you paid by EFT, the bank details above also carry the address to send proof of payment to.",
		email: "accounts@soupertroopers.org",
	},
	{
		question: "Which way of giving helps the most?",
		answer: "A direct EFT is our preferred method, because there are no card fees and more of the gift reaches the work. A monthly debit order is the most useful kind of gift over time, because a predictable amount is something we can plan around.",
	},
	{
		question: "Can I donate from outside South Africa?",
		answer: "Yes. PayPal handles non-South African cards and PayPal balances, so international donations go through there rather than through the South African card option.",
	},
	{
		question: "What does my donation pay for?",
		answer: "Transport to appointments and training, course and skills training fees, the cost of replacing ID documents, and care packs for essential needs - the practical costs that decide whether somebody can take up an opportunity or not.",
		link: { href: "/our-work", label: "How the CAST programme works" },
	},
	{
		question: "Can I donate goods instead of money?",
		answer: "Yes. Clothing, non-perishable food, toiletries, bedding, household goods and electronics are all useful at the Humanity Hub in Woodstock, and Section 18A certificates are available for donated goods too.",
		link: { href: "/get-involved/donate-goods", label: "What to bring and how to arrange it" },
	},
];
---

<Layout
	title="Donate to support our work in Cape Town"
	description="Donate to Souper Troopers by EFT, SnapScan, Zapper, PayPal or monthly debit order, and help people experiencing homelessness in Cape Town."
	jsonLd={[faqPageJsonLd(faqItems)]}
>
	<section class="page-hero">
		<div class="wrap">
			<h1>Donate</h1>
			<p>Every donation funds a step in someone's CAST journey - from a first conversation to a first pay cheque.</p>
			<p id="payfast-thanks" class="payfast-thanks" hidden>
				Thank you - your PayFast payment is on its way to us. If it doesn't reflect within a day or
				two, email <EmailLink client:visible address="info@soupertroopers.org" />.
			</p>
		</div>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">Where it goes</span>
			<h2>What your donation funds</h2>
			<p>Not admin overhead - the direct, practical costs of one person's CAST journey.</p>
		</div>
		<div class="grid grid-4">
			{fundedItems.map((item) => (
				<div class="goods-tile shimmer-up">
					<Image
						src={item.photo}
						alt=""
						role="presentation"
						class="goods-tile-img"
						width={500} widths={[300, 500]}
						sizes="(min-width: 700px) 260px, 45vw"
						onload="this.classList.add('is-loaded')"
					/>
					<div class="goods-tile-scrim"></div>
					<span>{item.label}</span>
				</div>
			))}
		</div>
	</section>

	<section class="impact-band">
		<div class="wrap">
			<div class="impact-stats">
				{impactStats.map((stat) => (
					<div class="impact-stat">
						{stat.value != null ? (
							<CountUp client:visible end={stat.value} suffix={stat.suffix ?? ""} />
						) : (
							<strong>{stat.displayValue}</strong>
						)}
						<span>{stat.label}</span>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">Ways to give</span>
			<h2>Choose the method that works for you</h2>
		</div>
			<div class="pay-masonry">
				<div class="card">
					<div class="payment-method-header">
						<svg class="payment-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 2 9h20L12 2zM3 10v8h2v-8H3zm4 0v8h2v-8H7zm4 0v8h2v-8h-2zm4 0v8h2v-8h-2zm4 0v8h2v-8h-2zM2 19v2h20v-2H2z" /></svg>
						<h3>Direct EFT</h3>
					</div>
					<p>Our preferred method - no card fees, so more of your gift reaches the work.</p>
					<dl class="bank-details">
						{bankDetails.map((detail) => (
							<div>
								<dt>{detail.term}</dt>
								<dd>
									{detail.copy && <CopyButton client:visible value={detail.value} label={detail.term.toLowerCase()} />}
									{detail.value}
								</dd>
							</div>
						))}
					</dl>
					<CopyButton client:visible value={bankDetailsText} label="bank details" text="Copy bank details" />
					<p class="redirect-note">
						Email your proof of payment to <EmailLink client:visible address="info@soupertroopers.org" />.
						Section 18A tax certificates are issued by our accounts team on <EmailLink client:visible address="accounts@soupertroopers.org" />.
					</p>
				</div>
				<div class="card">
					<div class="payment-method-header">
						<svg class="payment-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 5h20a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm0 3v2h20V8H2zm2 5v2h6v-2H4z" /></svg>
						<h3>Card - South African</h3>
					</div>
					<p>Donate with a South African credit or debit card, through PayFast.</p>
					<form class="payfast-form" action="https://www.payfast.co.za/eng/process" method="post">
						<input type="hidden" name="cmd" value="_paynow" />
						<input type="hidden" name="receiver" value="13206553" />
						<input type="hidden" name="item_name" value="Donate to Souper Troopers" />
						<input type="hidden" name="return_url" value={payfastReturnUrl} />
						<input type="hidden" name="cancel_url" value={payfastCancelUrl} />
						<label for="payfast-amount">Amount (R)</label>
						<input id="payfast-amount" type="number" name="amount" step="0.01" min="5.00" value="250" required />
						<button class="btn btn-outline-teal" type="submit">Donate by card &rarr;</button>
					</form>
				</div>
				<div class="card">
					<div class="payment-method-header">
						<svg class="payment-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h8v8H3V3zm2 2v4h4V5H5zm8-2h8v8h-8V3zm2 2v4h4V5h-4zM3 13h8v8H3v-8zm2 2v4h4v-4H5zm10-2h2v2h-2v-2zm4 0h2v2h-2v-2zm-4 4h2v2h-2v-2zm4 0h2v2h-2v-2zm-2 4h2v2h-2v-2z" /></svg>
						<h3>Zapper</h3>
					</div>
					<p>Scan the code with the Zapper app, or tap through if you're already on your phone.</p>
					<Image class="pay-qr" src={zapperQr} alt="Zapper QR code for donating to Souper Troopers" width={480} widths={[240, 480]} sizes="200px" />
					<a class="btn btn-outline-teal" href={zapperUrl} target="_blank" rel="noopener">Open Zapper &rarr;</a>
				</div>
				<div class="card">
					<div class="payment-method-header">
						<svg class="payment-icon payment-icon-paypal" viewBox="0 0 24 24" aria-hidden="true"><path d="M7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944.901C5.026.382 5.474 0 5.998 0h7.46c2.57 0 4.578.543 5.69 1.81 1.01 1.15 1.304 2.42 1.012 4.287-.023.143-.047.288-.077.437-.983 5.05-4.349 6.797-8.647 6.797h-2.19c-.524 0-.968.382-1.05.9l-1.12 7.106zm14.146-14.42a3.35 3.35 0 0 0-.607-.541c-.013.076-.026.153-.041.232-.591 3.031-2.412 5.11-5.744 6.024a13.15 13.15 0 0 1-3.494.462h-2.14l-.564 3.573h4.02c.524 0 .968-.382 1.05-.9l.043-.222.812-5.156.052-.28c.082-.518.526-.9 1.05-.9h.66c4.291 0 7.646-1.744 8.63-6.788.031-.16.058-.316.083-.47.026-.161.038-.32.036-.478z" /></svg>
						<h3>Card - international</h3>
					</div>
					<p>Donating from outside South Africa? PayPal handles non-SA cards and PayPal balances.</p>
					<a class="btn btn-outline-teal" href="https://www.paypal.com/donate/?hosted_button_id=ZLTV4BYWFALX2" target="_blank" rel="noopener">Donate via PayPal &rarr;</a>
				</div>
				<div class="card">
					<div class="payment-method-header">
						<svg class="payment-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 6V3L8 7l4 4V8c2.21 0 4 1.79 4 4 0 .82-.25 1.58-.67 2.22l1.46 1.46A5.98 5.98 0 0 0 18 12c0-3.31-2.69-6-6-6zm-6 6c0-.82.25-1.58.67-2.22L5.21 8.32A5.98 5.98 0 0 0 4 12c0 3.31 2.69 6 6 6v3l4-4-4-4v3c-2.21 0-4-1.79-4-4z" /></svg>
						<h3>Monthly debit order</h3>
					</div>
					<p>Give a set amount each month from a South African bank account - the most useful kind of gift, because it lets us plan.</p>
					<a class="btn btn-outline-teal" href="https://st.paysoftimpact.co.za/public/api/Template/Index/?id=26" target="_blank" rel="noopener">Set up a debit order &rarr;</a>
					<p class="redirect-note">You'll be securely redirected to PaySoftImpact to set this up.</p>
				</div>
				<div class="card">
					<div class="payment-method-header">
						<svg class="payment-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h8v8H3V3zm2 2v4h4V5H5zm8-2h8v8h-8V3zm2 2v4h4V5h-4zM3 13h8v8H3v-8zm2 2v4h4v-4H5zm10-2h2v2h-2v-2zm4 0h2v2h-2v-2zm-4 4h2v2h-2v-2zm4 0h2v2h-2v-2zm-2 4h2v2h-2v-2z" /></svg>
						<h3>SnapScan</h3>
					</div>
					<p>Scan the code with the SnapScan app, or tap through if you're already on your phone.</p>
					<Image class="pay-qr" src={snapscanQr} alt="SnapScan QR code for donating to Souper Troopers" width={480} widths={[240, 480]} sizes="200px" />
					<a class="btn btn-outline-teal" href="https://pos.snapscan.io/qr/V0w6Ewn7" target="_blank" rel="noopener">Open SnapScan &rarr;</a>
				</div>
			</div>
			<p style="font-size:0.9rem; color: rgba(36, 35, 43, 0.65);">
			Questions about giving? Email <EmailLink client:visible address="manager@soupertroopers.org" />.
		</p>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">Prefer to give another way?</span>
			<h2>Goods and products also help</h2>
		</div>
		<div class="grid grid-2 giving-grid">
			<div class="card"><h3>Donate goods</h3><p>Food, clothing, household items, and materials for African Worry Dolls.</p><a href="/get-involved/donate-goods">See the full list &rarr;</a></div>
			<div class="card"><h3>Shop with purpose</h3><p>Troopers Coffee and African Worry Dolls&trade; fund jobs directly.</p><a href="/shop">Shop &rarr;</a></div>
		</div>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">Common questions</span>
			<h2>Questions donors ask</h2>
		</div>
		<Faq items={faqItems} />
	</section>
</Layout>

<style>
	.payfast-thanks {
		margin-top: var(--space-4);
		font-weight: 600;
	}

	/* .card is already a flex column (see Layout.astro); grid rows stretch both cards to the
	   same height by default, so pushing the link down with margin-top: auto is enough to align
	   both links to the bottom regardless of how much body copy each card has. */
	.giving-grid a {
		margin-top: auto;
	}
</style>

<script>
	// PayFast's Pay Now form returns here with ?donated=1 (see payfastReturnUrl in the frontmatter).
	// Reveal the thank-you line, then drop the param so a refresh or share doesn't repeat it.
	if (new URLSearchParams(location.search).get("donated") === "1") {
		document.querySelector<HTMLElement>("#payfast-thanks")?.removeAttribute("hidden");
		history.replaceState(null, "", location.pathname);
	}
</script>
