---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Donate" description="Support the CAST programme — donation options for Souper Troopers.">
	<section class="page-hero">
		<div class="wrap">
			<h1>Donate</h1>
			<p>Every donation funds a step in someone's CAST journey — from a first conversation to a first pay cheque.</p>
		</div>
	</section>

	<section class="section wrap">
		<div class="grid grid-3">
			<div class="stat"><strong>1,700+</strong><span>lives supported since 2014</span></div>
			<div class="stat"><strong>77%</strong><span>employment success in the latest CAST intake</span></div>
			<div class="stat"><strong>Section 18A</strong><span>certificates available for donations</span></div>
		</div>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">Where it goes</span>
			<h2>What your donation funds</h2>
			<p>Not admin overhead — the direct, practical costs of one person's CAST journey.</p>
		</div>
		<div class="grid grid-4">
			<div class="stat"><span>Transport to appointments and training</span></div>
			<div class="stat"><span>Course &amp; skills training fees</span></div>
			<div class="stat"><span>ID document costs</span></div>
			<div class="stat"><span>Care packs for essential needs</span></div>
		</div>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">Ways to give</span>
			<h2>Choose the method that works for you</h2>
		</div>
		<div class="grid grid-2">
			<div class="card">
				<h3>Direct EFT</h3>
				<p>
					Our preferred method. Once you've made the transfer, email your proof of payment to
					<a href="mailto:info@soupertroopers.org">info@soupertroopers.org</a> so we can issue your
					Section 18A certificate.
				</p>
			</div>
			<div class="card">
				<h3>SnapScan</h3>
				<p>Scan or tap to pay instantly from your phone.</p>
				<a class="btn btn-primary" href="https://pos.snapscan.io/qr/V0w6Ewn7" target="_blank" rel="noopener">Donate via SnapScan &rarr;</a>
			</div>
			<div class="card">
				<h3>PayPal</h3>
				<p>Card or PayPal balance, once-off.</p>
				<a class="btn btn-primary" href="https://www.paypal.com/donate/?hosted_button_id=ZLTV4BYWFALX2" target="_blank" rel="noopener">Donate via PayPal &rarr;</a>
			</div>
			<div class="card">
				<h3>Monthly giving</h3>
				<p>Set up a recurring monthly donation to sustain the CAST programme.</p>
				<a class="btn btn-primary" href="https://st.paysoftimpact.co.za/public/api/Template/Index/?id=26" target="_blank" rel="noopener">Give monthly &rarr;</a>
			</div>
		</div>
		<p style="margin-top:2rem; font-size:0.9rem; color: rgba(36,35,43,0.6);">
			Questions about giving? Email <a href="mailto:manager@soupertroopers.org">manager@soupertroopers.org</a>.
		</p>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">Prefer to give another way?</span>
			<h2>Goods and products also help</h2>
		</div>
		<div class="grid grid-2">
			<div class="card"><h3>Donate goods</h3><p>Food, clothing, household items, and materials for African Worry Dolls.</p><a href="/get-involved">See the full list &rarr;</a></div>
			<div class="card"><h3>Shop with purpose</h3><p>Troopers Coffee and African Worry Dolls&trade; fund jobs directly.</p><a href="/shop">Shop &rarr;</a></div>
		</div>
	</section>
</Layout>
