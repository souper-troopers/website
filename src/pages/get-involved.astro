---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import foodPhoto from "../assets/images/goods/food.jpg";
import toiletriesPhoto from "../assets/images/goods/toiletries.jpg";
import clothingPhoto from "../assets/images/goods/clothing.jpg";
import linenPhoto from "../assets/images/goods/linen.jpg";
import householdPhoto from "../assets/images/goods/household.jpg";
import craftPhoto from "../assets/images/goods/craft.jpg";
import cleaningPhoto from "../assets/images/goods/cleaning.jpg";
import electronicsPhoto from "../assets/images/goods/electronics.jpg";

const goodsCategories = [
	{ label: "Non-perishable food", photo: foodPhoto },
	{ label: "Toiletries", photo: toiletriesPhoto },
	{ label: "Clothing (all seasons)", photo: clothingPhoto },
	{ label: "Linen & bedding", photo: linenPhoto },
	{ label: "Household goods", photo: householdPhoto },
	{ label: "Materials for African Worry Dolls", photo: craftPhoto },
	{ label: "Cleaning products", photo: cleaningPhoto },
	{ label: "Electronics", photo: electronicsPhoto },
];
---

<Layout title="Get Involved" description="Ways to support Souper Troopers — for individuals and businesses.">
	<section class="page-hero">
		<div class="wrap">
			<h1>Get Involved</h1>
			<p>There's a way to help whatever you have to give — time, goods, money, or a partnership.</p>
		</div>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">Individuals</span>
			<h2>Ways to help, person to person</h2>
		</div>
		<div class="grid grid-4">
			<div class="card"><h3>Donate money</h3><p>Fund CAST directly.</p><a href="/donate">Donate &rarr;</a></div>
			<div class="card"><h3>Donate goods</h3><p>Food, clothing, and more — see the full list below.</p></div>
			<div class="card"><h3>Volunteer</h3><p>Give your time and skills.</p><a href="mailto:manager@soupertroopers.org">Get in touch &rarr;</a></div>
			<div class="card"><h3>Buy products</h3><p>Coffee and worry dolls that fund jobs.</p><a href="/shop">Shop &rarr;</a></div>
		</div>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">Goods donation list</span>
			<h2>What you can donate</h2>
			<p>Every item helps — drop off at 66 Newmarket Street, Woodstock, Cape Town. Section 18A certificates are available for donated goods. Email <a href="mailto:manager@soupertroopers.org">manager@soupertroopers.org</a> to arrange.</p>
		</div>
		<div class="grid grid-4">
			{goodsCategories.map((item) => (
				<a class="goods-tile" href={`mailto:manager@soupertroopers.org?subject=${encodeURIComponent(`Donation drop-off: ${item.label}`)}`}>
					<Image src={item.photo} alt="" role="presentation" class="goods-tile-img" widths={[300, 500]} sizes="(min-width: 700px) 260px, 45vw" />
					<div class="goods-tile-scrim"></div>
					<span>{item.label}</span>
				</a>
			))}
		</div>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">Businesses</span>
			<h2>Corporate partnership</h2>
		</div>
		<div class="grid grid-4">
			<div class="card"><h3>Partner with us</h3><p>Long-term collaboration on shared outcomes — like our Woolworths Project, upskilling Troopers and creating job opportunities.</p></div>
			<div class="card"><h3>B-BBEE points</h3><p>Buy Troopers Coffee or donate — both count. Souper Troopers is B-BBEE Level 1.</p></div>
			<div class="card"><h3>Donate goods</h3><p>Office electronics, furniture, and supplies.</p></div>
			<div class="card"><h3>Sponsor a programme</h3><p>Fund a specific part of CAST or the Humanity Hub.</p></div>
		</div>
		<p style="margin-top:2rem;">Interested in partnering? Email <a href="mailto:manager@soupertroopers.org">manager@soupertroopers.org</a>. Financial donations come with Section 18A tax certificates.</p>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">Fundraise for us</span>
			<h2>Run your own fundraiser</h2>
			<p>Prefer to rally your own community? Here are a few ways to do it.</p>
		</div>
		<div class="grid grid-3">
			<div class="card"><h3>Host an event</h3><p>A dinner, a challenge, a sale — anything that gets people talking and giving.</p></div>
			<div class="card"><h3>Fundraise at work</h3><p>Team challenges, casual days, or a workplace giving campaign.</p></div>
			<div class="card"><h3>Fundraise at school</h3><p>Get learners involved in a cause close to home.</p></div>
		</div>
		<p style="margin-top:2rem;">Have an idea? Email <a href="mailto:manager@soupertroopers.org">manager@soupertroopers.org</a> and we'll help you get started.</p>
	</section>
</Layout>
