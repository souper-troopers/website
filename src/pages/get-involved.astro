---
import Layout from "../layouts/Layout.astro";
import EmailLink from "../components/EmailLink.svelte";
import { Image } from "astro:assets";
import foodPhoto from "../assets/images/goods/food.jpg";
import toiletriesPhoto from "../assets/images/goods/toiletries.jpg";
import clothingPhoto from "../assets/images/goods/clothing.jpg";
import linenPhoto from "../assets/images/goods/linen.jpg";
import householdPhoto from "../assets/images/goods/household.jpg";
import craftPhoto from "../assets/images/goods/craft.jpg";
import cleaningPhoto from "../assets/images/goods/cleaning.jpg";
import electronicsPhoto from "../assets/images/goods/electronics.jpg";
import { getBbbeeBenefits, getSiteSettings } from "../lib/sanity";
import individualsPhoto from "../assets/images/support-one-to-one.jpg";
import businessesPhoto from "../assets/images/partner-visit.jpg";

const bbbeeBenefits = await getBbbeeBenefits();
const settings = await getSiteSettings();
const bbbeeVerified = settings?.bbbeeLastVerified
	? new Date(settings.bbbeeLastVerified).toLocaleDateString("en-ZA", {
			day: "numeric",
			month: "long",
			year: "numeric",
		})
	: null;

const goodsCategories = [
	{ label: "Non-perishable food", photo: foodPhoto },
	{ label: "Toiletries", photo: toiletriesPhoto },
	{ label: "Clothing (all seasons)", photo: clothingPhoto },
	{ label: "Linen & bedding", photo: linenPhoto },
	{ label: "Household goods", photo: householdPhoto },
	{ label: "Materials for African Worry Dolls", photo: craftPhoto },
	{ label: "Cleaning products", photo: cleaningPhoto },
	{ label: "Electronics", photo: electronicsPhoto },
];
---

<Layout title="Volunteer, donate goods, or partner" description="Volunteer, drop goods at our Humanity Hub in Woodstock, or partner as a business - practical support for people experiencing homelessness in Cape Town.">
	<section class="page-hero">
		<div class="wrap">
			<h1>Get Involved</h1>
			<p>There's a way to help whatever you have to give - time, goods, money, or a partnership.</p>
		</div>
	</section>

	<section class="gi-group" id="individuals-band">
		<div class="wrap">
			<div class="gi-group-box">
			<div class="gi-band-media shimmer-up">
				<Image
					src={individualsPhoto}
					alt="A volunteer showing a Souper Squad member a technique, one to one"
					class="gi-band-img"
					width={1200} widths={[700, 1200]}
					sizes="(min-width: 1100px) 1060px, 100vw"
					onload="this.classList.add('is-loaded')"
				/>
				<div class="gi-band-scrim"></div>
				<div class="gi-band-text">
					<h2>For individuals</h2>
					<p>Give time, goods or money - and every route starts with something you already have.</p>
				</div>
			</div>
				<div class="gi-group-body">

	<section id="individuals" class="section wrap">
		<div class="section-intro">
			<h2>Ways to help, person to person</h2>
		</div>
		<div class="grid grid-3 action-grid">
			<a class="card action-card" href="/donate">
				<h3>Donate money</h3>
				<p>Fund the CAST programme directly - from a first conversation to a first pay cheque.</p>
				<span class="action-cta">Donate &rarr;</span>
			</a>
			<a class="card action-card" href="#goods">
				<h3>Donate goods</h3>
				<p>Food, toiletries, clothing, bedding, and more. Drop-offs welcome at the Humanity Hub.</p>
				<span class="action-cta">See what we need &rarr;</span>
			</a>
			<a class="card action-card" href="/get-involved/volunteer">
				<h3>Volunteer</h3>
				<p>Sort donations, help run the Hub, or teach a skill. Individuals and groups, one-off or regular.</p>
				<span class="action-cta">What volunteers do &rarr;</span>
			</a>
			<a class="card action-card" href="/shop">
				<h3>Buy products</h3>
				<p>Troopers Coffee and African Worry Dolls&trade; - every order funds a job.</p>
				<span class="action-cta">Visit the shop &rarr;</span>
			</a>
			<!-- MySchool no longer exists: Woolworths merged it into MyDifference and stopped accepting
			     MySchool cards on 30 June 2026 (confirmed by Shan, 2026-08-25). The card previously here
			     asked supporters to swipe one, which is the worst kind of wrong copy - it fails silently
			     at the till rather than producing a complaint anyone can act on. Linked to Woolworths'
			     own MyDifference page rather than to a sign-up that names Souper Troopers, because no
			     such link has been confirmed to exist yet; the wording promises a search, not one tap. -->
			<a class="card action-card" href="https://www.woolworths.co.za/mydifference" target="_blank" rel="noopener">
				<h3>Choose us on Woolworths MyDifference</h3>
				<p>Pick Souper Troopers as one of your causes in the Woolies app, and a share of what you already spend comes to us - at no cost to you.</p>
				<span class="action-cta">How it works &rarr;</span>
			</a>
			<a class="card action-card" href="#fundraise">
				<h3>Fundraise for us</h3>
				<p>Turn a birthday, a race, or a workplace challenge into support for the Hub.</p>
				<span class="action-cta">See how &rarr;</span>
			</a>
		</div>
	</section>

	<section id="goods" class="section wrap">
		<details class="gi-fold">
			<summary>
			<h2>What you can donate</h2>
				<span class="gi-fold-hint" aria-hidden="true"></span>
			</summary>
			<div class="gi-fold-body">
			<p>Every item helps - drop off at 66 Newmarket Street, Woodstock, Cape Town. Section 18A certificates are available for donated goods. Email <EmailLink client:visible address="manager@soupertroopers.org" /> to arrange.</p>
		<div class="grid grid-4">
			{goodsCategories.map((item) => (
				<div class="goods-tile shimmer-up">
					<Image
						src={item.photo}
						alt=""
						role="presentation"
						class="goods-tile-img"
						width={500} widths={[300, 500]}
						sizes="(min-width: 700px) 260px, 45vw"
						onload="this.classList.add('is-loaded')"
					/>
					<div class="goods-tile-scrim"></div>
					<span>{item.label}</span>
				</div>
			))}
		</div>
		{/* The grid stays here as the visual answer to "what can I bring". The page below is the
		    practical one - where, when, how it is arranged - and is what a search for "donate
		    clothes Cape Town" should land on. */}
		<p class="section-more">
			<a href="/get-involved/donate-goods">Where to bring it and how to arrange a drop-off &rarr;</a>
		</p>
			</div>
		</details>
	</section>

	<section id="fundraise" class="section wrap">
		<details class="gi-fold">
			<summary>
			<h2>Run your own fundraiser</h2>
				<span class="gi-fold-hint" aria-hidden="true"></span>
			</summary>
			<div class="gi-fold-body">
			<p>
				A birthday, a race, a workplace challenge, a school drive - anything can become a
				fundraiser. Three steps, and you don't need anything from us to start.
			</p>
		<div class="grid grid-3">
			<div class="card">
				<span class="step-number">1</span>
				<h3>Pick a platform</h3>
				<p>
					<a href="https://www.backabuddy.co.za" target="_blank" rel="noopener">BackaBuddy</a> and
					<a href="https://www.givengain.com" target="_blank" rel="noopener">GivenGain</a> both host
					South African fundraising campaigns and handle the payments for you.
				</p>
			</div>
			<div class="card">
				<span class="step-number">2</span>
				<h3>Set up your campaign</h3>
				<p>Register your event or milestone, choose Souper Troopers as the cause, and set a target.</p>
			</div>
			<div class="card">
				<span class="step-number">3</span>
				<h3>Share it</h3>
				<p>Send it to your people. Tag us and we'll share it too.</p>
			</div>
		</div>
		<p>Planning something? Email <EmailLink client:visible address="manager@soupertroopers.org" /> - we'll help however we can.</p>
			</div>
		</details>
	</section>

				</div>
			</div>
		</div>
	</section>

	<section class="gi-group" id="businesses-band">
		<div class="wrap">
			<div class="gi-group-box">
			<div class="gi-band-media shimmer-up">
				<Image
					src={businessesPhoto}
					alt="Kerry meeting a corporate partner at a Souper Troopers event"
					class="gi-band-img"
					width={1200} widths={[700, 1200]}
					sizes="(min-width: 1100px) 1060px, 100vw"
					onload="this.classList.add('is-loaded')"
				/>
				<div class="gi-band-scrim"></div>
				<div class="gi-band-text">
					<h2>For companies</h2>
					<p>Partner, sponsor, or book us - and see what it counts for on your scorecard.</p>
				</div>
			</div>
				<div class="gi-group-body">

	<section id="businesses" class="section wrap">
		<details class="gi-fold">
			<summary>
			<h2>Corporate partnership</h2>
				<span class="gi-fold-hint" aria-hidden="true"></span>
			</summary>
			<div class="gi-fold-body">
		<div class="grid grid-4">
			<div class="card"><h3>Partner with us</h3><p>Long-term collaboration on shared outcomes - like our Woolworths Project, upskilling Troopers and creating job opportunities.</p></div>
			<div class="card">
				<h3>Give what you already do</h3>
				<p>
					Skills and services go as far as cash: our accountants, lawyers, and web hosting are all
					donated. Marketing, IT, design, mentoring, training, delivery - if it's what your business
					does, we can probably use it.
				</p>
			</div>
			<div class="card"><h3>Donate goods</h3><p>Office electronics, furniture, and supplies.</p></div>
			<div class="card"><h3>Sponsor a programme</h3><p>Fund a specific part of CAST or the Humanity Hub.</p></div>
		</div>
		<p>Interested in partnering? Email <EmailLink client:visible address="manager@soupertroopers.org" />.</p>
		<p class="section-more">
			<a href="/get-involved/corporate-partnership">What a partnership looks like in practice &rarr;</a>
		</p>
			</div>
		</details>
	</section>

	<section class="section wrap">
		<details class="gi-fold">
			<summary>
			<h2>Two things you can book that fund the work</h2>
				<span class="gi-fold-hint" aria-hidden="true"></span>
			</summary>
			<div class="gi-fold-body">
			<p>
				Not everything here is a donation. These are things your business would spend money on
				anyway - the difference is where the money goes afterwards.
			</p>
		<div class="grid grid-2">
			<a class="card action-card" href="mailto:manager@soupertroopers.org?subject=Corporate%20workshop%20enquiry">
				<h3>Corporate workshops</h3>
				<p>
					Our Reconnection Workshops bring a team together around identity, reflection, and
					emotional wellbeing - facilitated by Jake Gluckman, a registered counsellor on our staff.
					Voltalia recently hosted one for their team.
				</p>
				<p>
					Every workshop directly funds the programmes at the Humanity Hub: skills development and
					daily meals, transport to interviews, interview clothing, and healthcare as basic and as
					decisive as an eye test or a set of dentures.
				</p>
				<span class="action-cta">Enquire about a workshop &rarr;</span>
			</a>
			<a class="card action-card" href="/shop">
				<h3>Coffee for your workplace</h3>
				<p>
					Troopers Coffee - our Dignity Blend - is available as a standing order for offices,
					guesthouses, and Airbnbs, not just as a one-off gift. The Lab Blue in Franschhoek serves
					it to guests at sunrise.
				</p>
				<p>
					Every bag funds the jobs behind it: the Souper Squad members who pack and sell it. And
					because we're a B-BBEE Level 1 contributor, it counts as preferential procurement spend
					on your scorecard.
				</p>
				<span class="action-cta">See the coffee &rarr;</span>
			</a>
		</div>
			</div>
		</details>
	</section>

	{bbbeeBenefits.length > 0 && (
		<section class="section wrap">
			<details class="gi-fold">
				<summary>
				<h2>Supporting us counts on your scorecard</h2>
					<span class="gi-fold-hint" aria-hidden="true"></span>
				</summary>
				<div class="gi-fold-body">
				<p>
					Souper Troopers is a B-BBEE Level 1 contributor and a registered PBO, so working with us
					is measurable on both your scorecard and your tax return.
				</p>
			<div class="grid grid-4">
				{bbbeeBenefits.map((benefit) => (
					<div class="card">
						{benefit.value && <span class="benefit-value">{benefit.value}</span>}
						<h3>{benefit.title}</h3>
						<p>{benefit.body}</p>
					</div>
				))}
			</div>
			{(settings?.bbbeeNote || bbbeeVerified) && (
				<p class="benefit-note">
					{settings?.bbbeeNote}
					{bbbeeVerified && <span class="benefit-verified">Last verified {bbbeeVerified}.</span>}
				</p>
			)}
				</div>
			</details>
		</section>
	)}

				</div>
			</div>
		</div>
	</section>

</Layout>
<script>
	/**
	 * The detail sections collapse, and several links point straight at them - the action cards at
	 * the top use #goods and #fundraise, and the header/footer may too. A closed <details> would
	 * scroll into view showing only its heading, which reads as a dead link rather than as a
	 * section that needs opening.
	 *
	 * Chrome opens a <details> when the hash targets something *inside* it, but here the id sits on
	 * the <section> wrapping it, and Safari and Firefox are less consistent - so this is done
	 * explicitly rather than relied upon.
	 */
	function openTarget() {
		if (!location.hash) return;
		const target = document.querySelector(location.hash);
		if (!target) return;
		const fold = (target.querySelector("details.gi-fold") ??
			target.closest("details.gi-fold")) as HTMLDetailsElement | null;
		if (fold && !fold.open) {
			fold.open = true;
			// Re-run the jump: the anchor was resolved against the collapsed height.
			requestAnimationFrame(() => target.scrollIntoView());
		}
	}

	openTarget();
	window.addEventListener("hashchange", openTarget);
</script>


<style>
	/* --- Audience jump bar and bands (2026-09-07) -----------------------------------------------
	   The page opened with six action cards and left the reader to work out which applied to them.
	   It now names the two audiences, which is what Adrian argued for and what Kerry meant by
	   speaking differently to each one.

	   ⚠ The bands are the hierarchy here, so they are the only thing at this level that carries
	   weight. An earlier pass put two large cards at the top *and* headings below, which repeated
	   both labels word for word - and the section chips ("Individuals", "Businesses") repeated them
	   a third time. The chips are gone and the chooser is now a slim bar; the band is the heading. */
	/* Each audience is one box: banner across the top, its sections inside. Before this the two
	   groups were only separated by whitespace, so on a long page it was easy to lose track of which
	   audience you were reading - the fold headings all look alike once the chips are gone. */
	.gi-group-box {
		/* ⚠ Not white. The cards inside are white, and on a white box they vanished into it - only
		   their shadow gave them an edge. Tinted to the page ground instead, so the box is defined by
		   its border and banner while the cards keep reading as cards. */
		background: var(--st-bg);
		border: 1px solid rgba(36, 35, 43, 0.12);
		border-radius: 20px;
		overflow: hidden;
	}

	.gi-group-body {
		padding: var(--space-4) var(--space-5) var(--space-6);
	}

	/* The sections inside still carry `.wrap`, which would apply a second max-width and a second set
	   of side padding within a container that already has both. Neutralised rather than stripped off
	   the markup, so the sections stay usable on their own if they are ever moved back out. */
	.gi-group-body :global(.section.wrap) {
		max-width: none;
		margin-left: 0;
		margin-right: 0;
		padding-left: 0;
		padding-right: 0;
	}

	/* The banner sits flush inside the box, so it loses its own rounding to the box's. */
	.gi-group-box .gi-band-media {
		border-radius: 0;
	}

	.gi-band {

		padding-top: var(--space-6);
	}

	.gi-band-media {
		position: relative;
		border-radius: 18px;
		overflow: hidden;
		/* ⚠ `width: 100%` is load-bearing, not tidiness. With `aspect-ratio` set and no explicit
		   width, a `min-height` makes the browser derive the *width* from the height instead - at
		   390px this rendered a 570px-wide banner and pushed the whole page 200px sideways. The
		   ratio changes at the breakpoint rather than a minimum height being imposed. */
		width: 100%;
		aspect-ratio: 16 / 9;
	}

	@media (min-width: 700px) {
		/* Short and wide once there is room: this is a banner, not a photograph to study, and a tall
		   one would push the content it introduces off the screen. */
		.gi-band-media {
			aspect-ratio: 3 / 1;
		}
	}

	.gi-band-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* Left-weighted so the text sits on the darkest part and the photograph survives on the right. */
	.gi-band-scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			100deg,
			rgba(24, 23, 30, 0.82) 0%,
			rgba(24, 23, 30, 0.62) 40%,
			rgba(24, 23, 30, 0.12) 74%,
			rgba(24, 23, 30, 0) 100%
		);
	}

	.gi-band-text {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: var(--space-2);
		padding: var(--space-5);
		max-width: 34rem;
	}

	.gi-band-text h2 {
		margin: 0;
		color: #fff;
		font-size: clamp(1.6rem, 3.4vw, 2.3rem);
		line-height: 1.1;
	}

	.gi-band-text p {
		margin: 0;
		color: rgba(255, 255, 255, 0.86);
		max-width: 32ch;
	}

	/* --- Folds ---------------------------------------------------------------------------------
	   Adrian asked for the detail to expand rather than all of it being on screen at once, and this
	   is the clearest instance of the "less copy" decision: nothing is deleted, it is simply not all
	   shown. It also keeps every word in the page for search engines, which a deletion would not. */
	/* A hairline above each fold inside a box: without it the collapsed headings sat directly under
	   the card grid and read as stray lines rather than as sections you can open. */
	.gi-group-body :global(.section) + :global(.section) .gi-fold {
		border-top: 1px solid rgba(36, 35, 43, 0.12);
		padding-top: var(--space-2);
	}

	.gi-fold > summary {
		list-style: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-3);
		padding: var(--space-3) 0;
	}

	.gi-fold > summary::-webkit-details-marker {
		display: none;
	}

	.gi-fold > summary h2 {
		margin: 0;
		flex: 1 1 auto;
	}

	.gi-fold > summary:hover h2 {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	/* Chevron drawn in CSS so it needs no icon and rotates with the state. */
	.gi-fold-hint {
		flex: 0 0 auto;
		width: 12px;
		height: 12px;
		border-right: 2px solid rgba(36, 35, 43, 0.55);
		border-bottom: 2px solid rgba(36, 35, 43, 0.55);
		transform: rotate(45deg) translate(-2px, -2px);
		transition: transform 120ms ease;
	}

	.gi-fold[open] > summary .gi-fold-hint {
		transform: rotate(-135deg) translate(-2px, -2px);
	}

	.gi-fold-body {
		padding-top: var(--space-3);
	}

	@media (prefers-reduced-motion: reduce) {
		.gi-fold-hint {
			transition: none;
		}
	}

	@media (min-width: 780px) {
		.gi-chooser {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	/* The route from a summary section down to its own page. Deliberately a plain underlined link
	   rather than a button: these navigate, and the button system on this site is reserved for
	   controls that act (see "The button system" in AGENTS.md). */
	.section-more {
		margin-top: var(--space-4);
		font-weight: 600;
	}

	/* Whole-card links with the CTA pinned to the bottom, so a row of six reads as six equal
	   choices rather than six boxes whose links happen to sit at different heights. */
	/* Exactly six items, so pin to three columns for a balanced 3+3 rather than letting auto-fit
	   make it 4+2 with two empty slots. */
	@media (min-width: 901px) {
		.action-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.action-card {
		text-decoration: none;
		color: inherit;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	.action-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 18px 36px rgba(0, 0, 0, 0.09);
	}

	.action-card p {
		margin-bottom: var(--space-4);
	}

	.action-cta {
		margin-top: auto;
		font-weight: 700;
		color: var(--st-teal-dark);
	}

	.action-card:hover .action-cta {
		text-decoration: underline;
	}

	@media (prefers-reduced-motion: reduce) {
		.action-card {
			transition: none;
		}

		.action-card:hover {
			transform: none;
		}
	}

	.step-number {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: var(--st-teal);
		color: var(--st-white);
		font-weight: 700;
	}

	/* Ink, not teal-dark — a static figure, not something you can act on. */
	.benefit-value {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--st-ink);
		line-height: 1.1;
	}

	.benefit-note {
		font-size: 0.85rem;
		line-height: 1.7;
		color: rgba(36, 35, 43, 0.65);
		max-width: 78ch;
	}

	.benefit-verified {
		display: block;
		margin-top: 0.35rem;
		font-weight: 600;
	}
</style>
