---
import FlipCard from "../components/FlipCard.astro";
import CardCtaLabel from "../components/CardCtaLabel.astro";
import Layout from "../layouts/Layout.astro";
import PhotoHero from "../components/PhotoHero.astro";
import volunteerDayPhoto from "../assets/images/volunteer-day.jpg";
import EmailLink from "../components/EmailLink.svelte";
import { Image } from "astro:assets";
import foodPhoto from "../assets/images/goods/food.jpg";
import toiletriesPhoto from "../assets/images/goods/toiletries.jpg";
import clothingPhoto from "../assets/images/goods/clothing.jpg";
import linenPhoto from "../assets/images/goods/linen.jpg";
import householdPhoto from "../assets/images/goods/household.jpg";
import craftPhoto from "../assets/images/goods/craft.jpg";
import cleaningPhoto from "../assets/images/goods/cleaning.jpg";
import electronicsPhoto from "../assets/images/goods/electronics.jpg";
import { getBbbeeBenefits, getSiteSettings } from "../lib/sanity";
import individualsPhoto from "../assets/images/support-one-to-one.jpg";
import businessesPhoto from "../assets/images/partner-visit.jpg";

const bbbeeBenefits = await getBbbeeBenefits();
const settings = await getSiteSettings();
const bbbeeVerified = settings?.bbbeeLastVerified
	? new Date(settings.bbbeeLastVerified).toLocaleDateString("en-ZA", {
			day: "numeric",
			month: "long",
			year: "numeric",
		})
	: null;

const goodsCategories = [
	{ label: "Non-perishable food", photo: foodPhoto },
	{ label: "Toiletries", photo: toiletriesPhoto },
	{ label: "Clothing (all seasons)", photo: clothingPhoto },
	{ label: "Linen & bedding", photo: linenPhoto },
	{ label: "Household goods", photo: householdPhoto },
	{ label: "Materials for African Worry Dolls", photo: craftPhoto },
	{ label: "Cleaning products", photo: cleaningPhoto },
	{ label: "Electronics", photo: electronicsPhoto },
];
---

<Layout title="Volunteer, donate goods, or partner" description="Volunteer, drop goods at our Humanity Hub in Woodstock, or partner as a business - practical support for people experiencing homelessness in Cape Town." heroOverlay>
	<PhotoHero image={volunteerDayPhoto} size="page" position="center 40%">
		<h1>Get Involved</h1>
		<p>There's a way to help whatever you have to give - time, goods, money, or a partnership.</p>
	</PhotoHero>

	{/* Two photo-top cards, side by side from 761px (decided 25 September): the page was three
	    text-on-photo blocks in a row - the hero and two banners - so the hero stopped reading as the
	    hero. Each card's <details> holds only its <summary> (photo, title, "See how"); its content is
	    the region straight after the card, shown by CSS `:has()` while that <details> is open. That is
	    what lets an opened card drop its content full width beneath the pair instead of growing one
	    column - a <details> body cannot be positioned outside its own box. DOM order is card, body,
	    card, body, so on a phone the content opens right under its card and the heading outline stays
	    h2 > h3. No JavaScript needed to open or close; the script below only handles anchors. */}
	<section class="section wrap gi-groups">
		<div class="card card-cta gi-card" id="individuals-band">
			<details class="gi-group-box" id="gi-individuals">
				<summary class="gi-group-summary">
					<span class="gi-card-media shimmer-up">
						<Image
							src={individualsPhoto}
							alt="A volunteer showing a Souper Squad member a technique, one to one"
							class="gi-card-img"
							width={1200} widths={[600, 1200]}
							sizes="(min-width: 761px) 540px, 100vw"
							onload="this.classList.add('is-loaded')"
						/>
					</span>
					<span class="gi-card-head">
						<h2 id="gi-individuals-title">For individuals</h2>
						<span class="gi-group-cue"><span class="gi-group-cue-text">See how</span><span class="gi-group-cue-mark" aria-hidden="true"></span></span>
					</span>
				</summary>
			</details>
			<div class="gi-card-text">
				<p>Give time, goods or money - and every route starts with something you already have.</p>
				<nav class="gi-routes" aria-label="Ways to help, person to person">
					<a class="card-cta-action" href="/donate">Donate money</a>
					<a class="card-cta-action" href="/get-involved/donate-goods/">Donate goods</a>
					<a class="card-cta-action" href="/get-involved/volunteer/">Volunteer</a>
					<a class="card-cta-action" href="/shop">Shop</a>
					<a class="card-cta-action" href="#fundraise">Fundraise</a>
				</nav>
			</div>
		</div>
		<div class="gi-group-body gi-body-individuals" role="region" aria-labelledby="gi-individuals-title" data-for="gi-individuals">

	<section id="individuals" class="section wrap">
		<div class="section-intro">
			<h3>Ways to help, person to person</h3>
		</div>
		<div class="grid grid-3 action-grid">
			<a class="card card-cta action-card" href="/donate">
				<h3>Donate money</h3>
				<p>Fund the CAST programme directly - from a first conversation to a first pay cheque.</p>
				<CardCtaLabel>Donate</CardCtaLabel>
			</a>
			<a class="card card-cta action-card" href="#goods">
				<h3>Donate goods</h3>
				<p>Food, toiletries, clothing, bedding, and more. Drop-offs welcome at the Humanity Hub.</p>
				<CardCtaLabel>See what we need</CardCtaLabel>
			</a>
			<a class="card card-cta action-card" href="/get-involved/volunteer">
				<h3>Volunteer</h3>
				<p>Sort donations, help run the Hub, or teach a skill. Individuals and groups, one-off or regular.</p>
				<CardCtaLabel>What volunteers do</CardCtaLabel>
			</a>
			<a class="card card-cta action-card" href="/shop">
				<h3>Buy products</h3>
				<p>Troopers Coffee and African Worry Dolls&trade; - every order funds a job.</p>
				<CardCtaLabel>Visit the shop</CardCtaLabel>
			</a>
			<!-- MySchool no longer exists: Woolworths merged it into MyDifference and stopped accepting
			     MySchool cards on 30 June 2026 (confirmed by Shan, 2026-08-25). The card previously here
			     asked supporters to swipe one, which is the worst kind of wrong copy - it fails silently
			     at the till rather than producing a complaint anyone can act on. Linked to Woolworths'
			     own MyDifference page rather than to a sign-up that names Souper Troopers, because no
			     such link has been confirmed to exist yet; the wording promises a search, not one tap. -->
			<a class="card card-cta action-card" href="https://www.woolworths.co.za/mydifference" target="_blank" rel="noopener">
				<h3>Choose us on Woolworths MyDifference</h3>
				<p>Pick Souper Troopers as one of your causes in the Woolies app, and a share of what you already spend comes to us - at no cost to you.</p>
				<CardCtaLabel>How it works</CardCtaLabel>
			</a>
			<a class="card card-cta action-card" href="#fundraise">
				<h3>Fundraise for us</h3>
				<p>Turn a birthday, a race, or a workplace challenge into support for the Hub.</p>
				<CardCtaLabel>See how</CardCtaLabel>
			</a>
		</div>
	</section>

	<section id="goods" class="section wrap">
					<div class="section-intro">
						<h3>What you can donate</h3>
					</div>
			{/* Same order as the partnership line below: context, then the way on, then the address to
			    write to. The link is the low-commitment step and belongs before the email. */}
			<p>Every item helps - drop off at <a href="/contact">66 Newmarket Street, Woodstock, Cape Town</a>, and Section 18A certificates are available for donated goods. <a class="gi-sub-link" href="/get-involved/donate-goods">Where to bring it &rarr;</a> For more info, email <EmailLink client:visible address="manager@soupertroopers.org" /> to arrange.</p>
		<div class="grid grid-4">
			{goodsCategories.map((item) => (
				<div class="goods-tile shimmer-up">
					<Image
						src={item.photo}
						alt=""
						role="presentation"
						class="goods-tile-img"
						width={500} widths={[300, 500]}
						sizes="(min-width: 700px) 260px, 45vw"
						onload="this.classList.add('is-loaded')"
					/>
					<span>{item.label}</span>
				</div>
			))}
		</div>
	</section>

	<section id="fundraise" class="section wrap">
					<div class="section-intro">
						<h3>Run your own fundraiser</h3>
					</div>
			<p>
				A birthday, a race, a workplace challenge, a school drive - anything can become a
				fundraiser. Three steps, and you don't need anything from us to start. Planning
				something? Email <EmailLink client:visible address="manager@soupertroopers.org" /> and
				we'll help however we can.
			</p>
		<div class="grid grid-3">
			<div class="card">
				<span class="step-number">1</span>
				<h3>Pick a platform</h3>
				<p>
					<a href="https://www.backabuddy.co.za" target="_blank" rel="noopener">BackaBuddy</a> and
					<a href="https://www.givengain.com" target="_blank" rel="noopener">GivenGain</a> both host
					South African fundraising campaigns and handle the payments for you.
				</p>
			</div>
			<div class="card">
				<span class="step-number">2</span>
				<h3>Set up your campaign</h3>
				<p>Register your event or milestone, choose Souper Troopers as the cause, and set a target.</p>
			</div>
			<div class="card">
				<span class="step-number">3</span>
				<h3>Share it</h3>
				<p>Send it to your people. Tag us and we'll share it too.</p>
			</div>
		</div>
	</section>

		</div>
		<div class="card card-cta gi-card" id="businesses-band">
			<details class="gi-group-box" id="gi-businesses">
				<summary class="gi-group-summary">
					<span class="gi-card-media shimmer-up">
						<Image
							src={businessesPhoto}
							alt="Kerry meeting a corporate partner at a Souper Troopers event"
							class="gi-card-img"
							width={1200} widths={[600, 1200]}
							sizes="(min-width: 761px) 540px, 100vw"
							onload="this.classList.add('is-loaded')"
						/>
					</span>
					<span class="gi-card-head">
						<h2 id="gi-businesses-title">For companies</h2>
						<span class="gi-group-cue"><span class="gi-group-cue-text">See how</span><span class="gi-group-cue-mark" aria-hidden="true"></span></span>
					</span>
				</summary>
			</details>
			<div class="gi-card-text">
				<p>Partner, sponsor, or book us - and see what it counts for on your scorecard.</p>
				<nav class="gi-routes" aria-label="Ways to work with us">
					<a class="card-cta-action" href="/get-involved/corporate-partnership/">Partnership</a>
					<a class="card-cta-action" href="mailto:manager@soupertroopers.org?subject=Corporate%20workshop%20enquiry">Workshops</a>
					<a class="card-cta-action" href="/shop">Coffee</a>
				</nav>
			</div>
		</div>
		<div class="gi-group-body gi-body-businesses" role="region" aria-labelledby="gi-businesses-title" data-for="gi-businesses">

	<section id="businesses" class="section wrap">
					<div class="section-intro">
						<h3>Corporate partnership</h3>
					</div>
		{/* Above the cards, not below them: a lone line after a grid reads as a stranded footer, and
		    every other sub-section here now leads with its prose. */}
		<p>Interested in partnering? <a class="gi-sub-link" href="/get-involved/corporate-partnership">What this looks like in practice &rarr;</a> For more info, email <EmailLink client:visible address="manager@soupertroopers.org" /></p>
		<div class="grid grid-4">
			<div class="card"><h3>Partner with us</h3><p>Long-term collaboration on shared outcomes - like our Woolworths Project, upskilling Troopers and creating job opportunities.</p></div>
			<div class="card">
				<h3>Give what you already do</h3>
				{/* No "More" here: its detail was the corporate partnership page's card word for word, and
				    that page is linked just above. */}
				<p>Skills and services go as far as cash - if it's what your business does, we can probably use it.</p>
			</div>
			<div class="card"><h3>Donate goods</h3><p>Office electronics, furniture, and supplies.</p></div>
			<div class="card"><h3>Sponsor a programme</h3><p>Fund a specific part of CAST or the Humanity Hub.</p></div>
		</div>
	</section>

	<section class="section wrap">
					<div class="section-intro">
						<h3>Two things you can book that fund the work</h3>
					</div>
			<p>
				Not everything here is a donation. These are things your business would spend money on
				anyway - the difference is where the money goes afterwards.
			</p>
		<div class="grid grid-2">
			<a class="card card-cta action-card" href="mailto:manager@soupertroopers.org?subject=Corporate%20workshop%20enquiry">
				<h3>Corporate workshops</h3>
				{/* Trimmed from 74 words on 2026-09-13. The full version - what a workshop covers and
				    exactly what it funds - is on /get-involved/corporate-partnership/, linked from the
				    section above. A whole-card link cannot hold a "More" toggle inside it. */}
				<p>
					Reconnection Workshops for your team, facilitated by Jake Gluckman, a registered
					counsellor on our staff. Voltalia hosted one recently, and every workshop funds the work
					at the Humanity Hub.
				</p>
				<CardCtaLabel>Enquire about a workshop</CardCtaLabel>
			</a>
			<a class="card card-cta action-card" href="/shop">
				<h3>Coffee for your workplace</h3>
				<p>
					Our Dignity Blend as a standing order for your office or guesthouse. It pays the Souper
					Squad who pack it, and counts as preferential procurement on your B-BBEE scorecard.
				</p>
				<CardCtaLabel>See the coffee</CardCtaLabel>
			</a>
		</div>
	</section>

	{bbbeeBenefits.length > 0 && (
		<section class="section wrap">
					<div class="section-intro">
						<h3>Supporting us counts on your scorecard</h3>
					</div>
				<p>
					Souper Troopers is a B-BBEE Level 1 contributor and a registered PBO, so working with us
					is measurable on both your scorecard and your tax return.
				</p>
			{/* Flip cards, like the partner wall on Who We Are (25 September): the figure and title on
			    the front, how it counts on the back, turned by "How it counts" over the wedge. Was a
			    "How it counts" <details> that grew one card and pushed the row down. */}
			<ul class="benefit-grid">
				{bbbeeBenefits.map((benefit, i) => (
					benefit.body ? (
						<FlipCard as="li" id={`benefit-back-${i}`} label="How it counts" name={benefit.title}>
							<Fragment slot="front">
								{benefit.value && <span class="benefit-value">{benefit.value}</span>}
								<h3 class="benefit-title">{benefit.title}</h3>
							</Fragment>
							<Fragment slot="back">
								<p class="benefit-back-title" aria-hidden="true">{benefit.title}</p>
								<p class="benefit-body">{benefit.body}</p>
							</Fragment>
						</FlipCard>
					) : (
						<li class="card benefit-plain">
							{benefit.value && <span class="benefit-value">{benefit.value}</span>}
							<h3 class="benefit-title">{benefit.title}</h3>
						</li>
					)
				))}
			</ul>
			{(settings?.bbbeeNote || bbbeeVerified) && (
				<p class="benefit-note">
					{settings?.bbbeeNote}
					{/* Explicit: the newline between these two expressions is trimmed, so without it the
					    note ran straight into the bracket - "practitioner.(last verified". */}
					{bbbeeVerified && <>{" "}<span class="benefit-verified">(last verified {bbbeeVerified})</span></>}
				</p>
			)}
		</section>
	)}

		</div>
	</section>

</Layout>
<script>
	/**
	 * The detail sections collapse, and several links point straight at them - the action cards at
	 * the top use #goods and #fundraise, and the header/footer may too. A closed <details> would
	 * scroll into view showing only its heading, which reads as a dead link rather than as a
	 * section that needs opening.
	 *
	 * Chrome opens a <details> when the hash targets something *inside* it, but here the id sits on
	 * the <section> wrapping it, and Safari and Firefox are less consistent - so this is done
	 * explicitly rather than relied upon.
	 */
	function openTarget() {
		if (!location.hash) return;
		const target = document.querySelector(location.hash);
		if (!target) return;
		// The audience content is not inside its <details> any more (see the note on .gi-groups): it
		// is a region after the card, shown while that card's <details> is open. So a target inside a
		// region opens the card named by its data-for, and any ancestor <details> as before.
		let opened = false;
		const region = target.closest<HTMLElement>("[data-for]");
		const card = region ? document.getElementById(region.dataset.for ?? "") : null;
		if (card instanceof HTMLDetailsElement && !card.open) {
			card.open = true;
			opened = true;
		}
		let el: Element | null = target;
		while (el) {
			if (el instanceof HTMLDetailsElement && !el.open) {
				el.open = true;
				opened = true;
			}
			el = el.parentElement;
		}
		if (opened) {
			// Re-run the jump: the anchor was resolved against the collapsed height.
			requestAnimationFrame(() => target.scrollIntoView());
		}
	}

	openTarget();
	window.addEventListener("hashchange", openTarget);
</script>


<style>
	/* --- Audience cards (2026-09-25) -------------------------------------------------------------
	   Two photo-top cards, the site's one photo-card shape: photo on top with no tint, then title,
	   "See how", one line and the route links on white. They replaced two full-width text-on-photo
	   banners (2026-09-07), which with the hero made three look-alike blocks in a row. The banner tint
	   and its contrast measurement went with them - nothing sits on a photo here now.

	   Layout: one column below 761px in DOM order (card, its content, card, its content); from 761px
	   the two cards share the first row and each content region spans the full width beneath them.
	   Row gaps are margins, not `gap`, because a closed region still occupies an (empty) grid row and
	   would leave a gap behind it. */
	.gi-groups {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		column-gap: var(--space-6);
		row-gap: 0;
	}

	.gi-card + .gi-group-body,
	.gi-group-body + .gi-card {
		margin-top: var(--space-5);
	}

	@media (min-width: 761px) {
		.gi-groups {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		#individuals-band {
			grid-column: 1;
			grid-row: 1;
		}

		#businesses-band {
			grid-column: 2;
			grid-row: 1;
			margin-top: 0;
		}

		.gi-body-individuals {
			grid-column: 1 / -1;
			grid-row: 2;
		}

		.gi-body-businesses {
			grid-column: 1 / -1;
			grid-row: 3;
		}

		/* The second card sits beside the first here, not under its content. */
		.gi-group-body + .gi-card {
			margin-top: 0;
		}

		/* Same specificity as the phone rule it overrides - an earlier version zeroed this too, and
		   the opened content sat flush against the cards. */
		.gi-card + .gi-group-body {
			margin-top: var(--space-6);
		}
	}

	/* Doubled class: the <=700px `.card { padding }` rule would otherwise inset the photo. */
	.card.gi-card {
		padding: 0;
		gap: 0;
		overflow: hidden;
		align-items: stretch;
	}

	.gi-card-media {
		display: block;
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	.gi-card-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.gi-card-head {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
		padding: var(--space-5) var(--space-6) 0;
	}

	.gi-card-head h2 {
		margin: 0;
		font-size: clamp(1.5rem, 2.6vw, 1.9rem);
		line-height: 1.15;
	}

	.gi-card-text {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: var(--space-3);
		padding: var(--space-3) var(--space-6) var(--space-4);
	}

	.gi-card-text p {
		margin: 0;
		color: rgba(36, 35, 43, 0.75);
	}

	@media (max-width: 700px) {
		.gi-card-head {
			padding: var(--space-4) var(--space-4) 0;
		}

		.gi-card-text {
			padding: var(--space-2) var(--space-4) var(--space-4);
		}
	}

	/* The content region, shown while its card is open. A box on the page ground, so the white cards
	   inside it keep reading as cards. */
	.gi-group-body {
		display: none;
		border: 1px solid rgba(36, 35, 43, 0.12);
		border-radius: 20px;
		padding: var(--space-8) var(--space-5) var(--space-6);
	}

	.gi-groups:has(#gi-individuals[open]) .gi-body-individuals,
	.gi-groups:has(#gi-businesses[open]) .gi-body-businesses {
		display: block;
	}

	/* The sections inside still carry `.wrap`, which would apply a second max-width and a second set
	   of side padding within a container that already has both. Neutralised rather than stripped off
	   the markup, so the sections stay usable on their own if they are ever moved back out. */
	.gi-group-body :global(.section.wrap) {
		max-width: none;
		margin-left: 0;
		margin-right: 0;
		padding-left: 0;
		padding-right: 0;
	}

	/* --- Folds ---------------------------------------------------------------------------------
	   Adrian asked for the detail to expand rather than all of it being on screen at once, and this
	   is the clearest instance of the "less copy" decision: nothing is deleted, it is simply not all
	   shown. It also keeps every word in the page for search engines, which a deletion would not. */
	/* Separation between the sub-sections inside a box. They are three different asks - how to help,
	   what to bring, how to fundraise - and with nothing between them they ran together as one
	   column of cards. A rule rather than nested boxes: the cards are already boxes, and boxing their
	   sections too would be a third level of containment inside a box that is itself a disclosure. */
	.gi-group-body :global(.section) + :global(.section) {
		margin-top: var(--space-6);
		padding-top: var(--space-6);
		border-top: 1px solid rgba(36, 35, 43, 0.14);
	}

	/* Subordinate to the banner's own heading - it is the parent here, which is why these are h3.
	   Sized down so the hierarchy reads without depending on the rule alone. */
	.gi-group-body :global(.section-intro h3) {
		margin: 0;
		font-size: clamp(1.15rem, 2vw, 1.45rem);
		line-height: 1.2;
	}

	/* `.section` is a flex column with a var(--space-8) gap site-wide, which is right for full-width
	   sections and too airy inside a box - it put 32px under every heading and between every block.
	   Tightened here only. */
	.gi-group-body :global(.section) {
		gap: var(--space-5);
	}

	/* Heading and its onward link on one line. The link used to trail the section as a lone
	   paragraph after the grid, where it read as a stranded footer rather than as the way on. */
	/* The way on now closes the section's own description rather than sitting beside the heading:
	   it reads as the end of the sentence that set the section up, which is where someone finishes
	   reading before deciding whether they want more. `nowrap` keeps the arrow with its last word. */
	.gi-group-body :global(.gi-sub-link) {
		font-weight: 600;
		white-space: nowrap;
	}

	/* The card's photo and title are the control: one click opens its content beneath the pair. */
	.gi-group-summary {
		display: block;
		list-style: none;
		cursor: pointer;
	}

	.gi-group-summary::-webkit-details-marker {
