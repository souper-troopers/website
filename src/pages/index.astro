---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import supportPhoto from "../assets/images/support-conversation.jpg";
import hubPhoto from "../assets/images/humanity-hub-exterior.jpg";
import shopPhoto from "../assets/images/shop-products.jpg";
import heroPhoto from "../assets/images/mandela-mural.png";
import BrushRing from "../components/BrushRing.astro";
import PhotoHero from "../components/PhotoHero.astro";
import StoryVideo from "../components/StoryVideo.astro";
import { getImpactStats, getFeaturedSuccessStories } from "../lib/sanity";

const impactStats = await getImpactStats("home");
const stories = await getFeaturedSuccessStories();

// The Donate tile leads on the same headline number as the impact band, read from Sanity rather
// than retyped here so the two can't drift apart when Kerry updates it.
const leadStat = impactStats.find((stat) => stat.value != null);

// The three pillars - the first try put to Kerry on the status page (q28), and the answer to "what
// is this?" before the page asks for anything. Every line is built from wording the site already
// uses. Photo on top, text on white beneath: Adrian's "too dark" point from the 21 September
// review, and no text ever sits on a photo, so there is no contrast to tune per image. The Hub
// photo is the building, not people (q19); the CAST one is the photo this page already used.
const pillars = [
	{
		title: "The Humanity Hub",
		text: "A service centre in Woodstock, Cape Town, and where all of our work happens.",
		href: "/about#humanity-hub",
		cta: "Visit the Hub",
		photo: hubPhoto,
		// Mirrors contact.astro: the 66 sits at the photo's left edge, so crop from the right only.
		position: "left center",
		alt: "The Humanity Hub on Newmarket Street, Woodstock, with Table Mountain behind",
	},
	{
		title: "The CAST programme",
		text: "From a first conversation to a first pay cheque - rooted in dignity, love and respect.",
		href: "/our-work",
		cta: "See the CAST journey",
		photo: supportPhoto,
		position: "center",
		alt: "A Souper Troopers social worker in conversation with a CAST participant",
	},
	{
		title: "Every purchase pays a wage",
		text: "Troopers Coffee and African Worry Dolls, made by people the CAST programme has supported.",
		href: "/shop",
		cta: "Visit the shop",
		photo: shopPhoto,
		position: "center",
		alt: "Troopers Coffee and African Worry Dolls from the Souper Troopers shop",
	},
];

// Generated once via sharp (resize 24px wide, jpeg q40) from mandela-mural.png - see commit history if it
// ever needs regenerating after the source photo changes.
const heroLqip =
	"data:image/jpeg;base64,";
---

<Layout title="Souper Troopers - homelessness charity in Cape Town" rawTitle description="A Cape Town charity for people experiencing homelessness, based at our Humanity Hub service centre in Woodstock. Donate, volunteer or shop with us." heroOverlay heroDonate>
	{/* The shared hero (PhotoHero.astro), at its natural height until the video lands. The mural is
	    the page's LCP image, so the component loads it eager + fetchpriority high (Cloudflare RUM had
	    measured LCP P90/P99 at 3,636ms when it was lazy). */}
	<PhotoHero image={heroPhoto} size="home" lqip={heroLqip}>
		<h1>We are all <span class="hero-highlight glow-word">human</span>. We all have a story. Together, we are the change.</h1>
		<p>
			The Humanity Hub is where Souper Troopers helps people move from crisis to dignity -
			through the CAST programme and a community that meets people halfway.
		</p>
		<div class="actions">
			<a class="btn btn-primary" href="/donate">Donate now</a>
		</div>
		<a href="#get-involved" class="hero-secondary-link">Or see how else you can help &darr;</a>
	</PhotoHero>

	{/* The CAST section and the shop band were folded into these cards on 2026-09-24 (the draft for
	    the 30 September review): each had its own full section, and the page said the same three
	    things at greater length. Our Work and the shop page carry the detail, one click away. */}
	<section class="section wrap">
		<h2 class="visually-hidden">What we do</h2>
		<div class="pillar-grid">
			{pillars.map((p) => (
				<a class="card pillar" href={p.href}>
					<div class="pillar-img shimmer-up">
						<Image
							src={p.photo}
							alt={p.alt}
							width={720} widths={[400, 720]}
							sizes="(min-width: 901px) 340px, (min-width: 561px) 50vw, 100vw"
							style={`object-position: ${p.position}`}
							onload="this.classList.add('is-loaded')"
						/>
					</div>
					<div class="pillar-body">
						<h3>{p.title}</h3>
						<p>{p.text}</p>
						<span class="pillar-cta">{p.cta} &rarr;</span>
					</div>
				</a>
			))}
		</div>
	</section>

	<section id="get-involved" class="section wrap">
		{/* "How to get involved" is Kerry's own phrase from the 21 September review, where she asked
		    for a big, obvious one on the homepage. Below the pillars, so the page says what the
		    organisation is before it asks. */}
		<div class="section-intro gi-intro">
			<h2>How to get involved</h2>
		</div>
		<div class="path-grid">
			<a href="/donate" class="path-tile path-lead">
				<BrushRing id="donate" viewBox="0 0 900 240" cx={760} cy={66} r={132} strokeWidth={28} opacity={0.22} dash="500 130" seed={11} frequency={0.011} displace={20} />
				<div class="path-tile-body">
					<span class="path-chip">Most direct way to help</span>
					{leadStat && (
						<p class="path-fact">{leadStat.value?.toLocaleString("en-US")}{leadStat.suffix}</p>
					)}
					<p class="path-fact-label">
						people supported since 2014 - your donation funds the next one, from a first
						conversation to a job.
					</p>
					<span class="btn btn-on-tile">Donate now &rarr;</span>
				</div>
			</a>
			<a href="/get-involved#individuals" class="path-tile path-support">
				<BrushRing id="volunteer" viewBox="0 0 300 240" cx={44} cy={204} r={106} strokeWidth={26} color="var(--st-teal-dark)" opacity={0.22} dash="330 120" seed={29} frequency={0.018} displace={20} />
				<div class="path-tile-body">
					<span class="path-mini-fact">Individuals &amp; groups</span>
					<h3>Volunteer</h3>
					<p>Give time, skills, or goods. Both make the Humanity Hub run.</p>
					<span class="path-cta">Get involved &rarr;</span>
				</div>
			</a>
			<a href="/get-involved#businesses" class="path-tile path-support">
				<BrushRing id="partner" viewBox="0 0 300 240" cx={250} cy={212} r={102} strokeWidth={26} color="var(--st-ink)" opacity={0.14} dash="340 120" seed={77} frequency={0.016} displace={20} />
				<div class="path-tile-body">
					<span class="path-mini-fact">B-BBEE Level 1</span>
					<h3>Partner with us</h3>
					<p>Corporate giving, B-BBEE points, and sponsorship with measurable impact.</p>
					<span class="path-cta">Partner with us &rarr;</span>
				</div>
			</a>
		</div>
	</section>

	<section class="stories-band">
		<div class="wrap">
			<span class="badge badge-on-dark">Success stories</span>
			<h2>People, not just statistics</h2>
			<p class="stories-lead">Some of the people below now work on our team.</p>
			<div class="stories-grid">
				{stories.map((story) => (
					<div class="story-card">
						{story.video && <StoryVideo url={story.video} title={`${story.name}'s story`} />}
						<p class="story-text">{story.quote ? `"${story.quote}"` : story.body}</p>
						<p class="story-name">{story.name}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	{/* The closing "Every story here started with someone deciding to help" band, with a third Donate
	    button, was removed on 2026-09-13. The page asked for a donation three times (hero, lead tile,
	    here) with Donate / Shop also always in the header - the repetition the 2 September review
	    asked us to cut. The hero button stays: the mobile header's Donate appears only once it has
	    scrolled away (see the script below). */}
</Layout>

<style>
	/* Three across on a laptop, one per row on a phone. Two across between would strand the third
	   card, so the middle band keeps one column but lays each card sideways (photo beside text). */
	.pillar-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-5);
	}

	/* Doubled class because the ≤700px `.card { padding }` rule sits later in Layout.astro at the
	   same specificity. */
	.card.pillar {
		padding: 0;
		gap: 0;
		overflow: hidden;
		align-items: stretch;
		text-decoration: none;
		color: var(--st-ink);
		transition: transform 0.2s ease;
	}

	.card.pillar:hover {
		transform: translateY(-4px);
	}

	.pillar-img {
		position: relative;
		aspect-ratio: 4 / 3;
	}

	.pillar-img img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.pillar-body {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: var(--space-6);
	}

	.pillar-body h3 {
		font-size: 1.35rem;
		margin-bottom: var(--space-2);
	}

	.pillar-body p {
		margin-bottom: var(--space-5);
	}

	/* The whole card is the link; this is its visible label, underlined like every link here. */
	.pillar-cta {
		margin-top: auto;
		font-weight: 700;
		color: var(--st-teal-dark);
		text-decoration: underline;
	}

	@media (max-width: 900px) and (min-width: 561px) {
		.pillar-grid {
			grid-template-columns: 1fr;
		}

		.card.pillar {
			flex-direction: row;
		}

		.pillar-img {
			flex: 0 0 42%;
			aspect-ratio: auto;
			min-height: 200px;
		}
	}

	@media (max-width: 560px) {
		.pillar-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card.pillar {
			transition: none;
		}

		.card.pillar:hover {
			transform: none;
		}
	}

	/* "Big and obvious" was Kerry's ask for this section: a larger heading than a normal section
	   intro, and taller tiles than the old secondary grid had. */
	.gi-intro h2 {
		font-size: clamp(2rem, 4.5vw, 2.8rem);
	}

	#get-involved :global(.path-tile) {
		min-height: 280px;
	}
</style>

