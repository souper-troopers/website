---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import supportPhoto from "../assets/images/support-conversation.jpg";
import heroPhoto from "../assets/images/mandela-mural.png";
import CountUp from "../components/CountUp.svelte";
---

<Layout title="Home" description="Souper Troopers helps people move from crisis to dignity through food, work and community in Cape Town.">
	<section class="hero hero-photo">
		<Image src={heroPhoto} alt="" role="presentation" class="hero-bg" widths={[800, 1600, 2400]} sizes="100vw" />
		<div class="hero-scrim"></div>
		<div class="wrap hero-content">
			<h1>We are all human. We all have a story. Together, we are the change.</h1>
			<p>
				Souper Troopers helps people move from crisis to dignity — through the CAST programme,
				the Humanity Hub, and a community that meets people halfway.
			</p>
			<div class="actions">
				<a class="btn btn-primary" href="/donate">Donate now</a>
				<a class="btn btn-secondary" href="/shop">Shop with purpose</a>
			</div>
		</div>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">Choose your path</span>
			<h2>However you want to help, there's a clear next step</h2>
		</div>
		<div class="path-grid">
			<a href="/donate" class="path-tile path-tile-primary path-teal">
				<h3>Donate</h3>
				<p>Support a person directly through the CAST programme — from a first conversation to a job.</p>
				<span class="path-cta">Donate now &rarr;</span>
			</a>
			<a href="/get-involved" class="path-tile path-green">
				<h3>Volunteer</h3>
				<p>Give time, skills, or goods. Individuals and groups both make the Humanity Hub run.</p>
				<span class="path-cta">Get involved &rarr;</span>
			</a>
			<a href="/get-involved" class="path-tile path-ink">
				<h3>Partner with us</h3>
				<p>Corporate giving, B-BBEE points, and sponsorship for businesses who want measurable impact.</p>
				<span class="path-cta">Partner with us &rarr;</span>
			</a>
		</div>
	</section>

	<section class="impact-band">
		<div class="wrap">
			<div class="section-intro">
				<span class="badge badge-on-dark">Impact</span>
				<h2>Impact you can't miss</h2>
				<p>Real outcomes from the CAST programme — the numbers behind every story.</p>
			</div>
			<div class="impact-stats">
				<div class="impact-stat"><CountUp client:visible end={1700} suffix="+" /><span>lives supported since 2014</span></div>
				<div class="impact-stat"><CountUp client:visible end={77} suffix="%" /><span>employment success in the latest CAST intake</span></div>
				<div class="impact-stat"><strong>ID docs</strong><span>secured for people with no path to services</span></div>
				<div class="impact-stat"><strong>Skills</strong><span>training and job-readiness for every participant</span></div>
			</div>
		</div>
	</section>

	<section class="section wrap">
		<div class="grid grid-2" style="align-items: center;">
			<div class="figure">
				<Image src={supportPhoto} alt="A Souper Troopers social worker in conversation with a CAST participant" widths={[400, 800]} sizes="(min-width: 700px) 500px, 100vw" />
			</div>
			<div>
				<span class="badge">The CAST journey</span>
				<h2>Connect. Assess. Support. Transform.</h2>
				<p>
					Every journey starts with a person requesting help and a social worker who shows up —
					rooted in dignity, love, and respect. From there: an honest assessment of what's needed,
					tailored support (documents, training, referrals, job-readiness), and a path toward
					independence.
				</p>
				<a href="/our-work">See the full CAST journey &rarr;</a>
			</div>
		</div>
	</section>

	<section class="stories-band">
		<div class="wrap">
			<span class="badge badge-on-dark">Success stories</span>
			<h2>People, not statistics</h2>
			<div class="stories-grid">
				<blockquote class="story-quote">
					<p>"I'm not just an inspiration to others, but an inspiration to myself."</p>
					<cite>— Odette Sue Oliver, Souper Squad</cite>
				</blockquote>
				<div class="story-block">
					<h3>Peaceful</h3>
					<p>
						Gained experience through the Troopers Coffee social enterprise, went on to train as a
						paralegal, and now works at Law 4 All — the ripple effect of purpose-driven work.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="section wrap">
		<div class="card" style="background: var(--st-ink); color: white; text-align: center; padding: 3rem;">
			<h2 style="margin-top:0;">Ready to be part of the story?</h2>
			<div class="actions" style="justify-content:center; display:flex; gap:1rem; flex-wrap:wrap;">
				<a class="btn btn-primary" href="/donate">Donate now</a>
				<a class="btn btn-outline" style="border-color:white; color:white;" href="/get-involved">Get involved</a>
			</div>
		</div>
	</section>
</Layout>

<script>
	const heroImg = document.querySelector<HTMLElement>(".hero-bg");
	const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	if (heroImg && !prefersReducedMotion) {
		const maxShift = 70;
		let ticking = false;

		function updateParallax() {
			const shift = Math.min(window.scrollY * 0.3, maxShift);
			heroImg!.style.transform = `translateY(${shift}px)`;
			ticking = false;
		}

		window.addEventListener(
			"scroll",
			() => {
				if (!ticking) {
					requestAnimationFrame(updateParallax);
					ticking = true;
				}
			},
			{ passive: true },
		);
	}
</script>
