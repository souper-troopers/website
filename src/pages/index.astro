---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import hubPhoto from "../assets/images/hub-haircut.jpg";
import castPhoto from "../assets/images/hub-lounge.jpg";
import shopPhoto from "../assets/images/shop-products.jpg";
import heroPhoto from "../assets/images/mandela-mural.png";
import PhotoHero from "../components/PhotoHero.astro";
import StoryVideo from "../components/StoryVideo.astro";
import CardCtaLabel from "../components/CardCtaLabel.astro";
import { getImpactStats, getFeaturedSuccessStories, getTeamMembers, urlFor } from "../lib/sanity";

const impactStats = await getImpactStats("home");
// The homepage shows one story (the first featured one); Our Work has them all.
const [story] = await getFeaturedSuccessStories();

// The story's person, if they are also on the team (Odette is: the story says "Odette Sue Oliver",
// the team card "Odette Oliver"). Matched on first name, and on surname too when the story gives
// one, so a middle name doesn't stop the match and two people sharing a first name don't cross.
const storyPerson = story
	? (await getTeamMembers()).find((person) => {
			const [first, ...rest] = story.name.trim().split(/\s+/);
			const [pFirst, ...pRest] = person.name.trim().split(/\s+/);
			if (first !== pFirst) return false;
			return rest.length === 0 || rest.at(-1) === pRest.at(-1);
		})
	: undefined;
const storyPortrait = storyPerson?.photo;

// The Donate tile leads on the same headline number as the impact band, read from Sanity rather
// than retyped here so the two can't drift apart when Kerry updates it.
const leadStat = impactStats.find((stat) => stat.value != null);

// The three pillars - the first try put to Kerry on the status page (q28), and the answer to "what
// is this?" before the page asks for anything. Every line is built from wording the site already
// uses. Photo on top, text on white beneath: Adrian's "too dark" point from the 21 September
// review, and no text ever sits on a photo, so there is no contrast to tune per image. Both people photos are
// Shan's, cleared by her blanket consent (q35).
const pillars = [
	{
		title: "The Humanity Hub",
		text: "A service centre in Woodstock, Cape Town, and where all of our work happens.",
		href: "/about#humanity-hub",
		cta: "Visit the Hub",
		photo: hubPhoto,
		// A haircut at the Hub (Shan's photos, 25 September; was the building, which Contact's
		// hero already shows). Portrait, so anchored on the two faces.
		position: "center 35%",
		alt: "A haircut at the Humanity Hub",
	},
	{
		title: "The CAST programme",
		text: "From a first conversation to a first pay cheque - rooted in dignity, love and respect.",
		href: "/our-work",
		cta: "See the CAST journey",
		photo: castPhoto,
		// Two people talking in the Hub's lounge (Shan's photos, 25 September; was Our Work's hero).
		position: "center 45%",
		alt: "Two people talking in the lounge at the Humanity Hub",
	},
	{
		title: "Every purchase pays a wage",
		text: "Troopers Coffee and African Worry Dolls, made by people the CAST programme has supported.",
		href: "/shop",
		cta: "Visit the shop",
		photo: shopPhoto,
		position: "center",
		alt: "Troopers Coffee and African Worry Dolls from the Souper Troopers shop",
	},
];

// Generated once via sharp (resize 24px wide, jpeg q40) from mandela-mural.png - see commit history if it
// ever needs regenerating after the source photo changes.
const heroLqip =
	"data:image/jpeg;base64,";
---

<Layout title="Souper Troopers - homelessness charity in Cape Town" rawTitle description="A Cape Town charity for people experiencing homelessness, based at our Humanity Hub service centre in Woodstock. Donate, volunteer or shop with us." heroOverlay heroDonate>
	{/* The shared hero (PhotoHero.astro), at its natural height until the video lands. The mural is
	    the page's LCP image, so the component loads it eager + fetchpriority high (Cloudflare RUM had
	    measured LCP P90/P99 at 3,636ms when it was lazy). */}
	<PhotoHero image={heroPhoto} size="home" lqip={heroLqip}>
		<h1>We are all <span class="hero-highlight glow-word">human</span>. We all have a story. Together, we are the change.</h1>
		{/* Cut at the dash on 25 September (no rewording): CAST and "meets people halfway" are said by the
		    pillar cards just below. The "Or see how else you can help" link went the same day - the
		    "How to get involved" cards are one scroll away. The Donate button stays: the mobile
		    header's Donate appears only once it has scrolled away. The headline's middle sentence is
		    a question for Kerry (q37 on the status page) - don't change it until she answers. */}
		<p>The Humanity Hub is where Souper Troopers helps people move from crisis to dignity.</p>
		<div class="actions">
			<a class="btn btn-primary" href="/donate">Donate now</a>
		</div>
	</PhotoHero>

	{/* The CAST section and the shop band were folded into these cards on 2026-09-24 (the draft for
	    the 30 September review): each had its own full section, and the page said the same three
	    things at greater length. Our Work and the shop page carry the detail, one click away. */}
	<section class="section wrap">
		<h2 class="visually-hidden">What we do</h2>
		<div class="pillar-grid">
			{pillars.map((p) => (
				<a class="card card-cta pillar" href={p.href}>
					<div class="pillar-img shimmer-up">
						<Image
							src={p.photo}
							alt={p.alt}
							width={720} widths={[400, 720]}
							sizes="(min-width: 901px) 340px, (min-width: 561px) 50vw, 100vw"
							style={`object-position: ${p.position}`}
							onload="this.classList.add('is-loaded')"
						/>
					</div>
					<div class="pillar-body">
						<h3>{p.title}</h3>
						<p>{p.text}</p>
						<CardCtaLabel>{p.cta}</CardCtaLabel>
					</div>
				</a>
			))}
		</div>
	</section>

	<section id="get-involved" class="section wrap">
		{/* "How to get involved" is Kerry's own phrase from the 21 September review, where she asked
		    for a big, obvious one on the homepage. Below the pillars, so the page says what the
		    organisation is before it asks. */}
		<div class="section-intro gi-intro">
			<h2>How to get involved</h2>
		</div>
		{/* Three equal plain white cards, the site's one card style (design brief phase 2). They
		    replaced a solid-teal Donate tile and two pale-teal ones; a 4px teal top rule they had at
		    first went on 25 September. Whole-card links; the hero's Donate button stays the page's one
		    filled button. No eyebrow labels (removed 2026-09-25): two cards had one and Donate didn't,
		    so the titles sat at different heights. */}
		<div class="grid grid-3 ways-grid">
			<a href="/donate" class="card card-cta way-card">
				<h3>Donate</h3>
				{leadStat && (
					<p class="way-fact">{leadStat.value?.toLocaleString("en-US")}{leadStat.suffix}</p>
				)}
				<p>
					people supported since 2014 - your donation funds the next one, from a first
					conversation to a job.
				</p>
				<CardCtaLabel>Donate now</CardCtaLabel>
			</a>
			<a href="/get-involved#individuals" class="card card-cta way-card">
				<h3>Volunteer</h3>
				<p>Give time, skills, or goods. Both make the Humanity Hub run.</p>
				<CardCtaLabel>Get involved</CardCtaLabel>
			</a>
			<a href="/get-involved#businesses" class="card card-cta way-card">
				<h3>Partner with us</h3>
				<p>Corporate giving, B-BBEE points, and sponsorship with measurable impact.</p>
				<CardCtaLabel>Partner with us</CardCtaLabel>
			</a>
		</div>
	</section>

	{/* One featured quote, no card box (decided 25 September): the first featured story's person as
	    a round portrait beside their words. The portrait is their team-card photo when they are on
	    the team; a story with a video shows the video's still instead, as the play button; with
	    neither, the quote stands alone. The three stories in full are Our Work's to tell. */}
	{story && (
		<section class="section wrap">
			<div class:list={["home-quote", !(story.video || storyPortrait) && "no-portrait"]}>
				{story.video ? (
					<div class="home-quote-portrait is-video">
						<StoryVideo url={story.video} title={`${story.name}'s story`} />
					</div>
				) : storyPortrait && (
					<div class="home-quote-portrait">
						<img
							src={urlFor(storyPortrait).width(480).height(480).fit("crop").auto("format").url()}
							alt={story.name}
							width="240"
							height="240"
							loading="lazy"
						/>
					</div>
				)}
				<div class="home-quote-text">
					<h2>People, not just statistics</h2>
					{story.quote && <blockquote><p>"{story.quote}"</p></blockquote>}
					<p class="home-quote-who"><strong>{story.name}</strong> - {story.body}</p>
					<a href="/our-work#stories">More stories on Our Work &rarr;</a>
				</div>
			</div>
		</section>
	)}

	{/* The closing "Every story here started with someone deciding to help" band, with a third Donate
	    button, was removed on 2026-09-13. The page asked for a donation three times (hero, lead tile,
	    here) with Donate / Shop also always in the header - the repetition the 2 September review
	    asked us to cut. The hero button stays: the mobile header's Donate appears only once it has
	    scrolled away (see the script below). */}
</Layout>

<style>
	/* Three across on a laptop, one per row on a phone. Two across between would strand the third
	   card, so the middle band keeps one column but lays each card sideways (photo beside text). */
	.pillar-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-5);
	}

	/* Doubled class because the ≤700px `.card { padding }` rule sits later in Layout.astro at the
	   same specificity. */
	.card.pillar {
		padding: 0;
		gap: 0;
		overflow: hidden;
		align-items: stretch;
		text-decoration: none;
		color: var(--st-ink);
		transition: transform 0.2s ease;
	}

	.card.pillar:hover {
		transform: translateY(-4px);
	}

	.pillar-img {
		position: relative;
		aspect-ratio: 4 / 3;
	}

	.pillar-img img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.pillar-body {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: var(--space-6);
	}

	.pillar-body h3 {
		font-size: 1.35rem;
		margin-bottom: var(--space-2);
	}

	/* No bottom margin: the .card-cta label brings its own 24px above it. */
	.pillar-body p {
		margin-bottom: 0;
	}

	@media (max-width: 900px) and (min-width: 561px) {
		.pillar-grid {
			grid-template-columns: 1fr;
		}

		.card.pillar {
			flex-direction: row;
		}

		.pillar-img {
			flex: 0 0 42%;
			aspect-ratio: auto;
			min-height: 200px;
		}
	}

	@media (max-width: 560px) {
		.pillar-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card.pillar {
			transition: none;
		}

		.card.pillar:hover {
			transform: none;
		}
	}

	/* "Big and obvious" was Kerry's ask for this section: a larger heading than a normal section
	   intro. */
	.gi-intro h2 {
		font-size: clamp(2rem, 4.5vw, 2.8rem);
	}

	/* The site's one card style: plain white, no top rule (the 4px teal rule was removed on
	   25 September). Whole-card links, so they carry their own text colour. */
	.card.way-card {
		color: var(--st-ink);
		text-decoration: none;
		gap: var(--space-2);
		transition: transform 0.2s ease;
	}

	.card.way-card:hover {
		transform: translateY(-4px);
	}

	@media (prefers-reduced-motion: reduce) {
		.card.way-card {
			transition: none;
		}

		.card.way-card:hover {
			transform: none;
		}
	}

	.way-card h3 {
		font-size: 1.35rem;
	}

	/* Static figure: ink, not teal (teal means clickable). */
	.way-fact {
		font-size: clamp(2.2rem, 5vw, 3rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.way-card p {
		margin-bottom: 0;
	}


	/* The featured quote: portrait left, words right from 761px; stacked below with a smaller
	   portrait on top. No card box - the quote is the shape. */
	.home-quote {
		display: grid;
		gap: var(--space-5);
		justify-items: start;
	}

	.home-quote-portrait {
		width: 160px;
		aspect-ratio: 1;
		border-radius: 50%;
		overflow: hidden;
		background: rgba(36, 35, 43, 0.06);
	}

	.home-quote-portrait img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* A video still is round too; StoryVideo's own 16:9 box and bottom margin are overridden so
	   it fills the circle, and its play button stays centred. */
	.home-quote-portrait.is-video :global(.story-video) {
		width: 100%;
		height: 100%;
		aspect-ratio: auto;
		margin: 0;
	}

	.home-quote-portrait.is-video :global(.story-video img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.home-quote-text {
		max-width: 44rem;
	}

	.home-quote-text h2 {
		margin: 0 0 var(--space-3);
		font-size: 1.5rem;
	}

	.home-quote blockquote {
		margin: 0 0 var(--space-4);
		padding: 0;
		border: 0;
	}

	.home-quote blockquote p {
		margin: 0;
		font-size: clamp(1.6rem, 3.2vw, 2.4rem);
		font-weight: 600;
		line-height: 1.25;
		color: var(--st-ink);
	}

	.home-quote-who {
		margin: 0 0 var(--space-3);
		color: rgba(36, 35, 43, 0.75);
	}

	.home-quote-who strong {
		color: var(--st-ink);
	}

	.home-quote-text a {
		font-weight: 700;
	}

	@media (min-width: 761px) {
		.home-quote {
			grid-template-columns: 240px minmax(0, 1fr);
			align-items: center;
			gap: var(--space-8);
		}

		.home-quote.no-portrait {
			grid-template-columns: minmax(0, 1fr);
		}

		.home-quote-portrait {
			width: 240px;
		}
	}
</style>

