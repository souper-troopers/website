---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import supportPhoto from "../assets/images/support-conversation.jpg";
import heroPhoto from "../assets/images/mandela-mural.png";
import CountUp from "../components/CountUp.svelte";
import { getImpactStats, getFeaturedSuccessStories } from "../lib/sanity";

const impactStats = await getImpactStats("home");
const stories = await getFeaturedSuccessStories();

// Generated once via sharp (resize 24px wide, jpeg q40) from mandela-mural.png — see commit history if it
// ever needs regenerating after the source photo changes.
const heroLqip =
	"data:image/jpeg;base64,";
---

<Layout title="Home" description="Souper Troopers helps people move from crisis to dignity through food, work and community in Cape Town." heroOverlay>
	<section class="hero hero-photo">
		<div class="hero-bg blur-up" style={`background-image:url(${heroLqip})`}>
			<Image
				src={heroPhoto}
				alt=""
				role="presentation"
				widths={[800, 1600, 2400]}
				sizes="100vw"
				onload="this.classList.add('is-loaded')"
			/>
		</div>
		<div class="hero-scrim"></div>
		<div class="wrap hero-content">
			<h1>We are all <span class="hero-highlight">human</span>. We all have a story. Together, we are the change.</h1>
			<p>
				Souper Troopers helps people move from crisis to dignity — through the CAST programme,
				the Humanity Hub, and a community that meets people halfway.
			</p>
			<div class="actions">
				<a class="btn btn-primary" href="/donate">Donate now</a>
			</div>
			<a href="#get-involved" class="hero-secondary-link">Or see how else you can help &darr;</a>
		</div>
	</section>

	<section id="get-involved" class="section wrap">
		<div class="section-intro">
			<span class="badge">Choose your path</span>
			<h2>However you want to help, there's a clear next step</h2>
		</div>
		<div class="path-grid">
			<a href="/donate" class="path-tile path-teal">
				<h3>Donate</h3>
				<p>Support a person directly through the CAST programme — from a first conversation to a job.</p>
				<span class="path-cta">Donate now &rarr;</span>
			</a>
			<a href="/get-involved#individuals" class="path-tile path-green">
				<h3>Volunteer</h3>
				<p>Give time, skills, or goods. Individuals and groups both make the Humanity Hub run.</p>
				<span class="path-cta">Get involved &rarr;</span>
			</a>
			<a href="/shop" class="path-tile path-gold">
				<h3>Buy something</h3>
				<p>Troopers Coffee and African Worry Dolls&trade; — every order funds the jobs behind them.</p>
				<span class="path-cta">Visit the shop &rarr;</span>
			</a>
			<a href="/get-involved#businesses" class="path-tile path-ink">
				<h3>Partner with us</h3>
				<p>Corporate giving, B-BBEE points, and sponsorship for businesses who want measurable impact.</p>
				<span class="path-cta">Partner with us &rarr;</span>
			</a>
		</div>
	</section>

	<section class="impact-band">
		<div class="wrap">
			<div class="section-intro">
				<span class="badge badge-on-dark">Impact</span>
				<h2>Impact you can't miss</h2>
				<p>Real outcomes from the CAST programme — the numbers behind every story.</p>
			</div>
			<div class="impact-stats">
				{impactStats.map((stat) => (
					<div class="impact-stat">
						{stat.value != null ? (
							<CountUp client:visible end={stat.value} suffix={stat.suffix ?? ""} />
						) : (
							<strong>{stat.displayValue}</strong>
						)}
						<span>{stat.label}</span>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section wrap">
		<div class="grid grid-2" style="align-items: center;">
			<div class="figure shimmer-up">
				<Image
					src={supportPhoto}
					alt="A Souper Troopers social worker in conversation with a CAST participant"
					widths={[400, 800]}
					sizes="(min-width: 700px) 500px, 100vw"
					onload="this.classList.add('is-loaded')"
				/>
			</div>
			<div class="section-intro">
				<span class="badge">The CAST journey</span>
				<h2>Connect. Assess. Support. Transform.</h2>
				<p>
					Every journey starts with a person requesting help and a social worker who shows up —
					rooted in dignity, love, and respect. From there: an honest assessment of what's needed,
					tailored support (documents, training, referrals, job-readiness), and a path toward
					independence.
				</p>
				<a href="/our-work">See the full CAST journey &rarr;</a>
			</div>
		</div>
	</section>

	<section class="stories-band">
		<div class="wrap">
			<span class="badge badge-on-dark">Success stories</span>
			<h2>People, not statistics</h2>
			<p class="stories-lead">Some of the people below now work on our team.</p>
			<div class="stories-grid">
				{stories.map((story) => (
					<div class="story-card">
						<p class="story-text">{story.quote ? `"${story.quote}"` : story.body}</p>
						<p class="story-name">{story.name}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section wrap">
		<div class="card closing-cta" style="text-align:center; align-items:center;">
			<h2>Every story here started with someone deciding to help</h2>
			<div class="actions">
				<a class="btn btn-primary" href="/donate">Donate now</a>
				<a class="btn btn-outline" href="/get-involved">Other ways to help</a>
			</div>
		</div>
	</section>
</Layout>

<script>
	const heroImg = document.querySelector<HTMLElement>(".hero-bg");
	const header = document.querySelector<HTMLElement>(".site-header-overlay");
	const hero = document.querySelector<HTMLElement>(".hero-photo");
	const heroDonateBtn = document.querySelector<HTMLElement>(".hero .btn-primary");
	const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	const parallaxRate = 0.3;
	let ticking = false;

	function update() {
		const heroHeight = hero?.offsetHeight ?? 0;

		if (heroImg && !prefersReducedMotion) {
			// No cap: the CSS overhang on .hero-bg (35%) is sized to comfortably cover a full
			// heroHeight * parallaxRate shift, so the image keeps drifting for as long as any
			// part of the hero is still in view instead of freezing partway through.
			const shift = window.scrollY * parallaxRate;
			heroImg.style.transform = `translateY(${shift}px)`;
		}
		// Fade the header from transparent to solid ink continuously as the hero scrolls by,
		// reaching fully solid right as the hero's bottom edge reaches the header — instead of
		// snapping at that threshold, which read as a sudden jump rather than a scroll effect.
		if (header && hero) {
			const threshold = Math.max(heroHeight - header.offsetHeight, 1);
			const progress = Math.min(Math.max(window.scrollY / threshold, 0), 1);
			header.style.setProperty("--header-fade", String(progress));

			// Mobile only (see .site-header-overlay .donate-cta in Layout.astro): the header's own
			// Donate button stays hidden — redundant right next to the hero's — until the hero's
			// button has actually scrolled out from under the header, at which point it's the only
			// Donate CTA left on screen and needs to reappear.
			const heroDonateHidden = heroDonateBtn ? heroDonateBtn.getBoundingClientRect().bottom < header.offsetHeight : window.scrollY > 0;
			header.classList.toggle("show-header-donate", heroDonateHidden);
		}
		ticking = false;
	}

	update();
	window.addEventListener(
		"scroll",
		() => {
			if (!ticking) {
				requestAnimationFrame(update);
				ticking = true;
			}
		},
		{ passive: true },
	);
</script>
