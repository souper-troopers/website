---
import Layout from "../layouts/Layout.astro";
import PhotoHero from "../components/PhotoHero.astro";
import supportPhoto from "../assets/images/support-conversation.jpg";
import CountUp from "../components/CountUp.svelte";
import { Image } from "astro:assets";
import essentialsPhoto from "../assets/images/services/essential-needs.jpg";
import recoveryPhoto from "../assets/images/services/recovery-support.jpg";
import familyPhoto from "../assets/images/services/family-reunification.jpg";
import documentationPhoto from "../assets/images/services/documentation.jpg";
import employmentPhoto from "../assets/images/services/employment-skills.jpg";
import socialPhoto from "../assets/images/services/social-enterprises.jpg";
import StoryVideo from "../components/StoryVideo.astro";
import { getImpactStats, getSuccessStories } from "../lib/sanity";

const impactStats = await getImpactStats("our-work");
const stories = await getSuccessStories();

const castSteps = [
	{
		letter: "C",
		title: "Connect",
		body: "A beneficiary requests assistance, and an appointment is scheduled with a social worker. This first appointment marks the start of accountability.",
	},
	{
		letter: "A",
		title: "Assess",
		body: "The social worker and individual assess the situation together, identify basic needs, and map out the individual journey - through conversation rooted in dignity, love, and respect.",
	},
	{
		letter: "S",
		title: "Support",
		body: "Tailored, holistic support: rehabilitation programmes, reunification services, ID document assistance, skills upliftment, job-readiness (CV writing, interview prep), and referrals to shelters and clinics.",
	},
	{
		letter: "T",
		title: "Transform",
		body: "With support in place, the person moves toward independence and becomes a success story. Every journey is unique - CAST is the consistent, shared framework.",
	},
];

// PROTOTYPE (2026-09-13): the services as seven identical cards, each a full-bleed photo under a dark
// tint with the words in white. The photos are CC0 stock placeholders (sources and licences in
// src/assets/images/services/SOURCES.md) until the shoot provides real ones - decorative, alt="", so
// nobody is presented as a Souper Troopers participant. Copy unchanged; Documentation sits with the
// other basics.
// `more` opens on click (the card-text budget) - unused since the Souper Squad card went.
// 25 September, from Shan (q33): Recovery support became Holistic support (no "addiction
// rehabilitation"), Housing assistance became Family reunification (so nobody reads it as a housing
// service; her photo), and the Souper Squad card came off - the project has ended (q38 asks about
// the Squad's other mentions).
const hubServices: { title: string; body: string; more?: string; photo: ImageMetadata }[] = [
	{ title: "Essential needs", body: "Toiletries, clothing, showers, food, and haircuts.", photo: essentialsPhoto },
	{ title: "Holistic support", body: "Trauma counselling and wellness - yoga, art therapy and more.", photo: recoveryPhoto },
	{ title: "Family reunification", body: "Reconnecting people with their families.", photo: familyPhoto },
	{ title: "Documentation & financial aid", body: "Help with ID applications, social grants, and budgeting.", photo: documentationPhoto },
	{ title: "Employment & education", body: "Skills development, job readiness, business training, and course enrolments.", photo: employmentPhoto },
	{ title: "Social enterprises", body: "Troopers Coffee, African Worry Dolls, and the Woolworths Project - income and skills development for Troopers.", photo: socialPhoto },
];
---

<Layout title="How we help people out of homelessness" description="CAST - Connect, Assess, Support, Transform. The route from a first conversation to steady work, run from the Humanity Hub, our service centre in Cape Town." heroOverlay>
	<PhotoHero image={supportPhoto} size="page" position="center 5%">
		<h1>Our Work</h1>
		<p>CAST is our framework for helping someone move from crisis to independence - one step at a time.</p>
	</PhotoHero>

	<section class="section wrap">
		{/* PROTOTYPE (2026-09-13): a proposal for the CAST infographic, not the final
		    design - that brief is with Brad's designer friend (2 September minutes). Kerry asked for it
		    "more playful", with the feeling of the programme coming through; the constraint is that it
		    sits coherently with the rest of the site and the words stay real text for search.
		    - The letters are the graphic: outlined, filling in turn, each in its own brand colour - red,
		      yellow, green, then the brand teal at Transform: warm to cool, crisis to independence.
		      (A teal ramp, deep to light, came first.)
		    - On desktop the steps climb; a brush-stroke path hops letter to letter, roughened the way
		      the homepage's BrushRing is, with a dot for the person travelling it.
		    - At Transform a yellow brush ring draws itself around the T.
		    The old `.cast-journey` styles in Layout.astro are untouched, so reverting is this file. */}
		<div class="cast-stage">
			<div class="section-intro">
				<h2>They show up for themselves. We meet them halfway.</h2>
			</div>
			<div class="cast2-wrap">
				<svg class="cast2-svg" aria-hidden="true" focusable="false">
					<defs>
						<filter id="cast2-rough" filterUnits="userSpaceOnUse" x="-100" y="-100" width="4000" height="4000">
							<feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7" result="noise" />
							<feDisplacementMap in="SourceGraphic" in2="noise" scale="7" xChannelSelector="R" yChannelSelector="G" />
						</filter>
					</defs>
					<path id="cast2-trail" class="cast2-trail" d="" filter="url(#cast2-rough)" />
					{/* Moved by a CSS transition started by the same class as the line's draw, so the two
					    share one clock. It was an SVG <animateMotion> first, which runs on its own timer and
					    trailed the line's leading edge by ~38px mid-run. */}
					<circle class="cast2-dot" r="7" />
				</svg>
				<ol class="cast2">
					{castSteps.map((step, i) => (
						<li style={`--i: ${i}; --c: ${["var(--st-red)", "var(--st-yellow)", "var(--st-green)", "var(--st-teal)"][i]}; --kern: ${["0.04em", "0.22em", "0.22em", "-0.19em"][i]}`}>
							{/* The big letter starts the word and the rest follows on its baseline in small type,
							    so the letter and the heading are one thing: C + "onnect". Screen readers get the
							    plain word from the hidden copy - the letter's two layers (outline and fill) and
							    the small tail are aria-hidden. No separate title under it any more. */}
							<h3 class="cast2-word">
								<span class="cast2-letter" aria-hidden="true"><span class="cast2-outline">{step.letter}</span><span class="cast2-fill">{step.letter}</span></span><span class="cast2-rest" aria-hidden="true">{step.title.slice(1)}</span>
								<span class="visually-hidden">{step.title}</span>
							</h3>
							<p>{step.body}</p>
						</li>
					))}
				</ol>
			</div>
		</div>
		{/* Inline so the armed state lands before first paint. The path is drawn through wherever the
		    letters actually are, so one script serves the climbing row and the stacked phone layout.
		    No JS: no path, everything else in its finished state. Reduced motion: path drawn, no play. */}
		<script is:inline>
			(() => {
				const stage = document.querySelector(".cast-stage");
				if (!stage) return;
				const wrap = stage.querySelector(".cast2-wrap");
				const path = stage.querySelector(".cast2-trail");
				const letters = [...stage.querySelectorAll(".cast2-letter")];
				const build = () => {
					const r = wrap.getBoundingClientRect();
					const boxes = letters.map((l) => {
						const b = l.getBoundingClientRect();
						return { l: b.left - r.left, r: b.right - r.left, t: b.top - r.top, b: b.bottom - r.top, cx: (b.left + b.right) / 2 - r.left, cy: (b.top + b.bottom) / 2 - r.top };
					});
					// Straight, and off the glyphs: through the letters' middles it showed through their
					// counters (the C's gap, the A's triangle) and read as a strike-through. So it runs
					// underneath the row, from the C's left edge to just past the end of "Transform", or
					// down the left of the phone stack. The hand-drawn feel is the roughness filter on the
					// stroke. Hops between letters and a wobble down the stack were tried first, 2026-09-13.
					const vertical = Math.abs(boxes[1].l - boxes[0].l) < 10;
					let start, end;
					if (vertical) {
						const x = Math.min(...boxes.map((b) => b.l)) - 12;
						start = [x, boxes[0].t];
						end = [x, boxes[boxes.length - 1].b];
					} else {
						const y = Math.max(...boxes.map((b) => b.b)) + 12;
						start = [boxes[0].l, y];
						// Just past the end of the last word ("ransform"), so the whole of it is underlined.
						const rests = stage.querySelectorAll(".cast2-rest");
						const lastRest = rests[rests.length - 1].getBoundingClientRect();
						end = [lastRest.right - r.left + 6, y];
					}
					path.setAttribute("d", `M${start[0].toFixed(1)},${start[1].toFixed(1)} L${end[0].toFixed(1)},${end[1].toFixed(1)}`);
					stage.style.setProperty("--trail", path.getTotalLength().toFixed(1));
					// The dot starts at the line's start and slides to its end - see .cast2-dot.
					const dot = stage.querySelector(".cast2-dot");
					dot.setAttribute("cx", start[0].toFixed(1));
					dot.setAttribute("cy", start[1].toFixed(1));
					stage.style.setProperty("--dot-dx", `${(end[0] - start[0]).toFixed(1)}px`);
					stage.style.setProperty("--dot-dy", `${(end[1] - start[1]).toFixed(1)}px`);
				};
				build();
				if ("ResizeObserver" in window) new ResizeObserver(build).observe(wrap);
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

				stage.classList.add("armed");
				const play = () => stage.classList.add("playing");
				if (!("IntersectionObserver" in window)) return play();
				const io = new IntersectionObserver((entries) => {
					if (entries.some((e) => e.isIntersecting)) { play(); io.disconnect(); }
				}, { threshold: 0.3 });
				io.observe(stage);
			})();
		</script>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<h2>The Humanity Hub, in practice</h2>
		</div>
		{/* PROTOTYPE (2026-09-13) - see the note on `hubServices`. Cards are not links, so no hover lift. */}
		<ul class="svc-cards" role="list">
			{hubServices.map((item) => (
				<li class="svc-card">
					<div class="svc-card-media">
						<Image src={item.photo} alt="" width={800} widths={[400, 800]} sizes="(max-width: 560px) 100vw, (max-width: 1023px) 50vw, 270px" class="svc-card-img" />
					</div>
					<div class="svc-card-text">
						<h3>{item.title}</h3>
						<p>{item.body}</p>
						{item.more && (
							<details class="card-more">
								<summary><span class="card-more-show">More</span><span class="card-more-hide">Less</span><span class="visually-hidden"> about the {item.title}</span></summary>
								<div><p>{item.more}</p></div>
							</details>
						)}
					</div>
				</li>
			))}
		</ul>
	</section>

	<section class="impact-band">
		<div class="wrap">
			<div class="section-intro">
				<h2>Outcomes from the latest CAST intake</h2>
			</div>
			<div class="impact-stats">
				{impactStats.map((stat) => (
					<div class="impact-stat">
						{stat.value != null ? (
							<CountUp client:visible end={stat.value} suffix={stat.suffix ?? ""} />
						) : (
							<strong>{stat.displayValue}</strong>
						)}
						<span>{stat.label}</span>
					</div>
				))}
			</div>
		</div>
	</section>

	<section id="stories" class="section wrap">
		<div class="section-intro">
			<h2>Real people, real outcomes</h2>
		</div>
		<div class="story-masonry">
			{stories.map((story) => (
				<div class="card">
					{story.video && <StoryVideo url={story.video} title={`${story.name}'s story`} />}
					{story.quote ? (
						<p class="quote">
							"{story.quote}"
							<cite>- {story.name}</cite>
						</p>
					) : (
						<h3>{story.name}</h3>
					)}
					<p>{story.body}</p>
				</div>
			))}
		</div>
	</section>
</Layout>

<style>
	/* PROTOTYPE - see the comment on the section. */
	.cast-stage {
		--step: 650ms;
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
		/* No card since 26 September (the user's call): the letters sit straight on the page ground.
		   Was a white card with a shadow (25 September), and ink before that. */
		color: var(--st-ink);
	}

	.cast-stage .section-intro h2 {
		color: var(--st-ink);
	}

	.cast2-wrap {
		position: relative;
	}

	/* No viewBox: user units are CSS pixels of the wrap, which is what the script draws in. */
	.cast2-svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
	}

	.cast2-trail {
		fill: none;
		/* Teal-dark on the white stage (was teal-light at half opacity on ink). */
		stroke: var(--st-teal-dark);
		stroke-width: 5;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0.8;
		stroke-dasharray: var(--trail, 0);
	}

	.cast2-dot {
		fill: var(--st-teal-dark);
		opacity: 0;
		filter: drop-shadow(0 0 6px rgba(20, 130, 148, 0.45));
	}

	.cast2 {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: var(--space-6);
		align-items: start;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* The climb: each step starts a little higher than the one before. 0 = the letters level
	   (2026-09-13); 44px was the climbing version. */
	.cast2 > li {
		--rise: 0px;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		margin-top: calc((3 - var(--i)) * var(--rise));
	}

	/* Room under every letter so the titles line up and the underline clears them. */
	.cast2-word {
		margin: 0;
		white-space: nowrap;
	}

	/* Inline-block on the heading's baseline, so the small tail of the word sits on the same line. */
	.cast2-letter {
		position: relative;
		display: inline-block;
		margin-bottom: 0.24em;
		/* ~15% smaller than first built (clamp(4.5rem, 8vw, 7.5rem)). */
		font-size: clamp(3.75rem, 6.75vw, 6.25rem);
		font-weight: 800;
		line-height: 0.9;
		letter-spacing: -0.02em;
	}

	/* The outline: a stroke painted *under* a fill in the stage's own colour (white since 25 September). The system font builds
	   some letters from overlapping shapes (the A's crossbar and apex), and a bare stroke outlines
	   every one of them, so the A showed its seams inside the letter (fixed 25 September). With
	   the fill on top, those inner lines are covered and only the outer edge shows. The stroke is
	   doubled to 4px because the fill covers its inner half, leaving the same 2px outline. */
	.cast2-outline {
		display: block;
		/* The page ground: this fill hides the outline's inner seams, so it must match what's behind. */
		color: var(--st-bg);
		-webkit-text-stroke: 4px var(--c);
		paint-order: stroke fill;
		transform-origin: 50% 60%;
	}

	.cast2-fill {
		position: absolute;
		inset: 0;
		color: var(--c);
	}

	/* Per-letter spacing before the tail, set on each step (`--kern`), in the tail's own ems so it
	   scales with it: the A's slope and the S's curve needed a little more room (+4px each at
	   1280), the T's crossbar left a gap (-5px). */
	.cast2-rest {
		margin-left: var(--kern, 0.04em);
		color: var(--st-ink);
		font-size: clamp(1.1rem, 1.7vw, 1.4rem);
		font-weight: 700;
		letter-spacing: 0.01em;
	}

	.cast2-word .visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}

	.cast2 p {
		margin: 0;
		color: rgba(36, 35, 43, 0.75);
	}

	@media (max-width: 900px) {
		.cast2 {
			grid-template-columns: 1fr;
			gap: var(--space-8);
		}

		/* One column; the indent is the gutter the brush line runs down. */
		.cast2 > li {
			margin-top: 0;
			padding-left: 1.25rem;
		}

		.cast2-letter {
			font-size: 3.75rem;
		}
	}

	/* --- The play: armed by the inline script, so no-JS and reduced motion get the finished state. */
	.cast-stage.armed .cast2-outline {
		opacity: 0.35;
		transform: scale(0.86);
	}

	.cast-stage.armed .cast2-fill {
		clip-path: inset(100% 0 0 0);
	}

	.cast-stage.armed .cast2 p {
		opacity: 0;
		transform: translateY(10px);
	}

	.cast-stage.armed .cast2-rest {
		display: inline-block;
		opacity: 0;
		transform: translateX(-6px);
	}

	.cast-stage.armed .cast2-trail {
		stroke-dashoffset: var(--trail, 0);
	}

	/* Each letter pops as the dot reaches it, then fills from the bottom up. */
	.cast-stage.armed.playing .cast2-outline {
		animation: cast2-pop 520ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
		animation-delay: calc(var(--i) * var(--step));
	}

	.cast-stage.armed.playing .cast2-fill {
		animation: cast2-fill 560ms cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
		animation-delay: calc(var(--i) * var(--step) + 120ms);
	}

	.cast-stage.armed.playing .cast2 p {
		animation: cast2-text 480ms ease-out forwards;
		animation-delay: calc(var(--i) * var(--step) + 260ms);
	}

	/* The rest of the word follows its letter, just after the pop. */
	.cast-stage.armed.playing .cast2-rest {
		animation: cast2-text 380ms ease-out forwards;
		animation-delay: calc(var(--i) * var(--step) + 200ms);
	}

	/* Linear, so the line reaches each letter on that letter's beat. */
	.cast-stage.armed.playing .cast2-trail {
		stroke-dashoffset: 0;
		transition: stroke-dashoffset calc(3 * var(--step)) linear;
	}

	/* Same trigger, duration and timing as the line's draw above, so the dot sits on its leading end
	   the whole way. */
	.cast-stage.armed.playing .cast2-dot {
		transform: translate(var(--dot-dx, 0px), var(--dot-dy, 0px));
		transition: transform calc(3 * var(--step)) linear;
		animation: cast2-dot calc(3 * var(--step) + 200ms) linear forwards;
	}

	@keyframes cast2-pop {
		from { opacity: 0.35; transform: scale(0.86); }
		60% { opacity: 1; transform: scale(1.06); }
		to { opacity: 1; transform: scale(1); }
	}

	@keyframes cast2-fill {
		to { clip-path: inset(0 0 0 0); }
	}

	@keyframes cast2-text {
		to { opacity: 1; transform: none; }
	}

	@keyframes cast2-dot {
		0% { opacity: 0; }
		8% { opacity: 1; }
		90% { opacity: 1; }
		100% { opacity: 0; }
	}

	/* PROTOTYPE: the Humanity Hub services as identical photo cards - see the note on `hubServices`.
	   Six cards since 25 September (the Souper Squad card went): three to a row on laptops, two on
	   tablets, so every row is full and the old 8-column offset for a stranded seventh card is gone.
	   Rows size to their own content (2026-09-25). */
	.svc-cards {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-5);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Photo on top, words on white beneath (design brief phase 2) - the homepage pillars' shape.
	   The words used to sit on the photo under a dark tint measured per photo; now nothing does. */
	.svc-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--st-white);
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.05);
	}

	.svc-card-media {
		position: relative;
		aspect-ratio: 4 / 3;
	}

	.svc-card-img {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.svc-card-text {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		padding: var(--space-5);
	}

	.svc-card h3 {
		margin: 0;
		font-size: 1.1rem;
	}

	.svc-card p {
		margin: 0;
		font-size: 0.95rem;
	}

	/* Two per row on tablets. */
	@media (max-width: 1023px) {
		.svc-cards {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.svc-cards {
			grid-template-columns: 1fr;
		}

		/* Photo beside the words on a phone: six cards with a full-width 4:3 photo each would add
		   ~1,500px to the page. */
		.svc-card {
			flex-direction: row;
		}

		.svc-card-media {
			flex: 0 0 38%;
			aspect-ratio: auto;
			min-height: 9rem;
		}

		.svc-card-text {
			padding: var(--space-4);
		}

	}
</style>
