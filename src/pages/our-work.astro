---
import Layout from "../layouts/Layout.astro";
import CountUp from "../components/CountUp.svelte";
import { getImpactStats, getSuccessStories } from "../lib/sanity";

const impactStats = await getImpactStats("our-work");
const stories = await getSuccessStories();

const castSteps = [
	{
		letter: "C",
		title: "Connect",
		body: "A beneficiary requests assistance, and an appointment is scheduled with a social worker. This first appointment marks the start of accountability.",
	},
	{
		letter: "A",
		title: "Assess",
		body: "The social worker and individual assess the situation together, identify basic needs, and map out the individual journey — through conversation rooted in dignity, love, and respect.",
	},
	{
		letter: "S",
		title: "Support",
		body: "Tailored, holistic support: rehabilitation programmes, reunification services, ID document assistance, skills upliftment, job-readiness (CV writing, interview prep), and referrals to shelters and clinics.",
	},
	{
		letter: "T",
		title: "Transform",
		body: "With support in place, the person moves toward independence and becomes a success story. Every journey is unique — CAST is the consistent, shared framework.",
	},
];

const hubServices = [
	{ title: "Essential needs", body: "Toiletries, clothing, showers, food, and haircuts." },
	{ title: "Recovery support", body: "Assistance with addiction rehabilitation and trauma counselling." },
	{ title: "Housing assistance", body: "Shelter placements and family reunification." },
	{ title: "Employment & education", body: "Skills development, job readiness, business training, and course enrolments." },
	{ title: "Documentation & financial aid", body: "Help with ID applications, social grants, and budgeting." },
	{ title: "Social enterprises", body: "Troopers Coffee, African Worry Dolls, and the Woolworths Project — income and skills development for Troopers." },
];
---

<Layout title="Our Work" description="The CAST programme: Connect, Assess, Support, Transform — how Souper Troopers helps people rebuild.">
	<section class="page-hero">
		<div class="wrap">
			<h1>Our Work</h1>
			<p>CAST is our framework for helping someone move from crisis to independence — one step at a time.</p>
		</div>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">The CAST journey</span>
			<h2>They show up for themselves. We meet them halfway.</h2>
		</div>
		<div class="grid grid-4">
			{castSteps.map((step) => (
				<div class="card">
					<span class="cast-letter">{step.letter}</span>
					<h3>{step.title}</h3>
					<p>{step.body}</p>
				</div>
			))}
		</div>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">What support looks like</span>
			<h2>The Humanity Hub, in practice</h2>
		</div>
		<div class="grid grid-3">
			{hubServices.map((item) => (
				<div class="card">
					<h3>{item.title}</h3>
					<p>{item.body}</p>
				</div>
			))}
		</div>
	</section>

	<section class="impact-band">
		<div class="wrap">
			<div class="section-intro">
				<span class="badge badge-on-dark">Impact</span>
				<h2>Outcomes from the latest CAST intake</h2>
			</div>
			<div class="impact-stats">
				{impactStats.map((stat) => (
					<div class="impact-stat">
						{stat.value != null ? (
							<CountUp client:visible end={stat.value} suffix={stat.suffix ?? ""} />
						) : (
							<strong>{stat.displayValue}</strong>
						)}
						<span>{stat.label}</span>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">Success stories</span>
			<h2>Real people, real outcomes</h2>
		</div>
		<div class="grid grid-2">
			{stories.map((story) => (
				<div class="card">
					{story.quote ? (
						<p class="quote">
							"{story.quote}"
							<cite>— {story.name}</cite>
						</p>
					) : (
						<h3>{story.name}</h3>
					)}
					<p>{story.body}</p>
				</div>
			))}
		</div>
	</section>
</Layout>
