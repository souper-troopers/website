---
import Layout from "../layouts/Layout.astro";
import CopyQuestionsButton from "../components/CopyQuestionsButton.svelte";
import Masonry from "../components/Masonry.astro";
import FeatureIcon from "../components/FeatureIcon.astro";

// Static site: this is the date of the most recent build/deploy, which is what
// "as of" should mean for a page describing the current state of the preview.
const updated = new Date().toLocaleDateString("en-ZA", { day: "numeric", month: "long", year: "numeric" });

const liveItems = [
	{ icon: "edit", status: "Done", title: "Content Kerry & Shan can edit directly", body: "They get their own login to update team bios, success stories, partners, and shop items - no developer needed for day-to-day changes." },
	{ icon: "publish", status: "Done", title: "You decide when the site updates", body: "There's now a Publish button at the top of the same tool you edit in, marked with a small rocket. Change as much as you like across as many pages as you like - nothing reaches the public site until you press it. No developer involved, no second account to sign into, and no waiting on us to be at a desk. Press it, and a couple of minutes later the site is showing your changes." },
	{ icon: "tag", status: "Done", title: "Real shop, real prices", body: "Coffee, Worry Dolls, and Gift Tags - same products and prices as the current site, pulled directly from it." },
	{ icon: "cart", status: "Test mode", title: "Shop checkout", body: "A full cart and checkout, using the same PayFast account already in use today. Proven with a real completed test purchase, start to finish - switching it to take real payments is one small step, whenever you're ready." },
	{ icon: "heart", status: "Done", title: "Donate page", body: "EFT, SnapScan, PayPal, and monthly giving all linked, matching the current site." },
	{ icon: "mail", status: "Done", title: "Contact form", body: "Working submissions, spam-protected - no more relying on email alone." },
	{ icon: "chart", status: "Done", title: "Visitor insights", body: "See how many people visit and which pages they look at - done in a privacy-friendly way, with no tracking of individual visitors." },
	{ icon: "search", status: "Done", title: "Built to be found - the technical half", body: "Links preview properly when shared on WhatsApp or social media, every page now tells Google what it is and that Souper Troopers is a Cape Town organisation, and the site is readable by the newer AI-powered search tools rather than only today's search engines. One straight caveat, because “we've done your SEO” is the kind of claim that quietly becomes untrue: being findable is half plumbing and half wording, and only the plumbing is ours to finish. Search “homeless charities cape town” today and Souper Troopers doesn't appear - that's a wording gap, not a technical one, and it won't close on its own. There's a question about it further down." },
	{ icon: "page", status: "Done", title: "Every product has its own page", body: "Each Worry Doll, gift tag and coffee option now has its own web address, rather than all of them sharing one page. That means a specific item can be found in a Google search, sent to someone as a direct link, or recommended by an AI assistant when someone asks where to buy handmade gifts in Cape Town. Each page also tells search engines the price in rands, whether it's in stock, and that it's made by Shmiley - which is what makes products eligible to appear as proper shopping results rather than plain blue links." },
	{ icon: "toggle", status: "Done", title: "You can mark things sold out", body: "There's now a “Sold out” tick-box on each shop item. Ticking it removes the Add to cart button and tells Google the item is unavailable, so nobody orders something you can't send. Untick it when stock is back. It's not automatic stock counting - just a switch you control." },
	{ icon: "backup", status: "Done", title: "Backups", body: "All content is automatically backed up every week - tested and confirmed actually working, not just switched on and hoped for. We're also alerted automatically if a backup ever fails, or quietly stops happening. That second part matters more than it sounds: backups tend to fail silently rather than loudly, so the real risk was never a broken backup - it's a missing one that nobody notices for six months." },
	{ icon: "phone", status: "Done", title: "Works properly on a phone", body: "Every page is built for phones and tablets as much as for a laptop - the menu, the shop, the donate page and the forms all adapt to the screen rather than being a shrunk-down desktop site. Most people will find you on a phone, so that's the version that matters most." },
	{ icon: "zap", status: "Done", title: "Fast, even on mobile data", body: "Pages are pre-built and served from servers around the world, so they arrive almost instantly. Every photo is automatically resized and converted to a modern, much smaller file format - a visitor on a phone gets a phone-sized image, not the full-resolution original. The whole homepage is lighter than a single unoptimised photo would be." },
	{ icon: "lock", status: "Done", title: "Card details never touch the site", body: "Payment happens on PayFast's own secure page, so no card numbers ever pass through this site or get stored here. The whole site is served over a secure (https) connection as standard." },
	{ icon: "access", status: "Done", title: "Accessible to more people", body: "Photos carry text descriptions for screen readers, the site can be navigated by keyboard, and animations are switched off automatically for anyone whose device asks for reduced motion. Text is checked against the recognised contrast standards, and you never have to be able to tell colours apart to use the site - every link is underlined as well as coloured, which matters for the roughly one in twelve men who are colour-blind." },
	{ icon: "brand", status: "Done", title: "It still looks like Souper Troopers", body: "This is a rebuild, not a rebrand. The teal, the logo and the lettering all come from your own brand document rather than anything we invented - so the new site reads as the same organisation, just with more room to breathe. Where we've made a judgement call you might not expect, it's written down further on rather than quietly slipped in." },
];

/**
 * Grouped by *what Kerry has to do*, not by area of the site — a long run of equally-weighted numbered
 * items reads as a to-do list however gently they're worded. Each group is 3-5 items, and the order
 * runs easiest-and-most-useful first ("send us something") to longest-lead-time last ("ask someone
 * else"), so the things with external dependencies are visible early enough to start them.
 *
 * Numbering stays global and continuous across groups rather than restarting per group, so the page matches
 * the numbered list the copy button puts on the clipboard.
 */
const questionGroups = [
	{ group: "Things to send us", note: "Content we can't write for you - all of it goes straight into the site." },
	{ group: "Quick things to confirm", note: "Short checks. We've used what's on the current site, but can't verify it ourselves." },
	{ group: "Your call", note: "Decisions that are genuinely yours - no wrong answers here." },
	{ group: "Things to ask someone else", note: "These need someone outside the two of you, so they're worth starting early." },
];

/**
 * `answered` is annotated rather than inferred on purpose. With every entry currently unanswered,
 * TypeScript would infer the element type without the field at all, and every `q.answered` read
 * below becomes an error the moment the last answered question is cleared — which is exactly when
 * nobody is looking. `astro build` doesn't typecheck, so it fails silently in the editor only.
 */
type Question = {
	group: string;
	title: string;
	ask: string;
	body: string;
	/** Optional page on this site that answers the question rather than describing it — rendered under the context, and carried into the copy-to-clipboard email as an absolute URL so it survives being pasted. */
	link?: { href: string; label: string };
	/** Set to true once Kerry has answered — see the note on `outstandingCount`. */
	answered?: boolean;
};

const questions: Question[] = [
	{ group: "Your call", title: "The “Shmiley” domain", ask: "What did you have in mind for the Shmiley domain - point it at the shop, or give Shmiley its own separate look?", body: "Kerry mentioned buying a domain for Shmiley - what was the plan for it? If the goal is for the products to be easier to find on Google, that part is now handled on the main site: every item has its own page, and each one names Shmiley as the maker. Our suggestion would be to point the Shmiley address at the shop for now, because a brand new web address starts with no history and takes months to build up standing with Google, whereas soupertroopers.org already has years of it. If instead you're picturing Shmiley as its own brand with its own look - aimed at shoppers rather than donors - that's very achievable too, and would share all the same design and content behind the scenes rather than being a second thing to maintain. It's really a question of how separate you want Shmiley to feel, and that one's yours to answer. Worth knowing before you decide: a second site wouldn't add a new monthly bill, but it isn't free either - it uses more of the same free allowance the main site runs on, it's a second thing to publish each time you update content, and the Shmiley domain itself has to be renewed every year. Pointing the domain at the shop avoids all three." },
	{ group: "Things to send us", title: "Descriptions for the shop items", ask: "Could you write a few sentences about each shop item - materials, size, who makes it, the story behind it?", body: "This is the single most useful thing you could send us for the shop. Most products currently have a line or two at most, and several have nothing at all. Now that each item has its own page there's room for a proper description - what it's made of, how big it is, who makes it, the story behind that particular design. It matters more than it sounds: when someone asks Google or ChatGPT for “handmade gifts that support a Cape Town charity”, the products that get recommended are the ones the system can actually describe. A few sentences per item, in your own words, would do it - and you can type them straight into the shop items yourselves, no developer needed." },
	{ group: "Things to send us", title: "Higher-resolution photos - the shop ones especially", ask: "Could you send the original, full-size photo files - particularly for the Shmiley products - plus more photos generally, and say where you'd like specific ones used?", body: "Two things here, and the first one matters more than it might sound. The product photos we inherited from the current site are small - none is bigger than 600 pixels on its longest edge, and several are much smaller than that. A product page needs a decent square image, so five of the eleven items are currently being enlarged past their real size to fill the space, which is what makes them look soft and blocky. The two Shmiley gift tags are the worst affected: those photos are being stretched to roughly three times and two and a half times their real size respectively. On a modern phone or laptop screen, which packs in twice the detail again, even the better ones look softer than they should. Nothing on our side can fix this - enlarging a small photo can't invent detail that was never captured. If the originals still exist on a camera or phone, straight off the device is ideal; a re-shoot of the gift tags on a plain background would transform that part of the shop. Second, and separately: more photos generally, and your thoughts on where specific ones should go (a homepage shot, team photos, images for the CAST journey)." },
	{ group: "Quick things to confirm", title: "The postal code for the Hub", ask: "Is 7925 the right postal code for 66 Newmarket Street?", body: "We've used 7925 wherever a postal code is needed, which is Woodstock's code generally - but we haven't been able to confirm it's the right one for Newmarket Street specifically, and codes can differ street by street. It matters most for the Google listing, where Google cross-checks the address you enter against other records of the organisation, and a code that doesn't match weakens that check. Once it's confirmed we'll add it to the address on the site too. Ten seconds on a delivery slip or a utility bill should settle it.", link: { href: "/google-listing", label: "Where this goes on the listing" } },
	{ group: "Quick things to confirm", title: "Please confirm the payment details are still current", ask: "Are the bank account, PayFast, SnapScan and Zapper details on the Donate page still the ones you use today?", body: "The Donate page now matches the current site properly - bank details, PayFast, SnapScan, Zapper, PayPal, and the monthly debit order are all there (SnapScan and PayPal were missing entirely before). Everything was pulled directly from the current site, including the ABSA account number and the PayFast/SnapScan/Zapper codes - but we haven't been able to test any of them with a real payment, so please have a look and confirm the bank account and PayFast details are still the ones you use today, in case anything changed since the current site was built." },
	{ group: "Your call", title: "Which donation method people actually use", ask: "Which donation method do people actually use most?", body: "EFT, SnapScan, Zapper, PayPal, card, or monthly debit order - knowing which ones actually get used lets us put them first, rather than showing six as equally prominent." },
	{ group: "Things to send us", title: "Your MySchool beneficiary link", ask: "What is your MySchool beneficiary code, or the sign-up link that names Souper Troopers?", body: "We've added MySchool to the ways-to-help list - it's the easiest ask on the whole site, because it costs the supporter nothing. To make it actually work we need your MySchool beneficiary code, or the sign-up link that names Souper Troopers, so people can nominate you in one click instead of having to search for you." },
	{ group: "Things to send us", title: "Do you have existing fundraising campaign pages?", ask: "Do you already have a BackaBuddy or GivenGain page we should link to?", body: "The Get Involved page now walks someone through starting their own fundraiser on BackaBuddy or GivenGain. If you already have a page set up on either, send us the link and we'll point people straight at it rather than making them create one from scratch." },
	{ group: "Things to send us", title: "Two of the impact numbers aren't numbers", ask: "Do you have real figures for ID documents secured and people through skills training?", body: "The homepage shows four impact figures, but only two are actual numbers - “1,700+ lives supported” and “77% employment success”. The other two just say “ID docs” and “Skills”. Those two land much softer as a result. If you have real figures - how many ID documents you've helped secure, how many people have been through skills training - we'll swap them in and the whole section gets stronger." },
	{ group: "Quick things to confirm", title: "Is the supporters list still current?", ask: "Is anyone on the supporters list who shouldn't be, and who is missing?", body: "We've brought back the supporters list from the current site (the Mount Nelson, Twelve Apostles, Superbalist, Charly's Bakery, Nik Rabinowitz and about twenty others) - it's real credibility that was missing. Some of those relationships may have wound down since it was written, though. Worth a quick read to check nobody's listed who shouldn't be, and to tell us who's missing. It's all editable by you later." },
	{ group: "Quick things to confirm", title: "Which press coverage should we show?", ask: "Are those two articles correct, and can you send a list of your best coverage?", body: "We've started an “in the news” section with two articles we found - Good Things Guy and the Cape Argus. We couldn't open them to double-check, so please confirm they're right. More importantly: if you have a list of your best coverage, send it. Being written about by someone else is one of the most persuasive things a donor can see, and right now the site doesn't show any of it. There's a second benefit that isn't obvious: when a news site links to you, Google treats that as a vote of confidence, and those votes are a large part of why some sites come up first. So the links are worth having for their own sake, not only as something to display." },
	{ group: "Your call", title: "Is Souper News a regular thing?", ask: "Are there earlier issues of Souper News, and is a new one planned each month?", body: "We found the March 2026 magazine - the Healing & Human Rights edition. It's genuinely good, and a lot of what's in it now appears on the new site (the corporate workshops and the office coffee are both on Get Involved). Two things would help: are there earlier issues we haven't seen, and is a new one planned each month? If they keep coming, they deserve a proper home on the site rather than a page of images you have to open one at a time." },
	{ group: "Things to ask someone else", title: "Could we get the original photos from EF Ogle?", ask: "Could you ask EF Ogle for the original photo files?", body: "Six pages of the magazine are beautiful professional photography, but they're baked into the page layouts, so we can't lift them out at any usable quality. The original image files would go a long way toward the “more photos” gap above - it's likely the biggest set of good photography you already own and aren't using on the website." },
	{ group: "Things to ask someone else", title: "Permission to name people online", ask: "Could you check with each person that they're happy for their story and photo to be on the public site?", body: "The magazine tells people's stories by name and pairs them with photographs - Unam's move into work as a barista, for example. These are exactly the stories that make the site land. But there's a real difference between a magazine and a website: a web page is permanent, and it's searchable by someone's name for years afterwards, including by future employers or family. Agreeing to appear in the March issue isn't automatically agreeing to that. Before we publish any of it, could you check with each person that they're happy for their story and photo to be on the public site - and let us know if anyone would rather we use a first name only, or leave them out entirely? We'd rather ask now than have to unpick it later." },
	{ group: "Things to ask someone else", title: "Could Werksmans check the B-BBEE wording?", ask: "Would you be willing to ask Werksmans to glance over the B-BBEE section?", body: "The Get Involved page now spells out what a business gets back for supporting you - the procurement and socio-economic development points, the Section 18A deduction. We've checked these against the current Codes of Good Practice and believe they're right, but they're regulated figures, and the procurement rules in particular are mid-review (changes were gazetted in January and aren't law yet). Since Werksmans already gives you pro bono legal time - and has published its own analysis of these exact changes - would you be willing to ask them to glance over that one section? It's a short read for them, and it means the numbers we're putting in front of corporate donors are ones you can stand behind. The page is built so the figures can be corrected in seconds without a developer." },
	{ group: "Your call", title: "A video at the top of the homepage", ask: "Do you like the idea of a short video at the top of the homepage - and is there footage we could use, or should we plan a shoot?", body: "At the moment the top of the homepage is the Mandela mural photo. We think a few seconds of video in that spot could be stronger - it's the one place on the site where movement genuinely earns its keep, and it would show the work rather than describe it. Before you say yes, the honest constraint: it needs to be short (five to fifteen seconds), silent, and filmed landscape, because it plays behind the headline rather than being something you sit and watch. We looked at the two films you already have and neither fits that job. The Capital International piece is a narrated seven-minute film - far too good to run silently behind text, and much better suited to its own “watch our story” spot further down the page. The Anthony CAST film is the right length at about a minute, but it's shot upright for a phone, so on a laptop it sits in the middle with bars down both sides. So: is this something you'd like? If so, is there other footage sitting on a phone or a camera somewhere, or should we plan a short shoot for it? Even a slow pan across the Hub on a busy morning would do it. Happy to leave the mural there if you'd rather - it's a good photo." },
	{ group: "Your call", title: "Quick-pick donation amounts", ask: "Would quick-pick donation amounts be useful, or should we skip it?", body: "Some charity sites offer set amounts to click (“R150 / R350 / R500”) instead of asking someone to type a number, which does tend to make giving quicker. This one is a suggestion rather than something we need from you. We'd only want to do it if the amounts line up with real costs you actually fund - a button that says R150 works when it pays for something specific, and rings hollow when it's just a round number someone picked." },
	{ group: "Things to send us", title: "The words people actually use", ask: "Who do you most need to reach right now - donors, volunteers, businesses, or people needing help - and what do they actually say when they get in touch?", body: "This is the one that unlocks the search problem, and it needs you rather than us. Search “homeless charities cape town” today and Souper Troopers doesn't come up. The reason is duller than you'd think: Google can only match a page to a search if the page uses the words people are actually typing. The site currently speaks the way you speak internally - dignity, CAST, connect and support, “we are all human” - which is right for someone already reading it, but it isn't what a stranger types into a search box. No page on the site plainly says Souper Troopers is a homelessness charity in Cape Town, so there is nothing there for Google to match. What would help most isn't a list of keywords, it's the real sentences. When somebody phones or emails you out of the blue, what do they actually say? “I've got bags of clothes, who takes them?” “How do I volunteer?” “Can my company do something for Mandela Day?” Those exact sentences are close to what people type into Google, and each one is a page we could write for you. Alongside that: of donors, volunteers, businesses, and people who need help themselves - which matters most over the next six months? Each group searches in completely different words, and it's better to aim properly at the one you care about than to average across all four." },
	{ group: "Things to ask someone else", title: "Set up your Google business listing", ask: "Could you check whether Souper Troopers already has a Google Business Profile, and set one up if not? It's the single biggest free thing available for being found, and worth starting soon because Google's verification can take up to two weeks. Separately: is there a phone number we can list publicly?", body: "Of everything on this page, this is the one we'd most like you to actually do rather than answer. It sits outside the website entirely, and for the search you'd most want to win it matters more than the site does. When someone searches “homeless charities cape town”, that block of results with the little map at the top of the page doesn't come from anyone's website - it comes from Google Business Profile, a free listing you claim and fill in yourself. No amount of work on the new site can win that block, which is why we're raising it separately rather than quietly handling it. Three things worth knowing. First, check before you create: Google sometimes generates an unclaimed listing for an organisation on its own, and it looks identical to having none - if you see a “Claim this business” link, claim that one rather than making a second, because duplicates then have to be merged. Second, if a listing does already exist it was probably set up years ago by a volunteer who has since moved on, so the real question is whether anyone still has access. Third, please set it up on an organisation Google account rather than a personal Gmail, and add both of you as owners - it's the same reasoning as the rest of the accounts, in that whoever holds that login controls how Souper Troopers appears on Google Maps indefinitely. We've written out everything that goes in it - the exact address, opening hours, categories, and a description ready to paste - on its own page, linked just below, so it's a ten-minute job rather than a blank form. On the phone number: we can't find one for Souper Troopers anywhere - not on the current site, not on the new one, not in a search. Google's listing really wants one and it's often the first thing people look for. If there's a number you're happy to have public, send it and we'll add it in both places. If you'd rather stay email-only, that's a perfectly reasonable choice for a small team - just say so and we'll stop treating it as a gap.", link: { href: "/google-listing", label: "Everything to put in the listing, ready to copy" } },
	{ group: "Your call", title: "How plainly should the site say “homeless”?", ask: "Are you happy for the site to use the word “homeless” in the summary lines Google shows, while the pages themselves keep saying “people experiencing homelessness”?", body: "A real tension, and it's yours to settle rather than ours. The site says “people experiencing homelessness”, which we've assumed is deliberate - it puts the person before the circumstance and it reads as more respectful. The difficulty is that almost nobody searches that way. People type “homeless charities cape town”, and a page that never uses the plainer word is much harder for Google to put in front of them. The middle road we'd suggest, and have already applied: keep your language in the writing on the page where people actually read it, and use the plainer wording in the one-line summary Google shows in its results. Nobody browsing the site would ever see the difference, but someone searching would find you. If you'd rather we didn't, say so and we'll take it out - we just didn't want to make that particular choice quietly on your behalf." },
];

/**
 * Flattened in group order, so the numbering the reader sees runs straight down the page and
 * matches the numbered list the copy button writes to the clipboard.
 */
const orderedQuestions = questionGroups.flatMap((g) => questions.filter((q) => q.group === g.group));

/**
 * Mark a question answered by adding `answered: true` to it above — the chip flips to green and it
 * drops out of the copy-to-clipboard email.
 *
 * Answered questions stay on the page rather than being removed, and that's the point: the number
 * beside each one is its position in this list, so deleting an answered question would renumber
 * everything below it. Kerry may well reply "here are 4, 7 and 11" days apart, and question 7 has
 * to still mean question 7 next week. Leaving them in place, greyed, keeps every number stable and
 * doubles as a visible record of what's already settled.
 *
 * The one case that still shifts numbers is *inserting* a new question above existing ones — so add
 * new ones at the end of their group.
 */
const outstandingCount = orderedQuestions.filter((q) => !q.answered).length;

/**
 * The questions as plain text for the clipboard button — numbered, with an "A:" line under each so
 * the paste doubles as an answer template rather than something Kerry has to reformat.
 *
 * Deliberately carries only the title and the one-line ask, not the full `body`: she'll have just
 * read the context on the page, and including it would bury the actual questions in an email.
 *
 * Group headings are carried across too — the point of grouping is that the list stops reading as
 * one flat run of equal chores, and that's just as true in the email as on the page.
 */
const questionsText = [
	`Souper Troopers website - questions (as of ${updated})`,
	"",
	...questionGroups.flatMap((g) => {
		// Answered questions are dropped from the email but keep their page numbers, so "7" still
		// refers to the same thing in a reply written a week after the last one.
		const rows = orderedQuestions.flatMap((ask, i) =>
			ask.group === g.group && !ask.answered
				? [
						`${i + 1}. ${ask.title}`,
						`Q: ${ask.ask}`,
						// Absolute, because this list exists to be pasted into an email where a
						// site-relative path would be dead.
						...(ask.link ? [`${ask.link.label}: ${new URL(ask.link.href, Astro.site).href}`] : []),
						"A: ",
						"",
					]
				: []
		);
		return rows.length ? [`== ${g.group.toUpperCase()} ==`, "", ...rows] : [];
	}),
	`Full context for each question: ${new URL("/request-for-comment/", Astro.site).href}`,
].join("\n");

/**
 * Deliberate choices Kerry might otherwise read as oversights.
 *
 * Deliberately NOT framed as "differences from the old site": we only have a page-level map of the
 * current site (docs/website-structure-and-journeys.md), so most old-vs-new comparisons would be
 * assertions we can't back up in a document the client will check against a site she knows far
 * better than we do. Only the social-links card makes a direct comparison, because that one is
 * recorded. The rest describe what this site does and why, which needs no such claim.
 */
const deviations = [
	{ title: "Publishing your changes is a two-step", body: "Worth knowing before you start editing. Your edits save the moment you make them, but the public site is only rebuilt when you ask for it - so you make a batch of changes, press Publish once, and they all go out together. It's deliberate rather than a limitation. Rebuilding after every single save would burn through the free hosting allowance in a matter of days, and batching is part of how the site stays free to run. Concretely, that allowance is around twenty publishes a month: ample when you're publishing a batch of edits at a time, and nowhere near enough if the site rebuilt itself every time you changed a word. If you ever do run out, publishing pauses until the start of the next month and everything already published stays online, so nothing breaks - but it's worth building the habit of making all your changes first and publishing once at the end, rather than pressing it after each small edit." },
	{ title: "Some wording is fixed, on purpose", body: "You can edit team bios, stories, partners, shop items and impact numbers yourselves. A few things are deliberately not editable - the CAST step descriptions, the list of Humanity Hub services, and the headline on the homepage. These are the load-bearing bits of the site's structure, where an accidental edit would visibly break a layout. Say the word if you'd rather have any of them opened up." },
	{ title: "The Sold out switch isn't stock counting", body: "Ticking “Sold out” hides the Add to cart button for that item. It doesn't count stock or decrease as orders come in - if you have five of something and sell five, nothing happens automatically. Real inventory tracking is a bigger piece of work and we didn't want to half-build it. For the volumes involved, a switch you control seemed more honest." },
	{ title: "Social links sit in the footer only", body: "The current site shows social icons in the top menu as well as at the bottom. Here they're at the bottom only. The top of the page is doing more work now - menu, cart, donate - and a row of icons that send people off to other platforms was competing with the things meant to lead somewhere on the site. Easy to put back up top if you'd rather." },
	{ title: "The goods list is a list, not buttons", body: "On Get Involved, the categories of goods you accept are labelled photos with one email address above them, rather than each tile being separately clickable. Tiles that look tappable but only open a blank email tend to frustrate more than they help - on a phone they often do nothing at all, depending on how email is set up. One clear address does the same job more reliably." },
	{ title: "How long we keep the backups", body: "The weekly backup takes a complete copy of everything - all the words, and every photo - rather than just what changed. That's the safest kind, but complete copies stack up, so we've set a limit rather than keeping all of them forever: every weekly backup for the last two months, then one a month for the past year, then one a year going back. In practice that means if something goes wrong you can go back to any week within the last two months, any month within the last year, or a yearly snapshot before that. We picked this rather than ask you, because it's the sort of thing there's a sensible standard answer to - but it's a setting, not a law, so tell us if you'd rather keep more." },
	{ title: "Coffee works differently to the other products", body: "Every Worry Doll and gift tag has its own page. Coffee doesn't - it's one product you choose options for (grind, size), so its page is the coffee page with the choices on it. That's deliberate rather than something we missed." },
	{ title: "We haven't asked you for a list of keywords", body: "If you've read anything about SEO before, you might be expecting us to ask which keywords you'd like to target - there genuinely used to be a box on every page where you typed them in. That box still exists in some tools, but Google stopped reading it in 2009, and putting words on a page that don't match what the page actually says now counts against you rather than for you. What replaced it is less exciting and more work: a page comes up when it properly answers something someone searched for, in the words they used. That's why the question we've asked instead is what people actually say when they contact you - those sentences are worth more than any keyword list. One practical consequence: if anyone ever cold-calls offering to sell you keywords or to “submit your site to 500 search engines”, that's the moment to be sceptical." },
];
---

<Layout title="Request for Comment" description="Souper Troopers website - where things stand.">
	<section class="page-hero">
		<div class="wrap">
			<span class="badge badge-on-dark">Request for comment - {updated}</span>
			<h1>Souper Troopers website: where things stand</h1>
			<p>A preview of the new site is ready for a look - in your own time, no meeting required first. This page covers what's already working, what we still need input on, and what any of it costs.</p>
		</div>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">Live in the preview</span>
			<h2>What's already working</h2>
			<p>This is a real, working preview - not a mockup. A couple of things (marked below) are intentionally still in "test mode" until you say go.</p>
		</div>
		<Masonry>
			{liveItems.map((item) => (
				<div class="card">
					<div class="fk-feature-head">
						<span class:list={["fk-feature-icon", { "is-test": item.status === "Test mode" }]}>
							<FeatureIcon name={item.icon} />
						</span>
						<span class:list={["fk-status", { "fk-status-test": item.status === "Test mode" }]}>{item.status}</span>
					</div>
					<h3>{item.title}</h3>
					<p>{item.body}</p>
				</div>
			))}
		</Masonry>
	</section>

	<section class="section wrap">
		<div class="fk-asks-head">
			<div class="section-intro">
				<span class="badge">Needs you</span>
				<h2>A few real questions</h2>
				<p>{outstandingCount} still open, and this is genuinely most of what's outstanding. Nothing urgent - take your time. They're sorted by the kind of thing they need from you, and each one ends with the actual question in a highlighted box. As you answer them we'll mark them off here, so this page stays an accurate picture rather than going stale.</p>
			</div>
			<CopyQuestionsButton client:load text={questionsText} />
		</div>
		{questionGroups.map((g) => (
			<div class="fk-ask-group">
				<div class="fk-group-head">
					<h3>{g.group}</h3>
					<p>{g.note}</p>
				</div>
				<div class="fk-asks">
					{orderedQuestions.map((ask, i) => ask.group === g.group && (
						<div class:list={["fk-ask", { "is-answered": ask.answered }]}>
							<span class="fk-ask-number">{i + 1}</span>
							<div>
								<div class="fk-ask-title-row">
									<h4>{ask.title}</h4>
									<span class:list={["fk-ask-status", { "is-answered": ask.answered }]}>
										{ask.answered ? "Answered" : "Awaiting your answer"}
									</span>
								</div>
								{/* Only the *context* collapses. Every title and every actual question stays
								    visible, so nothing being asked is ever hidden behind a click - the page
								    still reads end to end, it just isn't three screens of background per
								    question. <details>/<summary> rather than a scripted accordion: keyboard
								    operable and screen-reader announced for free, it prints expanded, and
								    browser find-in-page opens a closed <details> when the match is inside. */}
								<details class="fk-ask-context">
									<summary>
										<span class="fk-ask-context-label">Why we're asking</span>
									</summary>
									<p>{ask.body}</p>
								</details>
								<p class="fk-ask-question">{ask.ask}</p>
								{ask.link && (
									<p class="fk-ask-link">
										<a href={ask.link.href}>{ask.link.label} &rarr;</a>
									</p>
								)}
							</div>
						</div>
					))}
				</div>
			</div>
		))}

	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">Done this way on purpose</span>
			<h2>Choices worth knowing about</h2>
			<p>A few things work the way they do because we chose it, not because we ran out of time. Flagging them here so none of it looks like an oversight - and every one of them is a decision you can overrule.</p>
		</div>
		<Masonry>
			{deviations.map((item) => (
				<div class="card">
					<h3>{item.title}</h3>
					<p>{item.body}</p>
				</div>
			))}
		</Masonry>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">Costs</span>
			<h2>What this costs to run</h2>
		</div>
		<table class="fk-cost-table">
			<thead>
				<tr><th>Today</th><th>Cost</th></tr>
			</thead>
			<tbody>
				<tr><td>Hosting</td><td>Free*</td></tr>
				<tr><td>Content editing tool (for Kerry &amp; Shan)</td><td>Free*</td></tr>
				<tr><td>Visitor analytics</td><td>Free*</td></tr>
				<tr><td>Weekly content backups</td><td>Free*</td></tr>
				<tr><td>Payment processing</td><td>Free until something sells, then a small % per sale - same fees already being paid today, nothing new</td></tr>
			</tbody>
		</table>
		<p class="fk-table-note">* Free at the site's current size and usage. Two honest caveats rather than promising "free forever." First, if the site grows well beyond what it does today (heavy traffic, very frequent edits), some of these could eventually move to a paid tier - not something on the horizon right now. Second, these are commercial companies, and free tiers do sometimes get reduced or withdrawn; it has happened across the industry. The protection against that isn't a promise from them, it's that nothing here is locked in: the site is plain files in your own GitHub account, all the content lives in a system you own with weekly backups to your own private copy, and it could be moved to a different host without rebuilding it. The two pieces genuinely tied to the current host are the contact form and the shop's payment handling, and both are small enough to rebuild elsewhere in a day if it ever came to that.</p>
	</section>

	{/* Ends on a next step rather than a reassurance. "No rush" already appears in the questions
	    intro, and a page that finishes on a costs table leaves the reader with nothing to do —
	    this points back at the one control on the page that actually helps them reply. */}
	<section class="section wrap">
		<div class="fk-close">
			<h2>Replying to all this</h2>
			<p>The quickest way is the copy button in the questions section - it drops all {outstandingCount} into an email with a space to answer under each, so you can do them in any order, or a few at a time. If you'd sooner talk any of it through than write it down, that works just as well.</p>
		</div>
	</section>
</Layout>

<style>
	/* Icon and status share a row so the card opens with one clean band rather than two stacked
	   chips. Baseline-independent (center) because the icon is a fixed 40px puck and the status is
	   small caps text. */
	.fk-feature-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
		width: 100%;
		margin-bottom: 0.15rem;
	}

	/* A tint puck rather than a solid teal fill: solid teal + a centred glyph is the button shape
	   this site reserves for actions (see AGENTS.md). A soft wash reads as decoration, and the icon
	   itself carries the brand colour without ever looking pressable. */
	.fk-feature-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		flex-shrink: 0;
		border-radius: 12px;
		background: rgba(27, 171, 190, 0.12);
		color: var(--st-teal-dark, #148294);
	}

	/* Test-mode cards get the amber treatment their status chip already uses, so the two agree. */
	.fk-feature-icon.is-test {
		background: rgba(219, 188, 59, 0.22);
		color: #7a5f0a;
	}

	/* Outlined, where the icon puck beside it is filled. Two filled tint chips on one row read as a
	   matched pair and the eye can't tell which is the icon and which is the status; fill-vs-outline
	   separates them at a glance without adding another colour. The leading dot carries the status
	   colour, so the state is still legible if the text is skimmed past. */
	.fk-status {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		flex-shrink: 0;
		font-size: 0.64rem;
		font-weight: 700;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		background: transparent;
		color: #2f7a44;
		border: 1px solid rgba(47, 122, 68, 0.35);
		padding: 0.22rem 0.55rem;
		border-radius: 999px;
	}

	.fk-status::before {
		content: "";
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: currentColor;
	}

	.fk-status-test {
		color: #7a5f0a;
		border-color: rgba(122, 95, 10, 0.4);
	}

	/* Heading on the left, copy-to-clipboard on the right; wraps to stacked on narrow screens. */
	.fk-asks-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--space-6);
	}

	.fk-asks-head .section-intro {
		flex: 1 1 320px;
	}

	.fk-asks {
		display: grid;
		gap: 1.25rem;
	}

	/* Groups exist to stop a long run of numbered items reading as one flat to-do list, so the heading has
	   to be clearly a divider rather than another question: a hairline rule above it separates the
	   groups without adding boxes inside boxes. */
	.fk-ask-group {
		margin-top: var(--space-10);
	}

	.fk-ask-group:first-of-type {
		margin-top: var(--space-6);
	}

	.fk-group-head {
		margin-bottom: var(--space-5);
		padding-top: var(--space-4);
		border-top: 1px solid rgba(36, 35, 43, 0.12);
	}

	.fk-group-head h3 {
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(36, 35, 43, 0.65);
	}

	.fk-group-head p {
		margin-top: 0.3rem;
		font-size: 0.9rem;
		color: rgba(36, 35, 43, 0.65);
		max-width: 62ch;
	}

	/* Was h3 before the groups landed; the group heading is the h3 now, so each question title steps
	   down to h4 to keep the outline correct for screen readers. Size is unchanged. */
	.fk-ask h4 {
		font-size: 1.05rem;
	}

	.fk-ask {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.9rem;
		align-items: start;
	}

	.fk-ask > div {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	/* Title and its status share a row; the status wraps below on narrow screens rather than
	   squeezing the title. */
	.fk-ask-title-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem 0.75rem;
	}

	/* Deliberately quiet while unanswered: sixteen loud chips would read as sixteen alarms, and the
	   default state is "we haven't heard back yet", which is the normal state of this page rather
	   than a problem. Answered is the one that earns colour, so progress is what stands out. */
	.fk-ask-status {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		flex-shrink: 0;
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: rgba(36, 35, 43, 0.65);
		border: 1px solid rgba(36, 35, 43, 0.18);
		padding: 0.18rem 0.5rem;
		border-radius: 999px;
	}

	.fk-ask-status::before {
		content: "";
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: currentColor;
	}

	.fk-ask-status.is-answered {
		color: #2f7a44;
		border-color: rgba(47, 122, 68, 0.35);
	}

	/* Settled, not deleted — see the note on `outstandingCount` for why they stay put. Muted enough
	   to skim past, still readable if she wants to check what she told us. */
	.fk-ask.is-answered h4,
	.fk-ask.is-answered .fk-ask-question {
		opacity: 0.55;
	}

	.fk-ask.is-answered .fk-ask-number {
		background: rgba(36, 35, 43, 0.08);
		color: rgba(36, 35, 43, 0.65);
	}

	/* Disclosure for each question's background. Styled as a quiet text control, not a button —
	   it's a reading aid, and a button per question would compete with the copy-questions
	   button that actually does something. */
	.fk-ask-context {
		margin-top: 0.15rem;
	}

	.fk-ask-context summary {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		cursor: pointer;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--st-teal-dark, #148294);
		text-decoration: underline;
		text-underline-offset: 2px;
		/* Hides the native triangle in Chrome/Safari; Firefox uses list-style. */
		list-style: none;
		width: fit-content;
	}

	.fk-ask-context summary::-webkit-details-marker {
		display: none;
	}

	/* Own chevron, so it can rotate — the native marker can't be animated consistently. */
	.fk-ask-context summary::after {
		content: "";
		width: 6px;
		height: 6px;
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		transform: rotate(45deg) translate(-1px, -1px);
		transition: transform 0.15s ease;
	}

	.fk-ask-context[open] summary::after {
		transform: rotate(-135deg) translate(-2px, -2px);
	}

	.fk-ask-context summary:focus-visible {
		outline: 2px solid var(--st-teal, #1babbe);
		outline-offset: 3px;
		border-radius: 3px;
	}

	.fk-ask-context p {
		margin-top: 0.5rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.fk-ask-context summary::after {
			transition: none;
		}
	}

	/* A closed <details> hides its content natively, not via a CSS display rule, so it can't be
	   forced open from a print stylesheet — see the beforeprint script below, which does it. This
	   just tidies the control itself off the printed page. */
	@media print {
		.fk-ask-context summary {
			display: none;
		}
	}

	.fk-ask p {
		font-size: 0.94rem;
		color: rgba(36, 35, 43, 0.65);
		max-width: 62ch;
	}

	/* The context above each of these is necessary but long, so the thing actually being asked gets
	   pulled out as a tinted callout. It's differentiated from the <h3> title by *surface* — a wash
	   and a rule — rather than by colour or weight alone: bold ink on plain background read as a
	   second heading, and teal text is reserved for things you can act on (see AGENTS.md). Weight
	   600 against the title's 700 completes the separation, so the three levels read as heading /
	   prose / question.
	   Selector is `p.fk-ask-question` rather than the bare class so it outweighs `.fk-ask p` above,
	   which mutes the body copy to 65% ink. */
	.fk-ask p.fk-ask-question {
		margin-top: 0.6rem;
		padding: 0.6rem 0.85rem;
		border-left: 3px solid var(--st-teal, #1babbe);
		border-radius: 0 8px 8px 0;
		background: rgba(27, 171, 190, 0.08);
		font-weight: 600;
		color: var(--st-ink, #24232b);
	}

	/* Sits under the highlighted question rather than inside it: the callout is the thing being asked,
	   and a link inside a tinted box reads as part of the question's wording. Inherits the global
	   underline — see the note on body links in AGENTS.md. */
	.fk-ask-link {
		margin-top: 0.45rem;
		font-size: 0.9rem;
		font-weight: 600;
	}

	.fk-ask-number {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background: rgba(219, 188, 59, 0.22);
		color: #7a5f0a;
		font-weight: 700;
		font-size: 0.9rem;
		flex-shrink: 0;
		margin-top: 0.15rem;
	}


	.fk-cost-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.92rem;
	}

	.fk-cost-table th,
	.fk-cost-table td {
		text-align: left;
		padding: 0.7rem 0.9rem;
		border-bottom: 1px solid rgba(36, 35, 43, 0.09);
	}

	.fk-cost-table th {
		background: rgba(36, 35, 43, 0.04);
		font-weight: 700;
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		color: rgba(36, 35, 43, 0.65);
	}

	.fk-table-note {
		font-size: 0.85rem;
		color: rgba(36, 35, 43, 0.65);
	}

	.fk-close {
		padding-top: var(--space-6);
		border-top: 1px solid rgba(36, 35, 43, 0.12);
	}

	.fk-close h2 {
		font-size: 1.15rem;
		margin-bottom: 0.4rem;
	}

	.fk-close p {
		font-size: 0.94rem;
		color: rgba(36, 35, 43, 0.65);
		max-width: 62ch;
	}
</style>

<script>
	/**
	 * Expand every question's background before printing, and re-collapse afterwards.
	 *
	 * A closed <details> hides its content through the element's own behaviour rather than a CSS
	 * display rule, so a print stylesheet can't reveal it — the `open` attribute has to be set.
	 * Kerry is likely to print or PDF this to go through with Shan, and a printout of
	 * "Why we're asking" stubs with no reasoning under them would be worse than useless.
	 *
	 * Only rows this script opened are closed again, so anything already expanded on screen stays
	 * expanded after the print dialog closes.
	 */
	const contexts = document.querySelectorAll<HTMLDetailsElement>(".fk-ask-context");
	let openedForPrint: HTMLDetailsElement[] = [];

	window.addEventListener("beforeprint", () => {
		openedForPrint = [...contexts].filter((d) => !d.open);
		openedForPrint.forEach((d) => (d.open = true));
	});

	window.addEventListener("afterprint", () => {
		openedForPrint.forEach((d) => (d.open = false));
		openedForPrint = [];
	});
</script>
