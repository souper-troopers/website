---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import shopPhoto from "../assets/images/shop-products.jpg";
import OrderForm from "../components/OrderForm.svelte";
---

<Layout title="Shop" description="Troopers Coffee and African Worry Dolls — purpose-driven products from Shmiley, Souper Troopers' income-generating enterprise.">
	<section class="page-hero">
		<div class="wrap">
			<h1>Shop with purpose</h1>
			<p>Every product is made by people the CAST programme has supported. Every purchase funds the next journey.</p>
		</div>
	</section>

	<section class="section wrap">
		<div class="card">
			<span class="badge">Who makes this possible</span>
			<h2>Products by Shmiley</h2>
			<p>
				Shmiley (Pty) Ltd is Souper Troopers' own social enterprise — a private company owned by
				the non-profit, built to generate income and reduce our reliance on donor funding. Every
				sale directly funds skills development and job creation for the people we support, and
				profits are reinvested straight back into CAST.
			</p>
		</div>
	</section>

	<section class="section wrap">
		<div class="figure">
			<Image src={shopPhoto} alt="Troopers Coffee bags and African Worry Dolls on display" widths={[500, 1000]} sizes="(min-width: 900px) 900px, 100vw" />
		</div>
	</section>

	<section class="section wrap">
		<div class="grid grid-2">
			<div class="card">
				<span class="badge">Est. 2019</span>
				<h2>Troopers Coffee — Dignity Blend</h2>
				<p>
					Started by Michael Sachar, a Souper Troopers volunteer from the coffee industry, who
					believed great coffee could do more than wake people up — it could change lives. Beans
					are roasted locally by a small black-owned business.
				</p>
				<p>Available for corporate and home use. Corporate buyers earn B-BBEE points, and every bag funds skills development and employment.</p>
			</div>
			<div class="card">
				<span class="badge">Since 2022</span>
				<h2>African Worry Dolls&trade;</h2>
				<p>
					Handcrafted by the Souper Squad — formerly homeless individuals in the CAST programme —
					from upcycled shweshwe offcuts, stockings, beads, and stuffing. Each doll is one of a
					kind.
				</p>
				<p>
					Legend has it: whisper your worries to the doll before bed, and it carries them away
					while you sleep. Every purchase supports sustainable employment and skills training.
				</p>
			</div>
		</div>
	</section>

	<section class="section wrap">
		<div class="section-intro">
			<span class="badge">Request an order</span>
			<h2>Online checkout is coming — for now, order directly</h2>
			<p>Tell us what you'd like and we'll confirm pricing and delivery by email.</p>
		</div>
		<OrderForm client:visible />
	</section>
</Layout>
