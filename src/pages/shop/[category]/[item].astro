---
import Layout from "../../../layouts/Layout.astro";
import PhotoHero from "../../../components/PhotoHero.astro";
import shopPhoto from "../../../assets/images/shop-products.jpg";
import { getAllShopItems, urlFor, type ShopItemWithCategory } from "../../../lib/sanity";
import AddToCartButton from "../../../components/AddToCartButton.svelte";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { breadcrumbList, type Crumb } from "../../../lib/breadcrumbs";

export async function getStaticPaths() {
	const items = await getAllShopItems();
	return items.map((item) => ({
		params: { category: item.categorySlug, item: item.slug },
		props: { item },
	}));
}

interface Props {
	item: ShopItemWithCategory;
}

const { item } = Astro.props;

const rand = (n: number) => "R" + n.toLocaleString("en-ZA");

// The main photo, then the gallery. Width only, no crop: the doll shots are 3:4 portrait and a square
// crop clipped hats and feathers. Every slide shares the first photo's shape (see .carousel).
const slides = [item.photo, ...(item.gallery ?? [])].filter(Boolean).map((image) => ({
	src: urlFor(image!).width(900).auto("format").url(),
	srcset: [450, 900].map((w) => `${urlFor(image!).width(w).auto("format").url()} ${w}w`).join(", "),
}));
// Share cards and structured data want a landscape-friendly square; pad rather than crop.
const photoUrl = item.photo
	? urlFor(item.photo).width(900).height(900).fit("fill").bg("ffffff").ignoreImageParams().auto("format").url()
	: undefined;

// Worry dolls are each made by hand, so the photos show the style, not the exact doll you receive
// (Kerry, 21 September review: "you're placing an order for the variation and not what it looks like").
const handmade = item.categorySlug === "worry-dolls";

// Trailing slashes deliberately match Astro's own canonical/sitemap URLs — structured data that
// disagrees with the canonical tag on the same page reads as two URLs for one product.
const pageUrl = new URL(`/shop/${item.categorySlug}/${item.slug}/`, Astro.site).href;

// The short card blurb is the fallback when nobody has written the longer page copy yet. Used for
// the meta description and structured data (unchanged 25 September).
const bodyCopy = item.details || item.description;

// What the details card shows under the price (25 September): the item's own `details`, else the
// first sentence of its category's description - and nothing at all when neither exists, rather
// than a placeholder.
const categoryFirstSentence = (() => {
	const block = item.categoryDescription?.find((b) => b._type === "block");
	const text = block?.children?.map((child) => child.text ?? "").join("").trim();
	return text ? text.split(/(?<=[.!?])\s/)[0] : undefined;
})();
const leadCopy = item.details || categoryFirstSentence;

// The carousel takes its shape from the lead photo (Sanity's image metadata) rather than a fixed
// 3:4: the dolls stay 3:4, the square gift tags fill their box. Every slide shares that shape.
const slideRatio = item.photoDims ? `${item.photoDims.width} / ${item.photoDims.height}` : "3 / 4";

const productJsonLd = {
	"@context": "https://schema.org",
	"@type": "Product",
	name: item.name,
	url: pageUrl,
	sku: item._id,
	...(photoUrl && { image: [photoUrl, ...slides.slice(1).map((slide) => slide.src)] }),
	...(bodyCopy && { description: bodyCopy }),
	brand: { "@type": "Brand", name: "Souper Troopers" },
	offers: {
		"@type": "Offer",
		url: pageUrl,
		priceCurrency: "ZAR",
		price: item.price,
		availability: item.soldOut
			? "https://schema.org/OutOfStock"
			: "https://schema.org/InStock",
		itemCondition: "https://schema.org/NewCondition",
		seller: { "@type": "Organization", name: "Shmiley" },
	},
};

// One array feeds both the visible trail and the structured data — see src/lib/breadcrumbs.ts.
const crumbs: Crumb[] = [
	{ name: "Shop", path: "/shop/" },
	{ name: item.categoryName, path: `/shop/${item.categorySlug}/` },
	{ name: item.name, path: `/shop/${item.categorySlug}/${item.slug}/` },
];
const breadcrumbJsonLd = breadcrumbList(crumbs, Astro.site);
---

<Layout
	title={item.name}
	description={bodyCopy ?? `${item.name} from Souper Troopers' ${item.categoryName} range, handmade in Cape Town.`}
	ogType="product"
	ogImage={photoUrl}
	jsonLd={[productJsonLd, breadcrumbJsonLd]}
	heroOverlay
>
	<PhotoHero image={shopPhoto} size="band" position="center 55%">
		<Breadcrumbs crumbs={crumbs} />
		<h1>{item.name}</h1>
	</PhotoHero>

	<section class="section wrap">
		<div class="product">
			{slides.length > 0 && (
				<div class="carousel" data-carousel style={`--slide-ratio: ${slideRatio}`}>
					{/* A scroll-snap track: swipes on a phone and scrolls with a trackpad with no script at all.
					    The script below only adds the buttons and the counter. */}
					<ul class="carousel-track" tabindex="0" aria-label={`Photos of ${item.name}`}>
						{slides.map((slide, i) => (
							<li class="carousel-slide">
								<img
									src={slide.src}
									srcset={slide.srcset}
									sizes="(min-width: 721px) 520px, 100vw"
									alt={slides.length > 1 ? `${item.name}, example ${i + 1} of ${slides.length}` : item.name}
									width="900"
									height={item.photoDims ? Math.round(900 * item.photoDims.height / item.photoDims.width) : 1200}
									loading={i === 0 ? "eager" : "lazy"}
									fetchpriority={i === 0 ? "high" : undefined}
								/>
							</li>
						))}
					</ul>
					{slides.length > 1 && (
						<div class="carousel-controls" hidden>
							<button type="button" class="carousel-btn" data-dir="-1" aria-label="Previous photo">&larr;</button>
							<span class="carousel-count" aria-live="polite">1 / {slides.length}</span>
							<button type="button" class="carousel-btn" data-dir="1" aria-label="Next photo">&rarr;</button>
						</div>
					)}
				</div>
			)}

			{/* The details sit in the same white box as the photo (26 September; they were a separate
			    card beside it): the price as the heading line, then the copy, the handmade note, the
			    action, and the collection note under a hairline. */}
			<div class="product-detail">
				<div class="detail-top">
					<p class="product-price">{rand(item.price)}</p>
					{leadCopy && <p class="product-body">{leadCopy}</p>}
				</div>

				<div class="detail-buy">
					{handmade && (
						<p class="product-handmade">
							Every doll is handmade, so yours will be one of a kind. The photos show each style, not the
							exact doll you'll receive.
						</p>
					)}

					{item.soldOut ? (
						<p class="sold-out">
							Sold out for now — <a href="/contact">get in touch</a> and we'll let you know when it's back.
						</p>
					) : (
						<AddToCartButton
							client:load
							id={item._id}
							categoryName={item.categoryName}
							name={item.name}
							price={item.price}
						/>
					)}
				</div>

				<p class="product-note">
					Every purchase funds Souper Troopers' work with people experiencing homelessness in Cape Town.
					Orders are collected in person or by a courier you arrange.
				</p>
			</div>
		</div>
	</section>

	{/* "More from <category>" was removed on 25 September: the category page is one click back and
	    already shows every sibling. The back link stays. */}
	<section class="section wrap back-section">
		<p class="back-to-category">
			<a href={`/shop/${item.categorySlug}`}>&larr; All {item.categoryName}</a>
		</p>
	</section>
</Layout>

<style>
	/* One white box holding the photo and the details (26 September): the product photos are shot
	   on white, so the photo runs to the box's edges and reads as part of it. */
	.product {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: start;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--st-white);
		box-shadow: 0 0 0 1px rgba(36, 35, 43, 0.07), 0 14px 30px rgba(0, 0, 0, 0.05);
	}

	@media (max-width: 720px) {
		.product {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	/* One slide per view, all the shape of the lead photo (--slide-ratio, from Sanity's metadata) so
	   nothing jumps between photos; cover, so a gallery shot of a different shape fills the box. */
	.carousel {
		display: grid;
		gap: 0.75rem;
	}

	.carousel-track {
		display: flex;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		scrollbar-width: none;
		margin: 0;
		padding: 0;
		list-style: none;
		background: #fff;
	}

	.carousel-track::-webkit-scrollbar {
		display: none;
	}

	.carousel-track:focus-visible {
		outline: 3px solid var(--st-teal-dark);
		outline-offset: 3px;
	}

	.carousel-slide {
		flex: 0 0 100%;
		scroll-snap-align: start;
	}

	.carousel-slide img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: var(--slide-ratio, 3 / 4);
		object-fit: cover;
	}

	.carousel-controls {
		padding-bottom: var(--space-4);
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}

	/* Ink on white with a border: a control, but not a competing primary. 24px+ target. */
	.carousel-btn {
		min-width: 44px;
		min-height: 44px;
		border: 1px solid rgba(36, 35, 43, 0.25);
		border-radius: 999px;
		background: #fff;
		color: var(--st-ink);
		font-size: 1.1rem;
		cursor: pointer;
	}

	.carousel-btn:hover {
		border-color: var(--st-ink);
	}

	.carousel-btn:disabled {
		opacity: 0.35;
		cursor: default;
	}

	.carousel-count {
		min-width: 4ch;
		text-align: center;
		font-size: 0.9rem;
		font-variant-numeric: tabular-nums;
		color: rgba(36, 35, 43, 0.7);
	}

	@media (prefers-reduced-motion: reduce) {
		.carousel-track {
			scroll-behavior: auto;
		}
	}

	/* Three groups spread down the photo's full height (26 September): what it is and costs at the
	   top, the handmade note with Add to cart in the middle, the collection note as a footnote at the
	   base. Side by side only; stacked on a phone they simply follow one another. */
	.product {
		align-items: stretch;
	}

	.product-detail {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--space-8);
		padding: clamp(1.5rem, 3vw, 2.5rem);
	}

	.detail-buy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	@media (max-width: 720px) {
		.product-detail {
			gap: var(--space-5);
		}
	}

	/* Ink, not teal-dark: the teal family is reserved for things you can act on. The card's heading
	   line. */
	.product-price {
		margin: 0;
		font-size: 1.9rem;
		font-weight: 800;
		line-height: 1.1;
		color: var(--st-ink, #24232b);
	}

	.product-body {
		margin: var(--space-3) 0 0;
		line-height: 1.65;
		white-space: pre-line;
	}

	/* Plain muted text now, no callout rule - the same words as the category page's statement. */
	.product-handmade {
		margin: var(--space-3) 0 0;
		font-size: 0.95rem;
		line-height: 1.55;
		color: rgba(36, 35, 43, 0.72);
	}

	.detail-buy :global(button),
	.detail-buy .sold-out {
		margin-top: var(--space-5);
	}
	.detail-buy > :first-child {
		margin-top: 0;
	}

	.detail-buy .product-handmade {
		margin-top: 0;
	}

	.sold-out {
		margin-bottom: 0;
		font-weight: 600;
	}

	.product-note {
		margin: 0;
		padding-top: var(--space-4);
		border-top: 1px solid rgba(36, 35, 43, 0.1);
		font-size: 0.85rem;
		color: rgba(36, 35, 43, 0.68);
		line-height: 1.6;
	}

	.back-to-category {
		margin: 0;
	}

	/* Underline kept (no text-decoration: none): this had colour as its only affordance, with no
	   hover underline either, so it was invisible as a link to anyone who can't pick out the teal. */
	.back-to-category a {
		font-weight: 600;
		color: var(--st-teal-dark, #148294);
	}
</style>

<script>
	// Buttons and a counter for the photo carousel. The track already scrolls and snaps on its own, so
	// with no script the carousel still works - the controls just stay hidden.
	for (const root of document.querySelectorAll<HTMLElement>("[data-carousel]")) {
		const track = root.querySelector<HTMLElement>(".carousel-track");
		const controls = root.querySelector<HTMLElement>(".carousel-controls");
		if (!track || !controls) continue;
		const count = controls.querySelector<HTMLElement>(".carousel-count");
		const [prev, next] = controls.querySelectorAll<HTMLButtonElement>(".carousel-btn");
		const total = track.children.length;
		const current = () => Math.round(track.scrollLeft / track.clientWidth);
		const update = () => {
			const i = current();
			if (count) count.textContent = `${i + 1} / ${total}`;
			prev.disabled = i === 0;
			next.disabled = i === total - 1;
		};
		for (const button of [prev, next]) {
			button.addEventListener("click", () => {
				track.scrollTo({ left: (current() + Number(button.dataset.dir)) * track.clientWidth });
			});
		}
		track.addEventListener("keydown", (event) => {
			if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
			event.preventDefault();
			(event.key === "ArrowLeft" ? prev : next).click();
		});
		track.addEventListener("scroll", update, { passive: true });
		controls.hidden = false;
		update();
	}
</script>
