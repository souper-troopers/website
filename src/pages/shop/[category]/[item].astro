---
import Layout from "../../../layouts/Layout.astro";
import { getAllShopItems, shortProductName, urlFor, type ShopItemWithCategory } from "../../../lib/sanity";
import AddToCartButton from "../../../components/AddToCartButton.svelte";
import ItemCard from "../../../components/ItemCard.svelte";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { breadcrumbList, type Crumb } from "../../../lib/breadcrumbs";

export async function getStaticPaths() {
	const items = await getAllShopItems();
	return items.map((item) => ({
		params: { category: item.categorySlug, item: item.slug },
		props: {
			item,
			// Siblings, so each product links onward instead of being a dead end. Capped at three to
			// keep the row to a single grid line.
			related: items
				.filter((other) => other.categorySlug === item.categorySlug && other._id !== item._id)
				.slice(0, 3),
		},
	}));
}

interface Props {
	item: ShopItemWithCategory;
	related: ShopItemWithCategory[];
}

const { item, related } = Astro.props;

const rand = (n: number) => "R" + n.toLocaleString("en-ZA");

// The main photo, then the gallery. Width only, no crop: the doll shots are 3:4 portrait and a square
// crop clipped hats and feathers. Every slide shares the first photo's shape (see .carousel).
const slides = [item.photo, ...(item.gallery ?? [])].filter(Boolean).map((image) => ({
	src: urlFor(image!).width(900).auto("format").url(),
	srcset: [450, 900].map((w) => `${urlFor(image!).width(w).auto("format").url()} ${w}w`).join(", "),
}));
// Share cards and structured data want a landscape-friendly square; pad rather than crop.
const photoUrl = item.photo
	? urlFor(item.photo).width(900).height(900).fit("fill").bg("ffffff").auto("format").url()
	: undefined;

// Worry dolls are each made by hand, so the photos show the style, not the exact doll you receive
// (Kerry, 21 September review: "you're placing an order for the variation and not what it looks like").
const handmade = item.categorySlug === "worry-dolls";

// Trailing slashes deliberately match Astro's own canonical/sitemap URLs — structured data that
// disagrees with the canonical tag on the same page reads as two URLs for one product.
const pageUrl = new URL(`/shop/${item.categorySlug}/${item.slug}/`, Astro.site).href;

// The short card blurb is the fallback when nobody has written the longer page copy yet.
const bodyCopy = item.details || item.description;

const productJsonLd = {
	"@context": "https://schema.org",
	"@type": "Product",
	name: item.name,
	url: pageUrl,
	sku: item._id,
	...(photoUrl && { image: [photoUrl, ...slides.slice(1).map((slide) => slide.src)] }),
	...(bodyCopy && { description: bodyCopy }),
	brand: { "@type": "Brand", name: "Souper Troopers" },
	offers: {
		"@type": "Offer",
		url: pageUrl,
		priceCurrency: "ZAR",
		price: item.price,
		availability: item.soldOut
			? "https://schema.org/OutOfStock"
			: "https://schema.org/InStock",
		itemCondition: "https://schema.org/NewCondition",
		seller: { "@type": "Organization", name: "Shmiley" },
	},
};

// One array feeds both the visible trail and the structured data — see src/lib/breadcrumbs.ts.
const crumbs: Crumb[] = [
	{ name: "Shop", path: "/shop/" },
	{ name: item.categoryName, path: `/shop/${item.categorySlug}/` },
	{ name: item.name, path: `/shop/${item.categorySlug}/${item.slug}/` },
];
const breadcrumbJsonLd = breadcrumbList(crumbs, Astro.site);
---

<Layout
	title={item.name}
	description={bodyCopy ?? `${item.name} from Souper Troopers' ${item.categoryName} range, handmade in Cape Town.`}
	ogType="product"
	ogImage={photoUrl}
	jsonLd={[productJsonLd, breadcrumbJsonLd]}
>
	<section class="page-hero">
		<div class="wrap">
			<Breadcrumbs crumbs={crumbs} />
			<h1>{item.name}</h1>
		</div>
	</section>

	<section class="section wrap">
		<div class="product">
			{slides.length > 0 && (
				<div class="carousel" data-carousel>
					{/* A scroll-snap track: swipes on a phone and scrolls with a trackpad with no script at all.
					    The script below only adds the buttons and the counter. */}
					<ul class="carousel-track" tabindex="0" aria-label={`Photos of ${item.name}`}>
						{slides.map((slide, i) => (
							<li class="carousel-slide">
								<img
									src={slide.src}
									srcset={slide.srcset}
									sizes="(min-width: 721px) 520px, 100vw"
									alt={slides.length > 1 ? `${item.name}, example ${i + 1} of ${slides.length}` : item.name}
									width="900"
									height="1200"
									loading={i === 0 ? "eager" : "lazy"}
									fetchpriority={i === 0 ? "high" : undefined}
								/>
							</li>
						))}
					</ul>
					{slides.length > 1 && (
						<div class="carousel-controls" hidden>
							<button type="button" class="carousel-btn" data-dir="-1" aria-label="Previous photo">&larr;</button>
							<span class="carousel-count" aria-live="polite">1 / {slides.length}</span>
							<button type="button" class="carousel-btn" data-dir="1" aria-label="Next photo">&rarr;</button>
						</div>
					)}
				</div>
			)}

			<div class="product-detail">
				<div class="product-price">{rand(item.price)}</div>

				{bodyCopy && <p class="product-body">{bodyCopy}</p>}

				{handmade && (
					<p class="product-handmade">
						Every doll is handmade, so yours will be one of a kind. The photos show the style, not the
						exact doll you'll receive.
					</p>
				)}

				{item.soldOut ? (
					<p class="sold-out">
						Sold out for now — <a href="/contact">get in touch</a> and we'll let you know when it's back.
					</p>
				) : (
					<AddToCartButton
						client:load
						id={item._id}
						categoryName={item.categoryName}
						name={item.name}
						price={item.price}
					/>
				)}

				<p class="product-note">
					Every purchase funds Souper Troopers' work with people experiencing homelessness in Cape Town.
					Orders are collected in person or by a courier you arrange.
				</p>
			</div>
		</div>
	</section>

	{related.length > 0 && (
		<section class="section wrap">
			<h2>More from {item.categoryName}</h2>
			{/* .product-grid has fixed column counts, so a category with only one sibling left keeps
			    that card one column wide - the bug .grid-fill was once added here to fix (a lone
			    related thumbnail rendered at 1012px against the product's own 510px). */}
			<div class="product-grid">
				{related.map((other) => (
					<ItemCard
						client:load
						id={other._id}
						categoryName={other.categoryName}
						name={other.name}
						shortName={shortProductName(other.name, other.categoryName)}
						price={other.price}
						description={other.description}
						soldOut={other.soldOut}
						href={`/shop/${other.categorySlug}/${other.slug}`}
						photoUrl={other.photo ? urlFor(other.photo).width(500).height(500).fit("fill").bg("ffffff").auto("format").url() : undefined}
						photoLqip={other.photoLqip}
					/>
				))}
			</div>
			<p class="back-to-category">
				<a href={`/shop/${item.categorySlug}`}>&larr; All {item.categoryName}</a>
			</p>
		</section>
	)}
</Layout>

<style>
	.product {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 2.5rem;
		align-items: start;
	}

	@media (max-width: 720px) {
		.product {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.5rem;
		}
	}

	/* One slide per view, all the shape of the doll shots (3:4) so nothing jumps between photos;
	   `contain` on white keeps an odd-shaped photo whole rather than cropping it. */
	.carousel {
		display: grid;
		gap: 0.75rem;
	}

	.carousel-track {
		display: flex;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		scrollbar-width: none;
		margin: 0;
		padding: 0;
		list-style: none;
		border-radius: var(--radius, 18px);
		background: #fff;
	}

	.carousel-track::-webkit-scrollbar {
		display: none;
	}

	.carousel-track:focus-visible {
		outline: 3px solid var(--st-teal-dark);
		outline-offset: 3px;
	}

	.carousel-slide {
		flex: 0 0 100%;
		scroll-snap-align: start;
	}

	.carousel-slide img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 4;
		object-fit: contain;
	}

	.carousel-controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}

	/* Ink on white with a border: a control, but not a competing primary. 24px+ target. */
	.carousel-btn {
		min-width: 44px;
		min-height: 44px;
		border: 1px solid rgba(36, 35, 43, 0.25);
		border-radius: 999px;
		background: #fff;
		color: var(--st-ink);
		font-size: 1.1rem;
		cursor: pointer;
	}

	.carousel-btn:hover {
		border-color: var(--st-ink);
	}

	.carousel-btn:disabled {
		opacity: 0.35;
		cursor: default;
	}

	.carousel-count {
		min-width: 4ch;
		text-align: center;
		font-size: 0.9rem;
		font-variant-numeric: tabular-nums;
		color: rgba(36, 35, 43, 0.7);
	}

	@media (prefers-reduced-motion: reduce) {
		.carousel-track {
			scroll-behavior: auto;
		}
	}

	.product-handmade {
		margin: 0 0 1.5rem;
		padding: 0.75rem 1rem;
		border-left: 3px solid var(--st-teal);
		background: #fff;
		border-radius: 0 8px 8px 0;
		font-size: 0.95rem;
		line-height: 1.55;
	}

	/* Ink, not teal-dark: the teal family is reserved for things you can act on. As the largest
	   teal text on the page this read as the primary link. Also fixes contrast — teal-dark on
	   --st-bg is 4.29:1, under AA. */
	.product-price {
		font-weight: 700;
		font-size: 1.6rem;
		color: var(--st-ink, #24232b);
	}

	.product-body {
		margin: 1rem 0 1.75rem;
		line-height: 1.65;
		white-space: pre-line;
	}

	.sold-out {
		font-weight: 600;
		margin: 0 0 1rem;
	}

	.product-note {
		margin-top: 1.5rem;
		font-size: 0.85rem;
		color: rgba(36, 35, 43, 0.65);
		line-height: 1.6;
	}

	.back-to-category {
		margin-top: 1.5rem;
	}

	/* Underline kept (no text-decoration: none): this had colour as its only affordance, with no
	   hover underline either, so it was invisible as a link to anyone who can't pick out the teal. */
	.back-to-category a {
		font-weight: 600;
		color: var(--st-teal-dark, #148294);
	}
</style>

<script>
	// Buttons and a counter for the photo carousel. The track already scrolls and snaps on its own, so
	// with no script the carousel still works - the controls just stay hidden.
	for (const root of document.querySelectorAll<HTMLElement>("[data-carousel]")) {
		const track = root.querySelector<HTMLElement>(".carousel-track");
		const controls = root.querySelector<HTMLElement>(".carousel-controls");
		if (!track || !controls) continue;
		const count = controls.querySelector<HTMLElement>(".carousel-count");
		const [prev, next] = controls.querySelectorAll<HTMLButtonElement>(".carousel-btn");
		const total = track.children.length;
		const current = () => Math.round(track.scrollLeft / track.clientWidth);
		const update = () => {
			const i = current();
			if (count) count.textContent = `${i + 1} / ${total}`;
			prev.disabled = i === 0;
			next.disabled = i === total - 1;
		};
		for (const button of [prev, next]) {
			button.addEventListener("click", () => {
				track.scrollTo({ left: (current() + Number(button.dataset.dir)) * track.clientWidth });
			});
		}
		track.addEventListener("keydown", (event) => {
			if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
			event.preventDefault();
			(event.key === "ArrowLeft" ? prev : next).click();
		});
		track.addEventListener("scroll", update, { passive: true });
		controls.hidden = false;
		update();
	}
</script>
