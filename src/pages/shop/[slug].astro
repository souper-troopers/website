---
import Layout from "../../layouts/Layout.astro";
import PhotoHero from "../../components/PhotoHero.astro";
import shopPhoto from "../../assets/images/shop-products.jpg";
import { PortableText } from "astro-portabletext";
import { getProductCategories, getShopItems, shortProductName, urlFor } from "../../lib/sanity";
import AttributeProduct from "../../components/AttributeProduct.svelte";
import ItemCard from "../../components/ItemCard.svelte";

export async function getStaticPaths() {
	const categories = await getProductCategories();
	return categories.map((category) => ({
		params: { slug: category.slug },
		props: { category },
	}));
}

const { category } = Astro.props;
const items = category.displayMode === "items" ? await getShopItems(category.slug) : [];

// Trailing slashes match Astro's canonical/sitemap URLs — see the same note on [item].astro.
const shopUrl = new URL("/shop/", Astro.site).href;
const categoryUrl = new URL(`/shop/${category.slug}/`, Astro.site).href;

const categoryPhotoUrl = category.photo
	? urlFor(category.photo).width(900).height(900).fit("crop").auto("format").url()
	: undefined;

/**
 * An "attributes" category (currently just Coffee) is one product sold in several variants, so the
 * category page *is* its product page — there are no child pages to carry the markup. Without this
 * the coffee range would have no Product data anywhere on the site.
 */
const attributeProductJsonLd =
	category.displayMode === "attributes" && (category.attributeVariants?.length ?? 0) > 0
		? {
				"@context": "https://schema.org",
				"@type": "Product",
				name: category.name,
				url: categoryUrl,
				description: category.blurb,
				...(categoryPhotoUrl && { image: [categoryPhotoUrl] }),
				brand: { "@type": "Brand", name: "Souper Troopers" },
				offers: category.attributeVariants!.map((variant) => ({
					"@type": "Offer",
					name: variant.label,
					url: categoryUrl,
					priceCurrency: "ZAR",
					price: variant.price,
					availability: "https://schema.org/InStock",
					itemCondition: "https://schema.org/NewCondition",
					seller: { "@type": "Organization", name: "Shmiley" },
				})),
			}
		: null;

const breadcrumbJsonLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "Shop", item: shopUrl },
		{ "@type": "ListItem", position: 2, name: category.name, item: categoryUrl },
	],
};

/**
 * Worry dolls only, from the 21 September review: each is handmade, so the photos show a style, not
 * the doll you'll get; bespoke dolls and bulk orders go to a person rather than the cart. The minimum
 * of 10 and the inbox are what the call floated - confirming both is `q33` on the status page.
 */
const isDolls = category.slug === "worry-dolls";
const ordersEmail = "manager@soupertroopers.org";
const customHref = `mailto:${ordersEmail}?subject=${encodeURIComponent("Custom African Worry Dolls")}`;
const wholesaleHref = `mailto:${ordersEmail}?subject=${encodeURIComponent("Wholesale African Worry Dolls")}`;

const jsonLd = attributeProductJsonLd
	? [attributeProductJsonLd, breadcrumbJsonLd]
	: [breadcrumbJsonLd];
---

<Layout
	title={category.name}
	description={category.blurb}
	jsonLd={jsonLd}
	ogType={attributeProductJsonLd ? "product" : "website"}
	ogImage={categoryPhotoUrl}
	heroOverlay
>
	<PhotoHero image={shopPhoto} size="band" position="center 55%">
		<a class="back-link" href="/shop">&larr; All products</a>
		<h1>{category.name}</h1>
		<p>{category.blurb}</p>
	</PhotoHero>

	{category.description && (
		<section class="section wrap">
			<div class="prose">
				<PortableText value={category.description} />
			</div>
		</section>
	)}

	<section class="section wrap">
		{category.displayMode === "attributes" ? (
			<AttributeProduct
				client:load
				categorySlug={category.slug}
				categoryName={category.name}
				photoUrl={category.photo ? urlFor(category.photo).width(700).height(700).fit("crop").auto("format").url() : undefined}
				photoLqip={category.photoLqip}
				variants={category.attributeVariants ?? []}
			/>
		) : (
			<>
			{isDolls && (
				<p class="handmade-note">
					Every doll is handmade, so yours will be one of a kind. The photos show each style, not the
					exact doll you'll receive.
				</p>
			)}
			<div class="product-grid">
				{items.map((item) => (
					<ItemCard
						client:load
						id={item._id}
						categoryName={category.name}
						name={item.name}
						shortName={shortProductName(item.name, category.name)}
						price={item.price}
						description={item.description}
						soldOut={item.soldOut}
						href={`/shop/${category.slug}/${item.slug}`}
						photoUrl={item.photo ? urlFor(item.photo).width(500).height(500).fit("fill").bg("ffffff").auto("format").url() : undefined}
						photoLqip={item.photoLqip}
					/>
				))}
			</div>
			{/* Custom and wholesale share one box under the grid (2026-09-24). As a card inside the grid,
			    "Custom dolls" sat alone on the last row once the products lost their card boxes, with
			    the wholesale line trailing under it. Both are "talk to a person" routes, so they read
			    as one thing, apart from the products. */}
			{isDolls && (
				<div class="dolls-orders">
					<div>
						<h3>Custom dolls</h3>
						<p>
							Your colours, a theme, or dolls for an event. Made to order in batches of 10 or more,
							priced on request.
						</p>
						<a href={customHref}>Ask about a custom order &rarr;</a>
					</div>
					<div>
						<h3>Wholesale</h3>
						<p>
							Buying for a shop or a corporate gift? Wholesale is by appointment - <a href={wholesaleHref}>email us</a> and we'll send prices.
						</p>
					</div>
				</div>
			)}
			</>
		)}
	</section>
</Layout>

<style>
	.prose :global(* + *) {
		margin-top: 1rem;
	}

	/* Underlined: sitting on the ink hero in near-white, this was otherwise indistinguishable from
	   the surrounding heading copy, with teal appearing on hover only. */
	.back-link {
		display: inline-block;
		margin-bottom: 1rem;
		color: rgba(255, 255, 255, 0.92);
		font-size: 0.9rem;
		font-weight: 600;
	}

	.back-link:hover {
		color: var(--st-teal);
	}

	.handmade-note {
		margin: 0 0 var(--space-2);
		padding: 0.75rem 1rem;
		max-width: 60ch;
		border-left: 3px solid var(--st-teal);
		background: #fff;
		border-radius: 0 8px 8px 0;
		line-height: 1.55;
	}

	/* The site's one callout style - the handmade note's left rule (design brief phase 2; it was a
	   dashed box). Two columns on a laptop, stacked below 700px. */
	.dolls-orders {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-8);
		margin-top: var(--space-12);
		padding: var(--space-5) var(--space-6);
		border-left: 3px solid var(--st-teal);
		border-radius: 0 8px 8px 0;
		background: #fff;
	}

	.dolls-orders h3 {
		font-size: 1.1rem;
		margin-bottom: var(--space-2);
	}

	.dolls-orders p {
		color: rgba(36, 35, 43, 0.75);
		margin-bottom: var(--space-3);
	}

	.dolls-orders > div > a {
		font-weight: 700;
	}

	@media (max-width: 700px) {
		.dolls-orders {
			grid-template-columns: 1fr;
			gap: var(--space-6);
			padding: var(--space-5);
		}
	}
</style>
