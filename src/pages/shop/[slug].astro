---
import Layout from "../../layouts/Layout.astro";
import PhotoHero from "../../components/PhotoHero.astro";
import shopPhoto from "../../assets/images/shop-products.jpg";
import { PortableText } from "astro-portabletext";
import { getProductCategories, getShopItems, shortProductName, urlFor } from "../../lib/sanity";
import AttributeProduct from "../../components/AttributeProduct.svelte";
import ItemCard from "../../components/ItemCard.svelte";
import CardCtaLabel from "../../components/CardCtaLabel.astro";
import { backdropColour } from "../../lib/backdrop";

export async function getStaticPaths() {
	const categories = await getProductCategories();
	return categories.map((category) => ({
		params: { slug: category.slug },
		props: { category },
	}));
}

const { category } = Astro.props;
const items = category.displayMode === "items" ? await getShopItems(category.slug) : [];
// Each card's photo, and the colour of its own backdrop for the room above it (see backdrop.ts).
const cardPhotos = await Promise.all(
	items.map(async (item) => {
		const url = item.photo ? urlFor(item.photo).width(500).height(500).fit("fill").bg("ffffff").auto("format").url() : undefined;
		const backdrop = item.photo
			? await backdropColour(urlFor(item.photo).width(500).height(500).fit("fill").bg("ffffff").url())
			: undefined;
		return { url, backdrop };
	}),
);

// Trailing slashes match Astro's canonical/sitemap URLs — see the same note on [item].astro.
const shopUrl = new URL("/shop/", Astro.site).href;
const categoryUrl = new URL(`/shop/${category.slug}/`, Astro.site).href;

const categoryPhotoUrl = category.photo
	? urlFor(category.photo).width(900).height(900).fit("crop").auto("format").url()
	: undefined;

/**
 * An "attributes" category (currently just Coffee) is one product sold in several variants, so the
 * category page *is* its product page — there are no child pages to carry the markup. Without this
 * the coffee range would have no Product data anywhere on the site.
 */
const attributeProductJsonLd =
	category.displayMode === "attributes" && (category.attributeVariants?.length ?? 0) > 0
		? {
				"@context": "https://schema.org",
				"@type": "Product",
				name: category.name,
				url: categoryUrl,
				description: category.blurb,
				...(categoryPhotoUrl && { image: [categoryPhotoUrl] }),
				brand: { "@type": "Brand", name: "Souper Troopers" },
				offers: category.attributeVariants!.map((variant) => ({
					"@type": "Offer",
					name: variant.label,
					url: categoryUrl,
					priceCurrency: "ZAR",
					price: variant.price,
					availability: "https://schema.org/InStock",
					itemCondition: "https://schema.org/NewCondition",
					seller: { "@type": "Organization", name: "Shmiley" },
				})),
			}
		: null;

const breadcrumbJsonLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "Shop", item: shopUrl },
		{ "@type": "ListItem", position: 2, name: category.name, item: categoryUrl },
	],
};

/**
 * Worry dolls only, from the 21 September review: each is handmade, so the photos show a style, not
 * the doll you'll get; bespoke dolls and bulk orders go to a person rather than the cart. Shan
 * confirmed both on 25 September (`q33`): the minimum is 10, and these enquiries go to sales@.
 */
const isDolls = category.slug === "worry-dolls";
const ordersEmail = "sales@soupertroopers.org";
const customHref = `mailto:${ordersEmail}?subject=${encodeURIComponent("Custom African Worry Dolls")}`;
const wholesaleHref = `mailto:${ordersEmail}?subject=${encodeURIComponent("Wholesale African Worry Dolls")}`;

const jsonLd = attributeProductJsonLd
	? [attributeProductJsonLd, breadcrumbJsonLd]
	: [breadcrumbJsonLd];
---

<Layout
	title={category.name}
	description={category.blurb}
	jsonLd={jsonLd}
	ogType={attributeProductJsonLd ? "product" : "website"}
	ogImage={categoryPhotoUrl}
	heroOverlay
>
	<PhotoHero image={shopPhoto} size="band" position="center 55%">
		<a class="back-link" href="/shop">&larr; All products</a>
		<h1>{category.name}</h1>
		<p>{category.blurb}</p>
	</PhotoHero>

	{/* Items-mode categories (25 September): the description as a section intro at the site's 46rem
	    measure, its first paragraph a lead in ink and the rest muted. Coffee (attributes mode) keeps
	    the plain prose. */}
	{category.description && (
		<section class="section wrap">
			{category.displayMode === "items" ? (
				<div class="section-intro category-intro">
					<PortableText value={category.description} />
				</div>
			) : (
				<div class="prose">
					<PortableText value={category.description} />
				</div>
			)}
		</section>
	)}

	<section class="section wrap">
		{category.displayMode === "attributes" ? (
			<AttributeProduct
				client:load
				categorySlug={category.slug}
				categoryName={category.name}
				photoUrl={category.photo ? urlFor(category.photo).width(700).height(700).fit("crop").auto("format").url() : undefined}
				photoLqip={category.photoLqip}
				variants={category.attributeVariants ?? []}
			/>
		) : (
			<>
			{/* A centred statement above the grid (25 September; was a left-rule callout). Same words,
			    split into a heading line and the line beneath. */}
			{isDolls && (
				<div class="section-intro statement handmade-statement">
					<h2>Every doll is handmade, so yours will be one of a kind.</h2>
					<p>The photos show each style, not the exact doll you'll receive.</p>
				</div>
			)}
			<div class="product-grid">
				{items.map((item, i) => (
					<ItemCard
						client:load
						id={item._id}
						categoryName={category.name}
						name={item.name}
						shortName={shortProductName(item.name, category.name)}
						price={item.price}
						description={item.description}
						soldOut={item.soldOut}
						href={`/shop/${category.slug}/${item.slug}`}
						photoUrl={cardPhotos[i].url}
						backdrop={cardPhotos[i].backdrop}
						photoLqip={item.photoLqip}
					/>
				))}
			</div>
			</>
		)}
	</section>

	{/* Two white .card-cta cards under their own heading (25 September; they were one left-rule
	    callout). Each is a whole-card mailto link with the subjects the callout used. */}
	{isDolls && (
		<section class="section wrap">
			<div class="section-intro">
				<h2>Custom orders and wholesale</h2>
			</div>
			<div class="orders-grid">
				<a class="card card-cta" href={customHref}>
					<h3>Custom dolls</h3>
					<p>
						Your colours, a theme, or dolls for an event. Made to order in batches of 10 or more,
						priced on request.
					</p>
					<CardCtaLabel>Ask about a custom order</CardCtaLabel>
				</a>
				<a class="card card-cta" href={wholesaleHref}>
					<h3>Wholesale</h3>
					<p>Buying for a shop or a corporate gift? Wholesale is by appointment and we'll send prices.</p>
					<CardCtaLabel>Email us for prices</CardCtaLabel>
				</a>
			</div>
		</section>
	)}
</Layout>

<style>
	.prose :global(* + *) {
		margin-top: 1rem;
	}

	/* Underlined: sitting on the ink hero in near-white, this was otherwise indistinguishable from
	   the surrounding heading copy, with teal appearing on hover only. */
	.back-link {
		display: inline-block;
		margin-bottom: 1rem;
		color: rgba(255, 255, 255, 0.92);
		font-size: 0.9rem;
		font-weight: 600;
	}

	.back-link:hover {
		color: var(--st-teal);
	}

	/* The category intro: the site's 46rem measure, the first paragraph a lead in ink. */
	.category-intro {
		max-width: 46rem;
		gap: var(--space-3);
	}

	.category-intro :global(p) {
		max-width: none;
		margin: 0;
	}

	.category-intro :global(p:first-child) {
		font-size: 1.2rem;
		line-height: 1.5;
		color: var(--st-ink);
	}

	.handmade-statement {
		margin-bottom: var(--space-8);
	}

	.orders-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-5);
	}

	.orders-grid h3 {
		margin: 0;
		font-size: 1.1rem;
	}

	.orders-grid p {
		margin: 0;
		color: rgba(36, 35, 43, 0.75);
	}

	@media (max-width: 700px) {
		.orders-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
