---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import shopPhoto from "../../assets/images/shop-products.jpg";
import { getProductCategories, urlFor } from "../../lib/sanity";

const categories = await getProductCategories();
---

<Layout title="Handmade gifts and coffee from Cape Town" description="Troopers Coffee and African Worry Dolls - handmade in Cape Town by Souper Troopers. Every purchase creates work for people leaving homelessness.">
	<section class="page-hero">
		<div class="wrap">
			<h1>Shop with purpose</h1>
			{/* Says what is for sale, not why: the card below already says who makes it and where the money
			    goes, and this line used to say it first, in nearly the same words. */}
			<p>Troopers Coffee, African Worry Dolls and gift tags.</p>
		</div>
	</section>

	<section class="section wrap">
		{/* Was "Products by Shmiley", explaining the trading company. Adrian's point on the
		    2 September call was that this is exactly the wrong thing to open with: the homepage
		    never mentions Shmiley, so a visitor arrives here and meets a brand they have no reason
		    to recognise - "shopping with purpose, I understand, because you're supporting Souper
		    Troopers. What is Shmiley?" The call decided Shmiley stays in the background and this
		    space says plainly where the money goes instead. Brad asked for it as boldly as we can
		    put it, which is why it is the first thing on the page and why it is one sentence.

		    ⚠ Don't reintroduce Shmiley here without checking `/shmiley-decision` - the decision is
		    recorded there, on the RFC's Shmiley question, and in AGENTS.md, and all three have to
		    move together. */}
		{/* One card since 2026-09-13: the photograph and the promise were a banner and a separate
		    card, and the photo is what the sentence is about. No "Where the money goes" chip - the
		    heading says it. */}
		<div class="card shop-promise">
			<div class="shop-promise-media">
				{/* Above the fold at 390px and 1280px alike (measured), and the largest element on the
				    page - so same reasoning as the homepage hero: never lazy. See index.astro. */}
				<Image
					src={shopPhoto}
					alt="Troopers Coffee bags and African Worry Dolls on display"
					width={1600}
					widths={[600, 1100, 1600]}
					sizes="(min-width: 1100px) 1060px, 100vw"
					loading="eager"
					fetchpriority="high"
					class="shop-promise-img"
				/>
			</div>
			<div class="shop-promise-body">
				<h2>Every purchase pays a wage</h2>
				<p>
					Made in Cape Town by people the CAST programme has supported. All proceeds go straight
					back into the work - their wages, the training behind them, and the Humanity Hub where it
					happens.
				</p>
			</div>
		</div>
	</section>

	<section class="section wrap">
		<div class="grid grid-3">
			{categories.map((category) => (
				<a class="card category-tile" href={`/shop/${category.slug}`}>
					{category.photo && (
						<div
							class="category-tile-img blur-up"
							style={category.photoLqip ? `background-image:url(${category.photoLqip})` : undefined}
						>
							{/* Requested uncropped, by width only: the tile decides the crop now, since the
							    photo grows to fill the card's spare height (see .category-tile-img).
							    ⚠ The gift-tags source is 600x166, so it is upscaled at any tile size - a
							    better photo is the fix, not a setting. */}
							<img
								src={urlFor(category.photo).width(800).auto("format").url()}
								srcset={`${urlFor(category.photo).width(400).auto("format").url()} 400w, ${urlFor(category.photo).width(800).auto("format").url()} 800w`}
								sizes="(max-width: 700px) 100vw, 360px"
								alt={category.name}
								width="800"
								height="600"
								loading="lazy"
								onload="this.classList.add('is-loaded')"
							/>
						</div>
					)}
					<div class="category-tile-body">
						<h2>{category.name}</h2>
						<p>{category.blurb}</p>
						{/* Not "Shop {name}": the whole card is the link and the name is its heading, one line up. */}
						<span class="category-tile-cta">Shop &rarr;</span>
					</div>
				</a>
			))}
		</div>
	</section>

	<section class="section wrap">
		{/* No "Collection & delivery" chip - the heading says it. */}
		<div class="card">
			<h2>How orders are fulfilled</h2>
			<p>All orders are collected in person from 66 Newmarket Street, Woodstock, Cape Town.</p>
			<details class="card-more">
				<summary><span class="card-more-show">Times, couriers and bulk orders</span><span class="card-more-hide">Less</span></summary>
				<div>
					<p>Collection is Monday to Thursday, mornings to afternoons, and Friday mornings.</p>
					<p>Can't collect yourself? Arrange your own courier and we'll hand your order over - just email the details after ordering.</p>
					<p>Bulk or corporate orders: email us before ordering so we can plan ahead.</p>
				</div>
			</details>
		</div>
	</section>
</Layout>

<style>
	/* A frame, like the Contact page's Visit us card: no padding of its own, so the photo runs flush
	   to the card's edges, and the body restores the padding the global .card rule would have given. */
	.shop-promise {
		padding: 0;
		gap: 0;
		overflow: hidden;
	}

	/* 23:10 on wider screens is the shape the separate banner had (1060x460 at 1280px). On a phone
	   that shape is a sliver, so it drops to 4:3 there. */
	.shop-promise-media {
		position: relative;
		width: 100%;
		aspect-ratio: 4 / 3;
	}

	@media (min-width: 701px) {
		.shop-promise-media {
			aspect-ratio: 23 / 10;
		}
	}

	.shop-promise-img {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.shop-promise-body {
		align-self: stretch;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		padding: var(--space-6);
	}

	@media (max-width: 700px) {
		/* Mirrors the global .card padding at this width. */
		.shop-promise-body {
			padding: var(--space-4);
		}
	}
</style>
