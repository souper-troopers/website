---
import Layout from "../../layouts/Layout.astro";
import PhotoHero from "../../components/PhotoHero.astro";
import shopPhoto from "../../assets/images/shop-products.jpg";
import { getProductCategories, urlFor } from "../../lib/sanity";

const categories = await getProductCategories();
---

<Layout heroOverlay title="Handmade gifts and coffee from Cape Town" description="Troopers Coffee and African Worry Dolls - handmade in Cape Town by Souper Troopers. Every purchase creates work for people leaving homelessness.">
	{/* The shop photo that used to fill the "Every purchase pays a wage" card is the hero now (design
	    brief, 24 September); the promise itself stays word for word, directly below. */}
	<PhotoHero image={shopPhoto} position="center 55%">
		<h1>Shop with purpose</h1>
		{/* Says what is for sale, not why: the card below already says who makes it and where the money
		    goes, and this line used to say it first, in nearly the same words. */}
		<p>Troopers Coffee, African Worry Dolls and gift tags.</p>
	</PhotoHero>

	<section class="section wrap">
		{/* Was "Products by Shmiley", explaining the trading company. Adrian's point on the
		    2 September call was that this is exactly the wrong thing to open with: the homepage
		    never mentions Shmiley, so a visitor arrives here and meets a brand they have no reason
		    to recognise - "shopping with purpose, I understand, because you're supporting Souper
		    Troopers. What is Shmiley?" The call decided Shmiley stays in the background and this
		    space says plainly where the money goes instead. Brad asked for it as boldly as we can
		    put it, which is why it is the first thing on the page and why it is one sentence.

		    ⚠ Don't reintroduce Shmiley here without checking `/shmiley-decision` - the decision is
		    recorded there, on the RFC's Shmiley question, and in AGENTS.md, and all three have to
		    move together. */}
		{/* The promise, now without its photograph (that is the hero above). Same heading and words. */}
		<div class="section-intro">
			<h2>Every purchase pays a wage</h2>
			<p>
				Made in Cape Town by people the CAST programme has supported. All proceeds go straight
				back into the work - their wages, the training behind them, and the Humanity Hub where it
				happens.
			</p>
		</div>
	</section>

	<section class="section wrap">
		<div class="grid grid-3">
			{categories.map((category) => (
				<a class="category-tile" href={`/shop/${category.slug}`}>
					{category.photo && (
						<div
							class="category-tile-img blur-up"
							style={category.photoLqip ? `background-image:url(${category.photoLqip})` : undefined}
						>
							{/* Requested uncropped, by width only: the tile decides the crop (see
							    .category-tile-img). Category photos should be 4:3, like the Worry Dolls and
							    Gift Tags composites. */}
							<img
								src={urlFor(category.photo).width(800).auto("format").url()}
								srcset={`${urlFor(category.photo).width(400).auto("format").url()} 400w, ${urlFor(category.photo).width(800).auto("format").url()} 800w`}
								sizes="(max-width: 700px) 100vw, 360px"
								alt={category.name}
								width="800"
								height="600"
								loading="lazy"
								onload="this.classList.add('is-loaded')"
							/>
						</div>
					)}
					<div class="category-tile-body">
						<h2>{category.name}</h2>
						<p>{category.blurb}</p>
						{/* Not "Shop {name}": the whole card is the link and the name is its heading, one line up. */}
						<span class="category-tile-cta">Shop &rarr;</span>
					</div>
				</a>
			))}
		</div>
	</section>

	<section class="section wrap">
		{/* No "Collection & delivery" chip - the heading says it. */}
		<div class="card">
			<h2>How orders are fulfilled</h2>
			<p>All orders are collected in person from <a href="/contact">66 Newmarket Street, Woodstock, Cape Town</a>.</p>
			<details class="card-more">
				<summary><span class="card-more-show">Times, couriers and bulk orders</span><span class="card-more-hide">Less</span></summary>
				<div>
					<p>Collection is Monday to Thursday, mornings to afternoons, and Friday mornings.</p>
					<p>Can't collect yourself? Arrange your own courier and we'll hand your order over - just email the details after ordering.</p>
					<p>Bulk or corporate orders: email us before ordering so we can plan ahead.</p>
				</div>
			</details>
		</div>
	</section>
</Layout>
