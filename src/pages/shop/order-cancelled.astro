---
import Layout from "../../layouts/Layout.astro";
import PhotoHero from "../../components/PhotoHero.astro";
import shopPhoto from "../../assets/images/shop-products.jpg";
---

<Layout heroOverlay title="Order cancelled" description="Your order was not completed.">
	<PhotoHero image={shopPhoto} size="band" position="center 55%">
		<h1>Payment cancelled</h1>
		<p>No payment was taken. Your cart is still saved if you'd like to try again.</p>
	</PhotoHero>

	<section class="section wrap">
		<div class="card">
			<a class="btn btn-primary" href="/shop">Back to shop</a>
		</div>
	</section>
</Layout>
