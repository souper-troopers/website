---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Order cancelled" description="Your order was not completed.">
	<section class="page-hero">
		<div class="wrap">
			<h1>Payment cancelled</h1>
			<p>No payment was taken. Your cart is still saved if you'd like to try again.</p>
		</div>
	</section>

	<section class="section wrap">
		<div class="card">
			<a class="btn btn-primary" href="/shop">Back to shop</a>
		</div>
	</section>
</Layout>
