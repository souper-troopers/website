---
import Layout from "../../layouts/Layout.astro";
import PhotoHero from "../../components/PhotoHero.astro";
import shopPhoto from "../../assets/images/shop-products.jpg";
import EmailLink from "../../components/EmailLink.svelte";
---

<Layout heroOverlay title="Order confirmed" description="Thank you for your order." noindex>
	<PhotoHero image={shopPhoto} size="band" position="center 55%">
		<h1>Thank you</h1>
		<p>Your payment went through. We'll be in touch about collection or courier arrangements.</p>
	</PhotoHero>

	<section class="section wrap">
		<div class="card">
			<p>
				Collection is in person from <a href="/contact">66 Newmarket Street, Woodstock, Cape Town</a>, or you can arrange
				your own courier - email <EmailLink client:visible address="manager@soupertroopers.org" />
				with your order details if you haven't already.
			</p>
			<a class="btn btn-primary" href="/shop">Back to shop</a>
		</div>
	</section>

	{/* Never shown or submitted by a visitor. Netlify only accepts submissions to a form it found in
	    the built HTML, so this declares the fields payfast-itn sends when an order is paid - that
	    submission is what emails the order to the Hub. Keep the names in step with notifyHub(). */}
	<form name="shop-order" method="POST" data-netlify="true" hidden aria-hidden="true">
		<input type="hidden" name="form-name" value="shop-order" />
		<input type="text" name="buyer-name" />
		<input type="email" name="buyer-email" />
		<textarea name="items"></textarea>
		<input type="text" name="amount-paid" />
		<input type="text" name="check" />
		<input type="text" name="payfast-reference" />
		<input type="text" name="order-reference" />
		<input type="text" name="next-step" />
	</form>
</Layout>

<script>
	// Clear the cart once we land here after a successful payment.
	// Guarded: Safari in private browsing exposes localStorage and then throws on it.
	try {
		localStorage.removeItem("souper-troopers-cart");
	} catch {}
</script>
